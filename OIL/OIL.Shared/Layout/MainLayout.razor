@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject OIL.Shared.Services.CustomAuthStateProvider customAuthStateProvider

<MudThemeProvider Theme="_currentTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <!-- APP BAR -->
            <MudAppBar Elevation="1" Style="background-color: white; color: black; z-index: 1400;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start" OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ms-2" Style="font-weight:700;">Field Maintenance Systems</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Logout">Logout</MudButton>
            </MudAppBar>

            <!-- DRAWER -->
            <MudDrawer @bind-Open="_drawerOpen"
                       Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Md"
                       Elevation="2"
                       ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>

            <!-- MAIN CONTENT - Removed nested padding div to fix MAUI scroll jump -->
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </Authorized>

    <NotAuthorized>
        <!-- CHANGED: min-height: 100vh to height: 100vh to ensure it scrolls internally when body is locked -->
        <div style="height: 100vh; overflow-y: auto; -webkit-overflow-scrolling: touch; background-color: #f8fafc; padding: 1rem;">
            @Body
        </div>

        @* <div style="min-height: 100vh; overflow-y: auto; background-color: #f8fafc; padding: 1rem;">
            @Body
        </div> *@
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true; // Default open for better desktop feel

    [Inject] private NavigationManager Nav { get; set; }

    private async void Logout()
    {
        try
        {
            // 1. Clear the token from local storage
            
            customAuthStateProvider.NotifyLogout();

            // Add your specific logout logic here
            Nav.NavigateTo("login");
            
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }


       
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private MudTheme _currentTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#E21E26",
            AppbarBackground = "#ffffff",
            DrawerBackground = "#ffffff",
            Surface = "#ffffff"
        }
    };
}