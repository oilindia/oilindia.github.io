    private async Task HandleSubmit()
    {
        _isBusy = true;
        try
        {
            // FIX: Use JsonSerializerOptions or just ensure the single-argument version is available
            var auditJson = System.Text.Json.JsonSerializer.Serialize(_replacements);

            // 1. Update Job Assignments
            await SupabaseClient.From<JobAssignment>()
                .Where(x => x.Id == CurrentJobAssignmentId)
                .Set(x => x.SpareReplace, auditJson)
                // Note: Ensure 'status' column exists in your JobAssignment.cs POCO
                .Set(x => x.status, "Completed")
                .Update();

            // 2. Sync pid_markers
            foreach (var item in _replacements)
            {
                var markerUpdate = new PIDMarker
                {
                    LocationId = CurrentLocationId,
                    Device_location = item.DeviceLocation,
                    InstrumentType = item.InstrumentType,
                    MakeModelType = item.NewMakeModel,
                    Range = item.NewRange,
                    Serial_number = item.NewSerialNumber,
                    Replacement_cost = item.ApproxCost
                };

                // Logic: If manual or no ID was found during fetch, Insert. Otherwise, Update.
                if (item.IsManualLocation || item.IsManualType || item.LocationId == null)
                {
                    await SupabaseClient.From<PIDMarker>().Insert(markerUpdate);
                }
                else
                {
                    markerUpdate.Id = item.LocationId.Value;
                    await SupabaseClient.From<PIDMarker>().Update(markerUpdate);
                }
            }
        }
        finally
        {
            _isBusy = false;
        }
    }
}






