    private void SetSelectedYear(int year) => _selectedYear = year;
    private void OpenLoginModal()
    {
        _loginUser = "";
        _loginPass = "";
        _loginStatus = "";
        _loginSuccess = false;
        _showLoginModal = true;
    }
    private void CloseLoginModal() => _showLoginModal = false;

    private async Task HandleLoginSubmit()
    {
        if (string.IsNullOrWhiteSpace(_loginUser) || string.IsNullOrWhiteSpace(_loginPass))
        {
            _loginStatus = "Error: Please provide User ID and Passcode.";
            _loginSuccess = false;
            return;
        }

        _loginStatus = "Authenticating against OIL Instrumentation SCADA Node...";
        _loginSuccess = true;
        StateHasChanged();

        await Task.Delay(1000);
        _isProcessing = true;
        StateHasChanged();

        try
        {
            var success = await AuthService.Login(_loginUser, _loginPass, false);
            await Task.Delay(800);
            _isProcessing = false;

            if (success)
            {
                _loginStatus = "Access Granted! Redirecting to secure dashboard...";
                StateHasChanged();
                await Task.Delay(1000);
                _showLoginModal = false;
                Nav.NavigateTo("homeDB", forceLoad: false);
            }
            else
            {
                _loginStatus = "Authentication failed. Invalid credentials.";
                _loginSuccess = false;
                Snackbar.Add("Authentication failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _isProcessing = false;
            _loginStatus = $"Error: {ex.Message}";
            _loginSuccess = false;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}