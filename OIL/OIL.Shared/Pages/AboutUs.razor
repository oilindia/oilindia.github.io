@page "/home"

@using MudBlazor
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<style>
    .presentation-root {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100vw !important;
        height: 100vh;
        background-color: #050505;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .slide-body {
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem; /* Reduced padding */
        text-align: center;
    }

    .white-text {
        color: #ffffff !important;
        text-shadow: 0px 2px 10px rgba(0,0,0,0.8);
    }

    .sub-text {
        color: #e0e0e0 !important;
        max-width: 850px;
        line-height: 1.4;
    }

    .overlay-vibrant {
        background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.8));
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .nav-controller {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 20px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 8px 20px;
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        z-index: 1000;
    }
</style>

<div id="presentationCanvas" class="presentation-root">
    <MudCarousel @ref="_carousel" TData="object" Style="height:100vh"
                 ShowArrows="false" ShowBullets="true" AutoCycle="false"
                 @bind-SelectedIndex="_currentIndex">

        @* Slide 1: Introduction - Heavily condensed *@
        <MudCarouselItem Transition="Transition.Slide">
            <div class="slide-body" style="background: radial-gradient(circle, #232526 0%, #1a237e 100%);">
                <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="Size.Large" Style="font-size: 5rem;" Color="Color.Info" />
                <MudText Typo="Typo.h3" Class="white-text fw-bold mb-4">Field Maintenance Overview</MudText>
                <MudText Typo="Typo.body1" Class="sub-text">
                    The Instrumentation Field Maintenance Department delivers essential technical expertise across the Eastern and Western Fields, supporting diverse installations such as OCS, GCS, QPS, EPS, Boiler, and MSG units. Beyond core operations, the department extends its services to specialized sectors, including Medical, Field Engineering, Chemical, R&D, and CMT.                  
                </MudText>
                <MudText Typo="Typo.body1" Class="sub-text mt-4">
                    Managing 60+ assets per site—including PLC/DCS, SCADA, and safety sensors—our
                    team ensures maximum uptime. Through precision calibration and proactive
                    maintenance, we deliver zero production loss and maintain a perfect safety record.
                </MudText>

                <MudText Typo="Typo.body1" Class="sub-text mt-4">
                    With a portfolio of over 60 assets per site—ranging from PLC/DCS and SCADA systems to critical gas safety sensors—the team ensures maximum operational uptime. By providing precise on-site calibration and proactive maintenance of instrumentation assets, the department maintains rigorous system integrity. Their mission remains focused on delivering seamless preventive maintenance with zero production loss and an unblemished safety record.
                </MudText>
            </div>
        </MudCarouselItem>

        @* Slide 2: Zero Production Loss *@
        <MudCarouselItem Transition="Transition.Fade">
            <div class="slide-body" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80'); background-size: cover;">
                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Large" Color="Color.Error" Style="font-size: 4rem;" />
                <MudText Typo="Typo.h3" Class="white-text fw-bold">ZERO PRODUCTION LOSS</MudText>
                <MudText Typo="Typo.body1" Class="white-text mt-4 sub-text">
                    Eliminating unplanned downtime via real-time instrument health monitoring.
                    We mitigate risks before they impact operational costs.
                </MudText>
            </div>
        </MudCarouselItem>

        @* Slide 3: Maintenance Pillar *@
        <MudCarouselItem Transition="Transition.Slide">
            <div class="slide-body" style="background-color: #111;">
                <MudText Typo="Typo.h4" Color="Color.Info" Class="fw-bold mb-6">CORE MAINTENANCE</MudText>
                <MudGrid Justify="Justify.Center" Style="max-width: 800px;">
                    <MudItem xs="6">
                        <MudIcon Icon="@Icons.Material.Filled.Construction" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="white-text mt-2">Upkeep</MudText>
                        <MudText Typo="Typo.body2" Class="sub-text">Preventive servicing of hardware.</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudIcon Icon="@Icons.Material.Filled.ModelTraining" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="white-text mt-2">Calibration</MudText>
                        <MudText Typo="Typo.body2" Class="sub-text">Precision tuning for accuracy.</MudText>
                    </MudItem>
                </MudGrid>
            </div>
        </MudCarouselItem>

        @* Slide 4: Safety Pillar *@
        <MudCarouselItem Transition="Transition.Fade">
            <div class="slide-body" style="background-color: #1b5e20;">
                <MudIcon Icon="@Icons.Material.Filled.GppGood" Size="Size.Large" Style="font-size: 5rem;" />
                <MudText Typo="Typo.h3" Class="white-text fw-bold">SAFETY FIRST</MudText>
                <MudText Typo="Typo.body1" Class="white-text mt-4 sub-text">
                    Protecting lives and assets through rigorous maintenance of
                    Emergency Shutdown (ESD) and Fire & Gas systems.
                </MudText>
            </div>
        </MudCarouselItem>

        @* Slide 5: Digital Transformation *@
        <MudCarouselItem Transition="Transition.Slide">
            <div class="slide-body" style="background: #000;">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Info" Style="font-size: 4rem;" />
                <MudText Typo="Typo.h3" Class="white-text fw-bold">DIGITAL PORTAL</MudText>
                <MudText Typo="Typo.body1" Class="white-text mt-4 sub-text">
                    Unified reporting, driver management, and real-time field data
                    delivered through a single digital interface.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Info" Class="mt-8 px-8 py-2 rounded-pill" OnClick="HandleNext">
                    FINISH
                </MudButton>
            </div>
        </MudCarouselItem>
    </MudCarousel>

    <div class="nav-controller">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="Previous" Disabled="@(_currentIndex == 0)" />
        <MudIconButton Icon="@(_isFull ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Color="Color.Info" OnClick="ToggleFullScreen" />
        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Inherit" OnClick="HandleNext" />
    </div>
</div>

@code {
    private MudCarousel<object>? _carousel;
    private int _currentIndex = 0;
    private bool _isFull = false;
    private const int TotalSlides = 5;

    private async Task ToggleFullScreen()
    {
        if (!_isFull)
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('presentationCanvas').requestFullscreen()");
            _isFull = true;
        }
        else
        {
            await ExitFullScreen();
        }
    }

    private async Task ExitFullScreen()
    {
        await JSRuntime.InvokeVoidAsync("eval", "if(document.fullscreenElement) document.exitFullscreen()");
        _isFull = false;
    }

    private void Previous() => _carousel?.Previous();

    private async Task HandleNext()
    {
        if (_currentIndex == TotalSlides - 1)
        {
            await ExitFullScreen();
            Snackbar.Add("Presentation Completed", Severity.Success);
            _currentIndex = 0;
        }
        else
        {
            _carousel?.Next();
        }
    }
}