    private async Task gcsOpenCalibration(GcsInstrumentRow row)
    {
        try
        {
            _gcsactiveRowRef = row;
            if (string.IsNullOrWhiteSpace(row.CertNo))
            {
                var response = await SupabaseClient.From<CalibrationDetail>().Count(Supabase.Postgrest.Constants.CountType.Exact);
                int nextId = (int)response + 1;
                string safeTag = string.IsNullOrWhiteSpace(row.TagNumber) ? "GEN" : row.TagNumber.Replace("/", "-");
                row.CertNo = $"INST/{safeTag}/{nextId}";
            }

            if (row.CalibrationData == null)
            {
                row.CalibrationData = new ResultEntry
                {
                    RECertificateNo = row.CertNo,
                    REUnit = row.Unit,
                    REInstallation = row.Unit,
                    RERange = row.Range,
                    REInstrumentType = row.Instrument,
                    REModel = !string.IsNullOrWhiteSpace(row.ManualMakeModel) ? row.ManualMakeModel : row.MakeModel,
                    RERemarks = "Calibration completed successfully."
                };
            }

            _activeResult = row.CalibrationData;
            _activeResult.RECertificateNo = row.CertNo;
            _activeResult.REUnit = row.Unit;
            _activeResult.REInstallation = row.Unit;
            _activeResult.RERange = row.Range;
            _activeResult.REInstrumentType = row.Instrument;
            _activeResult.REModel = !string.IsNullOrWhiteSpace(row.ManualMakeModel) ? row.ManualMakeModel : row.MakeModel;

            if (_activeResult.RECalibration == null)
            {
                string instrumentName = row.Instrument?.ToLower() ?? "";
                if (instrumentName.Contains("controller"))
                    _activeResult.RECalibration = new ControllerInstrumentData { MasterCalibrator = "Druck DPI 610" };
                else if (instrumentName.Contains("transmitter"))
                    _activeResult.RECalibration = new BaseInstrumentData { MasterCalibrator = "Druck DPI 610" };
                else
                    _activeResult.RECalibration = new BaseInstrumentData { MasterCalibrator = "FLUKE (718Ex 300G)" };
            }

            if (_activeResult.RECalibration is BaseInstrumentData baseData) _activeResult.REMasterCalibrator = baseData.MasterCalibrator;
            if (_activeResult.RECalibration is ControllerInstrumentData controllerData) _activeResult.REMasterCalibrator = controllerData.MasterCalibrator;

            _isCalibrationVisible = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error opening GCS calibration: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCalibration(OcsInstrumentRow row)
    {
        try
        {
            _activeRowRef = row;
            if (string.IsNullOrWhiteSpace(row.CertNo))
            {
                var response = await SupabaseClient.From<CalibrationDetail>().Count(Supabase.Postgrest.Constants.CountType.Exact);
                int nextId = (int)response + 1;
                row.CertNo = $"INST/{row.TagNumber}/{nextId}";
            }

            if (row.CalibrationData == null)
            {
                row.CalibrationData = new ResultEntry
                {
                    RECertificateNo = row.CertNo,
                    REUnit = row.Unit,
                    REInstallation = row.Unit,
                    REInstrumentType = !string.IsNullOrWhiteSpace(row.Instrument) ? row.Instrument : row.ManualInstrument,
                    REModel = !string.IsNullOrWhiteSpace(row.MakeModel) ? row.MakeModel : row.ManualMakeModel,
                    RERange = !string.IsNullOrWhiteSpace(row.Range) ? row.Range : row.ManualRange
                };
            }

            _activeResult = row.CalibrationData;
            _activeResult.REInstallation ??= row.Unit ?? row.ManualUnit;
            _activeResult.REModel ??= row.MakeModel ?? row.ManualMakeModel;
            _activeResult.RERange ??= row.Range ?? row.ManualRange;
            _activeResult.REInstrumentType ??= row.Instrument ?? row.ManualInstrument;

            if (_activeResult.RECalibration == null)
            {
                string name = (_activeResult.REInstrumentType ?? "").ToLower();
                if (name.Contains("controller"))
                    _activeResult.RECalibration = new ControllerInstrumentData { MasterCalibrator = "Druck DPI 610" };
                else if (name.Contains("transmitter"))
                    _activeResult.RECalibration = new BaseInstrumentData { MasterCalibrator = "Druck DPI 610" };
                else
                    _activeResult.RECalibration = new BaseInstrumentData { MasterCalibrator = "FLUKE (718Ex 300G)" };
            }

            _isCalibrationVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveGcsReportSingle(GcsInstrumentRow contextRow)
    {
        try
        {
            bool? result = await DialogService.ShowMessageBoxAsync("Confirm Save", "Are you sure you want to save this row and its certificate?", yesText: "OK", cancelText: "Cancel");
            if (result == null || !result.Value) return;

            var pmReport = new PmReport
            {
                JobId = _selectedJob!.Id,
                LocationId = currentPMlocationID,
                TechnicianEmail = _email,
                SparesConsumed = _sparesConsumed,
                ApproxTotalCost = _approxTotalCost,
                SectionAJson = JsonSerializer.Serialize(_gcsRows),
                WorkPermit = _workPermit
            };

            var response = await SupabaseClient.From<PmReport>().Insert(pmReport);
            var savedReport = response.Models.FirstOrDefault();
            if (savedReport == null)
            {
                Snackbar.Add("Error: Could not retrieve saved report ID.", Severity.Error);
                return;
            }

            IEnumerable<GcsInstrumentRow> rowsToProcess = new List<GcsInstrumentRow> { contextRow };
            foreach (var row in rowsToProcess.Where(r => r.TestingType == "Calibration"))
            {
                string jsonToSave = "{}";
                if (row.CalibrationData?.RECalibration != null)
                {
                    var options = new JsonSerializerOptions { WriteIndented = false, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
                    jsonToSave = JsonSerializer.Serialize(row.CalibrationData.RECalibration, row.CalibrationData.RECalibration.GetType(), options);
                }

                var detail = new CalibrationDetail
                {
                    JobId = _selectedJob.Id,
                    PmReportId = savedReport.Id,
                    CertNo = row.CertNo,
                    Installation = row.Installation,
                    UnitId = row.Unit,
                    InstrumentType = row.Instrument,
                    Model = row.MakeModel,
                    Range = row.Range,
                    CalibrationDataJson = jsonToSave,
                    PerformedBy = _assignedTo,
                    WitnessedBy = _preparedBy
                };

                try
                {
                    await SupabaseClient.From<CalibrationDetail>().Insert(detail);
                    Snackbar.Add($"Report and Certificates Saved Successfully: {detail.CertNo}", Severity.Success);
                }
                catch (Exception ex) when (ex.Message.Contains("23505"))
                {
                    Console.WriteLine($"Skipping duplicate Certificate Number: {detail.CertNo}");
                    Snackbar.Add($"Skipping duplicate Certificate Number: {detail.CertNo}", Severity.Error);
                    continue;
                }
                catch (Exception detailEx)
                {
                    Snackbar.Add($"Save Error: {detailEx.Message}", Severity.Error);
                    Console.WriteLine($"Error saving detail for Cert {detail.CertNo}: {detailEx.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException?.Message ?? ex.Message;
            Snackbar.Add($"Save Error: {msg}", Severity.Error);
        }
    }

