                    <MudItem xs="12" sm="4"><MudTextField Label="Model Spec" @bind-Value="_activeResult.REModel" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" Label="Master Calibrator" @bind-Value="_activeResult.REMasterCalibrator" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
