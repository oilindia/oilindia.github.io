    // --- SUPABASE TABLE MODELS ---
    [Supabase.Postgrest.Attributes.Table("jobs")]
    public class Job : Supabase.Postgrest.Models.BaseModel
    {
        [Supabase.Postgrest.Attributes.PrimaryKey("id")] public Guid Id { get; set; }
        [Supabase.Postgrest.Attributes.Column("job_name")] public string JobName { get; set; } = "";
        [Supabase.Postgrest.Attributes.Column("status")] public string Status { get; set; } = "";
        [Supabase.Postgrest.Attributes.Column("location_id")] public int LocationId { get; set; }
        [Supabase.Postgrest.Attributes.Column("job_type")] public string JobType { get; set; } = "";
    }

    [Supabase.Postgrest.Attributes.Table("locations")]
    public class Location : Supabase.Postgrest.Models.BaseModel
    {
        [Supabase.Postgrest.Attributes.PrimaryKey("id")] public int Id { get; set; }
        [Supabase.Postgrest.Attributes.Column("installation_type")] public string? InstallationType { get; set; }
        [Supabase.Postgrest.Attributes.Column("installation_name")] public string? InstallationName { get; set; }
    }

    [Supabase.Postgrest.Attributes.Table("pid_markers")]
    public class PidMarker : Supabase.Postgrest.Models.BaseModel
    {
        [Supabase.Postgrest.Attributes.Column("tag_number")] public string? TagNumber { get; set; }
        [Supabase.Postgrest.Attributes.Column("device_location")] public string? DeviceLocation { get; set; }
        [Supabase.Postgrest.Attributes.Column("instrument_type")] public string? InstrumentType { get; set; }
        [Supabase.Postgrest.Attributes.Column("make_model_type")] public string? MakeModelType { get; set; }
        [Supabase.Postgrest.Attributes.Column("range")] public string? Range { get; set; }
        [Supabase.Postgrest.Attributes.Column("location_id")] public int LocationId { get; set; }
    }

    [Supabase.Postgrest.Attributes.Table("pm_reports")]
    public class PmReport : Supabase.Postgrest.Models.BaseModel
    {
        // REMOVE [Column("id")] here. PrimaryKey handles the mapping.
        [PrimaryKey("id", shouldInsert: false)]
        public int? Id { get; set; }
        [Supabase.Postgrest.Attributes.Column("job_id")] public Guid JobId { get; set; }
        [Supabase.Postgrest.Attributes.Column("location_id")] public int LocationId { get; set; }
        [Supabase.Postgrest.Attributes.Column("technician_email")] public string TechnicianEmail { get; set; } = "";
        [Supabase.Postgrest.Attributes.Column("section_a_controllers")] public string SectionAJson { get; set; } = "";
        [Supabase.Postgrest.Attributes.Column("work_permit")] public string WorkPermit { get; set; } = "";
        [Supabase.Postgrest.Attributes.Column("remarks")] public string Remarks { get; set; } = "";
        [Supabase.Postgrest.Attributes.Column("section_d_spares")] public string SparesConsumed { get; set; } = "";

    }

    [Supabase.Postgrest.Attributes.Table("pm_calibration_details")]
    public class CalibrationDetail : Supabase.Postgrest.Models.BaseModel
    {
        [PrimaryKey("id", shouldInsert: false)] // 'false' because Supabase generates the UUID
        //[Supabase.Postgrest.Attributes.PrimaryKey("id")]
        public int? Id { get; set; }

        [Supabase.Postgrest.Attributes.Column("pm_report_id")]
        public int? PmReportId { get; set; }

        [Supabase.Postgrest.Attributes.Column("job_id")]
        public Guid JobId { get; set; }

        [Supabase.Postgrest.Attributes.Column("cert_no")]
        public string CertNo { get; set; } = "";

        [Supabase.Postgrest.Attributes.Column("installation")]
        public string Installation { get; set; }

        [Supabase.Postgrest.Attributes.Column("instrument_type")]
        public string InstrumentType { get; set; }

        [Supabase.Postgrest.Attributes.Column("model")]
        public string Model { get; set; } = "";

        [Supabase.Postgrest.Attributes.Column("unit_id")]
        public string UnitId { get; set; } = "";

        [Supabase.Postgrest.Attributes.Column("instrument_range")]
        public string Range { get; set; } = "";

        [Supabase.Postgrest.Attributes.Column("master_calibrator")]
        public string MasterCalibrator { get; set; } = "";

        [Supabase.Postgrest.Attributes.Column("calibration_data")]
        public string CalibrationDataJson { get; set; } = "[]";

        [Supabase.Postgrest.Attributes.Column("performed_by_name")]
        public string PerformedBy { get; set; } = "";

        [Supabase.Postgrest.Attributes.Column("witnessed_by_name")]
        public string WitnessedBy { get; set; } = "";
    }

