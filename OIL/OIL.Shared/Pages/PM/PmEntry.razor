            <div class="d-flex flex-column flex-sm-row justify-end gap-2 pa-4 border-t bg-slate-50">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CloseCalibration">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseCalibration">Apply & Sync</MudButton>
            </div>
        </MudPaper>
    </div>
}





