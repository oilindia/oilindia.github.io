@page "/pmexecution"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Runtime.Serialization
@using System.Text.Json
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject OIL.Shared.Services.CustomAuthStateProvider AuthStateProvider
@using static Supabase.Postgrest.QueryOptions
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12" Style="width: 100%;">
    <MudPaper Class="pa-8" Elevation="3" Style="background-color: #f9f9f9; width: 100%; max-width: 100%;">
        @* --- HEADER & JOB SELECTION --- *@
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-6" Style="font-weight: bold;">
            PM EXECUTION: @(_detectedType ?? "SELECT JOB")
        </MudText>

        <MudGrid Class="mb-6">
            <MudItem xs="12" md="4">
                <MudSelect T="Job" Label="Select Job" Value="_selectedJob" ValueChanged="OnJobChanged"
                           ToStringFunc="@(j => j?.JobName ?? "")" Variant="Variant.Outlined">
                    @foreach (var job in _pendingJobs)
                    {
                        <MudSelectItem Value="@job" />
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_workPermit" Label="Notification Number" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_assignedTo" Label="Assigned To" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        @if (_isSearching)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
        }

        @* ============================================================ *@
        @* BRANCH 1: GCS UI (Ref: image_cc4400.png)                     *@
        @* ============================================================ *@
        @if (_selectedJob != null && _detectedType == "GCS")
        {
            <MudExpansionPanel Text="GCS Maintenance Section" IsExpanded="true">
                

                @* @RenderGcsGrid() *@

                <MudExpansionPanel Text="GCS Instrument Calibration" IsExpanded="true">

                    <MudAlert Severity="Severity.Info" Class="mb-4">Unit-wise grouping enabled for GCS workflow.</MudAlert>

                    <div class="gcs-container" style="width: 100%; padding: 10px;">
                        <MudTable Items="@_gcsRows"
                                  Dense="true"
                                  Bordered="false"
                                  Elevation="0"
                                  CustomHeader="true"
                                  Width="100%"
                                  Class="mud-width-full">
                            <RowTemplate>

                                @* --- GAP ROW --- *@
                                <MudTr Style="height: 10px; border: none !important;">
                                    <MudTd colspan="8" Style="background-color: darkred; border: none !important;"></MudTd>
                                    <MudTd colspan="8" Style="background-color: black; border: none !important;"></MudTd>
                                </MudTr>


                                @* --- SUB-ROW 3: COMPRESSOR DATA & VISUAL CHECKS --- *@
                                <MudTr Style="background-color: #fafafa; border-bottom: 3px solid #ddd;">
                                    <MudTd colspan="8">
                                        <MudGrid Class="pa-4 mb-2" Style="background: #f5f5f5; border-radius: 8px; border: 1px solid #e0e0e0;">
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.subtitle2"><b>Compressor Details:</b></MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                @* Note: Changed from _gcsData to context so it is unique per row *@
                                                <MudTextField @bind-Value="context.CompSlNo" Label="Comp. Sl. No" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudTextField @bind-Value="context.CompMakeModel" Label="Make (e.g. ATLAS COPCO)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                        </MudGrid>

                                        <div class="visual-checks pa-4" style="border: 1px solid #ccc; background-color: white; border-radius: 8px;">
                                            <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Visual Checking Points:</b></MudText>

                                            <MudCheckBox T="bool" @bind-Checked="context.CheckTripping"
                                                         Label="1] Checked all tripping parameters and their settings." Dense="true" Color="Color.Primary" />

                                            <MudCheckBox T="bool" @bind-Checked="context.CheckTubing"
                                                         Label="2] Panel inside tubing checked and found ok." Dense="true" Color="Color.Primary" />

                                            <MudCheckBox T="bool" @bind-Checked="context.CheckAFR"
                                                         Label="3] Air Filter Regulators draining and servicing done." Dense="true" Color="Color.Primary" />
                                        </div>
                                    </MudTd>
                                </MudTr>

                               



                                @* --- INSTRUMENT BLOCK START --- *@

                                @* SUB-ROW 1: IDENTIFICATION HEADER (Grey Background) *@
                                @* <MudTr Style="background-color: var(--mud-palette-background-grey); font-weight: bold; border-top: 2px solid var(--mud-palette-lines-default);"> *@
                                <MudTr Style="background-color: lightcoral;">
                                    <MudTd colspan="3" Style="color: black;">Unit / Location</MudTd>
                                    <MudTd colspan="2" Style="color: black;">Instrument</MudTd>
                                    <MudTd colspan="2" Style="color: black;">Tag Number</MudTd>
                                </MudTr>

                                @* SUB-ROW 1: IDENTIFICATION DATA (White Background) *@
                                @* <MudTr Style="background-color: var(--mud-palette-surface);"> *@
                                <MudTr Style="background-color: var(--mud-palette-surface); border-bottom: 2px solid var(--mud-palette-lines-default);">
                                    <MudTd colspan="3">
                                        <MudSelect T="string" Value="@context.Unit" ValueChanged="@(v => gcsOnUnitChanged(context, v))" Dense="true" Margin="Margin.Dense" Label="Select Unit">
                                            <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                            @foreach (var u in _uniqueUnits)
                                            {
                                                <MudSelectItem Value="@u">@u</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudTextField @bind-Value="context.ManualUnit" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd colspan="2">
                                        <MudSelect T="string" Value="@context.Instrument" ValueChanged="@(v => gcsOnInstrumentChanged(context, v))" Dense="true" Margin="Margin.Dense" Label="Select Instrument">
                                            <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                            @foreach (var i in context.AvailableInstruments)
                                            {
                                                <MudSelectItem Value="@i">@i</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudTextField @bind-Value="context.ManualInstrument" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd colspan="2">
                                        <MudSelect T="string" Value="@context.TagNumber" ValueChanged="@(v => gcsOnTagChanged(context, v))" Dense="true" Margin="Margin.Dense" Label="Select Tag">
                                            <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                            @foreach (var t in context.AvailableTags)
                                            {
                                                <MudSelectItem Value="@t">@t</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudTextField @bind-Value="context.ManualTag" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                    </MudTd>
                                </MudTr>

                                @* SUB-ROW 2: TECHNICAL HEADER (Light Blue/Alternative Background) *@
                                <MudTr Style="background-color: lightgray">
                                    <MudTd>Make / Model</MudTd>
                                    <MudTd>Range</MudTd>
                                    <MudTd>Quantity</MudTd>
                                    <MudTd colspan="2">Testing & Calibration</MudTd>
                                    <MudTd colspan="2">Remarks</MudTd>
                                    <MudTd>Actions</MudTd>
                                </MudTr>

                                @* SUB-ROW 2: TECHNICAL DATA (White Background) *@
                                <MudTr Style="background-color: var(--mud-palette-surface); border-bottom: 2px solid var(--mud-palette-lines-default);">
                                    <MudTd>
                                        <MudTextField @bind-Value="context.MakeModel" Margin="Margin.Dense" />
                                        <MudTextField @bind-Value="context.ManualMakeModel" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd>
                                        <MudTextField @bind-Value="context.Range" Margin="Margin.Dense" />
                                        <MudTextField @bind-Value="context.ManualRange" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd><MudNumericField @bind-Value="context.Quantity" Margin="Margin.Dense" Min="1" /></MudTd>
                                    <MudTd colspan="2">
                                        <div class="d-flex align-center gap-2">
                                            <MudSelect @bind-Value="context.TestingType" Margin="Margin.Dense" Dense="true" Style="min-width: 150px;">
                                                <MudSelectItem Value="@("Calibration")">Calibration</MudSelectItem>
                                                <MudSelectItem Value="@("Functional")">Functional</MudSelectItem>
                                            </MudSelect>
                                            @if (context.TestingType == "Calibration")
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Analytics" Size="Size.Small" Color="Color.Info"
                                                               OnClick="() => gcsOpenCalibration(context)" />
                                            }
                                        </div>
                                    </MudTd>
                                    <MudTd>
                                        <div class="d-flex flex-column">
                                            <MudSelect T="string"
                                                       Value="@context.Remarks"
                                                       ValueChanged="@(v => gcsOnRemarksChanged(context, v))"
                                                       Dense="true"
                                                       Margin="Margin.Dense"
                                                       Label="Select Remarks">
                                                <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                                @foreach (var t in context.AvailableRemarks)
                                                {
                                                    <MudSelectItem Value="@t">@t</MudSelectItem>
                                                }
                                            </MudSelect>

                                            <MudTextField @bind-Value="context.ManualRemarks"
                                                          Placeholder="Manual Entry"
                                                          Class="mt-2"
                                                          Margin="Margin.Dense" />
                                        </div>
                                    </MudTd>
                                    <MudTd>
                                        <div class="d-flex">
                                            <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Success" OnClick="@(() => SaveGcsReport())" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => _gcsRows.Remove(context))" />
                                        </div>
                                    </MudTd>
                                </MudTr>

                                @* --- GAP ROW: Creates the visual separation between entries --- *@
                                <MudTr Style="height: 5px; border: none !important;">
                                    <MudTd colspan="6" Style="background-color: blue; border: none !important;"></MudTd>
                                </MudTr>

                                <MudTr Style="background-color: #fafafa; border-bottom: 3px solid #ccc;">
                                    <MudTd colspan="8">
                                        @* 3. Status & Spares (The new fields you requested) *@
                                        <MudGrid Class="pa-4" Style="background: #ffffff; border: 1px solid #ccc; border-radius: 8px;">
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="context.SafetyInterlocks"
                                                              Label="Safety Interlocks"
                                                              Placeholder="Checked and found OK."
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="context.Hooter"
                                                              Label="Hooter Status"
                                                              Placeholder="Working properly."
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="context.SparesConsumed"
                                                              Label="Spares Consumed"
                                                              Placeholder="NIL"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudTd>
                                </MudTr>

                                @* --- GAP ROW --- *@
                                <MudTr Style="height: 10px; border: none !important;">
                                    <MudTd colspan="8" Style="background-color: darkred; border: none !important;"></MudTd>
                                    <MudTd colspan="8" Style="background-color: black; border: none !important;"></MudTd>
                                </MudTr>

                                @* --- INSTRUMENT BLOCK END --- *@
                            </RowTemplate>
                        </MudTable>


                        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Parts & Spares</MudText>
                        <MudGrid Class="mb-6">
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="Spares Consumed"
                                              Variant="Variant.Outlined"
                                              Lines="5"
                                              @bind-Value="_sparesConsumed"
                                              Placeholder="List the spares used here..." />
                            </MudItem>
                        </MudGrid>

                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddGcsRow"
                                   Color="Color.Secondary"
                                   Variant="Variant.Filled"
                                   Class="mt-2"
                                   FullWidth="true">
                            ++ ADD NEW ROW
                        </MudButton>
                    </div>



                    @* @RenderOcsGrid() *@

                    @* <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddOcsRow" Color="Color.Primary" Class="mt-2">Add Manual OCS Row</MudButton> *@
                </MudExpansionPanel>



                
            </MudExpansionPanel>

            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveGcsReport" Class="mt-6">Save GCS Report</MudButton>
        }

        @* ============================================================ *@
        @* BRANCH 2: OCS UI (Ref: image_cc4477.png)                     *@
        @* ============================================================ *@
        else if (_selectedJob != null && _detectedType == "OCS")
        {
            <MudExpansionPanel Text="OCS Instrument Calibration" IsExpanded="true">
                <MudAlert Severity="Severity.Info" Class="mb-4">Unit-wise grouping enabled for OCS workflow.</MudAlert>

                <div class="ocs-container" style="width: 100%; padding: 10px;">
                    <MudTable Items="@_ocsRows"
                              Dense="true"
                              Bordered="false"
                              Elevation="0"
                              CustomHeader="true"
                              Width="100%"
                              Class="mud-width-full">
                        <RowTemplate>

                            @* --- GAP ROW --- *@
                            <MudTr Style="height: 10px; border: none !important;">
                                <MudTd colspan="8" Style="background-color: darkred; border: none !important;"></MudTd>
                                <MudTd colspan="8" Style="background-color: black; border: none !important;"></MudTd>
                            </MudTr>

                            @* --- INSTRUMENT BLOCK START --- *@

                            @* SUB-ROW 1: IDENTIFICATION HEADER (Grey Background) *@
                            @* <MudTr Style="background-color: var(--mud-palette-background-grey); font-weight: bold; border-top: 2px solid var(--mud-palette-lines-default);"> *@
                            <MudTr Style="background-color: lightcoral;">
                                <MudTd colspan="3" Style="color: black;">Unit / Location</MudTd>
                                <MudTd colspan="2" Style="color: black;">Instrument</MudTd>
                                <MudTd colspan="2" Style="color: black;">Tag Number</MudTd>
                            </MudTr>

                            @* SUB-ROW 1: IDENTIFICATION DATA (White Background) *@
                            @* <MudTr Style="background-color: var(--mud-palette-surface);"> *@
                            <MudTr Style="background-color: var(--mud-palette-surface); border-bottom: 2px solid var(--mud-palette-lines-default);">
                                <MudTd colspan="3">
                                    <MudSelect T="string" Value="@context.Unit" ValueChanged="@(v => OnUnitChanged(context, v))" Dense="true" Margin="Margin.Dense" Label="Select Unit">
                                        <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                        @foreach (var u in _uniqueUnits)
                                        {
                                            <MudSelectItem Value="@u">@u</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTextField @bind-Value="context.ManualUnit" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd colspan="2">
                                    <MudSelect T="string" Value="@context.Instrument" ValueChanged="@(v => OnInstrumentChanged(context, v))" Dense="true" Margin="Margin.Dense" Label="Select Instrument">
                                        <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                        @foreach (var i in context.AvailableInstruments)
                                        {
                                            <MudSelectItem Value="@i">@i</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTextField @bind-Value="context.ManualInstrument" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd colspan="2">
                                    <MudSelect T="string" Value="@context.TagNumber" ValueChanged="@(v => OnTagChanged(context, v))" Dense="true" Margin="Margin.Dense" Label="Select Tag">
                                        <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                        @foreach (var t in context.AvailableTags)
                                        {
                                            <MudSelectItem Value="@t">@t</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTextField @bind-Value="context.ManualTag" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                </MudTd>
                            </MudTr>

                            @* SUB-ROW 2: TECHNICAL HEADER (Light Blue/Alternative Background) *@
                            <MudTr Style="background-color: lightgray">
                                <MudTd>Make / Model</MudTd>
                                <MudTd>Range</MudTd>
                                <MudTd>Quantity</MudTd>
                                <MudTd colspan="2">Testing & Calibration</MudTd>
                                <MudTd colspan="2">Remarks</MudTd>
                                <MudTd>Actions</MudTd>
                            </MudTr>

                            @* SUB-ROW 2: TECHNICAL DATA (White Background) *@
                            <MudTr Style="background-color: var(--mud-palette-surface); border-bottom: 2px solid var(--mud-palette-lines-default);">
                                <MudTd>
                                    <MudTextField @bind-Value="context.MakeModel" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="context.ManualMakeModel" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField @bind-Value="context.Range" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="context.ManualRange" Placeholder="Manual Entry" Class="mt-1" Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd><MudNumericField @bind-Value="context.Quantity" Margin="Margin.Dense" Min="1" /></MudTd>
                                <MudTd colspan="2">
                                    <div class="d-flex align-center gap-2">
                                        <MudSelect @bind-Value="context.TestingType" Margin="Margin.Dense" Dense="true" Style="min-width: 150px;">
                                            <MudSelectItem Value="@("Calibration")">Calibration</MudSelectItem>
                                            <MudSelectItem Value="@("Functional")">Functional</MudSelectItem>
                                        </MudSelect>
                                        @if (context.TestingType == "Calibration")
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Analytics" Size="Size.Small" Color="Color.Info"
                                                           OnClick="() => OpenCalibration(context)" />
                                        }
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-column">
                                        <MudSelect T="string"
                                                   Value="@context.Remarks"
                                                   ValueChanged="@(v => OnRemarksChanged(context, v))"
                                                   Dense="true"
                                                   Margin="Margin.Dense"
                                                   Label="Select Remarks">
                                            <MudSelectItem Value="@("NOT FOUND")">NOT FOUND</MudSelectItem>
                                            @foreach (var t in context.AvailableRemarks)
                                            {
                                                <MudSelectItem Value="@t">@t</MudSelectItem>
                                            }
                                        </MudSelect>

                                        <MudTextField @bind-Value="context.ManualRemarks"
                                                      Placeholder="Manual Entry"
                                                      Class="mt-2"
                                                      Margin="Margin.Dense" />
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Success" OnClick="@(() => SaveOcsReport())" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => _ocsRows.Remove(context))" />
                                    </div>
                                </MudTd>
                            </MudTr>

                            @* --- GAP ROW: Creates the visual separation between entries --- *@
                            @* --- GAP ROW --- *@
                            <MudTr Style="height: 10px; border: none !important;">
                                <MudTd colspan="8" Style="background-color: darkred; border: none !important;"></MudTd>
                                <MudTd colspan="8" Style="background-color: black; border: none !important;"></MudTd>
                            </MudTr>

                            @* --- INSTRUMENT BLOCK END --- *@
                        </RowTemplate>
                    </MudTable>


                    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Parts & Spares</MudText>
                    <MudGrid Class="mb-6">
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Spares Consumed"
                                          Variant="Variant.Outlined"
                                          Lines="5"
                                          @bind-Value="_sparesConsumed"
                                          Placeholder="List the spares used here..." />
                        </MudItem>
                    </MudGrid>

                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddOcsRow"
                               Color="Color.Secondary"
                               Variant="Variant.Filled"
                               Class="mt-2"
                               FullWidth="true">
                        ++ ADD NEW ROW
                    </MudButton>
                </div>



                @* @RenderOcsGrid() *@

                @* <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddOcsRow" Color="Color.Primary" Class="mt-2">Add Manual OCS Row</MudButton> *@
            </MudExpansionPanel>

            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveOcsReport" Class="mt-6">Submit Final Report</MudButton>
        }

    
    
    </MudPaper>
</MudContainer>


@* --- CALIBRATION DETAIL OVERLAY --- *@
@if (_isCalibrationVisible && _activeResult != null)
{
    @* <div class="overlay-backdrop">
        <MudPaper Class="pa-6" Style="width: 950px; max-height: 90vh; overflow-y: auto;">
            <div class="d-flex justify-space-between mb-4">
                <MudText Typo="Typo.h5">Calibration Certificate: @_activeResult.RECertificateNo</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseCalibration" />
            </div> *@

    <div style="position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;">
        <MudPaper Style="width: 900px; max-width: 95%; max-height: 90vh; overflow-y: auto; padding: 24px;" Elevation="25">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6"><b>Calibration Report:</b> @_activeResult.RECertificateNo</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseCalibration" />
            </div>

            <MudGrid Class="mb-4">
                <MudItem xs="4"><MudTextField Label="Installation" @bind-Value="_activeResult.REInstallation" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="4"><MudTextField Label="Model" @bind-Value="_activeResult.REModel" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="4"><MudTextField Label="Master Calibrator" @bind-Value="_activeResult.REMasterCalibrator" Variant="Variant.Outlined" /></MudItem>
                @* <MudItem xs="4">
                    <MudSelect T="string"
                               Label="Master Calibrators"
                               MultiSelection="false"
                               @bind-SelectedValues="_selectedCalibrators"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Clearable="true">
                        @foreach (var tool in _masterCalibratorList)
                        {
                            <MudSelectItem T="string" Value="@tool">@tool</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem> *@
            
            </MudGrid>

            @RenderCalibrationContent()

            <div class="mt-4">
                <MudTextField Label="Observations" @bind-Value="_activeResult.RERemarks" Lines="2" Variant="Variant.Outlined" />
            </div>

            <div class="d-flex justify-end mt-4">
