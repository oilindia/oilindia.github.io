    // --- SEPARATED RENDER FRAGMENTS (NO SHARED UI) ---

    @* Selects the view based on the specific type of calibration data *@
    private RenderFragment RenderCalibrationContent() => __builder =>
    {
        if (_activeResult?.RECalibration is ControllerInstrumentData ctrl)
        {
            @RenderControllerTable(ctrl)
            @RenderControllerSimulation(ctrl)
        }
        else if (_activeRowRef?.Instrument?.Contains("Transmitter") ?? false)
        {
            @RenderTransmitterTable(_activeResult?.RECalibration as BaseInstrumentData)
        }
        else // Default Gauge View
        {
            @RenderStandardTable(_activeResult?.RECalibration as BaseInstrumentData)
        }
    };

    private RenderFragment RenderTransmitterTable(BaseInstrumentData? data) => __builder =>
    {
        if (data == null) return;
        <table class="report-entry-table">
            <thead><tr><th>Input (mA)</th><th>Expected (PSI)</th><th>Actual (PSI)</th><th>Error %</th></tr></thead>
            <tbody>
                @foreach (var row in data.CalibrationTable)
                {
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.ExpectedOutput" /></td>
                        <td><input @bind="row.ActualOutput" class="highlight-input" /></td>
                        <td><input @bind="row.Error" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };








    private RenderFragment RenderGcsGrid() => __builder =>
    {
        <table class="report-table">
            <thead>
                <tr><th>Unit</th><th>Instrument</th><th>Range</th><th>Testing</th><th>Cert No</th><th>Remarks</th></tr>
            </thead>
            <tbody>
                @foreach (var inst in _gcsData.Instruments)
                {
                    <tr>
                        <td><input @bind="inst.Unit" /></td>
                        <td><input @bind="inst.Instrument" /></td>
                        <td><input @bind="inst.Range" /></td>
                        <td><select @bind="inst.TestingType"><option>Calibration</option><option>Functionality</option></select></td>
                        <td><input @bind="inst.CertNo" /></td>
                        <td><input @bind="inst.CalRemarks" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment RenderOcsGrid() => __builder =>
    {
        <table class="report-table">
            <thead>
                <tr><th>Sl</th><th>Unit</th><th>Instrument</th><th>Range</th><th>Qty</th><th>Testing</th><th>Cert No</th></tr>
            </thead>
            <tbody>
                @foreach (var row in _ocsRows)
                {
                    <tr>
                        <td>@row.SlNo</td>
                        <td><input @bind="row.Unit" /></td>
                        <td><input @bind="row.Instrument" /></td>
                        <td><input @bind="row.Range" /></td>
                        <td><input type="number" @bind="row.Quantity" style="width:50px" /></td>
                        <td><input @bind="row.TestingType" /></td>
                        <td><input @bind="row.CertNo" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    
    
    
    // --- RENDER FRAGMENTS ---



    private RenderFragment RenderStandardTable(BaseInstrumentData? data) => __builder =>
    {
        if (data == null) return;
        <table class="report-entry-table">
            <thead><tr><th>Input</th><th>Input %</th><th>Expected</th><th>Actual</th><th>Remarks</th></tr></thead>
            <tbody>
                @foreach (var row in data.CalibrationTable)
                {
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.InputPercentage" /></td>
                        <td><input @bind="row.ExpectedOutput" /></td>
                        <td><input @bind="row.ActualOutput" class="highlight-input" /></td>
                        <td><input @bind="row.CalRemarks" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment RenderControllerTable(ControllerInstrumentData data) => __builder =>
    {
        <table class="report-entry-table">
            <thead>
                <tr>
                    <th>Input Process Value</th>
                    <th>Measured Value</th>
                    <th>Error</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in data.CalibrationTable)
                {
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.ActualOutput" /></td>
                        <td><input @bind="row.Error" /></td>
                        <td><input @bind="row.CalRemarks" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment RenderControllerSimulation(ControllerInstrumentData data) => __builder =>
    {
        <div class="simulation-section mt-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Process Requirement & Parameters</b></MudText>
            <MudGrid Class="mb-2">
                <MudItem xs="6"><MudTextField Label="Set Point" @bind-Value="data.SetPoint" Variant="Variant.Outlined" AdornmentText="kg/cm2" /></MudItem>
                <MudItem xs="6"><MudTextField Label="Actuator Action" @bind-Value="data.ActuatorAction" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>

            <table class="report-entry-table mt-2">
                <thead>
                    <tr>
                        <th>Process Simulation (Kg/cm2)</th>
                        <th>Output Pressure (psi)</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sim in data.SimulationTable)
                    {
                        <tr>
                            <td><input @bind="sim.ProcessInput" @bind:event="oninput" /></td>
                            <td><input @bind="sim.OutputPressure" @bind:event="oninput" /></td>
                            <td><input @bind="sim.PSRemarks" @bind:event="oninput" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };


