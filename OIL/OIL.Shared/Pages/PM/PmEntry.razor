@page "/pmexecution"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Runtime.Serialization
@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using OIL.Shared.Services
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject CustomAuthStateProvider AuthStateProvider
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject IBrowserViewportService BrowserViewportService

<style>
    /* 1. GLOBAL UI & LAYOUT */
    :root {
        --border-color: #e2e8f0; /* Use a proper hex code */
    }

    /* CRITICAL FIX: Stops the page from blowing out horizontally and breaking the AppBar/Sidebar */
    .pm-execution-container {
        background: #f8fafc;
        min-height: 100vh;
        padding: 16px 8px;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    /* Fix the red background syntax error and layout */
    .node-header-bar {
        background-color: #0f172a; /* Changed from red to dark navy for professionalism */
        padding: 10px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 8px 8px 0 0;
        color: white;
    }

    /* Ensure the container doesn't force children to stretch */
    .pm-execution-container {
        background: #f8fafc;
        min-height: 100vh;
        padding: 16px 8px;
        width: 100%;
        /* Remove overflow-x: hidden here; let the MudContainer handle it */
    }

    /* 2. CARD DESIGN */
    .instrument-card {
        border-radius: 12px;
        border: 1px solid var(--border-color);
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .card-section-header {
        background-color: #f1f5f9;
        padding: 8px 16px;
        font-weight: 700;
        color: #334155;
        border-bottom: 1px solid var(--border-color);
        border-top: 1px solid var(--border-color);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .card-section-header:first-child {
            border-top: none;
        }

    /* 3. CALIBRATION MODAL OVERLAY */
    .calibration-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
    }

    .calibration-paper {
        width: 100%;
        max-width: 850px;
        max-height: 95vh;
        background: #ffffff;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .calibration-content-wrapper {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden; /* Changed to hidden since we are forcing it to fit now */
        padding: 16px 8px; /* Slightly reduced padding on mobile */
        background: #f8fafc;
    }

    /* 4. COMPACT CALIBRATION HTML TABLES (-40% WIDTH REDUCTION) */
    .report-entry-table {
        width: 100%;
        table-layout: fixed; /* Forces the table to squeeze into the container */
        border-collapse: collapse;
        font-size: 0.8rem;
        background: #ffffff;
    }

        .report-entry-table th {
            background: #0f172a;
            color: white;
            padding: 6px 4px;
            text-transform: uppercase;
            font-size: 0.65rem; /* Scaled down for mobile */
            line-height: 1.1;
            text-align: center;
            word-wrap: break-word; /* Allows headers to wrap tightly */
        }

        .report-entry-table td {
            padding: 2px; /* Hyper-dense cell padding */
            border: 1px solid #e2e8f0;
        }

        /* Super dense inputs to fit within fixed layout */
        .report-entry-table input,
        .report-entry-table select,
        .report-entry-table textarea {
            width: 100%;
            min-width: 0 !important; /* Removes MudBlazor forced widths */
            padding: 4px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            font-size: 0.75rem;
            box-sizing: border-box;
            text-align: center;
        }

            .report-entry-table input:focus {
                outline: 2px solid var(--mud-palette-primary);
                border-color: transparent;
            }

    /* 5. MOBILE BREAKPOINTS */
    @@media (max-width: 600px) {
        .pm-execution-container {
            padding: 8px 4px;
        }

        .calibration-paper {
            max-height: 100vh;
            border-radius: 6px;
        }

        .mud-button-root {
            width: 100%;
            margin-bottom: 8px;
        }

        .calibration-content-wrapper {
            padding: 8px 4px;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="pm-execution-container">
    <MudPaper Class="pa-4 pa-md-8 rounded-lg" Elevation="1">

        @* --- HEADER & JOB SELECTION --- *@
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6 gap-4 border-b pb-4">
            <div>
                <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800; letter-spacing: -0.5px;">
                    PM EXECUTION
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="font-weight: 500;">
                    Workflow Grouping Mode: <span class="text-primary font-weight-bold">@(_detectedType ?? "SELECT ACTIVE JOB")</span>
                </MudText>
            </div>
        </div>

        <MudGrid Class="mb-6" Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="Job" Label="Select Target Job Workflow" Value="_selectedJob" ValueChanged="OnJobChanged" ToStringFunc="@(j => j?.JobName ?? "")" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var job in _pendingJobs)
                    {
                        <MudSelectItem Value="@job" />
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_workPermit" Label="Notification Number" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.ConfirmationNumber" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_assignedTo" Label="Assigned Operations Specialist" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.AssignmentInd" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @if (_isSearching)
        {
            <div class="d-flex flex-column align-center my-8">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Fetching processing schemas...</MudText>
            </div>
        }

        @* ============================================================ *@
        @* BRANCH 1: GCS UI (CARD BASED)                                *@
        @* ============================================================ *@
        @if (_selectedJob != null && _detectedType == "GCS")
        {
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6" Style="font-weight: 700;" Color="Color.Primary">GCS Instrument Calibration Stack</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddGcsRow" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                    Add GCS Node
                </MudButton>
            </div>

            @foreach (var context in _gcsRows)
            {
                <MudCard Class="instrument-card" Elevation="0"> 
                    <div class="node-header-bar">
                        <span style="font-weight: bold;">Row #@context.SlNo - Entry</span>

                        <div class="d-flex" style="flex-shrink: 0;">
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" OnClick="@(() => SaveGcsReportSingle(context))" Style="color: white;" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => _gcsRows.Remove(context))" Style="color: white;" />
                        </div>
                    </div>
                   


                    <MudCardContent Class="pa-0">
                        @* 1. Compressor Details *@
                        <div class="card-section-header">Compressor Specifications</div>
                        <MudGrid Class="pa-4" Spacing="2">
                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="context.CompSlNo" Label="Compressor Serial No." Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="context.CompMakeModel" Label="Make / Model" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>

                        @* 2. Visual Checks *@
                        <div class="card-section-header">Visual Verification Points</div>
                        <div class="pa-4 d-flex flex-column gap-1">
                            <MudCheckBox T="bool" @bind-Checked="context.CheckTripping" Label="1] Verified automated tripping parameters." Dense="true" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Checked="context.CheckTubing" Label="2] Internal pneumatic routing tubing audited." Dense="true" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Checked="context.CheckAFR" Label="3] Air Filter Regulators drainage protocol executed." Dense="true" Color="Color.Primary" />
                        </div>

                        @* 3. Instrument Topology *@
                        <div class="card-section-header">Deployment Topology & Classification</div>
                        <MudGrid Class="pa-4" Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@context.Unit" ValueChanged="@(v => gcsOnUnitChanged(context, v))" Label="Unit Node" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">UNLISTED</MudSelectItem>
                                    @foreach (var u in _uniqueUnits)
                                    {
                                        <MudSelectItem Value="@u">@u</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="context.ManualUnit" Placeholder="Manual Override" Class="mt-1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@context.Instrument" ValueChanged="@(v => gcsOnInstrumentChanged(context, v))" Label="Asset Class" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">UNLISTED</MudSelectItem>
                                    @foreach (var i in context.AvailableInstruments)
                                    {
                                        <MudSelectItem Value="@i">@i</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="context.ManualInstrument" Placeholder="Manual Override" Class="mt-1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@context.TagNumber" ValueChanged="@(v => gcsOnTagChanged(context, v))" Label="Tag Registration" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">UNLISTED</MudSelectItem>
                                    @foreach (var t in context.AvailableTags)
                                    {
                                        <MudSelectItem Value="@t">@t</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="context.ManualTag" Placeholder="Manual Override" Class="mt-1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        @* 4. Technical Specs & Strategy *@
                        <div class="card-section-header">Technical Specifications & Strategy</div>
                        <MudGrid Class="pa-4" Spacing="2">
                            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="context.MakeModel" Label="Make/Model" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="context.Range" Label="Operating Range" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="4" md="2"><MudNumericField @bind-Value="context.Quantity" Label="Qty" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="8" md="4" Class="d-flex align-center gap-2">
                                <MudSelect @bind-Value="context.TestingType" Label="Evaluation Strategy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("Calibration")">Calibration</MudSelectItem>
                                    <MudSelectItem Value="@("Functional")">Functional</MudSelectItem>
                                </MudSelect>
                                @if (context.TestingType == "Calibration")
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" OnClick="() => gcsOpenCalibration(context)" Class="mt-1">Report</MudButton>
                                }
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Value="@context.Remarks" ValueChanged="@(v => gcsOnRemarksChanged(context, v))" Label="Diagnostics Select" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">CUSTOM EXCEPTION</MudSelectItem>
                                    @foreach (var t in context.AvailableRemarks)
                                    {
                                        <MudSelectItem Value="@t">@t</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="context.ManualRemarks" Label="Manual Annotations" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        @* 5. Infrastructure Layer *@
                        <div class="card-section-header">Infrastructure Checklist</div>
                        <MudGrid Class="pa-4" Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField @bind-Value="context.SafetyInterlocks" Label="Safety Interlocks" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField @bind-Value="context.Hooter" Label="Audible Hooter" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField @bind-Value="context.SparesConsumed" Label="Structural Spares" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }
        }

        @* ============================================================ *@
        @* BRANCH 2: OCS UI (CARD BASED)                                *@
        @* ============================================================ *@
        else if (_selectedJob != null && _detectedType == "OCS")
        {
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6" Style="font-weight: 700;" Color="Color.Primary">OCS Instrument Calibration Stack</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddOcsRow" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                    Add OCS Node
                </MudButton>
            </div>

            @foreach (var context in _ocsRows)
            {
                <MudCard Class="instrument-card" Elevation="0">
                    <div class="node-header-bar">
                        <span style="font-weight: bold;">Node #@context.SlNo - Configuration</span>

                        <div class="d-flex" style="flex-shrink: 0;">
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" OnClick="@(() => SaveOcsReportSingle(context))" Style="color: white;" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => _ocsRows.Remove(context))" Style="color: white;" />
                        </div>
                    </div>


                    

                    <MudCardContent Class="pa-0">
                        @* 1. Instrument Topology *@
                        <div class="card-section-header">Deployment Topology & Classification</div>
                        <MudGrid Class="pa-4" Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@context.Unit" ValueChanged="@(v => OnUnitChanged(context, v))" Label="Unit Node" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">UNLISTED</MudSelectItem>
                                    @foreach (var u in _uniqueUnits)
                                    {
                                        <MudSelectItem Value="@u">@u</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="context.ManualUnit" Placeholder="Manual Override" Class="mt-1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@context.Instrument" ValueChanged="@(v => OnInstrumentChanged(context, v))" Label="Asset Class" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">UNLISTED</MudSelectItem>
                                    @foreach (var i in context.AvailableInstruments)
                                    {
                                        <MudSelectItem Value="@i">@i</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="context.ManualInstrument" Placeholder="Manual Override" Class="mt-1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@context.TagNumber" ValueChanged="@(v => OnTagChanged(context, v))" Label="Tag Registration" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">UNLISTED</MudSelectItem>
                                    @foreach (var t in context.AvailableTags)
                                    {
                                        <MudSelectItem Value="@t">@t</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="context.ManualTag" Placeholder="Manual Override" Class="mt-1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        @* 2. Technical Specs & Strategy *@
                        <div class="card-section-header">Technical Specifications & Strategy</div>
                        <MudGrid Class="pa-4" Spacing="2">
                            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="context.MakeModel" Label="Make/Model" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="context.Range" Label="Operating Range" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="4" md="2"><MudNumericField @bind-Value="context.Quantity" Label="Qty" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="8" md="4" Class="d-flex align-center gap-2">
                                <MudSelect @bind-Value="context.TestingType" Label="Evaluation Strategy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("Calibration")">Calibration</MudSelectItem>
                                    <MudSelectItem Value="@("Functional")">Functional</MudSelectItem>
                                </MudSelect>
                                @if (context.TestingType == "Calibration")
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" OnClick="() => OpenCalibration(context)" Class="mt-1">Report</MudButton>
                                }
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Value="@context.Remarks" ValueChanged="@(v => OnRemarksChanged(context, v))" Label="Diagnostics Select" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("NOT FOUND")">CUSTOM EXCEPTION</MudSelectItem>
                                    @foreach (var t in context.AvailableRemarks)
                                    {
                                        <MudSelectItem Value="@t">@t</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="context.ManualRemarks" Label="Manual Annotations" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }
        }

        @* ============================================================ *@
        @* SHARED FOOTER: SUMMARY, LOGISTICS & PERSONNEL                *@
        @* ============================================================ *@
        @if (_selectedJob != null)
        {
            <MudText Typo="Typo.h6" Class="mt-8 mb-3 border-b pb-2" Style="font-weight: 700;">Global Logistics & Execution Summary</MudText>

            <MudGrid Class="mb-4" Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Global Remarks" Variant="Variant.Outlined" Lines="3" @bind-Value="_GCSremarks" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudDatePicker Label="Select PM Dates" Editable="true" Variant="Variant.Outlined" @bind-Date="_GCSdatePickerTemp" DateFormat="dd/MM/yyyy" Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GCSAddDate" Size="Size.Small" Style="height: 40px;">Add</MudButton>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var date in _GCSpmDates)
                        {
                            <MudChip T="string" OnClose="() => GCSRemoveDate(date)" Color="Color.Primary" Size="Size.Small">@date.ToString("dd/MM/yyyy")</MudChip>
                        }
                    </div>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-4" Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Consumable Spares Ledger" Variant="Variant.Outlined" Lines="2" @bind-Value="_sparesConsumed" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?" Label="Approx Total Cost (INR)" Variant="Variant.Outlined" Min="0" HideSpinButtons="true" Immediate="true" @bind-Value="_approxTotalCost" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CurrencyRupee" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <div class="d-flex gap-2">
                        <MudNumericField T="int?" Label="OT Hrs" Variant="Variant.Outlined" Min="0" HideSpinButtons="true" Immediate="true" @bind-Value="_overtimeHours" Adornment="Adornment.End" AdornmentText="h" Margin="Margin.Dense" />
                        <MudNumericField T="int?" Label="OT Mins" Variant="Variant.Outlined" Min="0" Max="59" HideSpinButtons="true" Immediate="true" @bind-Value="_overtimeMinutes" Adornment="Adornment.End" AdornmentText="m" Margin="Margin.Dense" />
                    </div>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-6" Spacing="2">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Job Carried By" MultiSelection="true" @bind-SelectedValues="_selectedCarriedBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem T="string" Value="@emp.EmpCode">@emp.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Report Prepared By" @bind-Value="_preparedBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem T="string" Value="@emp.EmpCode">@emp.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Job Supervised By" @bind-Value="_supervisedBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem T="string" Value="@emp.EmpCode">@emp.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Report Verified By" @bind-Value="_verifiedBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var emp in _executives)
                        {
