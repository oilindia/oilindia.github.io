            {
                Snackbar.Add("Error: Could not retrieve saved report ID.", Severity.Error);
                return;
            }

            foreach (var row in _gcsRows.Where(r => r.TestingType == "Calibration"))
            {
                string jsonToSave = "{}";
                if (row.CalibrationData?.RECalibration != null)
                {
                    var options = new JsonSerializerOptions { WriteIndented = false, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
                    jsonToSave = JsonSerializer.Serialize(row.CalibrationData.RECalibration, row.CalibrationData.RECalibration.GetType(), options);
                }

                var detail = new CalibrationDetail
                {
                    JobId = _selectedJob.Id,
                    PmReportId = savedReport.Id,
                    CertNo = row.CertNo,
                    Installation = row.Installation,
                    UnitId = row.Unit,
                    InstrumentType = row.Instrument,
                    Model = row.MakeModel,
                    Range = row.Range,
                    CalibrationDataJson = jsonToSave,
                    PerformedBy = _assignedTo
                };

                try
                {
                    await SupabaseClient.From<CalibrationDetail>().Insert(detail);
                    Snackbar.Add($"Report and Certificates Saved Successfully: {detail.CertNo}", Severity.Success);
                }
                catch (Exception ex) when (ex.Message.Contains("23505"))
                {
                    Snackbar.Add($"Save Error: {ex.Message}", Severity.Error);
                    Console.WriteLine($"Skipping duplicate Certificate Number: {detail.CertNo}");
                    Snackbar.Add($"Skipping duplicate Certificate Number: {detail.CertNo}", Severity.Error);
                    continue;
                }
                catch (Exception detailEx)
                {
                    Snackbar.Add($"Save Error: {detailEx.Message}", Severity.Error);
                    Console.WriteLine($"Error saving detail for Cert {detail.CertNo}: {detailEx.Message}");
                }
                Snackbar.Add($"Transaction Completed: {detail.CertNo}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException?.Message ?? ex.Message;
            Snackbar.Add($"Save Error: {msg}", Severity.Error);
        }
    }

    private async Task SaveOcsReport()
    {
        try
        {
            bool? result = await DialogService.ShowMessageBoxAsync("Confirm Save", "Are you sure you want to save this report and its certificates?", yesText: "OK", cancelText: "Cancel");
            if (result == null || !result.Value) return;

            var pmReport = new PmReport
            {
                JobId = _selectedJob!.Id,
                LocationId = currentPMlocationID,
                TechnicianEmail = _email,
                SparesConsumed = _sparesConsumed,
                ApproxTotalCost = _approxTotalCost,
                SectionAJson = JsonSerializer.Serialize(_ocsRows),
                WorkPermit = _workPermit,
                JobCarriedByEmpCodes = _selectedCarriedBy?.ToList(),
                ReportPreparedBy = _preparedBy,
                ReportSupervisedBy = _supervisedBy,
                ReportVerifiedBy = _verifiedBy
            };

            var response = await SupabaseClient.From<PmReport>().Insert(pmReport);
            var savedReport = response.Models.FirstOrDefault();
            if (savedReport == null)
            {
                Snackbar.Add("Error: Could not retrieve saved report ID.", Severity.Error);
                return;
            }

            foreach (var row in _ocsRows.Where(r => r.TestingType == "Calibration"))
            {
                string jsonToSave = "{}";
                if (row.CalibrationData?.RECalibration != null)
                {
                    var options = new JsonSerializerOptions { WriteIndented = false, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
                    jsonToSave = JsonSerializer.Serialize(row.CalibrationData.RECalibration, row.CalibrationData.RECalibration.GetType(), options);
                }

                var detail = new CalibrationDetail
                {
                    JobId = _selectedJob.Id,
                    PmReportId = savedReport.Id,
                    CertNo = row.CertNo,
                    Installation = row.Installation,
                    UnitId = row.Unit,
                    InstrumentType = row.Instrument,
                    Model = row.MakeModel,
                    Range = row.Range,
                    CalibrationDataJson = jsonToSave,
                    PerformedBy = _assignedTo
                };

                try
                {
                    await SupabaseClient.From<CalibrationDetail>().Insert(detail);
                    Snackbar.Add($"Report and Certificates Saved Successfully: {detail.CertNo}", Severity.Success);
                }
                catch (Exception ex) when (ex.Message.Contains("23505"))
                {
                    Console.WriteLine($"Skipping duplicate Certificate Number: {detail.CertNo}");
                    continue;
                }
                catch (Exception detailEx)
                {
                    Console.WriteLine($"Error saving detail for Cert {detail.CertNo}: {detailEx.Message}");
                }
                Snackbar.Add($"Transaction Completed: {detail.CertNo}", Severity.Success);
            }



        }
        catch (Exception ex)
        {
            var msg = ex.InnerException?.Message ?? ex.Message;
            Snackbar.Add($"Save Error: {msg}", Severity.Error);
        }
    }

    private void CloseCalibration() => _isCalibrationVisible = false;

    private RenderFragment RenderCalibrationContent() => __builder =>
    {
        if (_activeResult?.RECalibration is ControllerInstrumentData ctrl)
        {
            @RenderControllerTable(ctrl)
            @RenderControllerSimulation(ctrl)
        }
        else if (_activeRowRef?.Instrument?.Contains("Transmitter") ?? false)
        {
            @RenderTransmitterTable(_activeResult?.RECalibration as BaseInstrumentData)
        }
        else
        {
            @RenderStandardTable(_activeResult?.RECalibration as BaseInstrumentData)
        }
    };

    private RenderFragment RenderTransmitterTable(BaseInstrumentData? data) => __builder =>
    {
        if (data == null) return;
        <table class="report-entry-table">
            <thead><tr><th>Input (mA)</th><th>Expected (PSI)</th><th>Actual (PSI)</th><th>Error %</th></tr></thead>
            <tbody>
                @foreach (var row in data.CalibrationTable)
                {
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.ExpectedOutput" /></td>
                        <td><input @bind="row.ActualOutput" /></td>
                        <td><input @bind="row.Error" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment RenderStandardTable(BaseInstrumentData? data) => __builder =>
    {
        if (data == null) return;
        <table class="report-entry-table">
            <thead><tr><th>Input</th><th>Input %</th><th>Expected</th><th>Actual</th><th>Remarks</th></tr></thead>
            <tbody>
                @foreach (var row in data.CalibrationTable)
                {
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.InputPercentage" /></td>
                        <td><input @bind="row.ExpectedOutput" /></td>
                        <td><input @bind="row.ActualOutput" /></td>
                        <td><input @bind="row.CalRemarks" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment RenderControllerTable(ControllerInstrumentData data) => __builder =>
    {
        <table class="report-entry-table">
            <thead>
                <tr>
                    <th>Input Process Value</th>
                    <th>Measured Value</th>
                    <th>Error</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < data.CalibrationTable.Count; i++)
                {
                    var row = data.CalibrationTable[i];
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.ActualOutput" /></td>
                        <td><input @bind="row.Error" /></td>
                        @if (i == 0)
                        {
                            <td rowspan="@data.CalibrationTable.Count">
                                <textarea @bind="row.CalRemarks" placeholder="Remarks..." style="height: 100%;"></textarea>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment RenderControllerSimulation(ControllerInstrumentData data) => __builder =>
    {
        <div class="mt-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Process Requirement</b></MudText>
            <MudGrid Class="mb-2">
                <MudItem xs="6"><MudTextField Label="Set Point" @bind-Value="data.SetPoint" Variant="Variant.Outlined" AdornmentText="kg/cm2" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="6"><MudTextField Label="Actuator Action" @bind-Value="data.ActuatorAction" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            </MudGrid>

            <table class="report-entry-table mt-2">
                <thead>
                    <tr>
                        <th>Process Simulation (Kg/cm2)</th>
                        <th>Output Pressure (psi)</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sim in data.SimulationTable)
                    {
                        <tr>
                            <td><input @bind="sim.ProcessInput" @bind:event="oninput" /></td>
                            <td><input @bind="sim.OutputPressure" @bind:event="oninput" /></td>
                            <td><input @bind="sim.PSRemarks" @bind:event="oninput" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

