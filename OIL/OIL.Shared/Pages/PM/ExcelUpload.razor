@page "/pmexcelupload"
@inject IJSRuntime JS
@inject Supabase.Client SupabaseClient

<div class="report-manager-container">
    <!-- Controls Section (Hidden during print) -->
    <div class="controls-section no-print">
        <h3>PM Document & Report Manager</h3>

        <div class="form-grid">
            <div class="form-group">
                <label>Select Location:</label>
                <input type="text" @bind="locationName" class="form-control" placeholder="e.g. HAPJAN" />
            </div>

            <div class="form-group">
                <label>Report Date:</label>
                <input type="date" @bind="reportDate" class="form-control" />
            </div>

            <div class="form-group">
                <label>Document Type:</label>
                <select @bind="documentType" class="form-control">
                    <option value="PM Report">PM Report</option>
                    <option value="PM Certificate">PM Certificate</option>
                </select>
            </div>

            <div class="form-group">
                <label>Upload Excel File:</label>
                <InputFile OnChange="HandleFileSelected" accept=".xlsx, .xls" />
            </div>
        </div>

        @if (isProcessing)
        {
            <p class="status-text">Processing layout, removing empty columns, normalizing text, and cleaning rows...</p>
        }

        <div class="action-bar" style="margin-top: 15px;">
            <div class="selector-box" style="display: inline-block; margin-right: 15px;">
                <label>Load Saved Report: </label>
                <select @onchange="OnReportSelected" class="form-control" style="display:inline-block; width: 250px;">
                    <option value="">-- Choose saved report --</option>
                    @foreach (var report in savedReports)
                    {
                        <option value="@report.Id">@report.LocationName (@report.DocumentType) - @report.ReportDate.ToString("yyyy-MM-dd")</option>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(selectedHtmlContent))
            {
                <button class="save-btn" @onclick="SaveToDatabase">💾 Save to Database</button>
                <button class="print-btn" @onclick="PrintReport">🖨️ Print A4 Report</button>
            }
        </div>
    </div>

    <hr class="no-print" />

    <!-- A4 Paper Preview & Online Editable Container -->
    <div class="a4-page-wrapper">
        <div class="excel-preview-container">
            <!-- Professional Header with Logo -->
            <div class="report-header-block">
                <div class="logo-container">
                    <img src="_content/OIL.Shared/imgs/oil2.png" alt="OIL Logo" class="oil-logo" />
                </div>
                <div class="company-title-container">
                    <h2 class="company-name">OIL INDIA LIMITED</h2>
                    <p class="dept-name">INSTRUMENTATION DEPARTMENT — DULIAJAN</p>
                    <p class="doc-subtitle">@(string.IsNullOrEmpty(documentType) ? "PM Report" : documentType.ToUpper()) | LOCATION: @locationName | DATE: @reportDate.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
            <hr class="header-divider" />

            <!-- Editable Report Content -->
            @if (!string.IsNullOrEmpty(selectedHtmlContent))
            {
                <div id="editable-report-area" contenteditable="true" class="editable-area">
                    @((MarkupString)selectedHtmlContent)
                </div>
            }
            else
            {
                <p class="no-print placeholder-text">Fill in details, upload an Excel file, or select a saved report. You can edit text directly on this sheet before saving!</p>
            }
        </div>
    </div>
</div>

<style>
    .report-manager-container {
        padding: 20px;
        font-family: Arial, sans-serif;
        background-color: #f4f6f9;
        min-height: 100vh;
    }

    .controls-section {
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
        font-size: 13px;
    }

    .form-control {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
    }

    .status-text {
        color: #0066cc;
        font-style: italic;
        margin-top: 10px;
    }

    .save-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        margin-right: 10px;
    }

        .save-btn:hover {
            background-color: #0056b3;
        }

    .print-btn {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
    }

        .print-btn:hover {
            background-color: #218838;
        }

    .a4-page-wrapper {
        display: flex;
        justify-content: center;
        background-color: #e9ecef;
        padding: 30px 10px;
    }

    /* Exact A4 dimensions */
    .excel-preview-container {
        background-color: white;
        width: 210mm;
        min-height: 297mm;
        padding: 12mm 15mm;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        box-sizing: border-box;
    }

    /* Header Styling */
    .report-header-block {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .oil-logo {
        height: 55px;
        object-fit: contain;
    }

    .company-title-container {
        text-align: right;
    }

    .company-name {
        margin: 0;
        font-size: 18px;
        font-weight: bold;
        color: #111;
        letter-spacing: 0.5px;
    }

    .dept-name {
        margin: 2px 0;
        font-size: 11px;
        font-weight: bold;
        color: #444;
    }

    .doc-subtitle {
        margin: 0;
        font-size: 10px;
        color: #666;
    }

    .header-divider {
        border: none;
        border-top: 2px solid #222;
        margin-bottom: 15px;
    }

    .editable-area {
        outline: none;
    }

        .editable-area:focus {
            box-shadow: 0 0 0 2px rgba(0,123,255,0.25);
        }

    /* Table formatting and text normalization */
    .excel-preview-container table {
        border-collapse: collapse !important;
        width: 100% !important;
        background-color: white !important;
        table-layout: auto !important;
    }

    .excel-preview-container td, .excel-preview-container th {
        border: 1px solid #bbbbbb !important;
        padding: 6px 8px !important;
        font-size: 11px !important;
        vertical-align: middle !important;
        word-break: normal !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
    }

    /* Normalize converted Excel header blocks */
    .excel-preview-container tr:nth-child(-n+6) td,
    .excel-preview-container tr:nth-child(-n+6) th {
        font-size: 11px !important;
        text-align: center !important;
    }

    .placeholder-text {
        text-align: center;
        color: #6c757d;
        font-style: italic;
        padding: 50px;
    }

    @@media print {
        @@page {
            size: A4 portrait;
            margin: 8mm;
        }

        body {
            background-color: white !important;
            margin: 0;
            padding: 0;
        }

            body * {
                visibility: hidden;
            }

        .excel-preview-container, .excel-preview-container * {
            visibility: visible;
        }

        .a4-page-wrapper {
            background-color: white !important;
            padding: 0 !important;
            display: block !important;
        }

        .excel-preview-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

@code {
    private bool isProcessing = false;
    private string locationName = "HAPJAN";
    private DateTime reportDate = DateTime.Today;
    private string documentType = "PM Report";
    private List<DynamicReportModel> savedReports = new();
    private string selectedHtmlContent = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await JS.InvokeVoidAsync("eval", @"
            if (typeof XLSX === 'undefined') {
                var script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js';
                document.head.appendChild(script);
            }
            window.convertExcelToHtml = async (fileStream) => {
                const arrayBuffer = await fileStream.arrayBuffer();
                const workbook = XLSX.read(arrayBuffer, { type: 'array', cellStyles: true });
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                
                let html = XLSX.utils.sheet_to_html(worksheet, { header: '', footer: '' });
                
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const table = doc.querySelector('table');
                
                if (table) {
                    let rows = table.querySelectorAll('tr');
                    
                    // 1. Remove index numbers from the first column of every row
                    rows.forEach(row => {
                        const firstCell = row.querySelector('th, td');
                        if (firstCell) {
                            firstCell.remove();
                        }
                    });

                    // 2. Remove trailing/empty columns at the right end of the table
                    rows = table.querySelectorAll('tr');
                    let maxCols = 0;
                    rows.forEach(row => {
                        const cells = row.querySelectorAll('td, th');
                        if (cells.length > maxCols) maxCols = cells.length;
                    });

                    // Check from the last column backwards to see if every row has an empty cell in that column
                    for (let colIdx = maxCols - 1; colIdx >= 0; colIdx--) {
                        let allEmpty = true;
                        rows.forEach(row => {
                            const cells = row.querySelectorAll('td, th');
                            if (cells[colIdx] && cells[colIdx].textContent.trim() !== '') {
                                allEmpty = false;
                            }
                        });
                        if (allEmpty) {
                            rows.forEach(row => {
                                const cells = row.querySelectorAll('td, th');
                                if (cells[colIdx]) {
                                    cells[colIdx].remove();
                                }
                            });
                        } else {
                            // Stop once we hit a column with content
                            break;
                        }
                    }
                    
                    // 3. Trim excess empty blank rows from the bottom
                    rows = table.querySelectorAll('tr');
                    for (let i = rows.length - 1; i >= 0; i--) {
                        const cells = rows[i].querySelectorAll('td, th');
                        const isEmpty = Array.from(cells).every(c => c.textContent.trim() === '');
                        if (isEmpty) {
                            rows[i].remove();
                        } else {
                            break;
                        }
                    }

                    // 4. Normalize top rows (header text from Excel): strip inline font-size discrepancies and center-align
                    for (let i = 0; i < Math.min(6, rows.length); i++) {
                        const cells = rows[i].querySelectorAll('td, th');
                        cells.forEach(cell => {
                            cell.style.fontSize = '11px';
                            cell.style.textAlign = 'center';
                            const fontTags = cell.querySelectorAll('font');
                            fontTags.forEach(f => {
                                const span = document.createElement('span');
                                span.innerHTML = f.innerHTML;
                                span.style.fontSize = '11px';
                                f.replaceWith(span);
                            });
                        });
                    }
                    
                    html = doc.body.innerHTML;
                }
                return html;
            };

            window.getEditableHtml = () => {
                const el = document.getElementById('editable-report-area');
                return el ? el.innerHTML : '';
            };
        ");

        await LoadReportsList();
    }

    private async Task LoadReportsList()
    {
        try
        {
            var response = await SupabaseClient.From<DynamicReportModel>()
                .Order("created_at", Supabase.Postgrest.Constants.Ordering.Descending)
                .Get();
            savedReports = response.Models;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading report list: {ex.Message}");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var dotNetStreamRef = new DotNetStreamReference(stream);

            string htmlContent = await JS.InvokeAsync<string>("convertExcelToHtml", dotNetStreamRef);
            selectedHtmlContent = htmlContent;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing file: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task SaveToDatabase()
    {
        try
        {
            string currentHtml = await JS.InvokeAsync<string>("getEditableHtml");
            if (!string.IsNullOrEmpty(currentHtml))
            {
                selectedHtmlContent = currentHtml;
            }

            var newRecord = new DynamicReportModel
            {
                LocationName = string.IsNullOrWhiteSpace(locationName) ? "Unknown Location" : locationName,
                ReportDate = reportDate,
                DocumentType = documentType,
                HtmlContent = selectedHtmlContent,
                CreatedAt = DateTime.UtcNow
            };

            var insertResponse = await SupabaseClient.From<DynamicReportModel>().Insert(newRecord);
            var inserted = insertResponse.Models.FirstOrDefault();

            if (inserted != null)
            {
                savedReports.Insert(0, inserted);
                await JS.InvokeVoidAsync("alert", "Report successfully saved to Supabase database!");
            }
        }
        
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error saving report: {ex.Message}");
        }
    }

    private async Task OnReportSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int reportId))
        {
            var match = savedReports.FirstOrDefault(r => r.Id == reportId);
            if (match != null)
            {
                locationName = match.LocationName;
                reportDate = match.ReportDate;
                documentType = match.DocumentType;
                selectedHtmlContent = match.HtmlContent;
            }
        }
        else
        {
            selectedHtmlContent = string.Empty;
        }
        await Task.CompletedTask;
    }

    private async Task PrintReport()
    {
        string currentHtml = await JS.InvokeAsync<string>("getEditableHtml");
        if (!string.IsNullOrEmpty(currentHtml))
        {
            selectedHtmlContent = currentHtml;
        }
        await JS.InvokeVoidAsync("window.print");
    }

    [Supabase.Postgrest.Attributes.Table("pm_excel_upload_reports")]
    public class DynamicReportModel : Supabase.Postgrest.Models.BaseModel
    {
        [Supabase.Postgrest.Attributes.PrimaryKey("id", false)]
        public int Id { get; set; }

        [Supabase.Postgrest.Attributes.Column("location_name")]
        public string LocationName { get; set; } = string.Empty;

        [Supabase.Postgrest.Attributes.Column("report_date")]
        public DateTime ReportDate { get; set; } = DateTime.Today;

        [Supabase.Postgrest.Attributes.Column("document_type")]
        public string DocumentType { get; set; } = "PM Report";

        [Supabase.Postgrest.Attributes.Column("html_content")]
        public string HtmlContent { get; set; } = string.Empty;

        [Supabase.Postgrest.Attributes.Column("created_at")]
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
    }
}