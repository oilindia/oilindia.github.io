@page "/npme"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Runtime.Serialization
@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using OIL.Shared.Services
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject CustomAuthStateProvider AuthStateProvider
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject IBrowserViewportService BrowserViewportService
@inject NavigationManager Nav

@using System.Text.Json
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-2 pa-md-3 bg-light min-vh-100">
    <MudCard Elevation="3" Class="pa-2 pa-md-4 rounded-lg bg-white">

        @* --- HEADER & JOB SELECTION --- *@
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6 gap-4 border-b pb-4">
            <div>
                <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800; letter-spacing: -0.5px;">
                    PM EXECUTION
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="font-weight: 500;">
                    Workflow Grouping Mode: <span class="text-primary font-weight-bold">@(_detectedType ?? "SELECT ACTIVE JOB")</span>
                </MudText>
            </div>
        </div>

        <MudGrid Class="mb-6" Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="Job" Label="Select Target Job Workflow" Value="_selectedJob" ValueChanged="OnJobChanged" ToStringFunc="@(j => j?.JobName ?? "")" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var job in _pendingJobs)
                    {
                        <MudSelectItem Value="@job" />
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_workPermit" Label="Notification Number" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.ConfirmationNumber" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_assignedTo" Label="Assigned Operations Specialist" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.AssignmentInd" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @if (_isSearching)
        {
            <div class="d-flex flex-column align-center my-8">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Fetching processing schemas...</MudText>
            </div>
        }




        <EditForm Model="reportModel" OnValidSubmit="HandleValidSubmit">
            
            <!-- 1. HEADER SECTION -->
            @* <MudGrid Spacing="1" Class="align-center border-bottom pb-2 mb-2">
                <!-- Logo Area -->
                <MudItem xs="12" sm="3" Class="text-center d-flex flex-column align-center justify-center border-right-sm">
                    <img src="_content/OIL.Shared/imgs/oil.png" alt="Oil India Logo" style="max-height: 50px; object-fit: contain; margin-bottom: 2px;" onerror="this.style.display='none'" />
                    <MudText Typo="Typo.caption" Class="fw-bold text-dark lh-1">ऑयल इंडिया</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-black text-dark lh-1" Style="font-family: 'Arial Black', Arial, sans-serif; letter-spacing: 0.5px;">OIL INDIA</MudText>
                </MudItem>
                <!-- Title Area -->
                <MudItem xs="12" sm="9" Class="text-center">
                    <MudText Typo="Typo.caption" Class="fw-bold text-dark">ऑयल इंडिया लिमिटेड</MudText><br />
                    <MudText Typo="Typo.caption" Class="fw-bold text-dark">यंत्रीकरण विभाग / INSTRUMENTATION DEPARTMENT</MudText><br />
                    <MudText Typo="Typo.caption" Class="fw-bold text-dark">दुलियाजान / DULIAJAN / OIL INDIA LIMITED</MudText><br />
                    <MudText Typo="Typo.caption" Class="fw-bold text-muted mt-1">(केवल आंतरिक उपयोग हेतु / For Internal Use Only)</MudText>
                </MudItem>
            </MudGrid> *@

            <!-- 2. REF / DATES ROW -->
            <MudGrid Spacing="1" Class="mb-2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="reportModel.RefNo" Label="Ref No" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="reportModel.Dated" Label="Dated" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="reportModel.PmDate" Label="PM Date" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            <!-- 3. NOTIFICATION NUMBER ROW -->
            <MudGrid Spacing="1" Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="reportModel.NotificationNumber" Label="Notification Number" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="reportModel.InstallationName" Label="Installation Name" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            <!-- DYNAMIC EQUIPMENT / SECTION SECTIONS LOOP -->
            @for (int i = 0; i < reportModel.Equipments.Count; i++)
            {
                var eqIndex = i;
                var eq = reportModel.Equipments[eqIndex];
                var prefixLetter = GetAlphabetLabel(eqIndex);
                var headerStyle = GetSectionHeaderStyle(eqIndex);

                <MudCard Elevation="1" Class="my-3 rounded" Style="@($"border: 1px solid #333; border-left: 5px solid {headerStyle.DarkerColor};")">
                    
                    <!-- EQUIPMENT HEADER -->
                    <div class="pa-2" style="@($"background-color: {headerStyle.BgColor};")">
                        <MudGrid Spacing="1" Class="align-center">
                            @if (eq.IsCompressor)
                            {
                                <MudItem xs="12" sm="5">
                                    <MudTextField @bind-Value="eq.CompSlNo" Label="@($"{prefixLetter} Comp. Sl. No.")" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="5">
                                    <MudTextField @bind-Value="eq.Make" Label="Make" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12" sm="10">
                                    <MudTextField @bind-Value="eq.SectionTitle" Label="@($"{prefixLetter} Section Title")" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                            }
                            <MudItem xs="12" sm="2" Class="text-end">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => RemoveEquipment(eqIndex)">Remove</MudButton>
                            </MudItem>
                        </MudGrid>
                    </div>

                    <!-- VISUAL CHECKING POINTS SECTION (FOR COMPRESSOR) -->
                    <!-- VISUAL CHECKING POINTS SECTION (FOR COMPRESSOR) -->
                    @if (eq.IsCompressor)
                    {
                        <div class="pa-2 border-top border-bottom" style="@($"background-color: {headerStyle.LightBg};")">
                            <MudText Typo="Typo.caption" Class="fw-bold mb-1">Visual Checking Points</MudText>
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="4" Class="d-flex align-center">
                                    <MudCheckBox T="bool" @bind-Value="eq.Check1Passed" Dense="true" Size="Size.Small" Label="1]" />
                                    <MudTextField @bind-Value="eq.Check1Text" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="flex-grow-1 ml-1" />
                                </MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex align-center">
                                    <MudCheckBox T="bool" @bind-Value="eq.Check2Passed" Dense="true" Size="Size.Small" Label="2]" />
                                    <MudTextField @bind-Value="eq.Check2Text" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="flex-grow-1 ml-1" />
                                </MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex align-center">
                                    <MudCheckBox T="bool" @bind-Value="eq.Check3Passed" Dense="true" Size="Size.Small" Label="3]" />
                                    <MudTextField @bind-Value="eq.Check3Text" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="flex-grow-1 ml-1" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    }

                    <!-- JOB ITEMS MOBILE-RESPONSIVE CARDS -->
                    <div class="pa-2">
                        <MudText Typo="Typo.caption" Class="fw-bold text-dark mb-1">Job Done & Calibration Details</MudText>
                        
                        @for (int j = 0; j < eq.JobItems.Count; j++)
                        {
                            var jobIndex = j;
                            var job = eq.JobItems[jobIndex];
                            <MudCard Elevation="0" Class="pa-2 mb-2" Style="border: 1px dashed #adb5bd; background-color: #f8f9fa;">
                                <MudGrid Spacing="1" Class="align-center">
                                    <MudItem xs="6" sm="3">
                                        <MudAutocomplete T="string" @bind-Value="job.Unit" Label="Unit" SearchFunc="SearchUnit" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudAutocomplete T="string" @bind-Value="job.Instrument" Label="Instrument" SearchFunc="SearchInstrument" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudAutocomplete T="string" @bind-Value="job.MakeModel" Label="Make & Model" SearchFunc="SearchMakeModel" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudAutocomplete T="string" @bind-Value="job.Range" Label="Range" SearchFunc="SearchRange" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudAutocomplete T="string" @bind-Value="job.Action" Label="Servicing / Action" SearchFunc="SearchAction" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudAutocomplete T="string" @bind-Value="job.CertNo" Label="Cert No." SearchFunc="SearchCertNo" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudAutocomplete T="string" @bind-Value="job.Remarks" Label="Remarks" SearchFunc="SearchRemarks" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ResetValueOnEmptyText="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="1" Class="text-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => eq.JobItems.RemoveAt(jobIndex)" Title="Delete Row" />
                                    </MudItem>

                                    <!-- NEW: Certificate Button & Delete Button Container -->
                                    <MudItem xs="12" sm="2" Class="d-flex justify-center align-center">
                                        <MudIconButton Icon="@(job.IsCertificateCompleted ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Assignment)"
                                                       Color="@(job.IsCertificateCompleted ? Color.Success : Color.Primary)"
                                                       Size="Size.Small"
                                                       OnClick="() => OpenCertificateDialog(job)"
                                                       Title="Fill PM Certificate Values"
                                                       Class="mr-1" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => eq.JobItems.RemoveAt(jobIndex)" Title="Delete Row" />
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        }

                        <div class="text-right mt-1">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AddJobRow(eq)">Add Job Row</MudButton>
                        </div>
                    </div>

                    <!-- FOOTER SECTIONS (Safety Interlocks, Hooter, Spares) -->
                    @if (eq.IsCompressor)
                    {
                        <div class="pa-2 border-top bg-light">
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="eq.SafetyInterlocks" Label="Safety Interlocks" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="eq.Hooter" Label="Hooter" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="eq.SparesConsumed" Label="Spares Consumed" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    }

                </MudCard>
            }

            <!-- ADD NEW ITEM BUTTON BAR -->
            <div class="pa-2 my-2 text-center">
                <MudGrid Spacing="1" Justify="Justify.Center">
                    <MudItem xs="12" sm="6">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddCircle" FullWidth="true" OnClick="AddCompressorEquipment">Add Compressor Unit</MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddBox" FullWidth="true" OnClick="AddInstrumentSection">Add Instrument/Vessel Section</MudButton>
                    </MudItem>
                </MudGrid>
            </div>

            <!-- GENERAL REMARKS & SIGNATURES SECTION -->
            <MudCard Elevation="0" Class="pa-2 mt-3" Style="border-top: 1px solid #333;">
                <MudText Typo="Typo.subtitle2" Class="fw-bold text-dark mb-1">REMARKS:</MudText>
                <MudTextField @bind-Value="reportModel.Remark1" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-1" />
                <MudTextField @bind-Value="reportModel.Remark2" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-2" />

                <MudGrid Spacing="2" Class="mt-2 text-center pt-2 border-top">
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Class="text-muted mb-1">Report prepared by</MudText>
                        <MudTextField @bind-Value="reportModel.PreparedBy" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-1" />
                        <MudTextField @bind-Value="reportModel.PreparedByDesignation" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Class="text-muted mb-1">Job supervised by</MudText>
                        <MudTextField @bind-Value="reportModel.SupervisedBy" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-1" />
                        <MudTextField @bind-Value="reportModel.SupervisedByDesignation" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Class="text-muted mb-1">Report verified by</MudText>
                        <MudTextField @bind-Value="reportModel.VerifiedBy" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-1" />
                        <MudTextField @bind-Value="reportModel.VerifiedByDesignation" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudCard>

            <!-- ACTION SUBMIT BAR -->
            <div class="mt-3 text-center">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" FullWidth="true" StartIcon="@Icons.Material.Filled.CheckCircle">
                    Save PM Report Entry
                </MudButton>
            </div>

        </EditForm>
    </MudCard>
</MudContainer>




@code {


    private async Task OpenCertificateDialog(JobItemModel job)
    {
        // Fix: Use the standard string-based dictionary syntax
        var parameters = new DialogParameters
    {
        { "JobItem", job }
    };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        // Ensure the spelling here exactly matches your dialog file name
        var dialog = await DialogService.ShowAsync<PmCertificateDialog>($"PM Certificate Values - [{job.TagNumber} ({job.Instrument})]", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool completed && completed)
        {
            job.IsCertificateCompleted = true;
            StateHasChanged();
        }
    }

    private bool IsPressureInstrument(string type)
    {
        if (string.IsNullOrEmpty(type)) return false;
        return type.Contains("PRESSURE", StringComparison.OrdinalIgnoreCase) || 
               type.Contains("PG", StringComparison.OrdinalIgnoreCase) || 
               type.Contains("PT", StringComparison.OrdinalIgnoreCase) || 
               type.Contains("PC", StringComparison.OrdinalIgnoreCase);
    }

