    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }
    private string _email = "";
    private string _fullName = "";
    private string _designation = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthStateTask != null)
            {
                var authState = await AuthStateTask;
                var user = authState.User;
                if (user.Identity?.IsAuthenticated == true)
                {
                    _email = user.GetEmail();
                    _fullName = user.GetFullName();
                    _designation = user.GetDesignation();
                }
            }

            var jobRes = await SupabaseClient.From<Job>().Where(x => x.Status == "pending" || x.Status == "assigned").Where(x => x.JobType == "preventive").Get();
            _pendingJobs = jobRes.Models;

            var response = await SupabaseClient.From<EmployeeEngineer>().Where(x => x.Section == "FIELD MAINTENANCE").Get();
            _employees = response.Models;

            var executiveResponse = await SupabaseClient.From<EmployeeExecutive>().Where(x => x.Department == "FIELD MAINTENANCE").Get();
            _executives = executiveResponse.Models;

            _assignedTo = _fullName;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            return;
        }
    }

