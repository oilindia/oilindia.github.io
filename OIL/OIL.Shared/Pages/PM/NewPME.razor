    private async Task HandleValidSubmit()
    {
        try
        {
            // 1. Insert Report Header into pm_new_reports_gcs
            var reportEntity = new ReportEntity
            {
                ref_no = reportModel.RefNo,
                dated = reportModel.Dated,
                pm_date = reportModel.PmDate,
                notification_number = reportModel.NotificationNumber,
                installation_name = reportModel.InstallationName,
                remark1 = reportModel.Remark1,
                remark2 = reportModel.Remark2,
                prepared_by = reportModel.PreparedBy,
                prepared_by_designation = reportModel.PreparedByDesignation,
                supervised_by = reportModel.SupervisedBy,
                supervised_by_designation = reportModel.SupervisedByDesignation,
                verified_by = reportModel.VerifiedBy,
                verified_by_designation = reportModel.VerifiedByDesignation
            };

            var reportResponse = await SupabaseClient.From<ReportEntity>().Insert(reportEntity);
            var insertedReport = reportResponse.Models.FirstOrDefault();

            if (insertedReport == null)
            {
                Snackbar.Add("Failed to save report header.", Severity.Error);
                return;
            }

            // 2. Insert Equipments and Job Items sequentially with sort_order
            for (int i = 0; i < reportModel.Equipments.Count; i++)
            {
                var eq = reportModel.Equipments[i];
                var equipmentEntity = new EquipmentEntity
                {
                    report_id = insertedReport.id,
                    sort_order = i,
                    is_compressor = eq.IsCompressor,
                    comp_sl_no = eq.CompSlNo,
                    make = eq.Make,
                    section_title = eq.SectionTitle,
                    check1_passed = eq.Check1Passed,
                    check1_text = eq.Check1Text,
                    check2_passed = eq.Check2Passed,
                    check2_text = eq.Check2Text,
                    check3_passed = eq.Check3Passed,
                    check3_text = eq.Check3Text,
                    safety_interlocks = eq.SafetyInterlocks,
                    hooter = eq.Hooter,
                    spares_consumed = eq.SparesConsumed
                };

                var eqResponse = await SupabaseClient.From<EquipmentEntity>().Insert(equipmentEntity);
                var insertedEq = eqResponse.Models.FirstOrDefault();

                if (insertedEq != null && eq.JobItems != null)
                {
                    for (int j = 0; j < eq.JobItems.Count; j++)
                    {
                        var job = eq.JobItems[j];
                        var jobEntity = new JobItemEntity
                        {
                            equipment_id = insertedEq.id,
                            sort_order = j,
                            tag_number = job.TagNumber,
                            instrument_type = job.Instrument,
                            make_model_type = job.MakeModel,
                            range = job.Range,
                            device_location = job.DeviceLocation,
                            action = job.Action,
                            cert_no = job.CertNo,
                            remarks = job.Remarks
                        };

                        await SupabaseClient.From<JobItemEntity>().Insert(jobEntity);
                    }
                }
            }

            Snackbar.Add("PM Report saved successfully in sorted form!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving report: {ex.Message}", Severity.Error);
        }
    }

    
