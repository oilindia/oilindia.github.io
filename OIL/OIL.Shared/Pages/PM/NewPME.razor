    private async Task OnJobChanged(Job job)
    {
        _isSearching = false;
        try
        {
            if (job == null) return;
            _selectedJob = job;
            _isSearching = true;

            var locRes = await SupabaseClient.From<Location>().Where(x => x.Id == job.LocationId).Single();
            currentPMlocation = locRes!.InstallationName ?? "";
            currentPMlocationID = job.LocationId;
            _detectedType = locRes?.InstallationType?.ToUpper() == "GCS" ? "GCS" : "OCS";

            var markers = await SupabaseClient.From<PidMarker>().Where(x => x.LocationId == job.LocationId).Get();
            _allMarkers = markers.Models;
            _uniqueUnits = _allMarkers.Select(m => m.DeviceLocation ?? "").Distinct().OrderBy(x => x).ToList()!;

            // if (_detectedType == "GCS") InitializeGcs(markers.Models);
            // else InitializeOcs(markers.Models);```

            _isSearching = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            return;
        }
    }

