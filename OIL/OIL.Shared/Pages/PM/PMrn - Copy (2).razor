    private async Task OpenViewModal(ReportView report)
    {
        try
        {
            // Convert Guid to string to avoid "Unknown criterion type" error
            string jobIdString = report.JobId.ToString();

            var certRes = await SupabaseClient.From<CalibrationDetail>()
                .Filter("job_id", Supabase.Postgrest.Constants.Operator.Equals, jobIdString)
                .Get();

            _jobCertificates = certRes.Models;

            if (!_jobCertificates.Any())
            {
                Snackbar.Add("No calibration certificates found for this job.", Severity.Warning);
                return;
            }

            _isModalOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error fetching certificate: {ex.Message}", Severity.Error);
        }
    }

    private List<CalPoint> GeneratePoints(string? rangeStr)
    {
        var points = new List<CalPoint>();
        try
        {
            // Parses "0-35 kg/cm2" -> min: 0, max: 35
            var parts = rangeStr?.Split(' ')[0].Split('-');
            if (parts?.Length == 2 && double.TryParse(parts[1], out double max))
            {
                int[] percentages = { 0, 25, 50, 75, 100 };
                foreach (var p in percentages)
                {
                    double val = (max * p) / 100.0;
                    points.Add(new CalPoint { Percent = p, Input = val, Expected = val });
                }
            }
        }
        catch { /* Fallback to empty list */ }
        return points;
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("window.print");
