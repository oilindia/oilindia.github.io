@page "/pmdb3"

@using MudBlazor
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using static Supabase.Postgrest.Constants
@using System.Text.Json.Serialization

@inject IJSRuntime JSRuntime
@inject Supabase.Client Supabase

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <!-- FILTER -->
    <MudPaper Elevation="2" Class="pa-4 mb-6" Style="border-radius:18px;">

        <MudGrid Spacing="3" AlignItems="AlignItems.Center">

            <MudItem xs="12" sm="6" md="3">

                <MudDatePicker T="DateTime?"
                               Label="From Date"
                               @bind-Date="_startDate"
                               Editable="true"
                               Variant="Variant.Outlined" />

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudDatePicker T="DateTime?"
                               Label="To Date"
                               @bind-Date="_endDate"
                               Editable="true"
                               Variant="Variant.Outlined" />

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="RefreshDashboardAsync"
                           Loading="_loading"
                           FullWidth>

                    Apply Filter

                </MudButton>

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudPaper Class="pa-3"
                          Style="background:#f1f5f9;border-radius:14px;">

                    <MudText Typo="Typo.caption">
                        ACTIVE RANGE
                    </MudText>

                    <MudText Typo="Typo.subtitle1"
                             Style="font-weight:700;">

                        @_startDate?.ToString("dd MMM yyyy")
                        -
                        @_endDate?.ToString("dd MMM yyyy")

                    </MudText>

                </MudPaper>

            </MudItem>

        </MudGrid>

    </MudPaper>

    <!-- HEADER -->
    <MudPaper Elevation="0"
              Class="pa-6 mb-6"
              Style="border-radius:20px;background:linear-gradient(135deg,#0f172a,#1e293b);color:white;">

        <MudText Typo="Typo.h4" Style="font-weight:800;">
            PM Dashboard
        </MudText>

        <MudText Typo="Typo.subtitle1">
            Preventive Maintenance Analytics
        </MudText>

    </MudPaper>

    <!-- KPI -->
    <MudGrid Spacing="3" Class="mb-6">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5"
                      Style="background:linear-gradient(135deg,#2563eb,#1d4ed8);border-radius:18px;color:white;">

                <MudText Typo="Typo.overline">
                    TOTAL PM INSTALLS
                </MudText>

                <MudText Typo="Typo.h3">
                    @_dashboard.TotalPmInstalls
                </MudText>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5"
                      Style="background:linear-gradient(135deg,#16a34a,#15803d);border-radius:18px;color:white;">

                <MudText Typo="Typo.overline">
                    PM SHARE %
                </MudText>

                <MudText Typo="Typo.h3">
                    @_dashboard.PmSharePercent.ToString("0.0")%
                </MudText>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5"
                      Style="background:linear-gradient(135deg,#dc2626,#b91c1c);border-radius:18px;color:white;">

                <MudText Typo="Typo.overline">
                    NON PM JOBS
                </MudText>

                <MudText Typo="Typo.h3">
                    @_dashboard.NonPmJobs
                </MudText>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5"
                      Style="background:linear-gradient(135deg,#ea580c,#c2410c);border-radius:18px;color:white;">

                <MudText Typo="Typo.overline">
                    PM MAN DAYS
                </MudText>

                <MudText Typo="Typo.h3">
                    @_dashboard.PmManDays
                </MudText>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- CHARTS -->
    <MudGrid Spacing="3">

        <MudItem xs="12" md="6">

            <MudPaper Class="pa-4" Style="border-radius:18px;">

                <MudText Typo="Typo.h6" Class="mb-3">
                    PM Man Days Trend
                </MudText>

                <div style="height:350px;">
                    <canvas id="pmManDaysChart"></canvas>
                </div>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudPaper Class="pa-4" Style="border-radius:18px;">

                <MudText Typo="Typo.h6" Class="mb-3">
                    Top Installations
                </MudText>

                <div style="height:350px;">
                    <canvas id="topInstallationsChart"></canvas>
                </div>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudPaper Class="pa-4" Style="border-radius:18px;">

                <MudText Typo="Typo.h6" Class="mb-3">
                    PM Share %
                </MudText>

                <div style="height:350px;">
                    <canvas id="pmShareChart"></canvas>
                </div>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudPaper Class="pa-4" Style="border-radius:18px;">

                <MudText Typo="Typo.h6" Class="mb-3">
                    Field Distribution
                </MudText>

                <div style="height:350px;">
                    <canvas id="fieldDistributionChart"></canvas>
                </div>

            </MudPaper>

        </MudItem>

        <MudItem xs="12">

            <MudPaper Class="pa-4" Style="border-radius:18px;">

                <MudText Typo="Typo.h6" Class="mb-3">
                    Maintenance Overview
                </MudText>

                <div style="height:450px;">
                    <canvas id="maintenanceOverviewChart"></canvas>
                </div>

            </MudPaper>

        </MudItem>

    </MudGrid>

</MudContainer>

@code {

    private bool _loading;

    private DateTime? _startDate = DateTime.Today.AddMonths(-1);

    private DateTime? _endDate = DateTime.Today;

    private DashboardDto _dashboard = new();

    [Table("pm_reports")]
    public class DbPmReport : BaseModel
    {
        [PrimaryKey("id", false)]
        public string Id { get; set; } = "";

        [Column("job_id")]
        public string JobId { get; set; } = "";

        [Column("location_id")]
        public string LocationId { get; set; } = "";

        [Column("completion_date")]
        public DateTime? CompletionDate { get; set; }
    }

    [Table("jobs")]
    public class DbJob : BaseModel
    {
        [PrimaryKey("id", false)]
        public string Id { get; set; } = "";

        [Column("job_type")]
        public string JobType { get; set; } = "";

        [Column("created_at")]
        public DateTime? CreatedAt { get; set; }

        [Column("completion_date")]
        public DateTime? CompletionDate { get; set; }
    }

    [Table("locations")]
    public class DbLocation : BaseModel
    {
        [PrimaryKey("id", false)]
        public string Id { get; set; } = "";

        [Column("location_name")]
        public string LocationName { get; set; } = "";

        [Column("field_type")]
        public string FieldType { get; set; } = "";
    }

    [Table("job_assignments")]
    public class JobAssignment : BaseModel
    {
        [PrimaryKey("id", false)]
        public Guid Id { get; set; }

        [Column("job_overtime")]
        public double? JobOvertime { get; set; }
    }

    public class DashboardDto
    {
        public int TotalPmInstalls { get; set; }

        public double PmSharePercent { get; set; }

        public int NonPmJobs { get; set; }

        public int PmManDays { get; set; }

        public List<string> DailyLabels { get; set; } = new();

        public List<double> DailyPmManDays { get; set; } = new();

        public List<int> DailyPmCounts { get; set; } = new();

        public List<int> DailyNonPmCounts { get; set; } = new();

        public List<string> TopLocationLabels { get; set; } = new();

        public List<int> TopLocationCounts { get; set; } = new();

        public List<int> PmVsNonPm { get; set; } = new();

        public List<int> FieldDistribution { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task RefreshDashboardAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _loading = true;

        StateHasChanged();

        try
        {
            _dashboard = new DashboardDto();

            var start = (_startDate ?? DateTime.Today.AddMonths(-1)).Date;
            var end = (_endDate ?? DateTime.Today).Date.AddDays(1);

            var reportsTask = Supabase
                .From<DbPmReport>()
                .Select("*")
                .Filter("completion_date", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
                .Filter("completion_date", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd"))
                .Get();

            var jobsTask = Supabase
                .From<DbJob>()
                .Select("*")
                .Get();

            var locationsTask = Supabase
                .From<DbLocation>()
                .Select("*")
                .Get();

            await Task.WhenAll(reportsTask, jobsTask, locationsTask);

            var reports = reportsTask.Result.Models ?? new();
            var jobs = jobsTask.Result.Models ?? new();
            var locations = locationsTask.Result.Models ?? new();

            var jobsMap = jobs.ToDictionary(x => x.Id);
            var locationMap = locations.ToDictionary(x => x.Id);

            var joined = reports.Select(r =>
            {
                jobsMap.TryGetValue(r.JobId ?? "", out var job);
                locationMap.TryGetValue(r.LocationId ?? "", out var location);

                return new
                {
                    Report = r,
                    Job = job,
                    Location = location
                };
            }).ToList();

            var preventive = joined.Where(x =>
                x.Job != null &&
                !string.IsNullOrWhiteSpace(x.Job.JobType) &&
                x.Job.JobType.ToLower().Contains("preventive"))
                .ToList();

            var nonPreventive = joined.Where(x =>
                x.Job == null ||
                string.IsNullOrWhiteSpace(x.Job.JobType) ||
                !x.Job.JobType.ToLower().Contains("breakdown"))
                .ToList();

            _dashboard.TotalPmInstalls =
                preventive
                .Select(x => x.Location?.Id)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .Count();

            _dashboard.NonPmJobs = nonPreventive.Count;

            int totalJobs = joined.Count;

            _dashboard.PmSharePercent =
                totalJobs == 0
                ? 0
                : ((double)preventive.Count / totalJobs) * 100;

            int totalPmDays = 0;

            foreach (var item in preventive)
            {
                if (item.Job?.CreatedAt != null &&
                    item.Job?.CompletionDate != null)
                {
                    totalPmDays += Math.Max(
                        1,
                        (item.Job.CompletionDate.Value.Date -
                         item.Job.CreatedAt.Value.Date).Days + 1);
                }
            }

            _dashboard.PmManDays = totalPmDays;

            var grouped = joined
                .Where(x => x.Report.CompletionDate != null)
                .GroupBy(x => x.Report.CompletionDate!.Value.Date)
                .OrderBy(x => x.Key);

            foreach (var day in grouped)
            {
                _dashboard.DailyLabels.Add(day.Key.ToString("dd MMM"));

                int pmCount = day.Count(x =>
                    x.Job != null &&
                    x.Job.JobType.ToLower().Contains("preventive"));

                int nonPmCount = day.Count() - pmCount;

                _dashboard.DailyPmCounts.Add(pmCount);

                _dashboard.DailyNonPmCounts.Add(nonPmCount);

                double manDays = 0;

                foreach (var item in day)
                {
                    if (item.Job?.CreatedAt != null &&
                        item.Job?.CompletionDate != null)
                    {
                        manDays += Math.Max(
                            1,
                            (item.Job.CompletionDate.Value.Date -
                             item.Job.CreatedAt.Value.Date).Days + 1);
                    }
                }

                _dashboard.DailyPmManDays.Add(manDays);
            }

            var topLocations = preventive
                .GroupBy(x => x.Location?.LocationName ?? "Unknown")
                .Select(x => new
                {
                    Name = x.Key,
                    Count = x.Count()
                })
                .OrderByDescending(x => x.Count)
                .Take(5)
                .ToList();

            _dashboard.TopLocationLabels =
                topLocations.Select(x => x.Name).ToList();

            _dashboard.TopLocationCounts =
                topLocations.Select(x => x.Count).ToList();

            _dashboard.PmVsNonPm = new List<int>
            {
                preventive.Count,
                nonPreventive.Count
            };

            int central = preventive.Count(x =>
                (x.Location?.FieldType ?? "").ToLower().Contains("central"));

            int western = preventive.Count(x =>
                (x.Location?.FieldType ?? "").ToLower().Contains("western"));

            int eastern = preventive.Count(x =>
                (x.Location?.FieldType ?? "").ToLower().Contains("eastern"));

            _dashboard.FieldDistribution = new List<int>
            {
                central,
                western,
                eastern
            };

            await JSRuntime.InvokeVoidAsync(
                "initPmDashboardCharts",
                _dashboard);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        _loading = false;

        StateHasChanged();
    }
}