@code {
    private List<SectionItem> _currentJobItems = new();
    // Helper Classes to map your JSON data structure
    public class SectionItem
    {
        [JsonPropertyName("SlNo")] public string SlNo { get; set; } = "";
        [JsonPropertyName("Unit")] public string Unit { get; set; } = "";
        [JsonPropertyName("Instrument")] public string Instrument { get; set; } = "";
        [JsonPropertyName("TagNumber")] public string TagNumber { get; set; } = "";
        [JsonPropertyName("MakeModel")] public string MakeModel { get; set; } = "";
        [JsonPropertyName("Range")] public string Range { get; set; } = "";
        [JsonPropertyName("Quantity")] public int Quantity { get; set; }
        [JsonPropertyName("TestingType")] public string TestingType { get; set; } = "";
        [JsonPropertyName("CertNo")] public string CertNo { get; set; } = "";
        [JsonPropertyName("Remarks")] public string Remarks { get; set; } = "";

    }

    private List<ReportView> _reports = new();
    private List<Location> _locations = new();
    private List<CalibrationDetail> _jobCertificates = new();
    private ReportView _selectedReport = new();

    private bool _loading = true;
    private bool _isGcsModalOpen = false;
    private bool _isOcsModalOpen = false;

    public string currentLocationType = "";


    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task HandleViewClick(ReportView report)
    {
        _selectedReport = report;
        string jobIdStr = report.JobId.ToString();
        _currentJobItems.Clear();

        try
        {
            // 1. Fetch the PM Report data to get the JSON sections
            var reportRes = await SupabaseClient.From<PmReport>()
                .Filter("id", Supabase.Postgrest.Constants.Operator.Equals, report.Id)
                .Single();

            if (reportRes != null)
            {
                // Parse the JSON Sections (A and B)
                _currentJobItems.AddRange(ParseJsonSection(reportRes.SectionA));
                _currentJobItems.AddRange(ParseJsonSection(reportRes.SectionB));
            }

            // 2. Fetch Calibration Certificates for this Job
            var certRes = await SupabaseClient.From<CalibrationDetail>()
                .Filter("job_id", Supabase.Postgrest.Constants.Operator.Equals, jobIdStr)
                .Get();

            _jobCertificates = certRes.Models;

            foreach (var cert in _jobCertificates)
            {
                if (!string.IsNullOrWhiteSpace(cert.CalibrationDataJson))
                {
                    try
                    {
                        cert.ParsedData = JsonSerializer.Deserialize<ParsedCalibrationData>(cert.CalibrationDataJson);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"JSON Parsing failed for certificate record {cert.CertNo}: {ex.Message}");
                        cert.ParsedData = new ParsedCalibrationData(); // Fallback empty container to prevent UI crashes
                    }
                }
            }


            // 3. Open appropriate Modal
            if (report.LocationName.Contains("GCS", StringComparison.OrdinalIgnoreCase))



                _isGcsModalOpen = true;
            else
                _isOcsModalOpen = true;
        }
        catch (Exception ex) { Snackbar.Add("Data Load Error: " + ex.Message, Severity.Error); }
    }
    // This handles the escaped string JSON in your database
    private List<SectionItem> ParseJsonSection(object? jsonField)
    {
        if (jsonField == null) return new();
        try
        {
            string rawJson = jsonField.ToString();
            // Supabase sometimes returns JSON as a double-quoted string: "[{...}]"
            if (rawJson.StartsWith("\"") && rawJson.EndsWith("\""))
            {
                rawJson = JsonSerializer.Deserialize<string>(rawJson) ?? "[]";
            }
            return JsonSerializer.Deserialize<List<SectionItem>>(rawJson) ?? new();
        }
        catch { return new(); }
    }

