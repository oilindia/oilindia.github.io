@page "/PMrn7"

@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Text.Json
@using Microsoft.JSInterop
@inject ISnackbar Snackbar
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JSRuntime
@using System.Text.Json.Serialization

<style>
    /* --- SCREEN VIEW (UI LOOK) --- */
    .modal-overlay {
        position: fixed;
        z-index: 1000;
        left: 0; top: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.85);
        display: flex;
        flex-direction: column; 
        align-items: center; /* Centers the paper horizontally */
        overflow-y: auto;
        padding: 40px 0;
        backdrop-filter: blur(5px);
    }

    .landscape-report {
        background: white;
        width: 297mm; /* Standard A4 Landscape */
        min-height: 210mm;
        padding: 15mm;
        margin-bottom: 40px;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
        box-sizing: border-box;
    }

    .portrait-report {
        background: white;
        width: 210mm; /* Standard A4 Portrait */
        min-height: 297mm;
        padding: 15mm;
        margin-bottom: 40px;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
        box-sizing: border-box;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
    }

    .report-table th, .report-table td {
        border: 1px solid black;
        padding: 6px;
        font-size: 12px;
        color: black !important;
    }

    /* --- PRINT ENGINE (FIXES BLANK SCREEN & ORIENTATION) --- */
    @@media print {
        /* 1. Define named pages for mixed orientation */
        @@page { margin: 10mm; }
        @@page land { size: A4 landscape; }
        @@page port { size: A4 portrait; }

        /* 2. Hide MudBlazor UI elements explicitly */
        .mud-main-content, .mud-appbar, .mud-drawer, .mud-nav-menu, 
        .no-print, button, .mud-overlay {
            display: none !important;
        }

        /* 3. Reset Modal for Printing */
        body, html {
            height: auto !important;
            overflow: visible !important;
            background: white !important;
        }

        .modal-overlay {
            position: static !important; /* Removes 'fixed' so content flows */
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            background: white !important;
        }

        #printable-area {
            display: block !important;
            width: 100% !important;
        }

        /* 4. Force Landscape/Portrait Switching */
        .landscape-report {
            page: land;
            width: 100% !important;
            margin: 0 !important;
            box-shadow: none !important;
            break-after: page; /* Forces certs to start on new page */
        }

        .portrait-report {
            page: port;
            width: 100% !important;
            margin: 0 !important;
            box-shadow: none !important;
            break-after: page;
        }

        /* 5. Force text colors and remove UI shadows */
        * {
            -webkit-print-color-adjust: exact !important;
            color-print-color-adjust: exact !important;
            color: black !important;
        }
    }
</style>






<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 no-print">
    <MudPaper Elevation="3" Class="pa-4">
        @* <MudText Typo="Typo.h5" Class="mb-4">PM Completion Reports</MudText> *@

        <h3>PM Completion Reports</h3>
        <MudDataGrid T="ReportView" Items="@_reports" Loading="@_loading" Dense="true" Bordered="true">
            <Columns>
                <TemplateColumn Title="View" HeaderStyle="width: 50px;">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info"
                                       OnClick="@(() => HandleViewClick(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CompletionDateLocal" Title="Date" />
                <PropertyColumn Property="x => x.LocationName" Title="Installation" />
                <PropertyColumn Property="x => x.WorkPermit" Title="Permit #" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

