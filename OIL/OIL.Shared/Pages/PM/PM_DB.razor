@page "/pmdb"
@inject IJSRuntime JSRuntime

<style>
    /* Styling for the KPI cards title */
    .mud-overline {
        letter-spacing: 0.1rem;
        font-weight: 700;
        color: #64748b;
    }

    /* Grid layout for custom charts */
    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }

    /* Header Styling */
    .header-panel {
        background-color: #122c4f;
        border-radius: 12px;
        color: white;
    }

    .badge-outline {
        border: 1.5px solid #ffa726;
        border-radius: 50px;
        width: fit-content;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">

    <MudPaper Elevation="4" Class="pa-8 header-panel mb-8">
        @* Badge *@
        <div class="badge-outline px-4 py-1 mb-6">
            <MudText Typo="Typo.caption" Style="color: #ffa726; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;">
                Instrumentation Field Maintenance
            </MudText>
        </div>

        <MudText Typo="Typo.h3" Style="font-weight: 700;" Class="mb-1">
            Preventive Maintenance Dashboard
        </MudText>
        <MudText Typo="Typo.h3" Style="color: #ffcc80; font-weight: 700;" Class="mb-6">
            FY 2025-26
        </MudText>

        <MudText Typo="Typo.body1" Style="color: #b0bec5; max-width: 800px;" Class="mb-8">
            Dashboard summarising preventive maintenance performance, field coverage, maintenance trends and
            operational benefits achieved through a stronger PM programme.
        </MudText>

        <MudStack Row="true" Spacing="6" AlignItems="AlignItems.Center" Class="flex-wrap">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Style="color: #90a4ae;" Class="mr-2" />
                <MudText Typo="Typo.body2" Style="color: #cfd8dc;"><b>Reporting:</b> FY 2025-26</MudText>
            </div>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Style="color: #90a4ae;" Class="mr-2" />
                <MudText Typo="Typo.body2" Style="color: #cfd8dc;"><b>Scope:</b> PM Activities</MudText>
            </div>
        </MudStack>
    </MudPaper>

    @* --- KPI SNAPSHOT --- *@
    <div class="mb-10">
        <div style="border-left: 4px solid #ff9800; padding-left: 12px;" class="mb-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.h5" Style="font-weight: 800; color: #0d47a1;">KPI Snapshot</MudText>
            </MudStack>
        </div>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4" Style="border-top: 4px solid #90a4ae; height: 160px; position: relative;">
                    <MudText Typo="Typo.overline">PM JOBS (INSTALLS)</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800;">79</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Work" Style="position: absolute; bottom: 10px; right: 10px; font-size: 40px; color: #f5f5f5;" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4" Style="border-top: 4px solid #ffb74d; height: 160px; position: relative;">
                    <MudText Typo="Typo.overline">PM SHARE</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800;">10%</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="position: absolute; bottom: 10px; right: 10px; font-size: 40px; color: #f5f5f5;" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4" Style="border-top: 4px solid #4caf50; height: 160px; position: relative;">
                    <MudText Typo="Typo.overline">NON-PM JOBS</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800;">2,458</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Build" Style="position: absolute; bottom: 10px; right: 10px; font-size: 40px; color: #f5f5f5;" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4" Style="border-top: 4px solid #ef5350; height: 160px; position: relative;">
                    <MudText Typo="Typo.overline">PM MAN DAYS</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800;">258</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Style="position: absolute; bottom: 10px; right: 10px; font-size: 40px; color: #f5f5f5;" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

    @* --- PM TRENDS & GROWTH --- *@
    <div style="border-left: 4px solid #f59e0b; padding-left: 12px;" class="mb-4 mt-10">
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #0f172a;">PM Trends & Growth</MudText>
        <MudText Typo="Typo.caption" Style="color: #64748b;">Three-year PM trend, percentage trend and YoY growth</MudText>
    </div>

    <MudGrid Class="mb-6">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">PM Jobs (Man-Days)</MudText>
                <div class="chart-container"><canvas id="pmTrend"></canvas></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">Total PM Jobs (Installs)</MudText>
                <div class="chart-container"><canvas id="pmInstallBar"></canvas></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">PM % of Total Jobs</MudText>
                <div class="chart-container"><canvas id="pmPercent"></canvas></div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* --- FIELD DISTRIBUTION & COMPARISON --- *@
    <MudGrid Class="mb-10">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">YoY Growth %</MudText>
                <div class="chart-container"><canvas id="growthChart"></canvas></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">Maintenance Trends with PM % (Dual Axis)</MudText>
                <div class="chart-container"><canvas id="maintenanceTrendCombo"></canvas></div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <div style="border-left: 4px solid #3b82f6; padding-left: 12px;" class="mb-4">
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #0f172a;">Field Analysis & Overtime</MudText>
    </div>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px; height: 100%;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">Field-wise PM Jobs</MudText>
                <div class="chart-container"><canvas id="fieldBar"></canvas></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px; height: 100%;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">Field Distribution (CF/WF/EF)</MudText>
                <div class="chart-container"><canvas id="cfWfEfPie"></canvas></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 16px; height: 100%;">
                <MudText Typo="Typo.subtitle2" Class="mb-4">Total OverTime (OT Hours)</MudText>
                <div class="chart-container"><canvas id="totalOvertimeChart"></canvas></div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* --- ACHIEVEMENTS --- *@
    <div class="mt-10 mb-8">
        <div style="border-left: 4px solid #4caf50; padding-left: 12px;" class="mb-4">
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #0d47a1;">Achievements FY 2025-26</MudText>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4" Style="border: 1px solid #4caf50; border-radius: 12px; height: 100%;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mb-2" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800;">Zero Maintenance Failures</MudText>
                    <MudText Typo="Typo.caption">No instrument-related process downtime reported.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4" Style="border: 1px solid #ff9800; border-radius: 12px; height: 100%;">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Warning" Class="mb-2" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800;">OT Reduction</MudText>
                    <MudText Typo="Typo.caption">Decreased unplanned maintenance overtime hours.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4" Style="border: 1px solid #2196f3; border-radius: 12px; height: 100%;">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Info" Class="mb-2" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800;">Traceable Data</MudText>
                    <MudText Typo="Typo.caption">Full digital log of calibration and set points.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4" Style="border: 1px solid #f44336; border-radius: 12px; height: 100%;">
                    <MudIcon Icon="@Icons.Material.Filled.BuildCircle" Color="Color.Error" Class="mb-2" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800;">Lower Breakdowns</MudText>
                    <MudText Typo="Typo.caption">Improved reliability and field instrumentation health.</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

</MudContainer>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The JavaScript function defined in your _Host.cshtml or index.html
            await JSRuntime.InvokeVoidAsync("initAllMaintenanceCharts");
        }
    }
}