    private async Task LoadDashboardAsync()
    {
        try
        {
            _loading = true;
            _dashboard = new DashboardDto();
            var start = (_startDate ?? DateTime.Today.AddMonths(-1)).Date;
            var end = (_endDate ?? DateTime.Today).Date.AddDays(1);

            // Fetch everything in parallel
            var jobsTask = Supabase.From<DbJob>()
                .Select("*")
                .Filter("completion_date", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
                .Filter("completion_date", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd"))
                .Get();

            var assignmentsTask = Supabase.From<JobAssignment>()
                           .Select("*")
                           .Filter("created_at", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
                           .Filter("created_at", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd"))
                           .Get();


            var reportsTask = Supabase.From<DbPmReport>()
             .Select("*")
                           .Filter("completion_date", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
                           .Filter("completion_date", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd"))
                           .Get(); // Fetch reports to link later
            var locationsTask = Supabase.From<DbLocation>().Get();

            await Task.WhenAll(jobsTask, reportsTask, locationsTask);







            // Fetch assignments
            // var assignments = assignmentsTask.Result.Models ?? new();

            // Group assignments by JobId (Since one job might have multiple assignment records)
            // Assuming DbJobAssignment has a 'JobIds' property (as per your data: list of strings)
            // 1. Ensure the lookup is keyed by the correct type (Guid)
           

            // Update joinedData to include assignments




            // var jobs = jobsTask.Result.Models ?? new();
            // var reports = reportsTask.Result.Models ?? new();
            // var locations = locationsTask.Result.Models ?? new();


            // 1. Await the specific calls directly to get the Response objects
            var jobsResponse = await jobsTask;
            var assignmentsResponse = await assignmentsTask;
            var reportsResponse = await reportsTask;
            var locationsResponse = await locationsTask;

            // 2. Extract the models
            var jobs = jobsResponse.Models ?? new();
            var assignments = assignmentsResponse.Models ?? new();
            var reports = reportsResponse.Models ?? new();
            var locations = locationsResponse.Models ?? new();

            var assignmentLookup = assignments.ToLookup(a => a.JobIds.FirstOrDefault());
            //var reportMap = reports.ToDictionary(x => x.JobId ?? "");
            // Use ToLookup to handle multiple reports per JobId
            var reportLookup = reports.ToLookup(x => x.JobId ?? "");
            var locationMap = locations.ToDictionary(x => x.Id ?? "");
            // Update your joinedData creation:
            // var joinedData = jobs.Select(job => new
            // {
            //     Job = job,
            //     // Pick the most recent report or the first one found
            //     Report = reportLookup[job.Id ?? ""].OrderByDescending(r => r.CompletionDate).FirstOrDefault(),
            //     Location = locationMap.TryGetValue(job.LocationId.ToString()?.ToString() ?? "", out var l) ? l : null
            // }).ToList();
            var joinedData = jobs.Select(job => new
            {
                Job = job,
                Report = reportLookup[job.Id ?? ""].OrderByDescending(r => r.CompletionDate).FirstOrDefault(),
                Location = locationMap.TryGetValue(job.LocationId.ToString() ?? "", out var l) ? l : null,

                // 2. Convert job.Id (string) to Guid to match the key type of assignmentLookup
                Assignments = Guid.TryParse(job.Id, out Guid jobGuid)
                  ? assignmentLookup[jobGuid].ToList()
                  : new List<JobAssignment>()
            }).ToList();




            // // Create the primary joined list
            // var joinedData = jobs.Select(job => new
            // {
            //     Job = job,
            //     Report = reportMap.TryGetValue(job.Id ?? "", out var r) ? r : null,
            //     Location = locationMap.TryGetValue(job.LocationId.ToString()?.ToString() ?? "", out var l) ? l : null
            // }).ToList();

            // --- DASHBOARD CALCULATIONS ---

            // 1. Grouping by Completion Date (Use Job date, not Report date)
            var grouped = joinedData
                .Where(x => x.Job.CompletionDate.HasValue)
                .GroupBy(x => x.Job.CompletionDate!.Value.Date)
                .OrderBy(x => x.Key);

            foreach (var day in grouped)
            {
                _dashboard.DailyLabels.Add(day.Key.ToString("dd MMM"));

                // Use string comparison safely
                int pmCount = day.Count(x =>
                    x.Job.JobType?.Equals("preventive", StringComparison.OrdinalIgnoreCase) == true);

                int nonPmCount = day.Count(x =>
                                x.Job.JobType?.Equals("breakdown", StringComparison.OrdinalIgnoreCase) == true);

                _dashboard.DailyPmCounts.Add(pmCount);
                _dashboard.DailyNonPmCounts.Add(nonPmCount);

                // Calculate Man Days
                // Calculate Man Days based on actual personnel deployed from assignments
                double dailyManDays = day.Sum(x =>
                    x.Assignments.Sum(a => a.PersonnelIds?.Count ?? 0)
                );

                _dashboard.DailyPmManDays.Add(dailyManDays);
                //_dashboard.DailyPmManDays.Add(manDays);
            }

            // Update total for the KPI card
            _dashboard.PmManDays = (int)joinedData.Sum(x =>
                x.Assignments.Sum(a => a.PersonnelIds?.Count ?? 0));

            var topLocations = joinedData
               .GroupBy(x => x.Location?.LocationName ?? "Unknown")
               .Select(x => new
               {
                   Name = x.Key,
                   Count = x.Count()
               })
               .OrderByDescending(x => x.Count)
               .Take(5)
               .ToList();

            _dashboard.TopLocationLabels =
                topLocations.Select(x => x.Name).ToList();

            _dashboard.TopLocationCounts =
                topLocations.Select(x => x.Count).ToList();



            // 2. Summary Statistics
            _dashboard.TotalPmInstalls = locations.Count;
            _dashboard.NonPmJobs = joinedData.Count(x => x.Job.JobType == "breakdown");

            int totalPm = joinedData.Count(x => x.Job.JobType == "preventive");
            int totalJobs = joinedData.Count;

            _dashboard.PmSharePercent = totalJobs == 0 ? 0 : ((double)totalPm / totalJobs) * 100;

            _dashboard.PmVsNonPm = new List<int> { totalPm, (int)_dashboard.NonPmJobs };

            // 3. Field Distribution
            _dashboard.FieldDistribution = new List<int> {
            joinedData.Count(x => x.Location?.FieldType?.Contains("central", StringComparison.OrdinalIgnoreCase) == true),
            joinedData.Count(x => x.Location?.FieldType?.Contains("western", StringComparison.OrdinalIgnoreCase) == true),
            joinedData.Count(x => x.Location?.FieldType?.Contains("eastern", StringComparison.OrdinalIgnoreCase) == true)
        };




            // 4. Update UI
            await JSRuntime.InvokeVoidAsync("initPmDashboardCharts", _dashboard);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }


}