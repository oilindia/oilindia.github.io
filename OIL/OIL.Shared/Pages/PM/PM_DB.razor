    [Table("pm_reports")]
    public class DbPmReport : BaseModel
    {
        [PrimaryKey("id", false)]
        public string Id { get; set; } = "";

        [Column("job_id")]
        public string JobId { get; set; } = "";

        [Column("location_id")]
        public string LocationId { get; set; } = "";

        [Column("completion_date")]
        public DateTime? CompletionDate { get; set; }
    }

    [Table("jobs")]
    public class DbJob : BaseModel
    {
        [PrimaryKey("id", false)]
        public string Id { get; set; } = "";

        [Column("job_type")]
        public string JobType { get; set; } = "";

        [Column("created_at")]
        public DateTime? CreatedAt { get; set; }

        [Column("completion_date")]
        public DateTime? CompletionDate { get; set; }

        [Column("location_id")]
        public int LocationId { get; set; }
    }

    [Table("locations")]
    public class DbLocation : BaseModel
    {
        [PrimaryKey("id", false)]
        public string Id { get; set; } = "";

        [Column("location_name")]
        public string LocationName { get; set; } = "";

        [Column("field_type")]
        public string FieldType { get; set; } = "";
    }

    [Table("job_assignments")]
    public class JobAssignment : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("created_at")] public DateTime? CreatedAt { get; set; }
        [Column("driver_id")] public long? DriverId { get; set; }
        [Column("job_ids")] public List<Guid> JobIds { get; set; } = new();

        [Column("shift_name")] public string ShiftName { get; set; } = "";

        [Column("job_action")] public string JobAction { get; set; } = "";

        [Column("job_action_time")] public DateTime? JobActionTime { get; set; }
        [Column("personnel_ids")] public List<long> PersonnelIds { get; set; } = new();
        [Column("doc_number")] public string DocNumber { get; set; } = "";
        [Column("status")] public string Status { get; set; } = ""; // Field for soft delete
        [JsonIgnore] public string PrintableDate => CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "";

        [Column("job_overtime")]
        public double? JobOvertime { get; set; }
    }




