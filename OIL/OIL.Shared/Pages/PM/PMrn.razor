@code {

    private List<SectionItem> _currentJobItems = new();

    private List<ReportView> _reports = new();

    private List<Location> _locations = new();

    private List<CalibrationDetail> _jobCertificates = new();

    private ReportView _selectedReport = new();

    private bool _loading = true;

    private bool _isGcsModalOpen = false;

    private bool _isOcsModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task HandleViewClick(ReportView report)
    {
        _selectedReport = report;

        string jobIdStr = report.JobId.ToString();

        _currentJobItems.Clear();

        try
        {
            var reportRes = await SupabaseClient
                .From<PmReport>()
                .Filter("id",
                    Supabase.Postgrest.Constants.Operator.Equals,
                    report.Id)
                .Single();

            if (reportRes != null)
            {
                _currentJobItems.AddRange(
                    ParseJsonSection(reportRes.SectionA));

                _currentJobItems.AddRange(
                    ParseJsonSection(reportRes.SectionB));
            }

            var certRes = await SupabaseClient
                .From<CalibrationDetail>()
                .Filter("job_id",
                    Supabase.Postgrest.Constants.Operator.Equals,
                    jobIdStr)
                .Get();

            _jobCertificates = certRes.Models;

            foreach (var cert in _jobCertificates)
            {
                if (!string.IsNullOrWhiteSpace(cert.CalibrationDataJson))
                {
                    try
                    {
                        cert.ParsedData =
                            JsonSerializer.Deserialize<ParsedCalibrationData>(
                                cert.CalibrationDataJson);
                    }
                    catch
                    {
                        cert.ParsedData = new ParsedCalibrationData();
                    }
                }
            }

            if (report.LocationName.Contains("GCS",
                StringComparison.OrdinalIgnoreCase))
            {
                _isGcsModalOpen = true;
            }
            else
            {
                _isOcsModalOpen = true;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                "Data Load Error: " + ex.Message,
                Severity.Error);
        }
    }

    private List<SectionItem> ParseJsonSection(object? jsonField)
    {
        if (jsonField == null)
            return new();

        try
        {
            string rawJson = jsonField.ToString() ?? "[]";

            if (rawJson.StartsWith("\"") &&
                rawJson.EndsWith("\""))
            {
                rawJson =
                    JsonSerializer.Deserialize<string>(rawJson)
                    ?? "[]";
            }

            return JsonSerializer.Deserialize<List<SectionItem>>(rawJson)
                   ?? new();
        }
        catch
        {
            return new();
        }
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;

            var locRes = await SupabaseClient
                .From<Location>()
                .Get();

            _locations = locRes.Models;

            var res = await SupabaseClient
                .From<PmReport>()
                .Get();

            _reports = res.Models.Select(r => new ReportView
            {
                Id = r.Id,
                JobId = r.JobId,
                LocationId = r.LocationId,
                WorkPermit = r.WorkPermit,
                CompletionDate = r.CompletionDate,

                LocationName =
                    _locations.FirstOrDefault(
                        l => l.Id == r.LocationId)
                    ?.InstallationName ?? "N/A",

                VisualPoints = new List<VisualPoint>
                {
                    new()
                    {
                        Id = "1",
                        Description =
                        "Checked all tripping parameters and their settings."
                    },

                    new()
                    {
                        Id = "2",
                        Description =
                        "Panel inside wiring checked and found ok."
                    },

                    new()
                    {
                        Id = "3",
                        Description =
                        "Air Filter Regulators draining and servicing done."
                    }
                }

            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                "Fetch Error: " + ex.Message,
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrintReport()
    {
        StateHasChanged();

        await Task.Delay(500);

        await JSRuntime.InvokeVoidAsync("blazorPrint");
    }

