        <div id="printable-area" class="print-landscape">
            <div class="landscape-report">
                <table class="oil-header-table">
                    <tr>
                        <td width="20%" rowspan="3" class="logo-container">
                            <div class="logo-placeholder">
                                <img src="_content/OIL.Shared/imgs/oil.png" alt="OIL INDIA" style="max-height: 80px;">
                                <div class="logo-text-bold">ऑयल इंडिया</div>
                                <div class="logo-text-bold">OIL INDIA</div>
                            </div>
                        </td>
                        <td class="text-center header-main-title">
                            <div>ऑयल इंडिया लिमिटेड</div>
                            <div class="sub-dept-hindi">यंत्रीकरण विभाग</div>
                            <div class="dept-english">INSTRUMENTATION DEPARTMENT</div>
                            <div class="location-text">दुलियाजान / DULIAJAN</div>
                            <div class="company-english-bold">OIL INDIA LIMITED</div>
                            <div class="internal-use-text">(केवल आंतरिक उपयोग हेतु / For Internal Use Only)</div>
                        </td>
                        <td width="20%" class="ref-section">
                            <div><strong>Ref No:</strong> @_selectedReport.WorkPermit</div>
                            <div><strong>Dated:</strong> @_selectedReport.CompletionDateLocal</div>
                        </td>
                    </tr>
                </table>

                <table class="report-body-table">
                    <tr>
                        <td colspan="2" width="40%"><strong>Ref no:</strong> @_selectedReport.WorkPermit</td>
                        <td width="25%" class="text-center"><strong>Dated:</strong> @_selectedReport.CompletionDateLocal</td>
                        <td width="35%"><strong>PM Date:</strong> @_selectedReport.CompletionDateLocal</td>
                    </tr>

                    <tr>
                        <td colspan="4"><strong>Notification Number:</strong> @_selectedReport.WorkPermit</td>
                    </tr>

                    <tr>
                        <td colspan="2"><strong>A] Comp.Sl.No :</strong> @_selectedReport.CompSlNo</td>
                        <td colspan="2" class="text-center"><strong>Installation Name -</strong> @_selectedReport.InstallationName</td>
                    </tr>

                    <tr>
                        <td colspan="4" class="text-right" style="padding-right: 15%;">
                            <strong>Make -</strong> @_selectedReport.MakeModel
                        </td>
                    </tr>

                    <tr>
                        <td width="20%" class="text-center font-bold">Visual Checking Points</td>
                        <td colspan="3" class="no-padding">
                            <table class="inner-list-table">
                                @foreach (var point in _selectedReport.VisualPoints)
                                {
                                    <tr>
                                        <td>@point.Id] @point.Description</td>
                                    </tr>
                                }
                            </table>
                        </td>
                    </tr>
                </table>

                <table class="job-done-table">
                    <thead>
                        <tr>
                            <th width="5%" class="rotate-text">Job Done</th>
                            <th width="15%">Unit</th>
                            <th width="15%">Instrument</th>
                            <th width="10%">Make & Model</th>
                            <th width="10%">Range</th>
                            <th width="15%">Servicing - Cleaning/ Calibration/ Functionality Testing/ Replaced with pre Calibrated instrument</th>
                            <th width="12%">Calibration Certificate No. (attached with this report)</th>
                            <th width="18%">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _currentJobItems)
                        {
                            <tr>
                                @if (item == _currentJobItems.First())
                                {
                                    <td rowspan="@_currentJobItems.Count" class="text-center bold-vertical">Job Done</td>
                                }
                                <td>@item.Unit</td>
                                <td>@item.Instrument</td>
                                <td>@item.MakeModel</td>
                                <td>@item.Range</td>
                                <td>@item.TestingType</td>
                                <td>@item.CertNo</td>
                                <td>@item.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>


                @* <table class="report-table">
                    <tr>
                        <td colspan="4" style="text-align:left"><strong>Installation Name:</strong> @_selectedReport.LocationName</td>
                    </tr>
                    <tr style="background:#f5f5f5">
                        <th width="5%">Sl.</th>
                        <th width="15%">Unit</th>
                        <th width="20%">Instrument</th>
                        <th>Status / Remarks</th>
                    </tr> *@
                    @* This would be a loop of your GCS specific rows *@
                   @*  <tr>
                        <td>1</td>
                        <td>1st Stage Suction</td>
                        <td>Pressure Gauge</td>
                        <td>Calibration carried out using hand held calibrator.</td>
                    </tr>
                </table> *@
            </div>
        </div>

        <div id="printable-area" class="print-portrait">
            @foreach (var cert in _jobCertificates)
            {
                <div class="portrait-report page-break">
                    <div style="border: 2px solid black; padding: 15px;">
                        <h2 class="text-center">OIL INDIA LIMITED</h2>
                        <h4 class="text-center">CALIBRATION CERTIFICATE</h4>
                        <hr style="border:1px solid black" />

                        <table style="width:100%; text-align:left;">
                            <tr>
                                <td><strong>Certificate No:</strong> @cert.CertNo</td>
                                <td><strong>Date:</strong> @(cert.ReportDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><strong>Unit/Location:</strong> @cert.UnitId</td>
                                <td><strong>Model:</strong> @cert.Model</td>
                            </tr>
                            <tr>
                                <td><strong>Instrument:</strong> @cert.InstrumentType</td>
                                <td><strong>Range:</strong> @cert.InstrumentRange</td>
                            </tr>
                        </table>

                        @* Dynamic Master Calibrator extraction from JSON *@
                        @{
                            var calData = cert.CalibrationDataJson?.ToString();
                            string master = "Handheld Pressure Calibrator";
                            if (!string.IsNullOrEmpty(calData))
                            {
                                try
                                {
                                    // Handle the escaped string if necessary
                                    var cleanedJson = calData.StartsWith("\"") ? JsonSerializer.Deserialize<string>(calData) : calData;
                                    using var doc = JsonDocument.Parse(cleanedJson);
                                    master = doc.RootElement.GetProperty("MasterCalibrator").GetString() ?? master;
                                }
                                catch { }
                            }
                        }
                        <p class="mt-4"><strong>Master Calibrator Used:</strong> @master</p>

                        @* Placeholder for the 5-point calibration table *@
                        <table class="report-table mt-4">
                            <thead>
                                <tr><th>Standard Input</th><th>Observed Output</th><th>Error %</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>0%</td><td>---</td><td>---</td></tr>
                                <tr><td>50%</td><td>---</td><td>---</td></tr>
                                <tr><td>100%</td><td>---</td><td>---</td></tr>
                            </tbody>
                        </table>

                        <div class="d-flex justify-space-between mt-10">
                            <div>
                                <p>____________________</p>
                                <p>Performed By: <br /> @cert.PerformedByName</p>
                            </div>
                            <div>
                                <p>____________________</p>
                                <p>Witnessed By: <br /> @cert.WitnessedByName</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
}

