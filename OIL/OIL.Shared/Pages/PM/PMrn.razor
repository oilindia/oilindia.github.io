@code {
    private List<SectionItem> _currentJobItems = new();
    // Helper Classes to map your JSON data structure
    public class SectionItem
    {
        [JsonPropertyName("SlNo")] public string SlNo { get; set; } = "";
        [JsonPropertyName("Unit")] public string Unit { get; set; } = "";
        [JsonPropertyName("Instrument")] public string Instrument { get; set; } = "";
        [JsonPropertyName("TagNumber")] public string TagNumber { get; set; } = "";
        [JsonPropertyName("MakeModel")] public string MakeModel { get; set; } = "";
        [JsonPropertyName("Range")] public string Range { get; set; } = "";
        [JsonPropertyName("Quantity")] public int Quantity { get; set; }
        [JsonPropertyName("TestingType")] public string TestingType { get; set; } = "";
        [JsonPropertyName("CertNo")] public string CertNo { get; set; } = "";
        [JsonPropertyName("Remarks")] public string Remarks { get; set; } = "";

    }

    private List<ReportView> _reports = new();
    private List<Location> _locations = new();
    private List<CalibrationDetail> _jobCertificates = new();
    private ReportView _selectedReport = new();

    private bool _loading = true;
    private bool _isGcsModalOpen = false;
    private bool _isOcsModalOpen = false;

  

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task HandleViewClick(ReportView report)
    {
        _selectedReport = report;
        string jobIdStr = report.JobId.ToString();
        _currentJobItems.Clear();

        try
        {
            // 1. Fetch the PM Report data to get the JSON sections
            var reportRes = await SupabaseClient.From<PmReport>()
                .Filter("id", Supabase.Postgrest.Constants.Operator.Equals, report.Id)
                .Single();

            if (reportRes != null)
            {
                // Parse the JSON Sections (A and B)
                _currentJobItems.AddRange(ParseJsonSection(reportRes.SectionA));
                _currentJobItems.AddRange(ParseJsonSection(reportRes.SectionB));
            }

            // 2. Fetch Calibration Certificates for this Job
            var certRes = await SupabaseClient.From<CalibrationDetail>()
                .Filter("job_id", Supabase.Postgrest.Constants.Operator.Equals, jobIdStr)
                .Get();

            _jobCertificates = certRes.Models;

            // 3. Open appropriate Modal
            if (report.LocationName.Contains("GCS", StringComparison.OrdinalIgnoreCase))
                _isGcsModalOpen = true;
            else
                _isOcsModalOpen = true;
        }
        catch (Exception ex) { Snackbar.Add("Data Load Error: " + ex.Message, Severity.Error); }
    }
    // This handles the escaped string JSON in your database
    private List<SectionItem> ParseJsonSection(object? jsonField)
    {
        if (jsonField == null) return new();
        try
        {
            string rawJson = jsonField.ToString();
            // Supabase sometimes returns JSON as a double-quoted string: "[{...}]"
            if (rawJson.StartsWith("\"") && rawJson.EndsWith("\""))
            {
                rawJson = JsonSerializer.Deserialize<string>(rawJson) ?? "[]";
            }
            return JsonSerializer.Deserialize<List<SectionItem>>(rawJson) ?? new();
        }
        catch { return new(); }
    }

    // private async Task HandleViewClick(ReportView report)
    // {
    //     _selectedReport = report;

    //     // --- CRITICAL FIX ---
    //     // Passing Guid directly causes "Unknown criterion type" error.
    //     // We MUST convert it to a string for Postgrest.
    //     string jobIdStr = report.JobId.ToString();

    //     try
    //     {
    //         if (report.LocationName.Contains("GCS", StringComparison.OrdinalIgnoreCase))
    //         {
    //             // Optionally fetch certs here if needed for GCS logic
    //             _isGcsModalOpen = true;
    //         }
    //         else
    //         {
    //             _isOcsModalOpen = true;
    //         }
    //     }
    //     catch (Exception ex)
    //     {
    //         Snackbar.Add("Selection Error: " + ex.Message, Severity.Error);
    //     }
    // }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            var locRes = await SupabaseClient.From<Location>().Get();
            _locations = locRes.Models;

            var res = await SupabaseClient.From<PmReport>().Get();
            _reports = res.Models.Select(r => new ReportView
            {
                Id = r.Id,
                JobId = r.JobId,
                LocationId = r.LocationId,
                WorkPermit = r.WorkPermit,
                CompletionDate = r.CompletionDate,
                LocationName = _locations.FirstOrDefault(l => l.Id == r.LocationId)?.InstallationName ?? "N/A",
                // Initialize the VisualPoints list here
                VisualPoints = new List<VisualPoint>
        {
            new VisualPoint { Id = "1", Description = "Checked all tripping parameters and their settings." },
            new VisualPoint { Id = "2", Description = "Panel inside wiring checked and found ok." },
            new VisualPoint { Id = "3", Description = "Air Filter Regulators draining and servicing done." }
        }

            }).ToList();
        }
        catch (Exception ex) { Snackbar.Add("Fetch Error: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("window.print");

    #region Models
    [Table("pm_reports")]
    public class PmReport : BaseModel
    {
        [PrimaryKey("id", false)] public int Id { get; set; }
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("work_permit")] public string? WorkPermit { get; set; }
        [Column("completion_date")] public DateTime CompletionDate { get; set; }
        [Column("section_a_controllers")] public object? SectionA { get; set; }
        [Column("section_b_transmitters")] public object? SectionB { get; set; }

        // ADD THIS COLUMN to capture the date string from the DB
        [Column("pm_dates")] public string? PmDates { get; set; }
    }

    [Table("pm_calibration_details")]
    public class CalibrationDetail : BaseModel
    {
        [PrimaryKey("id")] public int Id { get; set; }
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("cert_no")] public string CertNo { get; set; } = "";
        [Column("installation")] public string? Installation { get; set; }
        [Column("unit_id")] public string? UnitId { get; set; }
        [Column("instrument_type")] public string? InstrumentRange { get; set; }

        [Column("model")] public string? Model { get; set; }
        [Column("instrument_range")] public string? InstrumentType { get; set; }
        [Column("report_date")] public DateTime? ReportDate { get; set; }
        [Column("performed_by_name")] public string? PerformedByName { get; set; }
        [Column("witnessed_by_name")] public string? WitnessedByName { get; set; }

        [Supabase.Postgrest.Attributes.Column("calibration_data")]
        public string CalibrationDataJson { get; set; } = "[]";
    }

    [Table("locations")]
    public class Location : BaseModel
    {
        [PrimaryKey("id")] public long Id { get; set; }
        [Column("installation_name")] public string? InstallationName { get; set; }
    }

    public class ReportView : PmReport
    {
        // Existing helper for dates
        public string CompletionDateLocal => CompletionDate.ToLocalTime().ToString("dd/MM/yyyy");

        // UI specific properties mapped from the JSON sections
        public string LocationName { get; set; } = "N/A";
        public string InstallationName { get; set; } = "";
        public string CompSlNo { get; set; } = "";
        public string MakeModel { get; set; } = "";
        public string PMDates { get; set; } = ""; // Mapped from the pm_dates column

        // To hold the list for the "Visual Checking Points"
        public List<VisualPoint> VisualPoints { get; set; } = new();
    }

    public class VisualPoint
    {
        public string Id { get; set; }
        public string Description { get; set; }
    }
    #endregion

}