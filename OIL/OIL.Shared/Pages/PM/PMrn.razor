    // 3. Helper method used by the HTML to find the employee details
    private EmployeeEngineer GetEmployee(string empCode)
    {
        if (string.IsNullOrWhiteSpace(empCode) || _employees == null)
            return null;

        return _employees.FirstOrDefault(e => e.EmpCode.ToString() == empCode.ToString());
    }



    private EmployeeExecutive GetExecutive(string empCode)
    {
        if (string.IsNullOrWhiteSpace(empCode) || _executives == null)
            return null;

        return _executives.FirstOrDefault(e => e.Id.ToString() == empCode.ToString());
    }

