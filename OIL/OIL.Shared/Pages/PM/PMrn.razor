@page "/PMrn"

@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Text.Json
@using Microsoft.JSInterop
@inject ISnackbar Snackbar
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JSRuntime
@using System.Text.Json.Serialization

<style>
    /* --- Modal & UI Layout (Screen Only) --- */
    .modal-overlay {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.92);
        display: block;
        overflow-y: auto;
        padding: 40px 0;
        backdrop-filter: blur(4px);
    }

    /* --- Report Paper Styles --- */
    .landscape-report, .portrait-report {
        background: white !important;
        color: black !important;
        margin: 0 auto 40px auto;
        font-family: 'Times New Roman', serif;
        box-shadow: 0 0 30px rgba(0,0,0,0.7);
        box-sizing: border-box;
        position: relative;
        z-index: 1001;
        display: block;
    }

    /* Link classes to named pages for mixed orientation */
    .landscape-report {
        width: 297mm;
        min-height: 210mm;
        padding: 10mm;
        page: landscape-page;
    }

    .portrait-report {
        width: 210mm;
        min-height: 297mm;
        padding: 20mm;
        page: portrait-page;
    }

    /* --- Table Formatting --- */
    .report-body-table, .job-done-table, .oil-header-table, .report-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        border: 1px solid #000;
        background: white;
    }

        .report-body-table td, .job-done-table td, .job-done-table th, .report-table td, .report-table th {
            border: 1px solid #000;
            padding: 5px;
            vertical-align: middle;
            word-wrap: break-word;
            font-size: 11px;
            color: black !important;
        }

    .bold-vertical {
        font-weight: bold;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        white-space: nowrap;
        text-align: center;
        background-color: #fff !important;
        padding: 10px 2px !important;
    }

    .inner-list-table td {
        border: none !important;
        border-bottom: 1px solid #000 !important;
        padding: 4px;
    }

    .inner-list-table tr:last-child td {
        border-bottom: none !important;
    }

    .text-center {
        text-align: center;
    }

    .font-bold {
        font-weight: bold;
    }

    .no-padding {
        padding: 0 !important;
    }

    /* --- FINAL PRINT ENGINE FIX --- */
    @@media print {
        /* 1. Define Named Pages */
        @@page landscape-page {
            size: A4 landscape;
            margin: 10mm;
        }

        @@page portrait-page {
            size: A4 portrait;
            margin: 10mm;
        }
        /* 2. Brute Force Visibility */
        /* Hide everything first */
        body * {
            visibility: hidden !important;
        }
        /* 3. Re-enable ONLY the report tree */
        /* We must make the modal and printable area visible or their children stay hidden */
        .modal-overlay,
        #printable-area,
        #printable-area *,
        .landscape-report,
        .portrait-report {
            visibility: visible !important;
        }
        /* 4. Flatten the layout for the print engine */
        html, body {
            height: auto !important;
            overflow: visible !important;
            background: white !important;
        }

        .modal-overlay {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 100% !important;
            height: auto !important;
            background: white !important;
            padding: 0 !important;
            margin: 0 !important;
            display: block !important;
            overflow: visible !important;
        }

        #printable-area {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
        }

        .landscape-report, .portrait-report {
            box-shadow: none !important;
            margin: 0 !important;
            width: 100% !important;
            border: none !important;
            /* Ensure page breaks trigger orientation change */
            break-after: page;
        }
        /* Hide UI buttons and framework extras */
        .no-print, .mud-appbar, .mud-drawer, .mud-overlay {
            display: none !important;
        }
    }
</style>








<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 no-print">
    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">PM Completion Reports</MudText>
        <MudDataGrid T="ReportView" Items="@_reports" Loading="@_loading" Dense="true" Bordered="true">
            <Columns>
                <TemplateColumn Title="View" HeaderStyle="width: 50px;">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info"
                                       OnClick="@(() => HandleViewClick(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CompletionDateLocal" Title="Date" />
                <PropertyColumn Property="x => x.LocationName" Title="Installation" />
                <PropertyColumn Property="x => x.WorkPermit" Title="Permit #" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@* ========================== GCS SUMMARY MODAL (Landscape) ========================== *@
