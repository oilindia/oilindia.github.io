@code {



    private DateTime? _startDate = DateTime.Today.AddMonths(-1);

    private DateTime? _endDate = DateTime.Today;

    private List<SectionItem> _currentJobItems = new();

    private List<ReportView> _reports = new();

    private List<Location> _locations = new();

    private List<CalibrationDetail> _jobCertificates = new();

    private List<MasterCalibrator> _masterCalibrators = new();

    private ReportView _selectedReport = new();

    private bool _loading = true;

    private bool _isGcsModalOpen = false;

    private bool _isOcsModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var empResponse = await SupabaseClient.From<EmployeeEngineer>().Get();
        _employees = empResponse.Models;

        await LoadData();
    }

    private async Task HandleViewClick(ReportView report)
    {
        _selectedReport = report;

        string jobIdStr = report.JobId.ToString();

        _currentJobItems.Clear();

        try
        {
            var reportRes = await SupabaseClient
                .From<PmReport>()
                .Filter("id",
                    Supabase.Postgrest.Constants.Operator.Equals,
                    report.Id)
                .Single();

            if (reportRes != null)
            {
                _currentJobItems.AddRange(
                    ParseJsonSection(reportRes.SectionA));

                _currentJobItems.AddRange(
                    ParseJsonSection(reportRes.SectionB));

                _currentJobItems.AddRange(
                    ParseJsonSection(reportRes.SectionDSpares));
            }

            var certRes = await SupabaseClient
                .From<CalibrationDetail>()
                .Filter("job_id",
                    Supabase.Postgrest.Constants.Operator.Equals,
                    jobIdStr)
                .Get();

            _jobCertificates = certRes.Models;

            foreach (var cert in _jobCertificates)
            {
                if (!string.IsNullOrWhiteSpace(cert.CalibrationDataJson))
                {
                    try
                    {
                        cert.ParsedData =
                            JsonSerializer.Deserialize<ParsedCalibrationData>(
                                cert.CalibrationDataJson);
                    }
                    catch
                    {
                        cert.ParsedData = new ParsedCalibrationData();
                    }
                }
            }

            if (report.LocationName.Contains("GCS",
                StringComparison.OrdinalIgnoreCase))
            {
                _isGcsModalOpen = true;
            }
            else
            {
                _isOcsModalOpen = true;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                "Data Load Error: " + ex.Message,
                Severity.Error);
        }
    }

    private List<SectionItem> ParseJsonSection(object? jsonField)
    {
        if (jsonField == null)
            return new();

        try
        {
            string rawJson = jsonField.ToString() ?? "[]";

            if (rawJson.StartsWith("\"") &&
                rawJson.EndsWith("\""))
            {
                rawJson =
                    JsonSerializer.Deserialize<string>(rawJson)
                    ?? "[]";
            }

            return JsonSerializer.Deserialize<List<SectionItem>>(rawJson)
                   ?? new();
        }
        catch
        {
            return new();
        }
    }

    private async Task LoadData()
    {
        try
        {
            var start = (_startDate ?? DateTime.Today.AddMonths(-1)).Date;
            var end = (_endDate ?? DateTime.Today).Date.AddDays(1);


            var response = await SupabaseClient.From<EmployeeEngineer>().Where(x => x.Section == "FIELD MAINTENANCE").Get();
            _employees = response.Models;

            var executiveResponse = await SupabaseClient.From<EmployeeExecutive>().Where(x => x.Department == "FIELD MAINTENANCE").Get();
            _executives = executiveResponse.Models;


            _loading = true;

            var locRes = await SupabaseClient
                .From<Location>()
                .Get();

            _locations = locRes.Models;

            var res = await SupabaseClient
                .From<PmReport>()
                 .Select("*")
                            .Filter("completion_date", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
                            .Filter("completion_date", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd"))
                .Get();

            // var reportsTask = await SupabaseClient
            //                 .From<PmReport>()
            //                 .Select("*")
            //                 .Filter("completion_date", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
            //                 .Filter("completion_date", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd"))
            //                 .Get();


            // Queries 'public.master_calibrators' and orders them by validity_date ascending
            // .Order(c => c.ValidityDate, Supabase.Postgrest.Constants.Ordering.Ascending)

            var masterCalibrators = await SupabaseClient
                .From<MasterCalibrator>()
                .Get();

            _masterCalibrators = masterCalibrators.Models
                            .OrderBy(c => c.ValidityDate)
                            .ToList();

            _reports = res.Models.Select(r => new ReportView
            {
                Id = r.Id,
                JobId = r.JobId,
                LocationId = r.LocationId,
                WorkPermit = r.WorkPermit,
                CompletionDate = r.CompletionDate,

                JobCarriedByEmpCodes = r.JobCarriedByEmpCodes,
                ReportPreparedBy = r.ReportPreparedBy,
                ReportSupervisedBy = r.ReportSupervisedBy,
                ReportVerifiedBy = r.ReportVerifiedBy,

                SectionDSpares = r.SectionDSpares,

                MultiSelectionPmDates = r.MultiSelectionPmDates,

                LocationName =
                    _locations.FirstOrDefault(
                        l => l.Id == r.LocationId)
                    ?.InstallationName ?? "N/A",

                VisualPoints = new List<VisualPoint>
                {
                    new()
                    {
                        Id = "1",
                        Description =
                        "Checked all tripping parameters and their settings."
                    },

                    new()
                    {
                        Id = "2",
                        Description =
                        "Panel inside wiring checked and found ok."
                    },

                    new()
                    {
                        Id = "3",
                        Description =
                        "Air Filter Regulators draining and servicing done."
                    }
                }

            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                "Fetch Error: " + ex.Message,
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrintReport()
    {
        StateHasChanged();

        await Task.Delay(500);

        await JSRuntime.InvokeVoidAsync("blazorPrint");
    }

    public class SectionItem
    {
        [JsonPropertyName("SlNo")]
        public string SlNo { get; set; } = "";

        [JsonPropertyName("Unit")]
        public string Unit { get; set; } = "";

        [JsonPropertyName("Instrument")]
        public string Instrument { get; set; } = "";

        [JsonPropertyName("TagNumber")]
        public string TagNumber { get; set; } = "";

        [JsonPropertyName("MakeModel")]
        public string MakeModel { get; set; } = "";

        [JsonPropertyName("Range")]
        public string Range { get; set; } = "";

        [JsonPropertyName("Quantity")]
        public int Quantity { get; set; }

        [JsonPropertyName("TestingType")]
        public string TestingType { get; set; } = "";

        [JsonPropertyName("CertNo")]
        public string CertNo { get; set; } = "";

        [JsonPropertyName("Remarks")]
        public string Remarks { get; set; } = "";
    }

    // 3. Model mapping to your PostgreSQL table
    [Table("employees_engineers")]
    public class EmployeeEngineer : BaseModel
