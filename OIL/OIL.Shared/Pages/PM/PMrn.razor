@page "/PMrn"

@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Text.Json
@using Microsoft.JSInterop
@using System.Text.Json.Serialization

@inject ISnackbar Snackbar
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JSRuntime

<style>

    html, body {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f3f3f3;
    }

    /* =========================
           MODAL
        ========================== */

    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow-y: auto;
        background: rgba(0,0,0,0.75);
        padding: 20px;
        box-sizing: border-box;
    }

    /* =========================
           REPORT PAGES
        ========================== */

    .landscape-report,
    .portrait-report {
        background: white;
        margin: 0 auto 30px auto;
        box-sizing: border-box;
        color: black;
        overflow: visible !important;
    }

    .landscape-report {
        width: 297mm;
        min-height: 210mm;
        padding: 12mm;
    }

    .portrait-report {
        width: 210mm;
        min-height: 297mm;
        padding: 12mm;
    }

    /* =========================
           TABLES
        ========================== */

    table {
        width: 100%;
        border-collapse: collapse !important;
        border-spacing: 0;
    }

    .report-table,
    .oil-header-table,
    .report-body-table,
    .job-done-table,
    .inner-list-table {
        width: 100%;
        border-collapse: collapse !important;
        table-layout: fixed;
        border: 1px solid black !important;
    }

        .report-table th,
        .report-table td,
        .oil-header-table th,
        .oil-header-table td,
        .report-body-table th,
        .report-body-table td,
        .job-done-table th,
        .job-done-table td,
        .inner-list-table th,
        .inner-list-table td {
            border: 1px solid black !important;
            padding: 6px;
            font-size: 12px;
            color: black !important;
            vertical-align: middle;
            word-wrap: break-word;
        }

        .job-done-table th {
            background: #efefef !important;
        }

    /* =========================
           TEXT HELPERS
        ========================== */

    .text-center {
        text-align: center;
    }

    .text-right {
        text-align: right;
    }

    .font-bold,
    .bold-vertical {
        font-weight: bold;
    }

    .bold-vertical {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        text-align: center;
    }

    .no-padding {
        padding: 0 !important;
    }

    .header-logo-section {
        text-align: center;
        margin-bottom: 10px;
    }

    .header-main-title {
        text-align: center;
        font-size: 14px;
        font-weight: bold;
    }

    .logo-text-bold {
        font-weight: bold;
        font-size: 12px;
    }

    /* =========================
           PRINT
        ========================== */

    @@media print {

        html,
        body {
            background: white !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
            height: auto !important;
        }

            body * {
                visibility: hidden;
            }

        #printable-area,
        #printable-area * {
            visibility: visible;
        }

        #printable-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            overflow: visible !important;
        }

        .modal-overlay {
            position: static !important;
            background: white !important;
            overflow: visible !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .no-print {
            display: none !important;
        }

        .landscape-report,
        .portrait-report {
            box-shadow: none !important;
            margin: 0 auto !important;
            page-break-after: always;
            break-after: page;
            overflow: visible !important;
        }

        .landscape-report {
            width: 100% !important;
        }

        .portrait-report {
            width: 100% !important;
        }

        table {
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        td,
        th {
            border: 1px solid black !important;
            color: black !important;
            background: white !important;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        @@page {
            size: A4;
            margin: 10mm;
        }
    }

</style>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 no-print">

    <MudPaper Elevation="3" Class="pa-4">

        <h3>PM Completion Reports</h3>

        <MudDataGrid T="ReportView"
                     Items="@_reports"
                     Loading="@_loading"
                     Dense="true"
                     Bordered="true">

            <Columns>

                <TemplateColumn Title="View" HeaderStyle="width: 50px;">

                    <CellTemplate>

                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       OnClick="@(() => HandleViewClick(context.Item))" />

                    </CellTemplate>

                </TemplateColumn>

                <PropertyColumn Property="x => x.CompletionDateLocal" Title="Date" />
                <PropertyColumn Property="x => x.LocationName" Title="Installation" />
                <PropertyColumn Property="x => x.WorkPermit" Title="Permit #" />

            </Columns>

        </MudDataGrid>

    </MudPaper>

</MudContainer>

@if (_isGcsModalOpen)
{
    <div class="modal-overlay">

        <div class="no-print" style="margin-bottom: 40px;">

            <MudButton OnClick="PrintReport"
                       Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Print">

                PRINT REPORT

            </MudButton>

            <MudButton OnClick="() => _isGcsModalOpen = false"
                       Variant="Variant.Outlined"
                       Style="color: white; border-color: white;">

                CLOSE

            </MudButton>

        </div>

        <div id="printable-area">

            <div class="landscape-report">

                <table class="oil-header-table">

                    <tr>

                        <td width="20%" rowspan="3" class="text-center">

                            <img src="_content/OIL.Shared/imgs/oil.png"
                                 alt="OIL INDIA"
                                 style="max-height: 50px;">

                            <div class="logo-text-bold">ऑयल इंडिया</div>
                            <div class="logo-text-bold">OIL INDIA</div>

                        </td>

                        <td class="text-center header-main-title">

                            <div style="font-size: 18px; font-weight: bold;">
                                ऑयल इंडिया लिमिटेड
                            </div>

                            <div style="font-size: 16px;">
                                यंत्रीकरण विभाग
                            </div>

                            <div style="font-size: 14px; font-weight: bold;">
                                INSTRUMENTATION DEPARTMENT
                            </div>

                            <div>दुलियाजान / DULIAJAN</div>

                            <div class="font-bold">
                                OIL INDIA LIMITED
                            </div>

                            <div style="font-style: italic; font-size: 11px;">
                                (केवल आंतरिक उपयोग हेतु / For Internal Use Only)
                            </div>

                        </td>

                        <td width="20%"
                            style="padding: 10px; font-size: 12px; border-left: 1px solid black;">

                            <div>
                                <strong>Ref No:</strong> @_selectedReport.WorkPermit
                            </div>

                            <div>
                                <strong>Dated:</strong> @_selectedReport.CompletionDateLocal
                            </div>

                        </td>

                    </tr>

                </table>

                <table class="report-body-table">

                    <tr>

                        <td colspan="2">
                            <strong>Ref no:</strong> @_selectedReport.WorkPermit
                        </td>

                        <td class="text-center">
                            <strong>Dated:</strong> @_selectedReport.CompletionDateLocal
                        </td>

                        <td>
                            <strong>PM Date:</strong> @_selectedReport.CompletionDateLocal
                        </td>

                    </tr>

                    <tr>

                        <td colspan="4">
                            <strong>Notification Number:</strong> @_selectedReport.WorkPermit
                        </td>

                    </tr>

                    <tr>

                        <td colspan="4"
                            class="text-right"
                            style="padding-right: 10%;">

                            <strong>Installation Name -</strong>
                            @_selectedReport.InstallationName

                        </td>

                    </tr>

                    <tr>

                        <td colspan="2">
                            <strong>A] Comp.Sl.No :</strong>
                            @_selectedReport.CompSlNo
                        </td>

                        <td colspan="2" class="text-center">

                            <strong>Make -</strong>
                            @_selectedReport.MakeModel

                        </td>

                    </tr>

                    <tr>

                        <td width="20%" class="text-center font-bold">

                            Visual Checking Points

                        </td>

                        <td colspan="3" class="no-padding">

                            <table class="inner-list-table">

                                @foreach (var point in _selectedReport.VisualPoints)
                                {
                                    <tr>
                                        <td>@point.Id] @point.Description</td>
                                    </tr>
                                }

                            </table>

                        </td>

                    </tr>

                </table>

                <table class="job-done-table" style="margin-top: -1px;">

                    <thead>

                        <tr style="background-color: #f2f2f2;">

                            <th width="5%" class="text-center">#</th>
                            <th width="15%">Unit</th>
                            <th width="15%">Instrument</th>
                            <th width="10%">Make & Model</th>
                            <th width="10%">Range</th>
                            <th width="15%">Servicing Details</th>
                            <th width="12%">Cert No.</th>
                            <th width="18%">Remarks</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in _currentJobItems)
                        {
                            <tr>

                                @if (_currentJobItems.Count > 0 &&
                                     item == _currentJobItems.First())
                                {
                                    <td rowspan="@_currentJobItems.Count"
                                        class="bold-vertical">

                                        Job Done

                                    </td>
                                }

                                <td>@item.Unit</td>
                                <td>@item.Instrument</td>
                                <td>@item.MakeModel</td>
                                <td>@item.Range</td>
                                <td>@item.TestingType</td>
                                <td>@item.CertNo</td>
                                <td>@item.Remarks</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (_jobCertificates != null && _jobCertificates.Any())
            {
                @foreach (var cert in _jobCertificates)
                {
                    ParsedCalibrationData? dataObj = null;

                    if (!string.IsNullOrWhiteSpace(cert.CalibrationDataJson))
                    {
                        try
                        {
                            dataObj = JsonSerializer.Deserialize<ParsedCalibrationData>(
                                cert.CalibrationDataJson);
                        }
                        catch
                        {
                        }
                    }

                    bool isController =
                        dataObj?.SimulationTable != null &&
                        dataObj.SimulationTable.Any();

                    <div style="page-break-before: always;"></div>

                    <div class="portrait-report">

                        <div class="header-logo-section">

                            <img src="_content/OIL.Shared/imgs/oil.png"
                                 alt="OIL INDIA"
                                 style="height: 60px;" />

                            <br />

                            <h3>OIL INDIA LIMITED</h3>

                        </div>

                        <div style="
                            border: 1px solid black;
                            border-top: none;
                            text-align: center;
                            background-color: #f8f9fa;">

                            <div style="font-weight:bold; padding:4px;">

                                Calibration report for -
                                @cert.InstrumentType

                            </div>

                        </div>

                        <table class="report-table" style="border-top: none;">

                            <tr>

                                <td style="width: 60%;">
                                    Installation: @cert.Installation
                                </td>

                                <td style="width: 40%;">
                                    Document No - @cert.CertNo
                                </td>

                            </tr>

                            <tr>

                                <td colspan="2">
                                    Date:
                                    @(cert.ReportDate?.ToString("dd/MM/yyyy") ?? "")
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Instrument Type : @cert.InstrumentType
                                </td>

                                <td>
                                    Unit : @cert.UnitId
                                </td>

                            </tr>

                            <tr>

                                <td colspan="2">
                                    Model : @cert.Model
                                </td>

                            </tr>

                            <tr>

                                <td colspan="2">
                                    Range: @cert.InstrumentRange
                                </td>

                            </tr>

                            <tr>

                                <td colspan="2">

                                    Calibrator Make/Model :
                                    @(dataObj?.MasterCalibrator ?? "")

                                </td>

                            </tr>

                        </table>

                        <table class="report-table" style="border-top: none;">

                            <thead>

                                <tr class="text-center">

                                    <th>Input Process Value</th>
                                    <th>Measured Value</th>
                                    <th>Error</th>
                                    <th>Remarks</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (dataObj?.CalibrationTable != null &&
                                     dataObj.CalibrationTable.Any())
                                {
                                    @for (int i = 0;
                                        i < dataObj.CalibrationTable.Count;
                                        i++)
                                    {
                                        var row =
                                            dataObj.CalibrationTable[i];

                                        <tr>

                                            <td>@row.InputValue</td>

                                            <td>@row.ActualOutput</td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(row.Error)
                                                    ? "0"
                                                    : row.Error)
                                            </td>

                                            @if (i == 0)
                                            {
                                                <td rowspan="@dataObj.CalibrationTable.Count"
                                                    class="text-center">

                                                    @(string.IsNullOrWhiteSpace(row.CalRemarks)
                                                        ? "Error Adjustments carried out"
                                                        : row.CalRemarks)

                                                </td>
                                            }

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td>0</td>
                                        <td>0</td>
                                        <td>0</td>

                                        <td class="text-center">
                                            No Data Present
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                        @if (isController)
                        {
                            <div style="
                                border: 1px solid black;
                                border-top: none;
                                padding: 5px;">

                                <p class="font-bold"
                                   style="
                                    text-decoration: underline;
                                    margin-bottom: 2px;">

                                    Process Requirement -

                                </p>

                                <p style="font-size: 13px;">

                                    As per process requirement the set point is
                                    @(dataObj?.SetPoint ?? "3.5kg/cm2")

                                </p>

                                <p class="font-bold" style="margin-top: 5px;">

                                    Controller Parameters:

                                </p>

                                <ul style="
                                    list-style: none;
                                    padding-left: 0;
                                    font-size: 13px;
                                    margin: 0;">

                                    <li>

                                        Actuator Operation -
                                        @(dataObj?.ActuatorAction ?? "Reverse action")

                                    </li>

                                    <li>

                                        Proportional Band -
                                        @(dataObj?.ProportionalBand ?? "5")

                                        |

                                        Reset Time -
                                        @(dataObj?.ResetTime ?? "1")

                                    </li>

                                </ul>

                            </div>

                            <table class="report-table"
                                   style="border-top: none;">

                                <thead>

                                    <tr class="text-center">

                                        <th>Simulation Input</th>
                                        <th>Output Pressure</th>
                                        <th>Remarks</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (dataObj?.SimulationTable != null)
                                    {
                                        @for (int j = 0;
                                            j < dataObj.SimulationTable.Count;
                                            j++)
                                        {
                                            var simRow =
                                                dataObj.SimulationTable[j];

                                            <tr>

                                                <td class="text-center">
                                                    @simRow.ProcessInput
                                                </td>

                                                <td class="text-center">
                                                    @simRow.OutputPressure
                                                </td>

                                                @if (j == 0)
                                                {
                                                    <td rowspan="@dataObj.SimulationTable.Count"
                                                        style="font-size: 11px;">

                                                        @simRow.PSRemarks

                                                    </td>
                                                }

                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>
                        }

                        <table class="report-table"
                               style="border-top: none;">

                            <tr>

                                <td colspan="2">
                                    Observations: OK.
                                </td>

                            </tr>

                            <tr style="background-color: #f1f1f1;">

                                <td style="width: 50%;">
                                    Calibration by:
                                </td>

                                <td style="width: 50%;">
                                    Engineer:
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Name: @cert.PerformedByName
                                </td>

                                <td>
                                    Name: @cert.WitnessedByName
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Designation: Technical Officer
                                </td>

                                <td>
                                    Designation: Maintenance Engineer
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Date:
                                    @(cert.ReportDate?.ToString("dd/MM/yyyy") ?? "")
                                </td>

                                <td>
                                    Date:
                                    @(cert.ReportDate?.ToString("dd/MM/yyyy") ?? "")
                                </td>

                            </tr>

                        </table>

                    </div>
                }
            }

        </div>

    </div>
}

