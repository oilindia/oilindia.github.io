@page "/PMrn"

@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Text.Json
@using Microsoft.JSInterop
@inject ISnackbar Snackbar
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JSRuntime

<style>
    /* Styling for the report appearance */
    .report-paper {
        background-color: white;
        color: black;
        font-family: 'Times New Roman', Times, serif;
        line-height: 1.4;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        color: black;
    }

        .report-table th, .report-table td {
            border: 1px solid black;
            padding: 4px 8px;
            text-align: left;
            font-size: 12px;
        }

    .header-field {
        border-bottom: 1px dotted black;
        display: inline-block;
        min-width: 200px;
    }

    /* Print logic to hide UI elements and focus on the report div */
    @@media print {
        body * {
            visibility: hidden;
        }

        #printable-report, #printable-report * {
            visibility: visible;
        }

        #printable-report {
            position: absolute;
            left: 0;
            top: 0;
            width: 210mm;
            border: none !important;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

<style>
    /* Styling to mimic the Word Document appearance */
    .report-paper {
        background-color: white;
        color: black;
        font-family: "Times New Roman", Times, serif;
        line-height: 1.2;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
    }

        .report-table th, .report-table td {
            border: 1px solid black !important;
            padding: 4px 8px;
            text-align: left;
            font-size: 12px;
        }

    .header-field {
        border-bottom: 1px dotted black;
        display: inline-block;
        min-width: 200px;
        padding-left: 5px;
    }

    /* Print Logic */
    @@media print {
        /* Specifically hide any MudBlazor overlays or scrollbars during print */
        .mud-overlay, .mud-dialog-container {
            display: none !important;
        }
        /* Hide everything by default */
        body * {
            display: none !important;
        }
        /* Show the report and all its children */
        /* #printable-report, #printable-report * {
            display: block !important;
        } */

        
        body * {
            visibility: hidden;
        }

        #printable-report, #printable-report * {
            visibility: visible;
        }

        #printable-report {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }
       

    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 no-print">
    <MudPaper Elevation="3" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">PM Completion Reports</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData">
                Refresh Data
            </MudButton>
        </MudStack>

        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="3">
                <MudDateRangePicker Label="Completion Date Range" @bind-DateRange="_dateRange" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_searchString" Label="Search Observations" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" OnClick="LoadData">Apply Filters</MudButton>
            </MudItem>
        </MudGrid>

        <MudDataGrid T="ReportView" Items="@_filteredReports" Loading="@_loading" Dense="true" Hover="true" Bordered="true">
            <Columns>
                <TemplateColumn Title="View" HeaderStyle="width: 50px;">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" OnClick="@(() => OpenViewModal(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CompletionDateLocal" Title="Date" />
                <PropertyColumn Property="x => x.LocationName" Title="Location" />
                <PropertyColumn Property="x => x.Observations" Title="General Observation" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@if (_isModalOpen)
{
    

    <div class="no-print" style="position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <MudPaper Style="width: 1000px; max-width: 98%; max-height: 95vh; padding: 20px; overflow-y: auto; margin-top: 20px; background-color: #f0f0f0;" Elevation="25">

            <!-- Header Actions -->
            <div class="d-flex justify-space-between align-center mb-6 no-print" style="position: sticky; top: 0; background: #f0f0f0; z-index: 10; padding: 10px 0;">
                <MudButton OnClick="PrintReport" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Size="Size.Large">
                    Print Report
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _isModalOpen = false" Color="Color.Error" Variant="Variant.Filled" />
            </div>

            <div id="printable-report" class="report-paper pa-10 mx-auto" style="width: 210mm; min-height: 297mm; border: 1px solid #ccc; padding: 40px;">

                <!-- Header Title -->
                <MudText Typo="Typo.h6" Align="Align.Center" Style="text-decoration: underline; font-weight: bold; text-transform: uppercase;">
                    Preventive Maintenance Checklist (OCS, EPS, QPS, WHS & FGGS)
                </MudText>

                <!-- Meta Data -->
                <div class="mt-6 mb-4" style="font-size: 14px;">
                    <p>Installation Name: <span class="header-field">@_viewingReport.LocationName</span> &nbsp;&nbsp;&nbsp;&nbsp; Date: <span class="header-field">@_viewingReport.CompletionDateLocal</span></p>
                    <p class="mt-2">Work Permit Number: <span class="header-field" style="width: 75%;">@_viewingReport.WorkPermit</span></p>
                    <p class="mt-2">Job Assigned To: <span class="header-field" style="width: 75%;">@_viewingReport.AssignedTo</span></p>
                </div>

                <!-- Section A: Controllers -->
                <MudText Typo="Typo.body1" Class="mt-6"><b>(A) Functionality Testing / Calibration / Replaced with pre calibrated controller</b></MudText>

                @foreach (var cat in new[] { "Pressure Controller", "Temperature Controller", "Level Controller" })
                {
                    <p class="mt-4 mb-1"><b>@cat</b></p>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">Sl.NO</th>
                                <th>Unit</th>
                                <th>Make</th>
                                <th>Model</th>
                                <th>Range</th>
                                <th>Set point of controller</th>
                                <th>PSV Setting of Vessel</th>
                                <th>Calibration Status</th>
                                <th>p-band, I-band</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Static rows as per document requirement - displaying up to 10 slots or data *@
                            @for (int i = 1; i <= 5; i++)
                            {
                                var row = _viewingRows.FirstOrDefault(r => r.Category == cat && r.SlNo == i.ToString());
                                <tr>
                                    <td>@i</td>
                                    <td>@(row?.Unit ?? "")</td>
                                    <td>@(row?.Make ?? "")</td>
                                    <td>@(row?.Model ?? "")</td>
                                    <td>@(row?.Range ?? "")</td>
                                    <td>@(row?.SetPoint ?? "")</td>
                                    <td>@(row?.PsvSetting ?? "")</td>
                                    <td>@(row?.CalibrationStatus ?? "")</td>
                                    <td>@(row?.Bands ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <!-- Section B: Transmitters & Gauges -->
                @foreach (var cat in new[] { "Pressure Transmitter", "Temperature Transmitter", "Level Transmitter", "Pressure Gauge", "Temperature Gauge" })
                {
                    <p class="mt-4 mb-1"><b>@cat</b></p>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">Sl.NO</th>
                                <th>Unit</th>
                                <th>Make</th>
                                <th>Model</th>
                                <th>Range</th>
                                <th>Calibrated / Replaced with pre calibrated Tx</th>
                                <th>Equipment used for Calibration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 1; i <= 3; i++)
                            {
                                var row = _viewingRows.FirstOrDefault(r => r.Category == cat && r.SlNo == i.ToString());
                                <tr>
                                    <td>@i</td>
                                    <td>@(row?.Unit ?? "")</td>
                                    <td>@(row?.Make ?? "")</td>
                                    <td>@(row?.Model ?? "")</td>
                                    <td>@(row?.Range ?? "")</td>
                                    <td>@(row?.CalibrationStatus ?? "")</td>
                                    <td>@(row?.EquipmentUsed ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <!-- Section C: Other Checkpoints -->
                <MudText Typo="Typo.body1" Class="mt-6"><b>(C) Other Check Points</b></MudText>
                <table class="report-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">Sl.No</th>
                            <th>Checking Point</th>
                            <th style="width: 80px;">Yes/No</th>
                            <th>Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var checkPoints = new[] {
                            "Whether Air Filter regulators drained?",
                            "Whether Pressure Gauges & Temperature Gauges are working properly?",
                            "Whether Functionality of Burner Management System / Remote ignition system of fired vessels checked?",
                            "Whether Functionality of Data acquisition panel / SRV Panel checked?",
                            "Whether Level Transmitters cone cleaning done?",
                            "Whether visual Inspection of cables, glands, junction box and cable trays carried out?",
                            "Whether Instrument air tube deformation or leakage found any?",
                            "Whether instrument label / tags readable?",
                            "Whether any interlocks bypassed?",
                            "Whether any static / on-line Gas Detector found faulty?",
                            "Whether proper PPE used and tool-box talk conducted?"
                        };
                        }
                        @for (int i = 0; i < checkPoints.Length; i++)
                        {
                            var cpVal = _viewingCheckpoints.ElementAtOrDefault(i);
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@checkPoints[i]</td>
                                <td>@(cpVal?.Value ?? "")</td>
                                <td>@(cpVal?.Comment ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Section D: Spares -->
                <MudText Typo="Typo.body1" Class="mt-6"><b>(D) Spares Consumed List (if any)</b></MudText>
                <table class="report-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">Sl. No</th>
                            <th>Instrument</th>
                            <th>Tag No</th>
                            <th>Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 1; i <= 5; i++)
                        {
                            var spare = _viewingSpares.ElementAtOrDefault(i - 1);
                            <tr>
                                <td>@i</td>
                                <td>@(spare?.Instrument ?? "")</td>
                                <td>@(spare?.TagNo ?? "")</td>
                                <td>@(spare?.Unit ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Observations -->
                <div class="mt-4">
                    <p><b>Any other observations:</b></p>
                    <div style="border-bottom: 1px solid black; min-height: 60px; line-height: 25px;">
                        @_viewingReport.Observations
                    </div>
                </div>

                <!-- Signatures -->
                <div class="mt-12">
                    <table style="width: 100%; border: none;">
                        <tr style="border: none;">
                            <td style="border: none; width: 40%; vertical-align: top;">
                                <p><b>Job Completed By</b></p>
                                <p style="margin-top: 40px;">Designations & Signatures:</p>
                            </td>
                            <td style="border: none; width: 30%; text-align: center; vertical-align: bottom;">
                                <div style="border-top: 1px solid black; width: 90%; margin: 0 auto; padding-top: 5px;">Signature (Checked By)</div>
                            </td>
                            <td style="border: none; width: 30%; text-align: center; vertical-align: bottom;">
                                <div style="border-top: 1px solid black; width: 90%; margin: 0 auto; padding-top: 5px;">Signature (Approved By)</div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </MudPaper>
    </div>

}






@code {
    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("window.print");

    // --- DB MODELS ---
    [Table("pm_reports")]
    public class PmReport : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("observations")] public string Observations { get; set; } = "";
        [Column("checklist_data")] public string ChecklistJson { get; set; } = "";
        [Column("completion_date")] public DateTime CompletionDate { get; set; }
        [Column("work_permit")] public string? WorkPermit { get; set; }
        [Column("assigned_to")] public string? AssignedTo { get; set; }
    }

    [Table("locations")]
    public class Location : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("installation_name")] public string? InstallationName { get; set; }
    }

    public class ReportView : PmReport
    {
        public string LocationName { get; set; } = "N/A";
        public string CompletionDateLocal => CompletionDate.ToLocalTime().ToString("yyyy-MM-dd");
    }

    // --- JSON MODELS ---
    public class PmJsonContainer
    {
        public List<ChecklistRow> Rows { get; set; } = new();
        public List<OtherCheckpoint> Checkpoints { get; set; } = new();
        public List<SpareItem> Spares { get; set; } = new();
    }

    public class ChecklistRow
    {
        public string Category { get; set; } = "";
        public string SlNo { get; set; } = "";
        public string Unit { get; set; } = "";
        public string Make { get; set; } = "";
        public string Model { get; set; } = "";
        public string Range { get; set; } = "";
        public string SetPoint { get; set; } = "";
        public string PsvSetting { get; set; } = "";
        public string CalibrationStatus { get; set; } = "";
        public string Bands { get; set; } = "";
        public string EquipmentUsed { get; set; } = "";
    }

    public class OtherCheckpoint
    {
        public string SlNo { get; set; } = "";
        public string CheckingPoint { get; set; } = "";
        public string Value { get; set; } = "";
        public string Comment { get; set; } = "";
    }

    public class SpareItem
    {
        public string SlNo { get; set; } = "";
        public string Instrument { get; set; } = "";
        public string TagNo { get; set; } = "";
        public string Unit { get; set; } = "";
    }

    // --- STATE ---
    private List<ReportView> _reports = new();
    private List<ReportView> _filteredReports => _reports
        .Where(r => string.IsNullOrWhiteSpace(_searchString) || r.Observations.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
        .Where(r => !_selectedLocationId.HasValue || r.LocationId == _selectedLocationId)
        .ToList();

    private List<Location> _locations = new();
    private ReportView _viewingReport = new();
    private List<ChecklistRow> _viewingRows = new();
    private List<OtherCheckpoint> _viewingCheckpoints = new();
    private List<SpareItem> _viewingSpares = new();

    private bool _loading = true;
    private bool _isModalOpen = false;
    private string _searchString = "";
    private DateRange _dateRange = new DateRange(DateTime.Now.AddMonths(-1), DateTime.Now);
    private long? _selectedLocationId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            var locRes = await SupabaseClient.From<Location>().Get();
            _locations = locRes.Models;

            var start = _dateRange.Start ?? DateTime.Now.AddMonths(-1);
            var end = _dateRange.End ?? DateTime.Now;

            var res = await SupabaseClient.From<PmReport>()
                            .Where(x => x.CompletionDate >= start && x.CompletionDate <= end)
                            .Get();

            _reports = res.Models.Select(r => new ReportView
            {
                Id = r.Id,
                LocationId = r.LocationId,
                Observations = r.Observations,
                ChecklistJson = r.ChecklistJson,
                CompletionDate = r.CompletionDate,
                WorkPermit = r.WorkPermit,
                AssignedTo = r.AssignedTo,
                LocationName = _locations.FirstOrDefault(l => l.Id == r.LocationId)?.InstallationName ?? "Unknown"
            }).OrderByDescending(x => x.CompletionDate).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void OpenViewModal(ReportView report)
    {
        _viewingReport = report;
        if (!string.IsNullOrEmpty(report.ChecklistJson))
        {
            try
            {
                var data = JsonSerializer.Deserialize<PmJsonContainer>(report.ChecklistJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                _viewingRows = data?.Rows ?? new();
                _viewingCheckpoints = data?.Checkpoints ?? new();
                _viewingSpares = data?.Spares ?? new();
            }
            catch { }
        }
        _isModalOpen = true;
    }
}