@page "/PMrn"

@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Text.Json
@using Microsoft.JSInterop
@inject ISnackbar Snackbar
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JSRuntime
@using System.Text.Json.Serialization


<style>
    .job-done-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: -1px; /* Overlap with previous table border */
        font-size: 11px; /* Slightly smaller to fit landscape data */
    }

        .job-done-table th, .job-done-table td {
            border: 1px solid #000;
            padding: 4px;
            vertical-align: top;
            word-wrap: break-word;
        }

        .job-done-table th {
            background-color: #f9f9f9;
            font-weight: normal;
            text-align: left;
        }

    .bold-vertical {
        font-weight: bold;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        white-space: nowrap;
        background-color: #fff !important;
    }

    /* Ensure the cells don't collapse too much in landscape */
    .job-done-table td {
        height: 40px;
    }

    .text-center {
        text-align: center;
    }


    .report-body-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        table-layout: fixed;
        border: 1px solid #000;
    }

        .report-body-table td {
            border: 1px solid #000;
            padding: 6px 8px;
            vertical-align: middle;
        }

    .inner-list-table {
        width: 100%;
        border-collapse: collapse;
    }

        .inner-list-table td {
            border: none;
            border-bottom: 1px solid #000;
            padding: 4px 8px;
        }

        .inner-list-table tr:last-child td {
            border-bottom: none;
        }

    .no-padding {
        padding: 0 !important;
    }

    .text-right {
        text-align: right;
    }

    .font-bold {
        font-weight: bold;
    }

    /* Adjustments for the specific layout flow */
    .report-body-table tr td {
        height: 30px;
    }

    /* --- Base UI Styles --- */
    .modal-overlay {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        display: flex;
        flex-direction: column;
        align-items: center;
        backdrop-filter: blur(4px);
        overflow-y: auto;
        padding-bottom: 50px;
    }

    /* --- Report Container Styles --- */
    .landscape-report {
        width: 297mm;
        min-height: 210mm;
        background: white;
        color: black;
        padding: 10mm;
        margin: 20px auto;
        font-family: 'Times New Roman', serif;
    }

    .portrait-report {
        width: 210mm;
        min-height: 297mm;
        background: white;
        color: black;
        padding: 10mm;
        margin: 20px auto;
        font-family: 'Times New Roman', serif;
    }

    /* --- Table Formatting --- */
    .oil-header-table {
        width: 100%;
        border: 1px solid black;
        border-bottom: none;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        color: black;
    }

        .report-table th, .report-table td {
            border: 1px solid black !important;
            padding: 5px;
            text-align: center;
            font-size: 11px;
            word-wrap: break-word;
        }

    /* --- Print Logic --- */
    @@media print {
        .no-print {
            display: none !important;
        }

        body * {
            visibility: hidden;
        }

        #printable-area, #printable-area * {
            visibility: visible;
        }

        #printable-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        /* Orientation Logic */
        .print-landscape {
            size: A4 landscape;
        }

        .print-portrait {
            size: A4 portrait;
        }

        .page-break {
            page-break-after: always;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 no-print">
    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">PM Completion Reports</MudText>
        <MudDataGrid T="ReportView" Items="@_reports" Loading="@_loading" Dense="true" Bordered="true">
            <Columns>
                <TemplateColumn Title="View" HeaderStyle="width: 50px;">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info"
                                       OnClick="@(() => HandleViewClick(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CompletionDateLocal" Title="Date" />
                <PropertyColumn Property="x => x.LocationName" Title="Installation" />
                <PropertyColumn Property="x => x.WorkPermit" Title="Permit #" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@* ========================== GCS SUMMARY MODAL (Landscape) ========================== *@
@if (_isGcsModalOpen)
{
    <div class="modal-overlay">
        <div class="no-print pa-4 sticky-top d-flex justify-center bg-dark" style="width: 100%; gap: 10px;">
