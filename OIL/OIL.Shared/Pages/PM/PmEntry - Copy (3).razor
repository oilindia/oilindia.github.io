    private GcsInstrumentRow? _gcsactiveRowRef;
    private OcsInstrumentRow? _activeRowRef;
    private ResultEntry? _activeResult; // This will now point to the row's data


    private async Task gcsOpenCalibration(GcsInstrumentRow row)
    {
        try
        {
            _gcsactiveRowRef = row;

            // =========================
            // Generate Certificate No
            // =========================
            if (string.IsNullOrWhiteSpace(row.CertNo))
            {
                var response = await SupabaseClient
                    .From<CalibrationDetail>()
                    .Count(Supabase.Postgrest.Constants.CountType.Exact);

                int nextId = (int)response + 1;

                string safeTag = string.IsNullOrWhiteSpace(row.TagNumber)
                    ? "GEN"
                    : row.TagNumber.Replace("/", "-");

                row.CertNo = $"INST/{safeTag}/{nextId}";
            }

            // =========================
            // Initialize CalibrationData
            // =========================
            if (row.CalibrationData == null)
            {
                row.CalibrationData = new ResultEntry
                {
                    RECertificateNo = row.CertNo,

                    // Auto-filled values
                    REUnit = row.Unit,
                    REInstallation = row.Unit,

                    RERange = row.Range,

                    REInstrumentType = row.Instrument,

                    // Auto-fill model
                    REModel = !string.IsNullOrWhiteSpace(row.ManualMakeModel)
                        ? row.ManualMakeModel
                        : row.MakeModel,

                    // Default remarks
                    RERemarks = "Calibration completed successfully."
                };
            }

            _activeResult = row.CalibrationData;

            // =========================
            // Keep values synced
            // =========================
            _activeResult.RECertificateNo = row.CertNo;

            _activeResult.REUnit = row.Unit;
            _activeResult.REInstallation = row.Unit;

            _activeResult.RERange = row.Range;

            _activeResult.REInstrumentType = row.Instrument;

            _activeResult.REModel = !string.IsNullOrWhiteSpace(row.ManualMakeModel)
                ? row.ManualMakeModel
                : row.MakeModel;

            // =========================
            // Initialize Calibration Type
            // =========================
            if (_activeResult.RECalibration == null)
            {
                string instrumentName = row.Instrument?.ToLower() ?? "";

                if (instrumentName.Contains("controller"))
                {
                    _activeResult.RECalibration = new ControllerInstrumentData
                    {
                        MasterCalibrator = "Druck DPI 610"
                    };
                }
                else if (instrumentName.Contains("transmitter"))
                {
                    _activeResult.RECalibration = new BaseInstrumentData
                    {
                        MasterCalibrator = "Druck DPI 610"
                    };
                }
                else
                {
                    _activeResult.RECalibration = new BaseInstrumentData
                    {
                        MasterCalibrator = "FLUKE (718Ex 300G)"
                    };
                }
            }

            // =========================
            // Sync Master Calibrator
            // =========================
            if (_activeResult.RECalibration is BaseInstrumentData baseData)
            {
                _activeResult.REMasterCalibrator = baseData.MasterCalibrator;
            }

            if (_activeResult.RECalibration is ControllerInstrumentData controllerData)
            {
                _activeResult.REMasterCalibrator = controllerData.MasterCalibrator;
            }

            // =========================
            // Show Modal
            // =========================
            _isCalibrationVisible = true;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error opening GCS calibration: {ex.Message}", Severity.Error);
        }
    }


    private async Task OpenCalibration(OcsInstrumentRow row)
    {
        try
        {
            _activeRowRef = row;

            // 1. Generate Cert Number
            if (string.IsNullOrWhiteSpace(row.CertNo))
            {
                var response = await SupabaseClient
                    .From<CalibrationDetail>()
                    .Count(Supabase.Postgrest.Constants.CountType.Exact);

                int nextId = (int)response + 1;

                row.CertNo = $"INST/{row.TagNumber}/{nextId}";
            }

            // 2. Initialize Calibration Result
            if (row.CalibrationData == null)
            {
                row.CalibrationData = new ResultEntry
                {
                    RECertificateNo = row.CertNo,

                    // AUTO FILLED VALUES
                    REUnit = row.Unit,
                    REInstallation = row.Unit,

                    REInstrumentType =
                        !string.IsNullOrWhiteSpace(row.Instrument)
                            ? row.Instrument
                            : row.ManualInstrument,

                    REModel =
                        !string.IsNullOrWhiteSpace(row.MakeModel)
                            ? row.MakeModel
                            : row.ManualMakeModel,

                    RERange =
                        !string.IsNullOrWhiteSpace(row.Range)
                            ? row.Range
                            : row.ManualRange

                    // RETagNo =
                    //     !string.IsNullOrWhiteSpace(row.TagNumber)
                    //         ? row.TagNumber
                    //         : row.ManualTag
                };
            }

            _activeResult = row.CalibrationData;

            // 3. Safety Refill (for old rows already saved previously)
            _activeResult.REInstallation ??=
                row.Unit ?? row.ManualUnit;

            _activeResult.REModel ??=
                row.MakeModel ?? row.ManualMakeModel;

            _activeResult.RERange ??=
                row.Range ?? row.ManualRange;

            _activeResult.REInstrumentType ??=
                row.Instrument ?? row.ManualInstrument;

            // _activeResult.RETagNo ??=
            //     row.TagNumber ?? row.ManualTag;

            // 4. Polymorphic Calibration Initialization
            if (_activeResult.RECalibration == null)
            {
                string name =
                    (_activeResult.REInstrumentType ?? "")
                    .ToLower();

                if (name.Contains("controller"))
                {
                    _activeResult.RECalibration =
                        new ControllerInstrumentData
                        {
                            MasterCalibrator = "Druck DPI 610"
                        };
                }
                else if (name.Contains("transmitter"))
                {
                    _activeResult.RECalibration =
                        new BaseInstrumentData
                        {
                            MasterCalibrator = "Druck DPI 610"
                        };
                }
                else
                {
                    _activeResult.RECalibration =
                        new BaseInstrumentData
                        {
                            MasterCalibrator = "FLUKE (718Ex 300G)"
                        };
                }
            }

            // OPTIONAL:
            // sync textbox with calibration object
            // _activeResult.REMasterCalibrator =
            //     _activeResult.RECalibration?.MasterCalibrator;

            _isCalibrationVisible = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }


