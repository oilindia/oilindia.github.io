    private RenderFragment RenderControllerSimulation(ControllerInstrumentData data) => __builder =>
    {
        <div class="simulation-section mt-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Process Requirement & Parameters</b></MudText>
            <MudGrid Class="mb-2">
                <MudItem xs="6"><MudTextField Label="Set Point" @bind-Value="data.SetPoint" Variant="Variant.Outlined" AdornmentText="kg/cm2" /></MudItem>
                <MudItem xs="6"><MudTextField Label="Actuator Action" @bind-Value="data.ActuatorAction" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>

            <table class="report-entry-table mt-2">
                <thead>
                    <tr>
                        <th>Process Simulation (Kg/cm2)</th>
                        <th>Output Pressure (psi)</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sim in data.SimulationTable)
                    {
                        <tr>
                            <td><input @bind="sim.ProcessInput" @bind:event="oninput" /></td>
                            <td><input @bind="sim.OutputPressure" @bind:event="oninput" /></td>
                            <td><input @bind="sim.PSRemarks" @bind:event="oninput" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };


