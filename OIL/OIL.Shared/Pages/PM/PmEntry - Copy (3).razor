                //     // Use Resolution.IgnoreDuplicates for ON CONFLICT DO NOTHING behavior
                //     Resolution = Resolution.IgnoreDuplicates
                // };

                try
                {
                    // Use Upsert with the Ignore resolution
                    // Attempt to insert the detail
                    await SupabaseClient.From<CalibrationDetail>().Insert(detail);
                    Snackbar.Add($"Report and Certificates Saved Successfully: {detail.CertNo}", Severity.Success);
                }
                catch (Exception ex) when (ex.Message.Contains("23505"))
                {
                    Snackbar.Add($"Save Error: {ex.Message}", Severity.Error);
