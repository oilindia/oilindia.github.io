    @* Selects the view based on the specific type of calibration data *@
    private RenderFragment RenderCalibrationContent() => __builder =>
    {
        if (_activeResult?.RECalibration is ControllerInstrumentData ctrl)
        {
            @RenderControllerTable(ctrl)
            @RenderControllerSimulation(ctrl)
        }
        else if (_activeRowRef?.Instrument?.Contains("Transmitter") ?? false)
        {
            @RenderTransmitterTable(_activeResult?.RECalibration as BaseInstrumentData)
        }
        else // Default Gauge View
        {
            @RenderStandardTable(_activeResult?.RECalibration as BaseInstrumentData)
        }
    };

    private RenderFragment RenderTransmitterTable(BaseInstrumentData? data) => __builder =>
    {
        if (data == null) return;
        <table class="report-entry-table">
            <thead><tr><th>Input (mA)</th><th>Expected (PSI)</th><th>Actual (PSI)</th><th>Error %</th></tr></thead>
            <tbody>
                @foreach (var row in data.CalibrationTable)
                {
                    <tr>
                        <td><input @bind="row.InputValue" /></td>
                        <td><input @bind="row.ExpectedOutput" /></td>
                        <td><input @bind="row.ActualOutput" class="highlight-input" /></td>
                        <td><input @bind="row.Error" /></td>
                    </tr>
                }
            </tbody>
        </table>
    };








