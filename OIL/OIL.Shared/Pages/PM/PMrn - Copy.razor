@if (_isModalOpen)
{
@* The outer overlay *@
    <div class="print-container-visible" style="position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        
        @* The inner container (the 'Paper' look) *@
        <div class="print-content-visible" style="width: 1000px; max-width: 98%; max-height: 95vh; padding: 20px; overflow-y: auto; background-color: #f0f0f0; border-radius: 4px;">

            <div class="d-flex justify-space-between align-center mb-6 no-print" style="position: sticky; top: 0; background: #f0f0f0; z-index: 10; padding: 10px 0;">
                <MudButton OnClick="PrintReport" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Size="Size.Large">
                    Print Report
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _isModalOpen = false" Color="Color.Error" Variant="Variant.Filled" />
            </div>

            <div id="printable-report" class="report-paper pa-10 mx-auto" style="width: 210mm; min-height: 297mm; border: 1px solid #ccc;">

                <MudText Typo="Typo.h6" Align="Align.Center" Style="text-decoration: underline; font-weight: bold; text-transform: uppercase;">
                    Preventive Maintenance Checklist (OCS, EPS, QPS, WHS & FGGS)
                </MudText>

                <div class="mt-6 mb-4" style="font-size: 14px;">
                    <p>Installation Name: <span class="header-field">@_viewingReport.LocationName</span> &nbsp;&nbsp;&nbsp;&nbsp; Date: <span class="header-field">@_viewingReport.CompletionDateLocal</span></p>
                    <p class="mt-2">Work Permit Number: <span class="header-field" style="width: 75%;">@_viewingReport.WorkPermit</span></p>
                    <p class="mt-2">Job Assigned To: <span class="header-field" style="width: 75%;">@_viewingReport.AssignedTo</span></p>
                </div>

                <MudText Typo="Typo.body1" Class="mt-6"><b>(A) Functionality Testing / Calibration / Replaced with pre calibrated controller</b></MudText>
                @foreach (var cat in new[] { "Pressure Controller", "Temperature Controller", "Level Controller" })
                {
                    <p class="mt-4 mb-1"><b>@cat</b></p>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">Sl.NO</th>
                                <th>Unit</th>
                                <th>Make</th>
                                <th>Model</th>
                                <th>Range</th>
                                <th>Set point</th>
                                <th>PSV Setting</th>
                                <th>Status</th>
                                <th>Bands</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 1; i <= 5; i++)
                            {
                                var row = _viewingRows.FirstOrDefault(r => r.Category == cat && r.SlNo == i.ToString());
                                <tr>
                                    <td>@i</td>
                                    <td>@(row?.Unit ?? "")</td>
                                    <td>@(row?.Make ?? "")</td>
                                    <td>@(row?.Model ?? "")</td>
                                    <td>@(row?.Range ?? "")</td>
                                    <td>@(row?.SetPoint ?? "")</td>
                                    <td>@(row?.PsvSetting ?? "")</td>
                                    <td>@(row?.CalibrationStatus ?? "")</td>
                                    <td>@(row?.Bands ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <MudText Typo="Typo.body1" Class="mt-6"><b>(B) Transmitters & Gauges</b></MudText>
                @foreach (var cat in new[] { "Pressure Transmitter", "Temperature Transmitter", "Level Transmitter", "Pressure Gauge", "Temperature Gauge" })
                {
                    <p class="mt-4 mb-1"><b>@cat</b></p>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">Sl.NO</th>
                                <th>Unit</th>
                                <th>Make</th>
                                <th>Model</th>
                                <th>Range</th>
                                <th>Status</th>
                                <th>Equipment Used</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 1; i <= 3; i++)
                            {
                                var row = _viewingRows.FirstOrDefault(r => r.Category == cat && r.SlNo == i.ToString());
                                <tr>
                                    <td>@i</td>
                                    <td>@(row?.Unit ?? "")</td>
                                    <td>@(row?.Make ?? "")</td>
                                    <td>@(row?.Model ?? "")</td>
                                    <td>@(row?.Range ?? "")</td>
                                    <td>@(row?.CalibrationStatus ?? "")</td>
                                    <td>@(row?.EquipmentUsed ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <MudText Typo="Typo.body1" Class="mt-6"><b>(C) Other Check Points</b></MudText>
                <table class="report-table">
                    <thead>
                        <tr><th style="width: 40px;">Sl.No</th><th>Checking Point</th><th style="width: 80px;">Yes/No</th><th>Comment</th></tr>
                    </thead>
                    <tbody>
                        @{
                            var checkPoints = new[] {
                            "Whether Air Filter regulators drained?",
                            "Whether Pressure Gauges & Temperature Gauges are working properly?",
                            "Whether Functionality of Burner Management System / Remote ignition system of fired vessels checked?",
                            "Whether Functionality of Data acquisition panel / SRV Panel checked?",
                            "Whether Level Transmitters cone cleaning done?",
                            "Whether visual Inspection of cables, glands, junction box and cable trays carried out?",
                            "Whether Instrument air tube deformation or leakage found any?",
                            "Whether instrument label / tags readable?",
                            "Whether any interlocks bypassed?",
                            "Whether any static / on-line Gas Detector found faulty?",
                            "Whether proper PPE used and tool-box talk conducted?"
                        };
                        }
                        @for (int i = 0; i < checkPoints.Length; i++)
                        {
                            var cpVal = _viewingCheckpoints.FirstOrDefault(x => x.CheckingPoint.Contains(checkPoints[i].Substring(0, 15)));
                            <tr><td>@(i + 1)</td><td>@checkPoints[i]</td><td>@(cpVal?.Value ?? "")</td><td>@(cpVal?.Comment ?? "")</td></tr>
                        }
                    </tbody>
                </table>

                <MudText Typo="Typo.body1" Class="mt-6"><b>(D) Spares Consumed List</b></MudText>
                <table class="report-table">
                    <thead><tr><th style="width: 40px;">Sl. No</th><th>Instrument</th><th>Tag No</th><th>Unit</th></tr></thead>
                    <tbody>
                        @for (int i = 1; i <= 5; i++)
                        {
                            var spare = _viewingSpares.ElementAtOrDefault(i - 1);
                            <tr><td>@i</td><td>@(spare?.Instrument ?? "")</td><td>@(spare?.TagNo ?? "")</td><td>@(spare?.Unit ?? "")</td></tr>
                        }
                    </tbody>
                </table>

                <div class="mt-4">
                    <p><b>Any other observations:</b></p>
                    <div style="border-bottom: 1px solid black; min-height: 60px;">@_viewingReport.Observations</div>
                </div>

                <div class="mt-12">
                    <table style="width: 100%; border: none;">
                        <tr style="border: none;">
                            <td style="border: none; width: 40%;"><p><b>Job Completed By</b></p><p style="margin-top: 40px;">Signatures:</p></td>
                            <td style="border: none; width: 30%; text-align: center; vertical-align: bottom;"><div style="border-top: 1px solid black; padding-top: 5px;">Checked By</div></td>
                            <td style="border: none; width: 30%; text-align: center; vertical-align: bottom;"><div style="border-top: 1px solid black; padding-top: 5px;">Approved By</div></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ReportView> _reports = new();
    private List<Location> _locations = new();
    private ReportView _viewingReport = new();
    private List<ChecklistRow> _viewingRows = new();
    private List<OtherCheckpoint> _viewingCheckpoints = new();
    private List<SpareItem> _viewingSpares = new();

    private bool _loading = true;
    private bool _isModalOpen = false;
    private DateRange _dateRange = new DateRange(DateTime.Now.AddMonths(-1), DateTime.Now);

    [Table("pm_reports")]
    public class PmReport : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("observations")] public string Observations { get; set; } = "";
        [Column("work_permit")] public string? WorkPermit { get; set; }
        [Column("assigned_to")] public string? AssignedTo { get; set; }
        [Column("completion_date")] public DateTime CompletionDate { get; set; }

        /* FIX: Columns changed to 'object' to prevent fetch-time parsing errors */
        [Column("checklist_data")] public object? ChecklistData { get; set; }
        [Column("section_a_controllers")] public object? SectionA { get; set; }
        [Column("section_b_transmitters")] public object? SectionB { get; set; }
        [Column("section_d_spares")] public object? SectionD { get; set; }
    }

    [Table("locations")]
    public class Location : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("installation_name")] public string? InstallationName { get; set; }
    }

    public class ReportView : PmReport
    {
        public string LocationName { get; set; } = "N/A";
        public string CompletionDateLocal => CompletionDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm");
    }

    public class ChecklistRow
    {
        public string Category { get; set; } = ""; public string SlNo { get; set; } = "";
        public string Unit { get; set; } = ""; public string Make { get; set; } = "";
        public string Model { get; set; } = ""; public string Range { get; set; } = "";
        public string SetPoint { get; set; } = ""; public string PsvSetting { get; set; } = "";
        public string CalibrationStatus { get; set; } = ""; public string Bands { get; set; } = "";
        public string EquipmentUsed { get; set; } = "";
    }

    public class OtherCheckpoint { public string CheckingPoint { get; set; } = ""; public string Value { get; set; } = ""; public string Comment { get; set; } = ""; }
    public class SpareItem { public string Instrument { get; set; } = ""; public string TagNo { get; set; } = ""; public string Unit { get; set; } = ""; }
    public class RawCheckpoint { public string Task { get; set; } = ""; public bool Done { get; set; } public string Notes { get; set; } = ""; }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            string start = (_dateRange.Start ?? DateTime.Now.AddMonths(-1)).ToString("yyyy-MM-ddTHH:mm:ssZ");
            string end = (_dateRange.End ?? DateTime.Now).ToString("yyyy-MM-ddTHH:mm:ssZ");

            var locRes = await SupabaseClient.From<Location>().Get();
            _locations = locRes.Models;

            var res = await SupabaseClient.From<PmReport>()
                .Filter("completion_date", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, start)
                .Filter("completion_date", Supabase.Postgrest.Constants.Operator.LessThanOrEqual, end)
                .Get();

            _reports = res.Models.Select(r => new ReportView
            {
                Id = r.Id,
                LocationId = r.LocationId,
                Observations = r.Observations,
                WorkPermit = r.WorkPermit,
                AssignedTo = r.AssignedTo,
                CompletionDate = r.CompletionDate,
                ChecklistData = r.ChecklistData,
                SectionA = r.SectionA,
                SectionB = r.SectionB,
                SectionD = r.SectionD,
                LocationName = _locations.FirstOrDefault(l => l.Id == r.LocationId)?.InstallationName ?? "Unknown"
            }).OrderByDescending(x => x.CompletionDate).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void OpenViewModal(ReportView report)
    {
        _viewingReport = report;
        _viewingRows = new();
        _viewingCheckpoints = new();
        _viewingSpares = new();

        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        /* FIX: Robust cleaning of the object types from Supabase */
        string GetRawJson(object? input)
        {
            if (input == null) return "[]";
            if (input is JsonElement element)
            {
                string raw = element.GetRawText();
                if (raw.StartsWith("\""))
                {
                    try { return JsonSerializer.Deserialize<string>(raw) ?? "[]"; } catch { return raw; }
                }
                return raw;
            }
            return input.ToString() ?? "[]";
        }

        try
        {
            string cleanA = GetRawJson(report.SectionA);
            _viewingRows.AddRange(JsonSerializer.Deserialize<List<ChecklistRow>>(cleanA, options) ?? new());

            string cleanB = GetRawJson(report.SectionB);
            _viewingRows.AddRange(JsonSerializer.Deserialize<List<ChecklistRow>>(cleanB, options) ?? new());

            string cleanD = GetRawJson(report.SectionD);
            _viewingSpares = JsonSerializer.Deserialize<List<SpareItem>>(cleanD, options) ?? new();

            string cleanC = GetRawJson(report.ChecklistData);
            var cRaw = JsonSerializer.Deserialize<List<RawCheckpoint>>(cleanC, options) ?? new();
            _viewingCheckpoints = cRaw.Select(x => new OtherCheckpoint
            {
                CheckingPoint = x.Task,
                Value = x.Done ? "Yes" : "No",
                Comment = x.Notes
            }).ToList();
        }
        catch (Exception ex) { Snackbar.Add("Mapping Error: " + ex.Message, Severity.Warning); }

        _isModalOpen = true;
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("window.print");
}