    // 2. Change GetJobName to be a purely synchronous memory lookup
    private (string JobName, string JobDescription) GetJobName(Guid id)
    {
        if (_jobDictionary.TryGetValue(id.ToString(), out var details))
        {
            return details; // Returns the (Name, Description) tuple from your dictionary
        }
        return ("", "");
    }


    private string GetJobLocationName(Guid id)
    {
        if (_dbJobs == null || _dbLocations == null) return "Loading Data...";

        // Use string matching for Guid safety across layers
        var job = _dbJobs.FirstOrDefault(x => x.Id.ToString() == id.ToString());
        if (job == null) return "Job Not Found";

        var location = _dbLocations.FirstOrDefault(x => x.Id == job.JobLocationId);
        return location?.InstallationName ?? "No Location Assigned";
    }

    private string GetJobDetailDesc(Guid id)
    {
        if (_dbJobs == null) return "";
        return _dbJobs.FirstOrDefault(x => x.Id.ToString() == id.ToString())?.JobDescription ?? "";
    }

