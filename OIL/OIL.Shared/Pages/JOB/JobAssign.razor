@page "/jobassign"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Models
@using Supabase.Postgrest.Attributes
@using Newtonsoft.Json
@using System.Globalization
@using System.Runtime.Serialization

@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IJSRuntime JSRuntime
@inject OIL.Shared.Services.AttendanceService AttendanceData
@using MemberType = OIL.Shared.Pages.JOB.JobAssign.Member

@using Supabase.Postgrest.Attributes;
@using Supabase.Postgrest.Models;
@using System.Runtime.Serialization;

@using System.IO
@inject Client SupabaseClient
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject IDialogService DialogService
@using System.Security.Claims
@using OIL.Shared.Services


<style>

    /* =========================================================
               GLOBAL PAGE
            ========================================================= */
    html, body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        overflow-x: hidden;
        font-family: Roboto, Arial, sans-serif;
    }

    /* =========================================================
               MAIN GRID CONTAINER
            ========================================================= */
    .grid-scroll-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        position: relative;
    }

        .grid-scroll-container::-webkit-scrollbar {
            height: 10px;
        }

        .grid-scroll-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

        .grid-scroll-container::-webkit-scrollbar-track {
            background: #f0f0f0;
        }

    /* =========================================================
               TABLE
            ========================================================= */
    .mud-table-root {
        background: white !important;
    }

    .mud-table-container {
        overflow: visible !important;
    }

    .mud-table {
        min-width: max-content;
        border-collapse: collapse !important;
        table-layout: fixed;
    }

    .mud-table-head {
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .mud-table-cell {
        padding: 4px !important;
        font-size: 0.74rem !important;
        text-align: center !important;
        border: 1px solid #ececec !important;
        white-space: nowrap;
        vertical-align: middle !important;
        background: white;
    }

    .mud-table-row:hover .mud-table-cell {
        background: #fafafa !important;
    }

    /* =========================================================
               HEADER CELLS
            ========================================================= */
    .header-cell {
        min-width: 52px;
        background: #f5f7fa !important;
        font-weight: 700 !important;
        border-bottom: 2px solid #594ae2 !important;
        color: #222;
        position: sticky;
        top: 0;
        z-index: 15;
        line-height: 1.2;
    }

        .header-cell small {
            font-size: 0.62rem;
            font-weight: 500;
            color: #666;
        }

    /* =========================================================
               STICKY FIRST COLUMN
            ========================================================= */
    .sticky-col {
        position: sticky;
        left: 0;
        z-index: 16;
        background: #f9f9f9 !important;
        min-width: 140px;
        max-width: 140px;
        width: 140px;
        font-weight: 700;
        border-right: 2px solid #d5d5d5 !important;
        text-align: left !important;
        padding-left: 8px !important;
        white-space: nowrap;
    }

    .mud-table-row:hover .sticky-col {
        background: #f1f1f1 !important;
    }

    /* =========================================================
               INPUT STACK
            ========================================================= */
    .cell-input-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        position: relative;
        min-height: 42px;
    }

    /* =========================================================
               STATUS DROPDOWN
            ========================================================= */
    .native-select {
        border: 1px solid #d0d0d0;
        background: #ffffff;
        width: 48px;
        height: 24px;
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        outline: none;
    }

        .native-select:hover {
            border-color: #594ae2;
            background: #f8f7ff;
        }

        .native-select:focus {
            border-color: #594ae2;
            box-shadow: 0 0 0 2px rgba(89,74,226,0.15);
        }

    /* =========================================================
               REMARK INPUT
            ========================================================= */
    .remark-input {
        border: 1px solid #e0e0e0;
        width: 48px;
        height: 20px;
        font-size: 0.62rem;
        border-radius: 4px;
        padding: 1px 4px;
        transition: all 0.2s ease;
        background: white;
        text-align: center;
    }

        .remark-input:hover {
            border-color: #bdbdbd;
        }

        .remark-input:focus {
            width: 110px;
            border-color: #594ae2;
            outline: none;
            position: absolute;
            z-index: 1000;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }

    /* =========================================================
               STATE COLORS
            ========================================================= */
    .modified {
        background-color: #fff8c6 !important;
        border: 1px solid #fbc02d !important;
    }

    .sunday-cell {
        background-color: #7f1d1d !important;
        color: white !important;
        font-weight: bold;
    }

    .today-focus {
        background-color: #e6f4ff !important;
        border: 1px solid #1890ff !important;
    }

    /* =========================================================
               SAVE BAR
            ========================================================= */
    .save-bar {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 5000;
        display: flex;
        gap: 10px;
        background: rgba(255,255,255,0.96);
        padding: 12px;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.18);
        backdrop-filter: blur(4px);
    }

    /* =========================================================
               PRINT OVERLAY + JOB CARD
            ========================================================= */

    .print-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        z-index: 99999;
        overflow-y: auto;
        padding: 24px;
    }

    .print-actions {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(0,0,0,0.85);
    }

    .job-card-main {
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        background: white;
        color: black;
        border: 2px solid black;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* =========================================================
               MOBILE RESPONSIVE
            ========================================================= */

    @@media (max-width: 768px) {

        .mud-table-cell {
            font-size: 0.65rem !important;
            padding: 2px !important;
        }

        .sticky-col {
            min-width: 110px;
            max-width: 110px;
            width: 110px;
            font-size: 0.68rem !important;
        }

        .header-cell {
            min-width: 42px;
            font-size: 0.62rem !important;
        }

        .native-select {
            width: 42px;
            font-size: 0.62rem;
        }

        .remark-input {
            width: 42px;
            font-size: 0.58rem;
        }

            .remark-input:focus {
                width: 90px;
            }

        .save-bar {
            left: 10px;
            right: 10px;
            bottom: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .print-overlay {
            padding: 8px;
        }

        .job-card-main {
            width: 100%;
            min-height: auto;
            transform: scale(0.95);
            transform-origin: top center;
        }
    }

    /* =========================================================
               PRINT FIXES
            ========================================================= */

    @@page {
        size: A4 portrait;
        margin: 6mm;
    }

    @@media print {

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
            overflow: hidden !important;
        }
            /* HIDE EVERYTHING */
            body * {
                visibility: hidden !important;
            }
        /* SHOW ONLY PRINT OVERLAY */
        .print-overlay,
        .print-overlay * {
            visibility: visible !important;
        }
        /* CLEAN WHITE PRINT BG */
        .print-overlay {
            position: absolute !important;
            inset: 0 !important;
            background: white !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
        }
        /* HIDE NON-PRINT CONTENT */
        .print-actions,
        .save-bar,
        .grid-scroll-container,
        .mud-table,
        .mud-overlay,
        .mud-dialog,
        .mud-snackbar-container,
        .mud-appbar,
        .mud-drawer,
        .mud-navmenu,
        .no-print {
            display: none !important;
        }
        /* ONLY PRINT JOB CARD */
        #job-card-to-print {
            visibility: visible !important;
            position: relative !important;
            display: block !important;
            width: 198mm !important;
            min-height: 285mm !important;
            margin: 0 auto !important;
            border: 1px solid black !important;
            box-shadow: none !important;
            page-break-after: avoid !important;
            break-after: avoid-page !important;
        }

        .job-card-main {
            width: 198mm !important;
            min-height: 285mm !important;
            margin: 0 auto !important;
            border: 1px solid black !important;
            overflow: hidden !important;
            box-shadow: none !important;
        }
        /* AVOID EXTRA PAGES */
        table,
        tr,
        td,
        div {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
        /* BETTER PRINT COLORS */
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }



    .status-p {
        background: #bbf7d0 !important;
        color: #14532d !important;
    }

    .status-g {
        background: #bfdbfe !important;
        color: #1e3a8a !important;
    }

    .status-m {
        background: #fef9c3 !important;
        color: #713f12 !important;
    }

    .status-e {
        background: #fbcfe8 !important;
        color: #831843 !important;
    }

    .status-a {
        background: #fecaca !important;
        color: #7f1d1d !important;
    }

    .status-o {
        background: #ffffff !important;
        color: #222 !important;
    }

    .status-cl {
        background: #ddd6fe !important;
        color: #4c1d95 !important;
    }

    .status-sl {
        background: #fed7aa !important;
        color: #9a3412 !important;
    }

    .engaged-cell {
        background-color: #fbcfe8 !important;
        border: 2px solid #ec4899 !important;
    }

        .engaged-cell .native-select,
        .engaged-cell .remark-input {
            background-color: #fdf2f8 !important;
        }

</style>




<MudOverlay Visible="_isSaving" DarkBackground="true" ZIndex="9999">
    <div class="d-flex flex-column align-items-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Color="Color.Inherit" Class="mt-4">Syncing with Database...</MudText>
    </div>
</MudOverlay>

@if (AttendanceData.IsDataReady)
{
    @* --- BULK UPDATE PANEL --- *@
    <MudExpansionPanels Class="mb-4 mx-2">
        <MudExpansionPanel Text="Bulk Mark Attendance" Icon="@Icons.Material.Filled.BatchPrediction">
            <MudGrid AlignItems="AlignItems.Center" Class="pa-2">
               @*  <MudItem xs="12" md="3">
                    <MudSelect T="Member" Label="Resource" @bind-Value="_bulkMember" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        @foreach (var m in AttendanceData.Engineers.Concat(AttendanceData.Drivers))
                        {
                            <MudSelectItem Value="@m">@m.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem> *@

                <MudItem xs="12" md="3">

                    <MudSelect T="Member"
                               Label="Resources"
                               MultiSelection="true"
                               SelectAll="true"
                               SelectedValues="_bulkMembers"
                               SelectedValuesChanged="@(x => _bulkMembers = x.ToList())"
                               ToStringFunc="@(m => m?.FullName ?? "")"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Margin="Margin.Dense">

                        @foreach (var m in AttendanceData.Engineers.Concat(AttendanceData.Drivers))
                        {
                            <MudSelectItem T="Member" Value="@m">
                                @m.FullName (@m.Role)
                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudItem>


                <MudItem xs="12" md="2">
                    <MudDateRangePicker Label="Dates" @bind-DateRange="_bulkRange" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string" Label="Status" @bind-Value="_bulkStatus" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        @foreach (var s in _shiftCodes)
                        {
                            <MudSelectItem Value="@s">@s</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="Reason/Remark" @bind-Value="_bulkReason" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyBulkUpdate" FullWidth="true">Apply</MudButton>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* --- SAVE NOTIFICATION BAR --- *@
    @if (_pendingChanges.Any())
    {
        <div class="save-bar d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelChanges">Discard (@_pendingChanges.Count)</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveChanges">Update Schedule</MudButton>
        </div>
    }

    <MudGrid Spacing="1" Class="px-2 pb-16">
        @* Side-by-Side Layout: lg="6" ensures two columns on wide screens *@
        <MudItem xs="12" lg="6">
            <MudText Typo="Typo.subtitle2" Class="ml-2 mb-1" Color="Color.Primary">ENGINEERS</MudText>
            <div class="grid-scroll-container">
                <MudTable Items="@(AttendanceData.Engineers
                              .OrderBy(x => x.Role)
                              .ThenBy(x => GetTodayPriority(x.UniqueId)))" T="MemberType" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                    <HeaderContent>
                        <MudTh Class="sticky-col">Name</MudTh>
                        <MudTh Class="sticky-col">E.Code</MudTh>
                        @foreach (var day in _daysInMonth)
                        {
                            <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">@day.Day <br /><small>@day.ToString("ddd")</small></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="sticky-col">@context.FullName</MudTd>
                        <MudTd Class="sticky-col">@context.UniqueId</MudTd>
                        @foreach (var day in _daysInMonth)
                        {
                            var d = day; var m = context;
                            <MudTd Class="@($"{GetCellClass(d)} {GetStatusClass(GetStatus(m.UniqueId, d))} {(IsResourceEngaged(m.UniqueId, d) ? "engaged-cell" : "")}")">
                                <div class="cell-input-stack">
                                    <select value="@GetStatus(m.UniqueId, d)"
                                            class="native-select
       @(IsModified(m.UniqueId, d) ? "modified" : "")
       @GetStatusClass(GetStatus(m.UniqueId, d))"
                                            @onchange="@(e => OnEntryChanged(m, d, e.Value?.ToString(), GetReason(m.UniqueId, d)))">
                                        <option value="">--</option>
                                        @foreach (var s in _shiftCodes)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                    <input type="text" class="remark-input" placeholder="..."
                                           value="@GetReason(m.UniqueId, d)"
                                           @onchange="@(e => OnEntryChanged(m, d, GetStatus(m.UniqueId, d), e.Value?.ToString()))" />
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudText Typo="Typo.subtitle2" Class="ml-2 mb-1" Color="Color.Secondary">DRIVERS</MudText>
            <div class="grid-scroll-container">
                <MudTable Items="@(AttendanceData.Drivers
    .OrderBy(x => x.Role)
    .ThenBy(x => GetTodayPriority(x.UniqueId)))"  T="MemberType" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                    <HeaderContent>
                        <MudTh Class="sticky-col">Name</MudTh>
                        <MudTh Class="sticky-col">VehicleNo.</MudTh>
                        @foreach (var day in _daysInMonth)
                        {
                            <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">@day.Day <br /><small>@day.ToString("ddd")</small></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="sticky-col">@context.FullName</MudTd>
                        <MudTd Class="sticky-col">@context.VehicleNumber</MudTd>
                        @foreach (var day in _daysInMonth)
                        {
                            var d = day; var m = context;
                            <MudTd Class="@($"{GetCellClass(d)} {GetStatusClass(GetStatus(m.UniqueId, d))} {(IsResourceEngaged(m.UniqueId, d) ? "engaged-cell" : "")}")">
                                <div class="cell-input-stack">
                                    <select value="@GetStatus(m.UniqueId, d)"
                                            class="native-select
                                        @(IsModified(m.UniqueId, d) ? "modified" : "")
                                        @GetStatusClass(GetStatus(m.UniqueId, d))"
                                            @onchange="@(e => OnEntryChanged(m, d, e.Value?.ToString(), GetReason(m.UniqueId, d)))">
                                        <option value="">--</option>
                                        @foreach (var s in _shiftCodes)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                    <input type="text" class="remark-input" placeholder="..."
                                           value="@GetReason(m.UniqueId, d)"
                                           @onchange="@(e => OnEntryChanged(m, d, GetStatus(m.UniqueId, d), e.Value?.ToString()))" />
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </MudItem>
    </MudGrid>
}
else
{
    <div class="d-flex align-center justify-center" style="height: 300px;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
    </div>
}












<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mt-md-8 mb-10 no-print">
    <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true" Class="responsive-header">
        <b>OIL Resource Dispatch Mapper</b>
    </MudText>

    @* --- SECTION 1: UPPER PANEL (Responsive Grid) --- *@
    <MudGrid Justify="Justify.Center" Class="align-center mt-2 mt-md-6">

        @* New Shift Dropdown *@
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-warning); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Shift</b></MudText>
                <MudSelect T="string" Label="Select Shift" Variant="Variant.Outlined" @bind-Value="_selectedShift" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("Morning")">Morning</MudSelectItem>
                    <MudSelectItem Value="@("Evening")">Evening</MudSelectItem>
                    @* <MudSelectItem Value="@("Night")">Night</MudSelectItem> *@
                </MudSelect>
            </MudPaper>
        </MudItem>

        @* <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-primary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>1. Vehicle</b></MudText>
                <MudSelect T="Driver" Label="Select Vehicle" Variant="Variant.Outlined" @bind-Value="_selectedDriver"
                           ToStringFunc="@(d => d?.VehicleNumber)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var d in _dbDrivers)
                    {
                        <MudSelectItem T="Driver" Value="@d">@d.VehicleNumber</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem> *@

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-primary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>1. Vehicle</b></MudText>
                <MudSelect T="Driver" Label="Select Vehicle" Variant="Variant.Outlined" @bind-Value="_selectedDriver"
                           ToStringFunc="@(d => d?.VehicleNumber)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var d in _dbDrivers)
                    {
                        <MudSelectItem T="Driver" Value="@d">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1">@d.VehicleNumber</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@d.DriverName</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-info); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>2. Jobs Assigned</b></MudText>
                <MudSelect T="Job" Label="Select Jobs" MultiSelection="true" @bind-SelectedValues="_selectedJobs"
                           Variant="Variant.Outlined" ToStringFunc="@(j => j?.JobName)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var j in _dbJobs)
                    {
                        <MudSelectItem T="Job" Value="@j">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1">@j.JobName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@j.JobDescription</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-secondary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>3. Personnel</b></MudText>
                <MudSelect T="Engineer" Label="Select Team" MultiSelection="true" @bind-SelectedValues="_selectedEngineers"
                           Variant="Variant.Outlined" ToStringFunc="@(p => p?.FullName)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var p in _dbEngineers)
                    {
                        <MudSelectItem T="Engineer" Value="@p">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1">@p.FullName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Designation</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

