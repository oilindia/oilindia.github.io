    private async Task DeleteAssignment(Guid id)
    {
        // Soft delete fix: setting status to "deleted" instead of physical deletion
        await SupabaseClient.From<Assignment>()
            .Where(x => x.Id == id)
            .Set(x => x.Status, "deleted")
            .Update();

        StateHasChanged();

        await LoadData();
        Snackbar.Add("Job marked as deleted", Severity.Info);
    }

    private async Task PrepareJobCard(Assignment item)
    {
        if (item == null) return;

        try
        {
            // 1. Fetch the latest lookup tables from Supabase immediately on demand
            _dbJobs = (await SupabaseClient.From<Job>().Get()).Models;
            _dbLocations = (await SupabaseClient.From<LocationTable>().Get()).Models;

            // 2. Refresh the local dictionary cache for GetJobName
            _jobDictionary = _dbJobs.ToDictionary(
                x => x.Id.ToString(),
                x => (x.JobName ?? "N/A", x.JobDescription ?? "")
            );

            // Explicitly fetch the fallback IST time in case the DB value is null
            string tzId = OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata";
            TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);
            DateTime fallbackIst = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, istZone);

            // 3. Construct your UI Card Model safely
            ActiveJobData = new JobCardModel
            {
                JobassignedBy = item.job_assignment_table_JobAssignedBy ?? "",
                DocNumber = item.DocNumber,

                // Render the UI explicitly in IST
                Date = item.CreatedAt ?? fallbackIst,
                //Date = item.CreatedAt ?? DateTime.Now,
                Vehicle = item.DriverId == default ? "No Driver" : (GetDriverName(item.DriverId) ?? "Unknown Driver"),

                JCLocations = item.JobIds?.Select(id => new JobLocations
                {
                    JobLocation = GetJobLocationName(id)
                }).ToList() ?? new List<JobLocations>(),

                Personnel = item.PersonnelIds?.Select(id => GetEngineerName(id) ?? "Unknown Personnel").ToList() ?? new List<string>(),

                Tasks = item.JobIds?.Select(id =>
                {
                    var details = GetJobName(id);
                    return new JobTask
                    {
                        Description = details.JobName ?? "",
                        JobDescription = GetJobDetailDesc(id) ?? ""
                    };
                }).ToList() ?? new List<JobTask>(),

                JCDetailedDesc = item.JobIds?.Select(id => new JobDetailedDesc
                {
                    JobDetailedDescString = GetJobDetailDesc(id) ?? ""
                }).ToList() ?? new List<JobDetailedDesc>(),
            };

            StateHasChanged();
            _isPreviewOpen = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Method Error: {ex.Message}");
            Snackbar.Add($"Error loading card data: {ex.Message}", Severity.Error);
        }
    }

