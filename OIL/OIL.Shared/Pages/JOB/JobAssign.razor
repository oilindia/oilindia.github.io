    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _dbDrivers = (await SupabaseClient.From<Driver>().Get()).Models;
            _dbJobs = (await SupabaseClient.From<Job>().Where(x => x.JobStatus == "pending" ).Get()).Models;
            _dbEngineers = (await SupabaseClient.From<Engineer>().Where(x => x.Section == "FIELD MAINTENANCE").Get()).Models;
