    [Table("job_assignments")]
    public class Assignment : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        
        private DateTime? _createdAt;

        [Column("created_at")]
        public DateTime? CreatedAt
        {
            get
            {
                if (!_createdAt.HasValue) return null;

                string tzId = OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata";
                TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);

                // Ensure the stored time is treated as UTC before conversion
                DateTime utcTime = DateTime.SpecifyKind(_createdAt.Value, DateTimeKind.Utc);
                return TimeZoneInfo.ConvertTimeFromUtc(utcTime, istZone);
            }
            set
            {
                // Ensure we always store it back to the field as UTC
                _createdAt = value?.ToUniversalTime();
            }
        }


        [Column("driver_id")] public long? DriverId { get; set; }
        [Column("job_ids")] public List<Guid> JobIds { get; set; } = new();

        [Column("shift_name")] public string ShiftName { get; set; } = "";

