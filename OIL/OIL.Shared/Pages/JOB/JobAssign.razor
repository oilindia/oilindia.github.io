        font-size: 1rem;
    }

    .oil-edit-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        z-index: 5000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .oil-edit-card {
        width: 95%;
        max-width: 500px;
    }
</style>

@code {

    private List<DateTime> _daysInMonth = new();
    private string[] _shiftCodes = { "P", "G", "M", "E", "A", "O", "CL", "SL" };
    private Dictionary<string, AttendanceScheduleModel> _pendingChanges = new();

    private Member _bulkMember;
    private DateRange _bulkRange = new(DateTime.Today, DateTime.Today.AddDays(7));
    private string _bulkStatus = "P";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();


        var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        for (var dt = start; dt <= end; dt = dt.AddDays(1)) _daysInMonth.Add(dt);

        if (!AttendanceData.IsDataReady)
        {
            await AttendanceData.InitializeAsync(SupabaseClient);
            StateHasChanged();
        }
    }

    private string GetStatus(string id, DateTime date) =>
        AttendanceData.AttendanceCache.TryGetValue($"{id}_{date:yyyyMMdd}", out var s) ? s : "";

    private bool IsModified(string id, DateTime date) => _pendingChanges.ContainsKey($"{id}_{date:yyyyMMdd}");

    private void OnStatusChanged(Member m, DateTime date, string status)
    {
        var key = $"{m.UniqueId}_{date:yyyyMMdd}";

        // Track the change locally
        _pendingChanges[key] = new AttendanceScheduleModel
        {
            WorkDate = date,
            Status = status,
            EmployeeCode = m.Role == "Engineer" ? m.UniqueId : null,
            DriverId = m.Role == "Driver" ? m.DbId : null
        };

        // Update UI cache immediately for visual feedback
        AttendanceData.AttendanceCache[key] = status;
    }

    private bool _isSaving = false;
    private async Task SaveChanges()
    {
        if (!_pendingChanges.Any()) return;

        try
        {
            _isSaving = true;

            var toUpdate = _pendingChanges.Values.ToList();
            await SupabaseClient.From<AttendanceScheduleModel>()
            .Upsert(toUpdate, new Supabase.Postgrest.QueryOptions { OnConflict = "work_date, employee_code, driver_id" });

            // CRITICAL: Reset the service state before re-initializing
            AttendanceData.ResetState();

            // Re-fetch everything from Supabase
            await AttendanceData.InitializeAsync(SupabaseClient);

            Snackbar.Add("Data synced successfully", Severity.Success);

            // Force the component to re-render with the new data from AttendanceData
            StateHasChanged();

            _isSaving = false;


           
        }
        catch (Exception ex)
        {
            _isSaving = false;
            // 3. Notify Blazor to re-render the grid
            StateHasChanged();
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelChanges()
    {
        try
        {
            _pendingChanges.Clear();
            AttendanceData.ResetState();
            await AttendanceData.InitializeAsync(SupabaseClient);
            Snackbar.Add("Changes discarded. Data refreshed.", Severity.Info);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _isSaving = false;
            // 3. Notify Blazor to re-render the grid
            StateHasChanged();
            Snackbar.Add("Failed to refresh data.", Severity.Error);
        }
    }

    private async Task ApplyBulkUpdate()
    {
        if (_bulkMember == null || _bulkRange.Start == null || _bulkRange.End == null) return;

        try
        {
            _isSaving = true;
            StateHasChanged();


           

            // Update UI Cache immediately
           // AttendanceData.AttendanceCache[key] = _bulkStatus;


            var updates = new List<AttendanceScheduleModel>();

            for (var dt = _bulkRange.Start.Value; dt <= _bulkRange.End.Value; dt = dt.AddDays(1))
            {
                
                // Inside ApplyBulkUpdate loop
                var memberId = _bulkMember.Role == "Engineer" ? _bulkMember.UniqueId : _bulkMember.DbId.ToString();
                var key = $"{memberId}_{dt:yyyyMMdd}";
                
                //var key = $"{_bulkMember.UniqueId}_{dt:yyyyMMdd}";

                // 1. UPDATE THE LOCAL UI CACHE IMMEDIATELY
                // This is what the grid actually looks at to render the cell text/color
                AttendanceData.AttendanceCache[key] = _bulkStatus;

                updates.Add(new AttendanceScheduleModel
                {
                    WorkDate = dt,
                    Status = _bulkStatus,
                    EmployeeCode = _bulkMember.Role == "Engineer" ? _bulkMember.UniqueId : null,
                    DriverId = _bulkMember.Role == "Driver" ? _bulkMember.DbId : null
                });
            }

            // 2. Push to Database
            await SupabaseClient.From<AttendanceScheduleModel>()
                .Upsert(updates, new Supabase.Postgrest.QueryOptions { OnConflict = "work_date, employee_code, driver_id" });


            _isSaving = false;
            // 3. Notify Blazor to re-render the grid
            StateHasChanged();

            Snackbar.Add("UI Updated", Severity.Success);
        }
        catch (Exception ex)
        {
            _isSaving = false;
            // 3. Notify Blazor to re-render the grid
            StateHasChanged();
            Snackbar.Add($"Update failed: {ex.Message}", Severity.Error);
        }
    }

