    //JobsGrid Data
    // --- New Jobs Grid Properties ---
    private bool _isJobsLoading = true;
    private List<JobDetailsDto> _jobsGridData = new();

    public async Task LoadJobsGridDataAsync()
    {
        try
        {
            _isJobsLoading = true;
            StateHasChanged();

            // 1. Fetch 50 Jobs
            var jobs = (await SupabaseClient.From<Job>()
                .Order(x => x.CreatedAt, Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(50)
                .Get()).Models;

            // 2. Fetch Assignments
            var assignments = (await SupabaseClient.From<Assignment>()
                .Order(x => x.CreatedAt, Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(50)
                .Get()).Models;

            // 3. Extract IDs for Lookups (Using .Where(x => x != 0) instead of .HasValue)
            var locationIds = jobs.Where(a => a.JobLocationId != 0).Select(a => a.JobLocationId).Distinct().ToList();
            var engineerIds = assignments.Where(a => a.PersonnelIds != null && a.PersonnelIds.Any()).SelectMany(a => a.PersonnelIds).Distinct().ToList();
            var driverIds = assignments.Where(a => a.DriverId != 0).Select(a => a.DriverId).Distinct().ToList();

            // 4. Fetch References using .Filter instead of .In
            var locations = (await SupabaseClient.From<LocationTable>()
                .Filter("id", Supabase.Postgrest.Constants.Operator.In, locationIds)
                .Get()).Models.ToDictionary(l => l.Id);

            var engineers = (await SupabaseClient.From<Engineer>()
                        .Filter("id", Supabase.Postgrest.Constants.Operator.In, engineerIds)
                        .Get()).Models.ToDictionary(e => e.Id);

            var drivers = (await SupabaseClient.From<Driver>()
                        .Filter("id", Supabase.Postgrest.Constants.Operator.In, driverIds)
                        .Get()).Models.ToDictionary(d => d.Id);

            // 5. Map to DTO
            _jobsGridData = jobs.Select(job =>
            {
                // Note: Since you stated assigned_to is in job_assignments, we find the assignment containing this job.id
                // If your DB job_ids are integers, ensure the comparison type matches.
                //var assignment = assignments.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains((Guid)job.Id.GetHashCode()));

                // Simply check if the JobIds array contains the current job's Guid
                var assignment = assignments.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains(job.Id));

                // Resolve Location from Job
                locations.TryGetValue(job.JobLocationId, out var loc);
                // Resolve Engineers safely
                string names = "Unassigned";
                string codes = "N/A";

                if (assignment?.PersonnelIds != null && assignment.PersonnelIds.Count() > 0)
                {
                    var assignedEngineers = assignment.PersonnelIds
                        .Where(id => engineers.ContainsKey(id))
                        .Select(id => engineers[id])
                        .ToList();

                    if (assignedEngineers.Any())
                    {
                        names = string.Join(", ", assignedEngineers.Select(e => e.FullName));
                        //codes = string.Join(", ", assignedEngineers.Select(e => e.EmpCode));
                    }
                }
                // Resolve Driver
                drivers.TryGetValue(assignment?.DriverId ?? 0, out var drv);


                // locations.TryGetValue(assignment?.LocationId ?? 0, out var loc);
                // engineers.TryGetValue(assignment?.AssignedToId ?? 0, out var eng);
                //drivers.TryGetValue(assignment?.DriverId ?? 0, out var drv);

                return new JobDetailsDto
                {
                    Id = job.Id,
                    CreatedAt = job.CreatedAt,
                    JobName = job.JobName,
                    //NotificationNumber = job.NotificationNumber,
                    //Priority = job.Priority ?? "Normal",
                    JobType = job.tbJobType,
                    Status = job.JobStatus ?? "pending",
                    LocationName = loc != null ? (loc.InstallationName ?? "Unknown") : "N/A",
                    // Join the names and codes into a single string
                    EngineerNames = names,
                    //EngineerCodes = codes,
                    ShiftName = assignment?.ShiftName,
                    DriverName = drv?.DriverName,
                    VehicleNumber = drv?.VehicleNumber
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _isJobsLoading = false;
            StateHasChanged();
        }
    }

