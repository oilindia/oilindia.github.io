@page "/jobassign"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Models
@using Supabase.Postgrest.Attributes
@using Newtonsoft.Json
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using MudBlazor
@using System.Globalization
@inject IJSRuntime JSRuntime
@inject OIL.Shared.Services.AttendanceService AttendanceData

<style>
    .mud-table-cell { padding: 2px 4px !important; font-size: 0.75rem !important; height: 32px !important; text-align: center !important; }
    .grid-scroll-container { width: 100%; overflow-x: auto; border: 1px solid #e0e0e0; border-radius: 4px; background: white; }
    .native-select { border: none; background: transparent; width: 40px; text-align: center; font-size: 0.7rem; font-weight: bold; cursor: pointer; }
    .native-select.modified { background-color: #fff9c4; border-radius: 2px; } /* Highlight unsaved cells */
    .sticky-col { position: sticky; left: 0; z-index: 10; background: #f9f9f9 !important; min-width: 120px; font-weight: 700; border-right: 2px solid #ddd !important; text-align: left !important; }
    .header-cell { min-width: 45px; background: #f5f5f5 !important; font-weight: bold; border-bottom: 2px solid #594ae2 !important; }
    .sunday-cell { background-color: #fff1f0 !important; color: #cf1322; }
    .today-focus { background-color: #e6f7ff !important; border: 1px solid #1890ff !important; }
    .save-bar { position: fixed; bottom: 20px; right: 20px; z-index: 100; }
</style>

@* --- PLACE IT HERE --- *@
<MudOverlay Visible="_isSaving" DarkBackground="true" ZIndex="9999">
    <div class="d-flex flex-column align-items-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Color="Color.Inherit" Class="mt-4">Syncing with Database...</MudText>
    </div>
</MudOverlay>



@if (AttendanceData.IsDataReady)
{
    @* --- BULK UPDATE PANEL --- *@
    <MudExpansionPanels Class="mb-4 mx-2">
        <MudExpansionPanel Text="Bulk Mark Attendance" Icon="@Icons.Material.Filled.BatchPrediction">
            <MudGrid AlignItems="AlignItems.Center" Class="pa-2">
                <MudItem xs="12" md="3">
                    <MudSelect T="Member" Label="Resource" @bind-Value="_bulkMember" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        @foreach (var m in AttendanceData.Engineers.Concat(AttendanceData.Drivers))
                        {
                            <MudSelectItem Value="@m">@m.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDateRangePicker Label="Dates" @bind-DateRange="_bulkRange" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string" Label="Status" @bind-Value="_bulkStatus" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        @foreach (var s in _shiftCodes)
                        {
                            <MudSelectItem Value="@s">@s
                            </MudSelectItem>                                     
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">

                   

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyBulkUpdate" FullWidth="true">Apply</MudButton>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* --- SAVE NOTIFICATION BAR --- *@
    @if (_pendingChanges.Any())
    {
        <div class="save-bar d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelChanges">Discard (@_pendingChanges.Count)</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveChanges">Update Schedule</MudButton>
        </div>
    }

    

    <MudGrid Spacing="1" Class="px-2 pb-16">
        @* Engineers Table *@
        <MudItem xs="12" lg="6">
            <MudText Typo="Typo.subtitle2" Class="ml-2 mb-1" Color="Color.Primary">ENGINEERS</MudText>
            <div class="grid-scroll-container">
                <MudTable Items="@AttendanceData.Engineers" T="Member" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                    <HeaderContent>
                        <MudTh Class="sticky-col">Name</MudTh>
                        @foreach (var day in _daysInMonth)
                        {
                            <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">@day.Day
                                <br/><small>@day.ToString("ddd")
                                </small></MudTh>                             
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="sticky-col">@context.FullName</MudTd>
                        @foreach (var day in _daysInMonth)
                        {
                            var d = day; var m = context;
                            <MudTd Class="@GetCellClass(d)">
                                <select value="@GetStatus(m.UniqueId, d)" 
                                class="native-select @(IsModified(m.UniqueId, d) ? "modified" : "")" 
                                @onchange="@(e => OnStatusChanged(m, d, e.Value?.ToString()))">
                                    <option value=""></option>
                                    @foreach (var s in _shiftCodes)
                                    {
                                        <option value="@s
                                        ">@s
                                        </option>                                     
                                    }
                                </select>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </MudItem>

        @* Drivers Table *@
        <MudItem xs="12" lg="6">
            <MudText Typo="Typo.subtitle2" Class="ml-2 mb-1" Color="Color.Secondary">DRIVERS</MudText>
            <div class="grid-scroll-container">
                <MudTable Items="@AttendanceData.Drivers" T="Member" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                    <HeaderContent>
                        <MudTh Class="sticky-col">Name</MudTh>
                        @foreach (var day in _daysInMonth)
                        {
                            <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">@day.Day
                                <br/><small>@day.ToString("ddd")
                                </small></MudTh>                             
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="sticky-col">@context.FullName</MudTd>
                        @foreach (var day in _daysInMonth)
                        {
                            var d = day; var m = context;
                            <MudTd Class="@GetCellClass(d)">
                                <select value="@GetStatus(m.UniqueId, d)" 
                                class="native-select @(IsModified(m.UniqueId, d) ? "modified" : "")" 
                                @onchange="@(e => OnStatusChanged(m, d, e.Value?.ToString()))">
                                    <option value=""></option>
                                    @foreach (var s in _shiftCodes)
                                    {
                                        <option value="@s
                                        ">@s
                                        </option>                                     
                                    }
                                </select>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </MudItem>
    </MudGrid>

}
else
{
    <div class="d-flex align-center justify-center" style="height: 300px;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
    </div>
}











<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mt-md-8 mb-10 no-print">
    <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true" Class="responsive-header">
        <b>OIL Resource Dispatch Mapper</b>
    </MudText>

    @* --- SECTION 1: UPPER PANEL (Responsive Grid) --- *@
    <MudGrid Justify="Justify.Center" Class="align-center mt-2 mt-md-6">

        @* New Shift Dropdown *@
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-warning); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Shift</b></MudText>
                <MudSelect T="string" Label="Select Shift" Variant="Variant.Outlined" @bind-Value="_selectedShift" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("Morning")">Morning</MudSelectItem>
                    <MudSelectItem Value="@("Evening")">Evening</MudSelectItem>
                    @* <MudSelectItem Value="@("Night")">Night</MudSelectItem> *@
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-primary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>1. Vehicle</b></MudText>
                <MudSelect T="Driver" Label="Select Vehicle" Variant="Variant.Outlined" @bind-Value="_selectedDriver"
                           ToStringFunc="@(d => d?.VehicleNumber)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var d in _dbDrivers)
                    {
                        <MudSelectItem T="Driver" Value="@d">@d.VehicleNumber</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-info); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>2. Jobs Assigned</b></MudText>
                <MudSelect T="Job" Label="Select Jobs" MultiSelection="true" @bind-SelectedValues="_selectedJobs"
                           Variant="Variant.Outlined" ToStringFunc="@(j => j?.JobName)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var j in _dbJobs)
                    {
                        <MudSelectItem T="Job" Value="@j">@j.JobName</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-secondary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>3. Personnel</b></MudText>
                <MudSelect T="Engineer" Label="Select Team" MultiSelection="true" @bind-SelectedValues="_selectedEngineers"
                           Variant="Variant.Outlined" ToStringFunc="@(p => p?.FullName)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var p in _dbEngineers)
                    {
                        <MudSelectItem T="Engineer" Value="@p">@p.FullName</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="1" Class="d-flex align-center justify-center mt-4 mt-md-0">
            <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="SaveAssignment" Label="Plot" Size="Size.Large" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-6 my-md-10" />

    @* --- SECTION 2: DISPATCH TABLE --- *@
    <MudTable Items="@_assignments" Hover="true" Elevation="4" Loading="@_loading" Dense="true"
              Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" Class="mx-2">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Doc No</MudTh>
            <MudTh>Vehicle</MudTh>
            <MudTh>Jobs</MudTh>
            <MudTh>Personnel</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.PrintableDate</MudTd>
            <MudTd DataLabel="Doc No"><b>@context.DocNumber</b></MudTd>
            <MudTd DataLabel="Vehicle">@GetDriverName(context.DriverId)</MudTd>
            <MudTd DataLabel="Jobs">
                @foreach (var id in context.JobIds)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-1">@GetJobName(id)</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Personnel"><small>@string.Join(", ", context.PersonnelIds.Select(GetEngineerName))</small></MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Info" OnClick="@(() => PrepareJobCard(context))" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => OpenEditModal(context))" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAssignment(context.Id))" Size="Size.Small" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@* --- SECTION 3: EDIT MODAL --- *@
@if (_isEditModalOpen)
{
    <div class="oil-edit-overlay no-print">
        <MudPaper Class="pa-6 oil-edit-card" Elevation="25">
            <MudText Typo="Typo.h6" Class="mb-4">Edit Job Card: @_editingItem.DocNumber</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect T="Driver" Label="Vehicle" @bind-Value="_editDriver" Variant="Variant.Outlined" ToStringFunc="@(d => d?.VehicleNumber)">
                        @foreach (var d in _dbDrivers)
                        {
                            <MudSelectItem T="Driver" Value="@d">@d.VehicleNumber</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="Job" Label="Jobs" MultiSelection="true" @bind-SelectedValues="_editJobs" Variant="Variant.Outlined" ToStringFunc="@(j => j?.JobName)">
                        @foreach (var j in _dbJobs)
                        {
                            <MudSelectItem T="Job" Value="@j">@j.JobName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="Engineer" Label="Personnel" MultiSelection="true" @bind-SelectedValues="_editEngineers" Variant="Variant.Outlined" ToStringFunc="@(p => p?.FullName)">
                        @foreach (var p in _dbEngineers)
                        {
                            <MudSelectItem T="Engineer" Value="@p">@p.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <div class="d-flex justify-end mt-6 gap-2">
                <MudButton OnClick="() => _isEditModalOpen = false">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateAssignment">Save Changes</MudButton>
            </div>
        </MudPaper>
    </div>
}

@* --- SECTION 4: PRINT PREVIEW --- *@
@if (_isPreviewOpen)
{
    <div class="print-overlay">
        <div class="print-actions no-print pa-4 d-flex justify-center" style="margin-top: 30px;">
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => _isPreviewOpen = false" Class="mr-2">Exit Preview</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PrintNow" StartIcon="@Icons.Material.Filled.LocalPrintshop">Print Job Card</MudButton>
        </div>

        <div id="job-card-to-print" class="job-card-main">
            @* --- HEADER SECTION --- *@
            <div class="header-grid">
                <div class="logo-box d-flex align-center pa-2">
                    <div class="logo-container">
                        <img src="_content/OIL.Shared/imgs/oil.svg" alt="Oil India Logo" style="height: 45px; width: auto;" />
                    </div>
                    <div class="ml-2">
                        <MudText Typo="Typo.caption" Style="font-weight: bold; line-height: 1;">ऑयल इंडिया लिमिटेड</MudText><br />
                        <MudText Typo="Typo.caption" Style="font-weight: bold; line-height: 1;">Oil India Limited</MudText><br />
                        <MudText Style="font-size: 8px;">(A Govt. of India Enterprise)</MudText>
                    </div>
                </div>
                <div class="dept-box pa-1 text-center">
                    <MudText Style="font-size: 11px;">यंत्रीकरण विभाग, क्षेत्र मुख्यालय, दुलियाजान</MudText> 
                    <MudText Typo="Typo.body2" Style="font-weight: bold;">Instrumentation Department, Field Headquarter, Duliajan</MudText> 
                    <MudText Style="font-size: 11px;">कार्य आवंटन पर्ची</MudText> 
                    <MudText Typo="Typo.button" Style="font-weight: bold; letter-spacing: 2px;">JOB CARD</MudText> 
                </div>
                <div class="doc-box pa-1">
                    <MudText Style="font-size: 10px;">Doc No: <b>@ActiveJobData.DocNumber</b></MudText> 
                    <div class="mt-1" style="border-top: 1px solid black;">
                        <MudText Style="font-size: 10px;">Date: <b>@ActiveJobData.Date.ToString("dd/MM/yy")</b></MudText> 
                    </div>
                </div>
            </div>

            @* --- ASSIGNMENT SECTION --- *@
            <div class="row-flex border-top">
                <div class="col-30 pa-1 border-right">Job Assigned by:</div> 
                <div class="col-70 pa-1 font-handwriting">Instrumentation Executive</div>
            </div>

            @* --- MAIN JOB TABLE --- *@
            <div class="row-flex border-top header-row-bg">
                <div class="col-30 pa-1 border-right text-center"><b>Location/Unit/Notification</b></div> 
                <div class="col-70 pa-1 text-center"><b>Job Description</b></div> 
            </div>
            <div class="row-flex border-top" style="min-height: 300px;">
                <div class="col-30 pa-2 border-right font-handwriting">
                    Oil Field Headquarter / Duliajan
                </div>
                <div class="col-70 pa-2 font-handwriting">
                    @foreach (var task in ActiveJobData.Tasks)
                    {
                        <div class="mb-2">→ @task.Description</div>
                    }
                </div>
            </div>

            @* --- INTERLOCK / SETPOINT SECTION --- *@
            <div class="pa-1 border-top bg-light"><b>Details of any interlock bypass or Setpoint Change:</b></div>
            <div class="row-flex border-top" style="min-height: 60px;">
                <div class="col-70 border-right pa-2"></div>
                <div class="col-30 pa-1 text-center" style="font-size: 9px;">
                    Signature of Change Requestor & Name 
                </div>
            </div>

            @* --- PERSONNEL & VEHICLE SECTION --- *@
            <div class="pa-1 border-top bg-light"><b>Details of Personnel and Vehicle Assigned:</b></div> 
            <div class="row-flex border-top">
                <div class="col-50 border-right pa-2 font-handwriting" style="min-height: 80px;">
                    <b>Personnel:</b><br />
                    @string.Join(", ", ActiveJobData.Personnel)
                </div>
                <div class="col-50 pa-2">
                    <div class="font-handwriting"><b>Vehicle:</b> @ActiveJobData.Vehicle</div> 
                    <div class="d-flex mt-4 border-top-dotted">
                        <MudText Style="font-size: 9px;" Class="mr-4">Opening KMS: ______</MudText> 
                        <MudText Style="font-size: 9px;">Closing KMS: ______</MudText> 
                    </div>
                </div>
            </div>

            @* --- TOOL BOX TALK SECTION --- *@
            <div class="pa-1 border-top bg-light"><b>Tool Box Talk Record:</b></div> 
            <div class="pa-2 border-top" style="font-size: 9px; line-height: 1.2;">
                <div class="row-flex">
                    <div class="col-50">1. Job Specific PPE to be worn including coveralls.</div> 
                    <div class="col-50">2. Appropriate work permit to be taken at the installation.</div> 
                </div>
                <div class="row-flex">
                    <div class="col-50">3. Operator in-charge to be informed before starting job.</div> 
                    <div class="col-50">4. Operator in-charge to be informed after finishing job.</div> 
                </div>
                <div class="row-flex">
                    <div class="col-50">5. Set point change or interlock bypass done to be recorded and operator to be informed.</div> 
                    <div class="col-50">6. Others: __________________________</div> 
                </div>
            </div>

            @* --- SIGNATURE SECTION --- *@
            @* --- SIGNATURE SECTION (Triple Height & Closing Line) --- *@
            <div class="pa-4 border-top border-bottom text-center" style="min-height: 150px; display: flex; flex-direction: column; justify-content: space-between;">
                <MudText Style="font-size: 9px;">
                    Certified that Tool Box meeting has been conducted to execute job safely.
                </MudText>

                <div class="mt-auto mb-4">
                    <div style="border-top: 1px solid black; width: 250px; margin: auto;">
                        <MudText Style="font-size: 9px;">Signature of attendees </MudText>
                    </div>
                </div>
            </div>
        </div>

        <style>
                .header-row-bg {
                    background-color: #f5f5f5;
                    font-size: 11px;
                }

                .border-top-dotted {
                    border-top: 1px dotted black;
                }
        </style>
    
    
    
    </div>
}

<style>
