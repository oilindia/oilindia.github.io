            // _assignments = (await SupabaseClient.From<Assignment>()
            //     .Order("created_at", Supabase.Postgrest.Constants.Ordering.Descending)
            //     .Get()).Models;

            // Added .Limit(25) to fetch only the latest 25 assignments
            _assignments = (await SupabaseClient.From<Assignment>()
                .Order("created_at", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(35)
                .Get()).Models;

            // Fetch all jobs in one single API call
            var allJobs = (await SupabaseClient.From<Job>().Get()).Models;

            // Store both Name and Description in the dictionary cache
            _jobDictionary = allJobs.ToDictionary(
                x => x.Id.ToString(),
                x => (x.JobName ?? "", x.JobDescription ?? "") // Use your actual Description property name here
            );
        }
        catch(Exception e)
