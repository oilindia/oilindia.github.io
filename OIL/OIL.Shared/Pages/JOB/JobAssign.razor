    private void ApplyBulkUpdate()
    {
        if (!_bulkMembers.Any()
            || _bulkRange.Start == null
            || _bulkRange.End == null)
            return;

        foreach (var member in _bulkMembers)
        {
            for (
                var dt = _bulkRange.Start.Value.Date;
                dt <= _bulkRange.End.Value.Date;
                dt = dt.AddDays(1))
            {
                OnEntryChanged(
                    member,
                    dt,
                    _bulkStatus,
                    _bulkReason);
            }
        }

        Snackbar.Add(
            $"{_bulkMembers.Count} resources updated",
            Severity.Success);
    }


