    private async Task SaveAssignment()
    {
        try
        {
            _isSaving = true;
            if (_selectedDriver == null || !_selectedJobs.Any()) return;

            // 1. Calculate explicit IST time for string generations (like DocNumber)
            string tzId = OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata";
            TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);
            DateTime currentIstTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, istZone);

            // 1. Prepare and Save Assignment to Database
            var item = new Assignment
            {
                Id = Guid.NewGuid(),
                // Ensure this saves as UTC. If utilizing _selectedDate, force it to UTC.
                CreatedAt = _selectedDate?.ToUniversalTime() ?? DateTime.UtcNow,
                DriverId = _selectedDriver.Id,
                ShiftName = _selectedShift,
                job_assignment_table_JobAssignedBy = _fullName,
                JobAction = "assigned",
                JobIds = _selectedJobs.Select(x => x.Id).ToList(),
                PersonnelIds = _selectedEngineers.Select(x => x.Id).ToList(),
                // Inject the explicit IST calculation here
                DocNumber = $"OIL-{_selectedShift[0]}-{currentIstTime:ddMMyy-HHmm}"
            };

            await SupabaseClient.From<Assignment>().Insert(item);

            foreach (var job in _selectedJobs)
            {
                job.JobStatus = "assigned";
                await SupabaseClient.From<Job>().Update(job);
            }

            // 2. Format Grid Data (Read BEFORE clearing state)
            string plottedJobNames = string.Join(", ", _selectedJobs.Select(j => j.JobName));
            DateTime targetDate = DateTime.Today;

            // 3. Update Attendance Grid for Selected Engineers
            if (_selectedEngineers != null)
            {
                foreach (var eng in _selectedEngineers)
                {
                    var member = AttendanceData.Engineers.FirstOrDefault(e => e.UniqueId == eng.EmployeeCode);
                    if (member != null)
                    {
                        var currentStatus = GetStatus(member.UniqueId, targetDate);
                        if (string.IsNullOrWhiteSpace(currentStatus)) currentStatus = "P";

                        OnEntryChanged(member, targetDate, currentStatus, plottedJobNames);
                    }
                }
            }

            // 4. Update Attendance Grid for Selected Driver
            var driverMember = AttendanceData.Drivers.FirstOrDefault(d => d.UniqueId == _selectedDriver.VehicleNumber);
            if (driverMember != null)
            {
                var currentStatus = GetStatus(driverMember.UniqueId, targetDate);
                if (string.IsNullOrWhiteSpace(currentStatus)) currentStatus = "P";

                OnEntryChanged(driverMember, targetDate, currentStatus, plottedJobNames);
            }

            // 5. Reload external data
            await LoadData();

            // 6. Safely clear selections now that all logic is complete
            _selectedDriver = null;
            _selectedJobs = new List<Job>();
            _selectedEngineers = new List<Engineer>();

            _isSaving = false;
            Snackbar.Add("Job Plotted", Severity.Success);


            StateHasChanged();
        }
        catch (Exception ex)
        {
            _isSaving = false;
            Console.WriteLine($"Method Error: {ex.Message}");
            Snackbar.Add($"Error : {ex.Message}", Severity.Error);
        }
    }

