@page "/jobassign"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Models
@using Supabase.Postgrest.Attributes
@using Newtonsoft.Json
@using System.Globalization
@using System.Runtime.Serialization

@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IJSRuntime JSRuntime
@inject OIL.Shared.Services.AttendanceService AttendanceData

<style>

    /* =========================================================
           GLOBAL PAGE
        ========================================================= */

    html, body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        overflow-x: hidden;
        font-family: Roboto, Arial, sans-serif;
    }

    * {
        box-sizing: border-box;
    }

    /* =========================================================
           MAIN RESPONSIVE CONTAINER
        ========================================================= */

    .page-wrapper {
        width: 100%;
        overflow-x: hidden;
    }

    /* =========================================================
           GRID SCROLL CONTAINER
        ========================================================= */

    .grid-scroll-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid #dcdcdc;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        position: relative;
        -webkit-overflow-scrolling: touch;
    }

        .grid-scroll-container::-webkit-scrollbar {
            height: 8px;
        }

        .grid-scroll-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

        .grid-scroll-container::-webkit-scrollbar-track {
            background: #f0f0f0;
        }

    /* =========================================================
           TABLE
        ========================================================= */

    .mud-table-root {
        background: white !important;
        width: 100%;
    }

    .mud-table-container {
        overflow: visible !important;
    }

    .mud-table {
        min-width: max-content;
        border-collapse: collapse !important;
        table-layout: fixed;
    }

    .mud-table-head {
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .mud-table-cell {
        padding: 4px !important;
        font-size: 0.74rem !important;
        text-align: center !important;
        border: 1px solid #ececec !important;
        white-space: nowrap;
        vertical-align: middle !important;
        background: white;
    }

    .mud-table-row:hover .mud-table-cell {
        background: #fafafa !important;
    }

    /* =========================================================
           HEADER CELLS
        ========================================================= */

    .header-cell {
        min-width: 56px;
        background: #f5f7fa !important;
        font-weight: 700 !important;
        border-bottom: 2px solid #594ae2 !important;
        color: #222;
        position: sticky;
        top: 0;
        z-index: 15;
        line-height: 1.2;
    }

        .header-cell small {
            font-size: 0.62rem;
            font-weight: 500;
            color: #666;
        }

    /* =========================================================
           STICKY FIRST COLUMN
        ========================================================= */

    .sticky-col {
        position: sticky;
        left: 0;
        z-index: 16;
        background: #f9f9f9 !important;
        min-width: 150px;
        max-width: 150px;
        width: 150px;
        font-weight: 700;
        border-right: 2px solid #d5d5d5 !important;
        text-align: left !important;
        padding-left: 8px !important;
        white-space: nowrap;
    }

    .mud-table-row:hover .sticky-col {
        background: #f1f1f1 !important;
    }

    /* =========================================================
           INPUT STACK
        ========================================================= */

    .cell-input-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        position: relative;
        min-height: 42px;
    }

    /* =========================================================
           STATUS DROPDOWN
        ========================================================= */

    .native-select {
        border: 1px solid #d0d0d0;
        background: #ffffff;
        width: 52px;
        height: 24px;
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        outline: none;
    }

        .native-select:hover {
            border-color: #594ae2;
            background: #f8f7ff;
        }

        .native-select:focus {
            border-color: #594ae2;
            box-shadow: 0 0 0 2px rgba(89,74,226,0.15);
        }

    /* =========================================================
           REMARK INPUT
        ========================================================= */

    .remark-input {
        border: 1px solid #e0e0e0;
        width: 52px;
        height: 22px;
        font-size: 0.62rem;
        border-radius: 4px;
        padding: 1px 4px;
        transition: all 0.2s ease;
        background: white;
        text-align: center;
    }

        .remark-input:hover {
            border-color: #bdbdbd;
        }

        .remark-input:focus {
            width: 120px;
            border-color: #594ae2;
            outline: none;
            position: absolute;
            z-index: 1000;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }

    /* =========================================================
           STATE COLORS
        ========================================================= */

    .modified {
        background-color: #fff8c6 !important;
        border: 1px solid #fbc02d !important;
    }

    .sunday-cell {
        background-color: #fff1f0 !important;
        color: #cf1322 !important;
    }

    .today-focus {
        background-color: #e6f4ff !important;
        border: 1px solid #1890ff !important;
    }

    /* =========================================================
           SAVE BAR
        ========================================================= */

    .save-bar {
        position: fixed;
        bottom: 18px;
        right: 18px;
        z-index: 5000;
        display: flex;
        gap: 10px;
        background: rgba(255,255,255,0.96);
        padding: 12px;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.18);
        backdrop-filter: blur(4px);
        flex-wrap: wrap;
    }

    /* =========================================================
           RESPONSIVE CARDS
        ========================================================= */

    .selection-paper {
        border-radius: 16px !important;
        min-height: 190px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 100%;
    }

    /* =========================================================
           RESPONSIVE TABLE
        ========================================================= */

    .dispatch-table {
        width: 100%;
        overflow-x: auto;
    }

    /* =========================================================
           PRINT OVERLAY
        ========================================================= */

    .print-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        z-index: 99999;
        overflow-y: auto;
        padding: 20px;
    }

    .print-actions {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(0,0,0,0.85);
        border-radius: 12px;
    }

    .job-card-main {
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        background: white;
        color: black;
        border: 2px solid black;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* =========================================================
           JOB CARD STYLES
        ========================================================= */

    .header-grid {
        display: grid;
        grid-template-columns: 1.2fr 2fr 1fr;
        border-bottom: 1px solid black;
    }

    .logo-box,
    .dept-box {
        border-right: 1px solid black;
    }

    .row-flex {
        display: flex;
        width: 100%;
    }

    .col-30 {
        width: 30%;
    }

    .col-50 {
        width: 50%;
    }

    .col-70 {
        width: 70%;
    }

    .border-top {
        border-top: 1px solid black;
    }

    .border-bottom {
        border-bottom: 1px solid black;
    }

    .border-right {
        border-right: 1px solid black;
    }

    .bg-light {
        background-color: #f0f0f0;
        font-size: 11px;
        font-weight: bold;
    }

    .header-row-bg {
        background-color: #f5f5f5;
        font-size: 11px;
    }

    .font-handwriting {
        font-family: 'Comic Sans MS', cursive;
        color: #1a237e;
        font-size: 1rem;
    }

    .border-top-dotted {
        border-top: 1px dotted black;
    }

    /* =========================================================
           EDIT MODAL
        ========================================================= */

    .oil-edit-overlay {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        z-index: 5000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .oil-edit-card {
        width: 100%;
        max-width: 600px;
        max-height: 95vh;
        overflow-y: auto;
        border-radius: 18px !important;
    }

    /* =========================================================
           MOBILE RESPONSIVE
        ========================================================= */

    @@media (max-width: 1200px) {

        .selection-paper {
            min-height: 170px;
        }

        .job-card-main {
            width: 100%;
            max-width: 100%;
        }
    }

    @@media (max-width: 992px) {

        .sticky-col {
            min-width: 130px;
            max-width: 130px;
            width: 130px;
            font-size: 0.72rem !important;
        }

        .header-cell {
            min-width: 50px;
        }

        .selection-paper {
            min-height: auto;
        }

        .save-bar {
            left: 12px;
            right: 12px;
            bottom: 12px;
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {

        .mud-table-cell {
            font-size: 0.64rem !important;
            padding: 2px !important;
        }

        .sticky-col {
            min-width: 110px;
            max-width: 110px;
            width: 110px;
            font-size: 0.64rem !important;
            padding-left: 6px !important;
        }

        .header-cell {
            min-width: 42px;
            font-size: 0.6rem !important;
        }

        .native-select {
            width: 40px;
            height: 22px;
            font-size: 0.58rem;
        }

        .remark-input {
            width: 40px;
            height: 20px;
            font-size: 0.54rem;
        }

            .remark-input:focus {
                width: 90px;
            }

        .save-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .responsive-header {
            font-size: 1.5rem !important;
        }

        .print-overlay {
            padding: 6px;
        }

        .job-card-main {
            width: 100%;
            min-height: auto;
            transform: scale(0.95);
            transform-origin: top center;
        }

        .header-grid {
            grid-template-columns: 1fr;
        }

        .logo-box,
        .dept-box {
            border-right: none;
            border-bottom: 1px solid black;
        }

        .row-flex {
            flex-direction: column;
        }

        .col-30,
        .col-50,
        .col-70 {
            width: 100%;
        }

        .border-right {
            border-right: none;
            border-bottom: 1px solid black;
        }

        .font-handwriting {
            font-size: 0.82rem;
        }
    }

    @@media (max-width: 480px) {

        .mud-table-cell {
            font-size: 0.58rem !important;
        }

        .sticky-col {
            min-width: 95px;
            max-width: 95px;
            width: 95px;
            font-size: 0.58rem !important;
        }

        .header-cell {
            min-width: 38px;
            font-size: 0.55rem !important;
        }

        .native-select {
            width: 34px;
            font-size: 0.54rem;
        }

        .remark-input {
            width: 34px;
            font-size: 0.5rem;
        }

        .responsive-header {
            font-size: 1.15rem !important;
        }

        .selection-paper {
            padding: 16px !important;
        }

        .job-card-main {
            transform: scale(0.88);
        }
    }

    /* =========================================================
           PRINT
        ========================================================= */

    @@page {
        size: A4 portrait;
        margin: 6mm;
    }

    @@media print {

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
            overflow: hidden !important;
        }

            body * {
                visibility: hidden !important;
            }

        .print-overlay,
        .print-overlay * {
            visibility: visible !important;
        }

        .print-overlay {
            position: absolute !important;
            inset: 0 !important;
            background: white !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
        }

        .print-actions,
        .save-bar,
        .grid-scroll-container,
        .mud-overlay,
        .mud-dialog,
        .mud-snackbar-container,
        .mud-appbar,
        .mud-drawer,
        .mud-navmenu,
        .no-print {
            display: none !important;
        }

        #job-card-to-print {
            visibility: visible !important;
            position: relative !important;
            display: block !important;
            width: 198mm !important;
            min-height: 285mm !important;
            margin: 0 auto !important;
            border: 1px solid black !important;
            box-shadow: none !important;
            page-break-after: avoid !important;
            break-after: avoid-page !important;
        }

        .job-card-main {
            width: 198mm !important;
            min-height: 285mm !important;
            margin: 0 auto !important;
            border: 1px solid black !important;
            overflow: hidden !important;
            box-shadow: none !important;
            transform: none !important;
        }

        table,
        tr,
        td,
        div {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }

</style>

<div class="page-wrapper">

    <MudOverlay Visible="_isSaving" DarkBackground="true" ZIndex="9999">
        <div class="d-flex flex-column align-items-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6" Color="Color.Inherit" Class="mt-4">
                Syncing with Database...
            </MudText>
        </div>
    </MudOverlay>

    @if (AttendanceData.IsDataReady)
    {
        <!-- BULK UPDATE PANEL -->

        <MudExpansionPanels Class="mb-4 mx-2">
            <MudExpansionPanel Text="Bulk Mark Attendance"
                               Icon="@Icons.Material.Filled.BatchPrediction">

                <MudGrid AlignItems="AlignItems.Stretch"
                         Spacing="2"
                         Class="pa-2">

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Member"
                                   Label="Resource"
                                   @bind-Value="_bulkMember"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense">

                            @foreach (var m in AttendanceData.Engineers.Concat(AttendanceData.Drivers))
                            {
                                <MudSelectItem Value="@m">@m.FullName</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="2">
                        <MudDateRangePicker Label="Dates"
                                            @bind-DateRange="_bulkRange"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string"
                                   Label="Status"
                                   @bind-Value="_bulkStatus"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense">

                            @foreach (var s in _shiftCodes)
                            {
                                <MudSelectItem Value="@s">@s</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string"
                                      Label="Reason / Remark"
                                      @bind-Value="_bulkReason"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" md="2" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="ApplyBulkUpdate"
                                   FullWidth="true">
                            Apply
                        </MudButton>
                    </MudItem>

                </MudGrid>

            </MudExpansionPanel>
        </MudExpansionPanels>

        <!-- SAVE BAR -->
        @if (_pendingChanges.Any())
        {
            <div class="save-bar">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="CancelChanges">

                    Discard (@_pendingChanges.Count)

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveChanges">

                    Update Schedule

                </MudButton>

            </div>
        }

        <!-- ATTENDANCE TABLES -->

        <MudGrid Spacing="2" Class="px-2 pb-16">

            <!-- ENGINEERS -->

            <MudItem xs="12" xl="6">

                <MudPaper Elevation="2" Class="pa-2">

                    <MudText Typo="Typo.subtitle2"
                             Class="ml-2 mb-2"
                             Color="Color.Primary">

                        ENGINEERS

                    </MudText>

                    <div class="grid-scroll-container">

                        <MudTable Items="@AttendanceData.Engineers"
                                  T="Member"
                                  Dense="true"
                                  Hover="true"
                                  Breakpoint="Breakpoint.None"
                                  Elevation="0">

                            <HeaderContent>

                                <MudTh Class="sticky-col">Name</MudTh>

                                @foreach (var day in _daysInMonth)
                                {
                                    <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">
                                        @day.Day
                                        <br />
                                        <small>@day.ToString("ddd")</small>
                                    </MudTh>
                                }

                            </HeaderContent>

                            <RowTemplate>

                                <MudTd Class="sticky-col">
                                    @context.FullName
                                </MudTd>

                                @foreach (var day in _daysInMonth)
                                {
                                    var d = day;
                                    var m = context;

                                    <MudTd Class="@GetCellClass(d)">

                                        <div class="cell-input-stack">

                                            <select value="@GetStatus(m.UniqueId, d)"
                                                    class="native-select @(IsModified(m.UniqueId, d) ? "modified" : "")"
                                                    @onchange="@(e => OnEntryChanged(m, d, e.Value?.ToString(), GetReason(m.UniqueId, d)))">

                                                <option value="">--</option>

                                                @foreach (var s in _shiftCodes)
                                                {
                                                    <option value="@s">@s</option>
                                                }

                                            </select>

                                            <input type="text"
                                                   class="remark-input"
                                                   placeholder="..."
                                                   value="@GetReason(m.UniqueId, d)"
                                                   @onchange="@(e => OnEntryChanged(m, d, GetStatus(m.UniqueId, d), e.Value?.ToString()))" />

                                        </div>

                                    </MudTd>
                                }

                            </RowTemplate>

                        </MudTable>

                    </div>

                </MudPaper>

            </MudItem>

            <!-- DRIVERS -->

            <MudItem xs="12" xl="6">

                <MudPaper Elevation="2" Class="pa-2">

                    <MudText Typo="Typo.subtitle2"
                             Class="ml-2 mb-2"
                             Color="Color.Secondary">

                        DRIVERS

                    </MudText>

                    <div class="grid-scroll-container">

                        <MudTable Items="@AttendanceData.Drivers"
                                  T="Member"
                                  Dense="true"
                                  Hover="true"
                                  Breakpoint="Breakpoint.None"
                                  Elevation="0">

                            <HeaderContent>

                                <MudTh Class="sticky-col">Name</MudTh>

                                @foreach (var day in _daysInMonth)
                                {
                                    <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">
                                        @day.Day
                                        <br />
                                        <small>@day.ToString("ddd")</small>
                                    </MudTh>
                                }

                            </HeaderContent>

                            <RowTemplate>

                                <MudTd Class="sticky-col">
                                    @context.FullName
                                </MudTd>

                                @foreach (var day in _daysInMonth)
                                {
                                    var d = day;
                                    var m = context;

                                    <MudTd Class="@GetCellClass(d)">

                                        <div class="cell-input-stack">

                                            <select value="@GetStatus(m.UniqueId, d)"
                                                    class="native-select @(IsModified(m.UniqueId, d) ? "modified" : "")"
                                                    @onchange="@(e => OnEntryChanged(m, d, e.Value?.ToString(), GetReason(m.UniqueId, d)))">

                                                <option value="">--</option>

                                                @foreach (var s in _shiftCodes)
                                                {
                                                    <option value="@s">@s</option>
                                                }

                                            </select>

                                            <input type="text"
                                                   class="remark-input"
                                                   placeholder="..."
                                                   value="@GetReason(m.UniqueId, d)"
                                                   @onchange="@(e => OnEntryChanged(m, d, GetStatus(m.UniqueId, d), e.Value?.ToString()))" />

                                        </div>

                                    </MudTd>
                                }

                            </RowTemplate>

                        </MudTable>

                    </div>

                </MudPaper>

            </MudItem>

        </MudGrid>
    }
    else
    {
        <div class="d-flex align-center justify-center"
             style="height: 300px;">

            <MudProgressCircular Indeterminate="true"
                                 Size="Size.Large"
                                 Color="Color.Primary" />

        </div>
    }

    <!-- RESOURCE DISPATCH MAPPER -->

    <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                  Class="mt-4 mt-md-8 mb-10 no-print">

        <MudText Typo="Typo.h4"
                 Align="Align.Center"
                 GutterBottom="true"
                 Class="responsive-header">

            <b>OIL Resource Dispatch Mapper</b>

        </MudText>

        <!-- TOP PANEL -->

        <MudGrid Justify="Justify.Center"
                 AlignItems="AlignItems.Stretch"
                 Spacing="3"
                 Class="mt-2 mt-md-6">

            <!-- SHIFT -->

            <MudItem xs="12" sm="6" md="4" lg="2">

                <MudPaper Elevation="4"
                          Class="pa-4 pa-md-6 selection-paper"
                          Style="border-top: 6px solid var(--mud-palette-warning);">

                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <b>Shift</b>
                    </MudText>

                    <MudSelect T="string"
                               Label="Select Shift"
                               Variant="Variant.Outlined"
                               @bind-Value="_selectedShift"
                               AnchorOrigin="Origin.BottomCenter">

                        <MudSelectItem Value="@("Morning")">
                            Morning
                        </MudSelectItem>

                        <MudSelectItem Value="@("Evening")">
                            Evening
                        </MudSelectItem>

                    </MudSelect>

                </MudPaper>

            </MudItem>

            <!-- VEHICLE -->

            <MudItem xs="12" sm="6" md="4" lg="2">

                <MudPaper Elevation="4"
                          Class="pa-4 pa-md-6 selection-paper"
                          Style="border-top: 6px solid var(--mud-palette-primary);">

                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <b>1. Vehicle</b>
                    </MudText>

                    <MudSelect T="Driver"
                               Label="Select Vehicle"
                               Variant="Variant.Outlined"
                               @bind-Value="_selectedDriver"
                               ToStringFunc="@(d => d?.VehicleNumber)"
                               AnchorOrigin="Origin.BottomCenter">

                        @foreach (var d in _dbDrivers)
                        {
                            <MudSelectItem T="Driver" Value="@d">
                                @d.VehicleNumber
                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudPaper>

            </MudItem>

            <!-- JOBS -->

            <MudItem xs="12" sm="6" md="6" lg="3">

                <MudPaper Elevation="4"
                          Class="pa-4 pa-md-6 selection-paper"
                          Style="border-top: 6px solid var(--mud-palette-info);">

                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <b>2. Jobs Assigned</b>
                    </MudText>

                    <MudSelect T="Job"
                               Label="Select Jobs"
                               MultiSelection="true"
                               @bind-SelectedValues="_selectedJobs"
                               Variant="Variant.Outlined"
                               ToStringFunc="@(j => j?.JobName)"
                               AnchorOrigin="Origin.BottomCenter">

                        @foreach (var j in _dbJobs)
                        {
                            <MudSelectItem T="Job" Value="@j">
                                @j.JobName
                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudPaper>

            </MudItem>

            <!-- PERSONNEL -->

            <MudItem xs="12" sm="6" md="6" lg="3">

                <MudPaper Elevation="4"
                          Class="pa-4 pa-md-6 selection-paper"
                          Style="border-top: 6px solid var(--mud-palette-secondary);">

                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <b>3. Personnel</b>
                    </MudText>

                    <MudSelect T="Engineer"
                               Label="Select Team"
                               MultiSelection="true"
                               @bind-SelectedValues="_selectedEngineers"
                               Variant="Variant.Outlined"
                               ToStringFunc="@(p => p?.FullName)"
                               AnchorOrigin="Origin.BottomCenter">

                        @foreach (var p in _dbEngineers)
                        {
                            <MudSelectItem T="Engineer" Value="@p">
                                @p.FullName
                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudPaper>

            </MudItem>

            <!-- PLOT BUTTON -->

            <MudItem xs="12" lg="1"
                     Class="d-flex align-center justify-center">

                <MudFab Color="Color.Success"
                        StartIcon="@Icons.Material.Filled.Add"
                        OnClick="SaveAssignment"
                        Label="Plot"
                        Size="Size.Large" />

            </MudItem>

        </MudGrid>

        <MudDivider Class="my-6 my-md-10" />

        <!-- DISPATCH TABLE -->

        <div class="dispatch-table">

            <MudTable Items="@_assignments"
                      Hover="true"
                      Elevation="4"
                      Loading="@_loading"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm"
                      HorizontalScrollbar="true"
                      Class="mx-1 mx-md-2">

                <HeaderContent>

                    <MudTh>Date</MudTh>
                    <MudTh>Doc No</MudTh>
                    <MudTh>Vehicle</MudTh>
                    <MudTh>Jobs</MudTh>
                    <MudTh>Personnel</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="Date">
                        @context.PrintableDate
                    </MudTd>

                    <MudTd DataLabel="Doc No">
                        <b>@context.DocNumber</b>
                    </MudTd>

                    <MudTd DataLabel="Vehicle">
                        @GetDriverName(context.DriverId)
                    </MudTd>

                    <MudTd DataLabel="Jobs">

                        @foreach (var id in context.JobIds)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Text"
                                     Class="ma-1">

                                @GetJobName(id)

                            </MudChip>
                        }

                    </MudTd>

                    <MudTd DataLabel="Personnel">
                        <small>
                            @string.Join(", ", context.PersonnelIds.Select(GetEngineerName))
                        </small>
                    </MudTd>

                    <MudTd DataLabel="Actions"
                           Style="text-align:right">

                        <MudIconButton Icon="@Icons.Material.Filled.Print"
                                       Color="Color.Info"
                                       OnClick="@(() => PrepareJobCard(context))"
                                       Size="Size.Small" />

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditModal(context))"
                                       Size="Size.Small" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAssignment(context.Id))"
                                       Size="Size.Small" />

                    </MudTd>

                </RowTemplate>

            </MudTable>

        </div>

    </MudContainer>

</div>

@code {

    private List<DateTime> _daysInMonth = new();
    private string[] _shiftCodes = { "P", "G", "M", "E", "A", "O", "CL", "SL" };
    private Dictionary<string, AttendanceScheduleModel> _pendingChanges = new();
    private bool _isSaving = false;
    private bool IsModified(string id, DateTime date) => _pendingChanges.ContainsKey($"{id}_{date:yyyyMMdd}");
    private Member _bulkMember;
    private DateRange _bulkRange = new(DateTime.Today, DateTime.Today.AddDays(7));
    private string _bulkStatus = "P";
    private string _bulkReason = "";

    protected override async Task OnInitializedAsync()
    {
        var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        for (var dt = start; dt <= start.AddMonths(1).AddDays(-1); dt = dt.AddDays(1)) _daysInMonth.Add(dt);

        if (!AttendanceData.IsDataReady)
        {
            await AttendanceData.InitializeAsync(SupabaseClient);
        }

        LoadData();
    }

    private string GetStatus(string id, DateTime date) =>
        _pendingChanges.TryGetValue($"{id}_{date:yyyyMMdd}", out var pending) ? pending.Status :
        (AttendanceData.AttendanceCache.TryGetValue($"{id}_{date:yyyyMMdd}", out var s) ? s : "");

    private string GetReason(string id, DateTime date) =>
        _pendingChanges.TryGetValue($"{id}_{date:yyyyMMdd}", out var pending) ? pending.Reason :
        (AttendanceData.RemarksCache.TryGetValue($"{id}_{date:yyyyMMdd}", out var r) ? r : "");

    private bool IsModified(string key) => _pendingChanges.ContainsKey(key);

    private void OnEntryChanged(Member m, DateTime date, string status, string reason)
    {
        var cleanDate = new DateTime(date.Year, date.Month, date.Day, 0, 0, 0, DateTimeKind.Unspecified);
        var key = $"{m.UniqueId}_{cleanDate:yyyyMMdd}";

        _pendingChanges[key] = new AttendanceScheduleModel
        {
            WorkDate = cleanDate,
            Status = status,
            Reason = reason,
            EmployeeCode = m.Role == "Engineer" ? m.UniqueId : null,
            DriverId = m.Role == "Driver" ? m.DbId : null
        };
    }

    private async Task SaveChanges()
    {
        if (!_pendingChanges.Any()) return;
        try
        {
            _isSaving = true;
            var toUpdate = _pendingChanges.Values.ToList();
            await SupabaseClient.From<AttendanceScheduleModel>()
                .Upsert(toUpdate, new Supabase.Postgrest.QueryOptions { OnConflict = "work_date, employee_code, driver_id" });

            _pendingChanges.Clear();
            AttendanceData.ResetState();
            await AttendanceData.InitializeAsync(SupabaseClient);
            Snackbar.Add("Database sync complete", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; }
    }

    private async Task CancelChanges()
    {
        _pendingChanges.Clear();
        AttendanceData.ResetState();
        await AttendanceData.InitializeAsync(SupabaseClient);
        Snackbar.Add("Changes discarded", Severity.Info);
    }

    private void ApplyBulkUpdate()
    {
        if (_bulkMember == null || _bulkRange.Start == null || _bulkRange.End == null) return;
        
        for (var dt = _bulkRange.Start.Value.Date; dt <= _bulkRange.End.Value.Date; dt = dt.AddDays(1))
        {
            OnEntryChanged(_bulkMember, dt, _bulkStatus, _bulkReason);
        }
        Snackbar.Add("Bulk updates staged (pending save)", Severity.Info);
    }

    private string GetHeaderClass(DateTime d) => d.DayOfWeek == DayOfWeek.Sunday ? "sunday-cell" : "";
    private string GetCellClass(DateTime d) => (d.Date == DateTime.Today ? "today-focus " : "") + (d.DayOfWeek == DayOfWeek.Sunday ? "sunday-cell" : "");

