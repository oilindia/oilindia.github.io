@page "/jobassign"

@using Npgsql
@using Dapper
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config


@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Models
@using Supabase.Postgrest.Attributes
@using Newtonsoft.Json
@using System.Globalization
@using System.Runtime.Serialization

@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IJSRuntime JSRuntime
@inject OIL.Shared.Services.AttendanceService AttendanceData
@using MemberType = OIL.Shared.Pages.JOB.JobAssign.Member

@using Supabase.Postgrest.Attributes;
@using Supabase.Postgrest.Models;
@using System.Runtime.Serialization;

@using System.IO
@inject Client SupabaseClient
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject IDialogService DialogService
@using System.Security.Claims
@using OIL.Shared.Services



<MudOverlay Visible="_isSaving" DarkBackground="true" ZIndex="9999">
    <div class="d-flex flex-column align-items-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Color="Color.Inherit" Class="mt-4">Syncing with Database...</MudText>
    </div>
</MudOverlay>

@if (AttendanceData.IsDataReady)
{
    @* --- BULK UPDATE PANEL --- *@
    <MudExpansionPanels Class="mb-4 mx-2">
        <MudExpansionPanel Text="Bulk Mark Attendance" Icon="@Icons.Material.Filled.BatchPrediction">
            <MudGrid AlignItems="AlignItems.Center" Class="pa-2">
                @*  <MudItem xs="12" md="3">
                    <MudSelect T="Member" Label="Resource" @bind-Value="_bulkMember" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        @foreach (var m in AttendanceData.Engineers.Concat(AttendanceData.Drivers))
                        {
                            <MudSelectItem Value="@m">@m.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem> *@

                <MudItem xs="12" md="3">

                    <MudSelect T="Member"
                               Label="Resources"
                               MultiSelection="true"
                               SelectAll="true"
                               SelectedValues="_bulkMembers"
                               SelectedValuesChanged="@(x => _bulkMembers = x.ToList())"
                               ToStringFunc="@(m => m?.FullName ?? "")"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Margin="Margin.Dense">

                        @foreach (var m in AttendanceData.Engineers.Concat(AttendanceData.Drivers))
                        {
                            <MudSelectItem T="Member" Value="@m">
                                @m.FullName (@m.Role)
                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudItem>


                <MudItem xs="12" md="2">
                    <MudDateRangePicker Label="Dates" @bind-DateRange="_bulkRange" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string" Label="Status" @bind-Value="_bulkStatus" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        @foreach (var s in _shiftCodes)
                        {
                            <MudSelectItem Value="@s">@s</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="Reason/Remark" @bind-Value="_bulkReason" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyBulkUpdate" FullWidth="true">Apply</MudButton>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* --- DATA MANAGEMENT BAR (NEW) --- *@
    <div class="d-flex justify-end gap-3 mb-2 mx-2">
        <MudFileUpload T="IBrowserFile" FilesChanged="ImportFromExcel" Accept=".xlsx" MaxFileSize="10485760">
            <ActivatorContent>
                <MudButton HtmlTag="label"
                           Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.FileUpload">
                    Import Excel
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportToExcel">
            Export Excel
        </MudButton>
    </div>


    @* --- SAVE NOTIFICATION BAR --- *@
    @if (_pendingChanges.Any())
    {
        <div class="save-bar d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelChanges">Discard (@_pendingChanges.Count)</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveChanges">Update Schedule</MudButton>
        </div>
    }

    <MudGrid Spacing="1" Class="px-2 pb-16">
        @* Side-by-Side Layout: lg="6" ensures two columns on wide screens *@
        <MudItem xs="12" lg="6">
            <MudText Typo="Typo.subtitle2" Class="ml-2 mb-1" Color="Color.Primary">ENGINEERS</MudText>
            <div id="staff-grid" class="grid-scroll-container">
                <MudTable Items="@(AttendanceData.Engineers
                                                        .OrderBy(x => x.TeamGroup)
                                                        .ThenBy(x => GetTodayPriority(x.UniqueId)))" T="MemberType" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                    <HeaderContent>

                        <MudTh Class="sticky-col">E.Code</MudTh>
                        <MudTh Class="sticky-col">Team Group</MudTh>
                        <MudTh Class="sticky-col">Name</MudTh>
                        @foreach (var day in _daysInMonth)
                        {
                            <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">@day.Day <br /><small>@day.ToString("ddd")</small></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>

                        <MudTd Class="sticky-col">@context.UniqueId</MudTd>
                        <MudTd Class="sticky-col">@context.TeamGroup</MudTd>
                        <MudTd Class="sticky-col">@context.FullName</MudTd>
                        @foreach (var day in _daysInMonth)
                        {
                            var d = day; var m = context;
                            <MudTd Class="@($"{GetCellClass(d)} {GetStatusClass(GetStatus(m.UniqueId, d))} {(IsResourceEngaged(m.UniqueId, d) ? "engaged-cell" : "")}")">
                                <div class="cell-input-stack">
                                    <select value="@GetStatus(m.UniqueId, d)"
                                            class="native-select
                                        @(IsModified(m.UniqueId, d) ? "modified" : "")
                                        @GetStatusClass(GetStatus(m.UniqueId, d))"
                                            @onchange="@(e => OnEntryChanged(m, d, e.Value?.ToString(), GetReason(m.UniqueId, d)))">
                                        <option value="">--</option>
                                        @foreach (var s in _shiftCodes)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                    <input type="text" class="remark-input" placeholder="..."
                                           value="@GetReason(m.UniqueId, d)"
                                           @onchange="@(e => OnEntryChanged(m, d, GetStatus(m.UniqueId, d), e.Value?.ToString()))" />
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudText Typo="Typo.subtitle2" Class="ml-2 mb-1" Color="Color.Secondary">DRIVERS</MudText>
            <div id="driver-grid" class="grid-scroll-container">
                <MudTable Items="@(AttendanceData.Drivers
                              .OrderBy(x => x.Role)
                              .ThenBy(x => GetTodayPriority(x.UniqueId)))" T="MemberType" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                    <HeaderContent>
                        <MudTh Class="sticky-col">Name</MudTh>
                        <MudTh Class="sticky-col">VehicleNo.</MudTh>
                        @foreach (var day in _daysInMonth)
                        {
                            <MudTh Class="@($"header-cell {GetHeaderClass(day)}")">@day.Day <br /><small>@day.ToString("ddd")</small></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="sticky-col">@context.FullName</MudTd>
                        <MudTd Class="sticky-col">@context.VehicleNumber</MudTd>
                        @foreach (var day in _daysInMonth)
                        {
                            var d = day; var m = context;
                            <MudTd Class="@($"{GetCellClass(d)} {GetStatusClass(GetStatus(m.UniqueId, d))} {(IsResourceEngaged(m.UniqueId, d) ? "engaged-cell" : "")}")">
                                <div class="cell-input-stack">
                                    <select value="@GetStatus(m.UniqueId, d)"
                                            class="native-select
                                        @(IsModified(m.UniqueId, d) ? "modified" : "")
                                        @GetStatusClass(GetStatus(m.UniqueId, d))"
                                            @onchange="@(e => OnEntryChanged(m, d, e.Value?.ToString(), GetReason(m.UniqueId, d)))">
                                        <option value="">--</option>
                                        @foreach (var s in _shiftCodes)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                    <input type="text" class="remark-input" placeholder="..."
                                           value="@GetReason(m.UniqueId, d)"
                                           @onchange="@(e => OnEntryChanged(m, d, GetStatus(m.UniqueId, d), e.Value?.ToString()))" />
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </MudItem>


        @* --- NEW: DETAILED JOBS GRID (LAST 3 DAYS) --- *@
        <MudGrid Spacing="1" Class="px-2 pb-16">
            <MudItem xs="12">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Warning">JOBS OVERVIEW (LAST 3 DAYS - ALL STATUSES)</MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadJobsGridDataAsync">Refresh Jobs</MudButton>
                </div>

                @if (_isJobsLoading)
                {
                    <MudProgressLinear Color="Color.Warning" Indeterminate="true" />
                }
                else
                {
                    <div id="jobs-grid" class="grid-scroll-container" style="max-height: 450px; overflow-y: auto;">

                        
                        
                        
                        
                        <MudTable Items="@_jobsGridData" Dense="true" Hover="true" Elevation="1" Striped="true" FixedHeader="true" Height="calc(100vh - 200px)">

                            <ColGroup>
                                <col style="width: 12%;" />
                                <col style="width: 28%;" />
                                <col style="width: 15%;" />
                                <col style="width: 15%;" />
                                <col style="width: 15%;" />
                                <col style="width: 7%;" />
                                <col style="width: 8%;" />
                            </ColGroup>

                            <HeaderContent>
                                <MudTh>Date Created</MudTh>
                                <MudTh>Job & Notification</MudTh>
                                <MudTh>Location</MudTh>
                                <MudTh>Assigned Engineer</MudTh>
                                <MudTh>Logistics Details</MudTh>
                                <MudTh Style="text-align: center;">Priority</MudTh>
                                <MudTh Style="text-align: center;">Status</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd DataLabel="Date Created">
                                    <MudText Typo="Typo.body2" Class="fw-bold">@context.CreatedAt?.ToString("dd MMM yyyy")</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CreatedAt?.ToString("HH:mm")</MudText>
                                </MudTd>

                                <MudTd DataLabel="Job & Notification" Style="white-space: normal; word-break: break-word;">
                                    <MudText Typo="Typo.body2" Class="fw-bold mb-1">@context.JobName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        No: @(string.IsNullOrEmpty(context.NotificationNumber) ? "N/A" : context.NotificationNumber) | Type: @context.JobType
                                    </MudText>
                                </MudTd>

                                <MudTd DataLabel="Location">
                                    <div class="d-flex align-start gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mud-text-secondary mt-1" />
                                        <MudText Typo="Typo.body2" Style="white-space: normal; word-break: break-word;">
                                            @context.LocationName
                                        </MudText>
                                    </div>
                                </MudTd>

                                <MudTd DataLabel="Assigned Engineer">
                                    @if (context.EngineerNames != "Unassigned")
                                    {
                                        <MudText Typo="Typo.body2" Class="fw-bold">@context.EngineerNames</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Code: @context.EngineerCodes</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary"><em>Unassigned</em></MudText>
                                    }
                                </MudTd>

                                <MudTd DataLabel="Logistics Details">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        <em>No Dispatch Active</em>
                                    </MudText>
                                </MudTd>

                                <MudTd DataLabel="Priority">
                                    <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)" Variant="Variant.Text" Class="font-weight-bold">
                                        @context.Priority
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                                        @context.Status
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>


                    </div>
                }
            </MudItem>
        </MudGrid>






    </MudGrid>
}
else
{
    <div class="d-flex align-center justify-center" style="height: 300px;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
    </div>
}












<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mt-md-8 mb-10 no-print">
    <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true" Class="responsive-header">
        <b>OIL Resource Dispatch Mapper</b>
    </MudText>

    @* --- SECTION 1: UPPER PANEL (Responsive Grid) --- *@
    <MudGrid Justify="Justify.Center" Class="align-center mt-2 mt-md-6">


        @* New Date Picker *@
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-success); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Date</b></MudText>
                <MudDatePicker Label="Select Date" @bind-Date="_selectedDate" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" />
            </MudPaper>
        </MudItem>

        @* New Shift Dropdown *@
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-warning); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Shift</b></MudText>
                <MudSelect T="string" Label="Select Shift" Variant="Variant.Outlined" @bind-Value="_selectedShift" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("M")">Morning</MudSelectItem>
                    <MudSelectItem Value="@("E")">Evening</MudSelectItem>
                    <MudSelectItem Value="@("G")">General</MudSelectItem>
                </MudSelect>
            </MudPaper>
        </MudItem>

        @* <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-primary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>1. Vehicle</b></MudText>
                <MudSelect T="Driver" Label="Select Vehicle" Variant="Variant.Outlined" @bind-Value="_selectedDriver"
                           ToStringFunc="@(d => d?.VehicleNumber)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var d in _dbDrivers)
                    {
                        <MudSelectItem T="Driver" Value="@d">@d.VehicleNumber</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem> *@

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-primary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>1. Vehicle</b></MudText>
                <MudSelect T="Driver" Label="Select Vehicle" Variant="Variant.Outlined" @bind-Value="_selectedDriver"
                           ToStringFunc="@(d => d?.VehicleNumber)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var d in _dbDrivers)
                    {
                        <MudSelectItem T="Driver" Value="@d">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1">@d.VehicleNumber</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@d.DriverName</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-info); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>2. Jobs Assigned</b></MudText>
                <MudSelect T="Job" Label="Select Jobs" MultiSelection="true" @bind-SelectedValues="_selectedJobs"
                           Variant="Variant.Outlined" ToStringFunc="@(j => j?.JobName)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var j in _dbJobs)
                    {
                        <MudSelectItem T="Job" Value="@j">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1">@j.JobName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@j.JobDescription</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 pa-md-6" Style="border-top: 6px solid var(--mud-palette-secondary); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>3. Personnel</b></MudText>
                <MudSelect T="Engineer" Label="Select Team" MultiSelection="true" @bind-SelectedValues="_selectedEngineers"
                           Variant="Variant.Outlined" ToStringFunc="@(p => p?.FullName)" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var p in _dbEngineers)
                    {
                        <MudSelectItem T="Engineer" Value="@p">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1">@p.FullName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Designation</MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="1" Class="d-flex align-center justify-center mt-4 mt-md-0">
            <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="SaveAssignment" Label="Plot" Size="Size.Large" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-6 my-md-10" />

    @* --- SECTION 2: DISPATCH TABLE --- *@
    <MudTable Items="@_assignments" Hover="true" Elevation="4" Loading="@_loading" Dense="true"
              Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" Class="mx-2">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Doc No</MudTh>
            <MudTh>Vehicle</MudTh>
            <MudTh>Jobs</MudTh>
            <MudTh>Personnel</MudTh>
            <MudTh>AssignStatus</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.PrintableDate</MudTd>
            <MudTd DataLabel="Doc No"><b>@context.DocNumber</b></MudTd>
            <MudTd DataLabel="Vehicle">@GetDriverName(context.DriverId)</MudTd>
            @* <MudTd DataLabel="Jobs">
                @foreach (var id in context.JobIds)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-1">@GetJobName(id)</MudChip>
                }
            </MudTd> *@
            @* <MudTd DataLabel="Jobs">
                @foreach (var id in context.JobIds)
                {
                    var jobDetails = GetJobName(id); // Fetch the Tuple once

                    <div class="mb-2">
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@jobDetails.JobName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block; line-height: 1.2;">
                            @jobDetails.JobDescription
                        </MudText>
                    </div>
                }
            </MudTd> *@

            <MudTd DataLabel="Jobs" Style="white-space: normal !important; max-width: 250px; min-width: 200px; vertical-align: top;">
                @foreach (var id in context.JobIds)
                {
                    var jobDetails = GetJobName(id);

                    <div class="mb-2" style="word-break: break-word;">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; white-space: normal;">
                            @jobDetails.JobName
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block; line-height: 1.2; white-space: normal;">
                            @jobDetails.JobDescription
                        </MudText>
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Personnel"><small>@string.Join(", ", context.PersonnelIds.Select(GetEngineerName))</small></MudTd>
            <MudTd DataLabel="Personnel"><small>@context.Status</small></MudTd>

            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Info" OnClick="@(() => PrepareJobCard(context))" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => OpenEditModal(context))" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAssignment(context.Id))" Size="Size.Small" />
            </MudTd>
        </RowTemplate>
    </MudTable>



</MudContainer>

@* --- SECTION 3: EDIT MODAL --- *@
@if (_isEditModalOpen)
{
    <div class="oil-edit-overlay no-print">
        <MudPaper Class="pa-6 oil-edit-card" Elevation="25">
            <MudText Typo="Typo.h6" Class="mb-4">Edit Job Card: @_editingItem.DocNumber</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect T="Driver" Label="Vehicle" @bind-Value="_editDriver" Variant="Variant.Outlined" ToStringFunc="@(d => d?.VehicleNumber)">
                        @foreach (var d in _dbDrivers)
                        {
                            <MudSelectItem T="Driver" Value="@d">@d.VehicleNumber</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    @* UPDATE: Bind foreach to _availableJobsForEdit instead of _dbJobs *@
                    <MudSelect T="Job" Label="Jobs" MultiSelection="true" @bind-SelectedValues="_editJobs" Variant="Variant.Outlined" ToStringFunc="@(j => j?.JobName)">
                        @foreach (var j in _availableJobsForEdit)
                        {
                            <MudSelectItem T="Job" Value="@j">@j.JobName</MudSelectItem>
                        }
                    </MudSelect>
                    @* <MudSelect T="Job" Label="Jobs" MultiSelection="true" @bind-SelectedValues="_editJobs" Variant="Variant.Outlined" ToStringFunc="@(j => j?.JobName)">
                        @foreach (var j in _dbJobs)
                        {
