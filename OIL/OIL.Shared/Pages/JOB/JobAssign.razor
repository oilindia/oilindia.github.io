    .job-card-main {
        width: 210mm;
        min-height: 297mm;
        margin: auto;
        border: 2px solid black;
        background: white;
        color: black;
        display: flex;
        flex-direction: column;
    }

    .border-bottom {
        border-bottom: 1px solid black;
    }

    .header-grid {
        display: grid;
        grid-template-columns: 1.2fr 2fr 1fr;
        border-bottom: 1px solid black;
    }

    .logo-box, .dept-box {
