    // --- EXPORT LOGIC ---
    private async Task ExportToExcel()
    {
        _isSaving = true; // Show overlay
        StateHasChanged();

        try
        {
            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var ws = workbook.Worksheets.Add("Attendance Status");

            // 1. Build Headers
            ws.Cell(1, 1).Value = "Unique ID";
            ws.Cell(1, 2).Value = "Role";
            ws.Cell(1, 3).Value = "Name/Vehicle";
            ws.Cell(1, 4).Value = "Team Group";

            int colIndex = 5;
            foreach (var day in _daysInMonth)
            {
                ws.Cell(1, colIndex).Value = $"{day.Day}-{day.ToString("MMM")}";
                ws.Cell(1, colIndex).Style.Font.Bold = true;
                ws.Cell(1, colIndex + 1).Value = "Remark"; // Column for remark next to status
                ws.Cell(1, colIndex + 1).Style.Font.Bold = true;
                colIndex += 2;
            }

            // 2. Populate Data (Engineers + Drivers)
            int rowIndex = 2;
            var allMembers = AttendanceData.Engineers.Concat(AttendanceData.Drivers).ToList();

            foreach (var member in allMembers)
            {
                ws.Cell(rowIndex, 1).Value = member.UniqueId;
                ws.Cell(rowIndex, 2).Value = member.Role;
                ws.Cell(rowIndex, 3).Value = member.Role == "Driver" ? $"{member.FullName} ({member.VehicleNumber})" : member.FullName;
                ws.Cell(rowIndex, 4).Value = member.TeamGroup;

                int dayCol = 5;
                foreach (var day in _daysInMonth)
                {
                    var status = GetStatus(member.UniqueId, day);
                    var reason = GetReason(member.UniqueId, day);

                    ws.Cell(rowIndex, dayCol).Value = status;
                    ws.Cell(rowIndex, dayCol + 1).Value = reason;
                    dayCol += 2;
                }
                rowIndex++;
            }

            ws.Columns().AdjustToContents(); // Auto-fit columns

            // 3. Convert to Byte Array and Download
            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var content = stream.ToArray();

            await JS.InvokeVoidAsync("downloadFileFromStream", "AttendanceExport.xlsx", Convert.ToBase64String(content));
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    // --- IMPORT LOGIC ---
    private async Task ImportFromExcel(IBrowserFile file)
    {
        if (file == null) return;

        _isSaving = true; // Show overlay
        StateHasChanged();

        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10485760).CopyToAsync(stream); // 10MB limit
            stream.Position = 0;

            using var workbook = new ClosedXML.Excel.XLWorkbook(stream);
            var ws = workbook.Worksheet("Attendance Status");
            if (ws == null) return; // Validate worksheet exists

            var rows = ws.RowsUsed().Skip(1); // Skip header row
            var allMembers = AttendanceData.Engineers.Concat(AttendanceData.Drivers).ToList();

            foreach (var row in rows)
            {
                var uniqueId = row.Cell(1).GetString();
                var member = allMembers.FirstOrDefault(m => m.UniqueId == uniqueId);

                if (member == null) continue; // Skip unknown IDs

                int dayCol = 5;
                foreach (var day in _daysInMonth)
                {
                    var excelStatus = row.Cell(dayCol).GetString();
                    var excelReason = row.Cell(dayCol + 1).GetString();

                    var currentStatus = GetStatus(member.UniqueId, day);
                    var currentReason = GetReason(member.UniqueId, day);

                    // Only trigger change if the Excel value is different from the current state
                    if (excelStatus != currentStatus || excelReason != currentReason)
                    {
                        // Use your existing method so it registers in _pendingChanges
                        OnEntryChanged(member, day, excelStatus, excelReason);
                    }
                    dayCol += 2;
                }
            }
        }
        catch (Exception ex)
        {
            // Handle parsing errors (e.g., show a Snackbar notification)
            Console.WriteLine($"Import Failed: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }












