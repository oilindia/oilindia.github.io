    private async Task UpdateAssignment()
    {
        try
        {
            _loading = true;

            // 0. Fetch fresh active assignments to ensure we capture any real-time shifts
            var activeAssignments = (await SupabaseClient.From<Assignment>()
                .Where(x => x.Status != "deleted" && x.Id != _editingItem.Id)
                .Get()).Models;

            // =================================================================
            // FIX: Match types exactly to Postgres DDL layout
            // =================================================================

            // 1. Jobs are UUIDs -> C# Guid
            var oldJobIds = _editingItem.JobIds ?? new List<Guid>();
            var newJobIds = _editJobs.Select(j => j.Id).ToList();

            // 2. Personnel are bigints -> C# long
            var oldPersonnelIds = _editingItem.PersonnelIds ?? new List<long>();
            var newPersonnelIds = _editEngineers.Select(e => e.Id).ToList();

            // 3. Driver is bigint null -> C# long?
            long? newDriverId = _editDriver?.Id;

            // =================================================================
            // STEP 1: RESOLVE JOB CONFLICTS & UPDATES (Guid / UUID)
            // =================================================================
            var jobsToUnassignIds = oldJobIds.Except(newJobIds).ToList();
            var jobsToAssignIds = newJobIds.Except(oldJobIds).ToList();

            // If a job was unselected from this assignment, it returns to "pending"
            foreach (var jobId in jobsToUnassignIds)
            {
                var job = _allDbJobs.FirstOrDefault(j => j.Id == jobId);
                if (job != null)
                {
                    job.JobStatus = "pending";
                    await SupabaseClient.From<Job>().Update(job);
                }
            }

            // If a job is newly added here, check if it was stolen from another assignment
            foreach (var jobId in jobsToAssignIds)
            {
                var conflictAssignment = activeAssignments.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains(jobId));
                if (conflictAssignment != null)
                {
                    conflictAssignment.JobIds.Remove(jobId);
                    await SupabaseClient.From<Assignment>().Update(conflictAssignment);
                }

                var job = _allDbJobs.FirstOrDefault(j => j.Id == jobId);
                if (job != null)
                {
                    job.JobStatus = "assigned";
                    await SupabaseClient.From<Job>().Update(job);
                }
            }

            // =================================================================
            // STEP 2: RESOLVE PERSONNEL (ENGINEER) CONFLICTS (long / bigint)
            // =================================================================
            var engineersStolenIds = newPersonnelIds.Except(oldPersonnelIds).ToList();

            foreach (var engId in engineersStolenIds)
            {
                // If this engineer is working elsewhere, remove them from that assignment
                var conflictAssignment = activeAssignments.FirstOrDefault(a => a.PersonnelIds != null && a.PersonnelIds.Contains(engId));
                if (conflictAssignment != null)
                {
                    conflictAssignment.PersonnelIds.Remove(engId);
                    await SupabaseClient.From<Assignment>().Update(conflictAssignment);
                }
            }

            // =================================================================
            // STEP 3: RESOLVE DRIVER / VEHICLE CONFLICTS (long? / bigint null)
            // =================================================================
            if (newDriverId.HasValue && newDriverId != _editingItem.DriverId)
            {
                // If the newly selected driver is assigned to another team, clear them from that team
                var conflictAssignment = activeAssignments.FirstOrDefault(a => a.DriverId == newDriverId);
                if (conflictAssignment != null)
                {
                    conflictAssignment.DriverId = null; // Explicitly null out the driver from the old team
                    await SupabaseClient.From<Assignment>().Update(conflictAssignment);
                }
            }

            // =================================================================
            // STEP 4: SAVE THE CURRENT ASSIGNMENT CHANGES
            // =================================================================
            _editingItem.DriverId = newDriverId;
            _editingItem.JobIds = newJobIds;
            _editingItem.PersonnelIds = newPersonnelIds;

            await SupabaseClient.From<Assignment>().Update(_editingItem);

            // =================================================================
            // STEP 5: REFRESH STATE
            // =================================================================
            _isEditModalOpen = false;
            Snackbar.Add("Assignment updated and resource conflicts resolved!", Severity.Success);

            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Critical Update Error: {ex.Message}");
            Snackbar.Add($"Error updating assignment: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }


