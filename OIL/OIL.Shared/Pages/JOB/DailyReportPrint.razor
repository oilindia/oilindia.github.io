@page "/dailyreportprint"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JS

<style>
    /* --- PRINT OPTIMIZATION --- */
    @@media print {
        .no-print, .mud-appbar, .mud-drawer, .mud-nav-menu, .mud-overlay {
            display: none !important;
        }

        .mud-main-content {
            margin-top: 0 !important;
            padding: 0 !important;
        }

        body, html {
            background: white !important;
            margin: 0 !important;
            width: 100%;
        }

        .a4-container {
            width: 100% !important;
            margin: 0 !important;
            padding: 5mm !important;
            border: none !important;
            box-shadow: none !important;
        }

        @@page {
            size: A4 landscape;
            margin: 5mm;
        }
    }

    /* --- LAYOUT STYLES --- */
    .a4-container {
        width: 287mm;
        min-height: 200mm;
        padding: 10mm;
        margin: 10px auto;
        background: white;
        color: black;
        font-family: Arial, sans-serif;
        border: 1px solid #000;
    }

    /* --- HEADER --- */
    .header-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
    }

        .header-table td {
            border: 1px solid black;
            padding: 5px;
            vertical-align: middle;
        }

    .logo-box {
        width: 15%;
        text-align: center;
    }

    .title-box {
        width: 60%;
        text-align: center;
    }

    .meta-box {
        width: 25%;
        font-size: 11px;
        line-height: 1.4;
        text-align: left;
        padding-left: 10px;
    }

    /* --- BANNERS --- */
    .section-banner {
        background: #f2f2f2;
        border: 1px solid black;
        border-top: none;
        padding: 5px 15px;
        font-weight: bold;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
    }

    /* --- DATA TABLES --- */
    .report-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
        table-layout: fixed;
    }

        .report-table th, .report-table td {
            border: 1px solid black;
            padding: 4px;
            font-size: 10px;
            text-align: center;
            word-wrap: break-word;
            vertical-align: middle;
        }

        .report-table th {
            background: #f9f9f9;
            font-weight: bold;
            text-transform: uppercase;
        }

    .text-left {
        text-align: left !important;
        padding-left: 5px !important;
    }

    /* --- FOOTER (Matches image_bbf7a3.png) --- */
    .footer-container {
        display: flex;
        justify-content: space-between;
        margin-top: 15px;
        align-items: flex-start;
    }

    .signature-section {
        border: 1px solid black;
        border-radius: 15px;
        padding: 15px;
        width: 65%;
        min-height: 100px;
        line-height: 2;
    }

    .stats-card {
        border: 1px solid black;
        border-radius: 15px;
        padding: 15px;
        width: 30%;
        font-weight: bold;
    }

    .handwritten {
        font-family: 'Courier New', monospace;
        font-size: 14px;
        text-decoration: underline;
    }
</style>

@* --- NAVIGATION CONSOLE (With Date Selectors & Refresh) --- *@
<div class="no-print pa-4" style="background: #e3f2fd; border-bottom: 3px solid #1565c0;">
    <MudGrid Justify="Justify.Center" Class="align-center">
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Select Previous Day" @bind-Date="_prevDate" Variant="Variant.Outlined" Color="Color.Secondary" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Select Today's Date" @bind-Date="_todayDate" Variant="Variant.Outlined" Color="Color.Primary" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="RefreshData" StartIcon="@Icons.Material.Filled.Sync">Refresh Data</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="HandlePrint" StartIcon="@Icons.Material.Filled.LocalPrintshop">Print Report</MudButton>
        </MudItem>
    </MudGrid>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="a4-container">
        @* --- HEADER --- *@
        <table class="header-table">
            <tr>
                <td class="logo-box">
                    <img src="_content/OIL.Shared/imgs/oil.png" style="height: 45px;" /><br />
                    <b style="font-size: 9px;">OIL INDIA</b>
                </td>
                <td class="title-box">
                    <div style="font-size: 14px; font-weight: bold;">Instrumentation Department, Field Headquarters [cite: 8]</div>
                    <div style="font-size: 11px;">यंत्रीकरण विभाग, क्षेत्र मुख्यालय, दुलियाजान [cite: 8]</div>
                    <div style="font-size: 15px; font-weight: 800; margin-top: 5px;">दैनिक रिपोर्ट / DAILY REPORT [cite: 9]</div>
                </td>
                <td class="meta-box">
                    Date: <b>@(_todayDate?.ToString("dd-MM-yyyy"))</b><br />
                    Ref. No.: <b>INST/FM-WF/@(_todayDate?.ToString("ddMMyy"))</b><br />
                    Field: <b>Western Field</b><br />
                    Generated: <b>@DateTime.Now.ToString("dd-MM-yyyy HH:mm")</b>
                </td>
            </tr>
        </table>

        @* --- PREVIOUS DAY SECTION --- *@
        <div class="section-banner">
            <span>Previous Day Job Carried Out: @(_prevDate?.ToString("dd-MM-yyyy"))</span>
        </div>
        <table class="report-table">
            <thead>
                <tr>
                    <th style="width: 30px;">SL</th>
                    <th style="width: 40px;">SHIFT</th>
                    <th style="width: 80px;">NOTIF. NO.</th>
                    <th style="width: 140px;">INSTALLATION</th>
                    <th style="width: 100px;">EQUIPMENT</th>
                    <th style="width: 50px;">DEVICE</th>
                    <th style="width: 60px;">TAG NO.</th>
                    <th class="text-left">FIELD REPORT</th>
                    <th>JOB DONE</th>
                    <th style="width: 70px;">REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (item, index) in _prevDayEntries.Select((v, i) => (v, i)))
                {
                    <tr>
                        <td>@(index + 1)</td>
                        <td>@item.ShiftName</td>
                        <td>@item.NotificationNo</td>
                        <td class="text-left">@GetLocationName(item.JobIds.FirstOrDefault())</td>
                        <td>@GetJobName(item.JobIds.FirstOrDefault())</td>
                        <td>@item.DeviceType</td>
                        <td>@item.TagNo</td>
                        <td class="text-left">@item.FieldReport</td>
                        <td class="text-left">@item.JobDoneDetails</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>

        @* --- TODAY'S PLANNED SECTION --- *@
        <div class="section-banner" style="margin-top: 15px;">
            <span>Today's Planned Jobs: @(_todayDate?.ToString("dd-MM-yyyy"))</span>
        </div>
        <table class="report-table">
            <thead>
                <tr>
                    <th style="width: 30px;">SL</th>
                    <th style="width: 40px;">SHIFT</th>
                    <th style="width: 80px;">NOTIF. NO.</th>
                    <th style="width: 140px;">INSTALLATION</th>
                    <th style="width: 100px;">EQUIPMENT</th>
                    <th style="width: 80px;">DEVICE</th>
                    <th class="text-left">FIELD REPORT</th>
                    <th style="width: 80px;">VEHICLE</th>
                    <th style="width: 150px;">PERSON</th>
                    <th style="width: 70px;">REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (item, index) in _todayEntries.Select((v, i) => (v, i)))
                {
                    <tr>
                        <td>@(index + 1)</td>
                        <td>@item.ShiftName</td>
                        <td>@item.NotificationNo</td>
                        <td class="text-left">@GetLocationName(item.JobIds.FirstOrDefault())</td>
                        <td>@GetJobName(item.JobIds.FirstOrDefault())</td>
                        <td>@item.DeviceType</td>
                        <td class="text-left">@item.PlannedTask</td>
                        <td>@(_drivers.FirstOrDefault(d => d.Id == item.DriverId)?.FullName ?? "-")</td>
                        <td class="text-left">@string.Join(", ", item.PersonnelIds.Select(GetEngineerName))</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>

        @* --- FOOTER (Matches image_bbe915.png) --- *@
        <div class="footer-container">
            <div class="signature-section">
                <div><b>Prepared By:</b> <span class="handwritten">R. Pal</span></div>
                <div><b>Signature:</b> <span class="handwritten">Rahul Pal</span></div>
                <div><b>Date:</b> <span class="handwritten">@(_todayDate?.ToString("dd/MM/yy"))</span></div>
            </div>

            <div class="stats-card">
                <div style="font-size: 16px;">Today's Jobs: @_todayEntries.Count</div>
                <div style="font-size: 16px; margin-top: 10px;">Notification Pending: 4</div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime? _prevDate = DateTime.Today.AddDays(-1);
    private DateTime? _todayDate = DateTime.Today;
    private bool _loading = true;

    private List<Assignment> _prevDayEntries = new(), _todayEntries = new();
    private List<Driver> _drivers = new();
    private List<Job> _jobs = new();
    private List<Engineer> _engineers = new();
    private List<Location> _locations = new();

    protected override async Task OnInitializedAsync() => await RefreshData();

    private async Task RefreshData()
    {
        _loading = true;
        try
        {
            _drivers = (await SupabaseClient.From<Driver>().Get()).Models;
            _jobs = (await SupabaseClient.From<Job>().Get()).Models;
            _engineers = (await SupabaseClient.From<Engineer>().Get()).Models;
            _locations = (await SupabaseClient.From<Location>().Get()).Models;

            var todayStr = _todayDate?.ToString("yyyy-MM-dd");
            var prevStr = _prevDate?.ToString("yyyy-MM-dd");

            // Logic to fetch based on specific selected dates
            _prevDayEntries = (await SupabaseClient.From<Assignment>()
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, prevStr)
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _prevDate?.AddDays(1).ToString("yyyy-MM-dd"))
                .Get()).Models;

            _todayEntries = (await SupabaseClient.From<Assignment>()
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, todayStr)
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _todayDate?.AddDays(1).ToString("yyyy-MM-dd"))
                .Get()).Models;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetLocationName(Guid jobId) => _locations.FirstOrDefault(l => l.Id == _jobs.FirstOrDefault(j => j.Id == jobId)?.LocationId)?.InstallationName ?? "N/A";
    private string GetJobName(Guid jobId) => _jobs.FirstOrDefault(j => j.Id == jobId)?.JobName ?? "N/A";
    private string GetEngineerName(long id) => _engineers.FirstOrDefault(e => e.Id == id)?.FullName ?? "N/A";
    private async Task HandlePrint() => await JS.InvokeVoidAsync("window.print");

    [Table("job_assignments")]
    public class Assignment : BaseModel
    {
        [PrimaryKey("id")] public Guid Id { get; set; }
        [Column("created_at")] public DateTime? CreatedAt { get; set; }
        [Column("shift_name")] public string ShiftName { get; set; }
        [Column("job_ids")] public List<Guid> JobIds { get; set; } = new();
        [Column("personnel_ids")] public List<long> PersonnelIds { get; set; } = new();
        [Column("driver_id")] public long? DriverId { get; set; }
        [Column("notification_no")] public string NotificationNo { get; set; }
        [Column("device_type")] public string DeviceType { get; set; }
        [Column("tag_no")] public string TagNo { get; set; }
        [Column("field_report")] public string FieldReport { get; set; }
        [Column("job_done_details")] public string JobDoneDetails { get; set; }
        [Column("planned_task")] public string PlannedTask { get; set; }
    }

    /* Keep existing models for Driver, Job, Engineer, Location */
    [Table("locations")] public class Location : BaseModel { [PrimaryKey("id")] public long Id { get; set; } [Column("installation_name")] public string InstallationName { get; set; } }
    [Table("jobs")] public class Job : BaseModel { [PrimaryKey("id")] public Guid Id { get; set; } [Column("job_name")] public string JobName { get; set; } [Column("location_id")] public long? LocationId { get; set; } }
    [Table("drivers")] public class Driver : BaseModel { [PrimaryKey("id")] public long Id { get; set; } [Column("full_name")] public string FullName { get; set; } }
    [Table("employees_engineers")] public class Engineer : BaseModel { [PrimaryKey("id")] public long Id { get; set; } [Column("full_name")] public string FullName { get; set; } }
}