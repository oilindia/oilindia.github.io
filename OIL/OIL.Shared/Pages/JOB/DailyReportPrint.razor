@page "/dailyreportprint"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JS


@using System.Collections.Generic;
@using System.Linq;
@using System.Text.Json;

<style>

    /* =========================================================
               GLOBAL PAGE
            ========================================================= */
    html, body {
        margin: 0;
        padding: 0;
        background: #e9ecef;
        font-family: Arial, Helvetica, sans-serif;
        overflow-x: auto;
    }

    * {
        box-sizing: border-box;
    }

    /* =========================================================
               PRINT FIXES
            ========================================================= */
    @@media print {

        html, body {
            background: white !important;
            width: 100% !important;
            height: auto !important;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            body * {
                visibility: hidden;
            }

        .a4-container,
        .a4-container * {
            visibility: visible;
        }

        .a4-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            min-height: auto !important;
            margin: 0 !important;
            padding: 5mm !important;
            border: none !important;
            box-shadow: none !important;
            background: white !important;
            overflow: visible !important;
        }

        .no-print,
        .mud-appbar,
        .mud-drawer,
        .mud-nav-menu,
        .mud-overlay,
        .mud-dialog,
        .mud-snackbar-container,
        .mud-fab,
        .mud-button-root {
            display: none !important;
        }

        .mud-main-content {
            margin: 0 !important;
            padding: 0 !important;
        }

        @@page {
            size: A4 landscape;
            margin: 5mm;
        }

        table {
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-footer-group;
        }

        .report-table th,
        .report-table td {
            color: black !important;
            background: white !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .section-banner {
            background: #f0f0f0 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }

    /* =========================================================
               SCREEN CONTAINER
            ========================================================= */
    .a4-container {
        width: 287mm;
        min-height: 200mm;
        padding: 10mm;
        margin: 20px auto;
        background: white;
        color: black;
        border: 1px solid #222;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        overflow-x: auto;
    }

    /* =========================================================
               TOP TOOLBAR
            ========================================================= */
    .no-print {
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    /* =========================================================
               HEADER TABLE
            ========================================================= */
    .header-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
        table-layout: fixed;
    }

        .header-table td {
            border: 1px solid black;
            padding: 6px;
            vertical-align: middle;
        }

    .logo-box {
        width: 15%;
        text-align: center;
    }

        .logo-box img {
            max-width: 100%;
            height: auto;
        }

    .title-box {
        width: 60%;
        text-align: center;
        line-height: 1.4;
    }

    .meta-box {
        width: 25%;
        font-size: 11px;
        line-height: 1.6;
        text-align: left;
        padding-left: 10px !important;
    }

    /* =========================================================
               SECTION BANNERS
            ========================================================= */
    .section-banner {
        background: #f2f2f2;
        border: 1px solid black;
        border-top: none;
        padding: 6px 15px;
        font-weight: bold;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* =========================================================
               REPORT TABLE
            ========================================================= */
    .report-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
        table-layout: fixed;
    }

        .report-table th,
        .report-table td {
            border: 1px solid black;
            padding: 4px;
            font-size: 10px;
            text-align: center;
            vertical-align: middle;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        .report-table th {
            background: #f7f7f7;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.2;
        }

        .report-table tbody tr:nth-child(even) {
            background: #fcfcfc;
        }

        .report-table tbody tr:hover {
            background: #f1f7ff;
        }

    /* =========================================================
               TEXT ALIGNMENT
            ========================================================= */
    .text-left {
        text-align: left !important;
        padding-left: 6px !important;
    }

    /* =========================================================
               FOOTER
            ========================================================= */
    .footer-container {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 20px;
        align-items: stretch;
    }

    .signature-section {
        border: 1px solid black;
        border-radius: 14px;
        padding: 15px;
        width: 68%;
        min-height: 120px;
        line-height: 2;
    }

    .stats-card {
        border: 1px solid black;
        border-radius: 14px;
        padding: 15px;
        width: 32%;
        font-weight: bold;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .handwritten {
        font-family: "Courier New", monospace;
        font-size: 14px;
        text-decoration: underline;
    }

    /* =========================================================
               RESPONSIVE TABLE
            ========================================================= */
    @@media (max-width: 1200px) {

        .a4-container {
            width: 100%;
            min-width: 1200px;
            margin: 10px;
        }
    }

    @@media (max-width: 768px) {

        .header-table td {
            font-size: 9px;
            padding: 4px;
        }

        .report-table th,
        .report-table td {
            font-size: 8px;
            padding: 3px;
        }

        .section-banner {
            font-size: 10px;
            padding: 5px 8px;
        }

        .footer-container {
            flex-direction: column;
        }

        .signature-section,
        .stats-card {
            width: 100%;
        }

        .stats-card {
            margin-top: 10px;
        }
    }

    /* =========================================================
               LOADING BAR
            ========================================================= */
    .mud-progress-linear {
        position: sticky;
        top: 0;
        z-index: 2000;
    }

</style>

@* --- NAVIGATION CONSOLE (With Date Selectors & Refresh) --- *@
<div class="no-print pa-4" style="background: #e3f2fd; border-bottom: 3px solid #1565c0;">
    <MudGrid Justify="Justify.Center" Class="align-center">

        @* --- NEW FIELD TYPE DROPDOWN --- *@
        <MudItem xs="12" md="3">
            <MudSelect T="string" Label="Field Type" @bind-Value="selectedFieldType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@("Western Fields")" />
                <MudSelectItem Value="@("Eastern Fields")" />
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudDatePicker Label="Select Previous Day" @bind-Date="_prevDate" Variant="Variant.Outlined" Color="Color.Secondary" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Select Today's Date" @bind-Date="_todayDate" Variant="Variant.Outlined" Color="Color.Primary" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="RefreshData" StartIcon="@Icons.Material.Filled.Sync">Refresh Data</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="HandlePrint" StartIcon="@Icons.Material.Filled.LocalPrintshop">Print Report</MudButton>
        </MudItem>
    </MudGrid>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="a4-container">
        @* --- HEADER --- *@
        <table class="header-table">
            <tr>
                <td class="logo-box">
                    <img src="_content/OIL.Shared/imgs/oil.png" style="height: 45px;" /><br />
                    <b style="font-size: 9px;">OIL INDIA</b>
                </td>
                <td class="title-box">
                    <div style="font-size: 14px; font-weight: bold;">Instrumentation Department, Field Headquarters </div>
                    <div style="font-size: 11px;">यंत्रीकरण विभाग, क्षेत्र मुख्यालय, दुलियाजान </div>
                    <div style="font-size: 15px; font-weight: 800; margin-top: 5px;">दैनिक रिपोर्ट / DAILY REPORT </div>
                </td>
                <td class="meta-box">
                    Date: <b>@(_todayDate?.ToString("dd-MM-yyyy"))</b><br />
                    Ref. No.: <b>INST/FM-WF/@(_todayDate?.ToString("ddMMyy"))</b><br />
                    Field: <b>@selectedFieldType</b><br />
                    Generated: <b>@DateTime.Now.ToString("dd-MM-yyyy HH:mm")</b>
                </td>
            </tr>
        </table>

        <div class="section-banner">
            <table class="header-table">
                <tr>
                    <td><b>To : विभाग अध्यक्ष (यंत्रीकरण) / HOD (Instrumentation)</b></td>
                    <td><b>Through : अनुभाग प्रमुख / Section Head (Inst. - Field Maintenance)</b></td>

                </tr>
            </table>
        </div>

        @* --- PREVIOUS DAY SECTION --- *@
        <div class="section-banner">
            <span>Previous Day Job Carried Out: @(_prevDate?.ToString("dd-MM-yyyy"))</span>
        </div>
        <table class="report-table">
            <thead>
                <tr>
                    <th style="width: 30px;">SL</th>
                    <th style="width: 40px;">SHIFT</th>
                    <th style="width: 80px;">NOTIF. NO.</th>
                    <th style="width: 140px;">INSTALLATION</th>
                    <th style="width: 100px;">EQUIPMENT</th>
                    @* <th style="width: 50px;">DEVICE</th> *@
                    <th style="width: 60px;">TAG NO.</th>
                    <th class="text-left">FIELD REPORT</th>
                    <th>JOB DONE</th>
                    <th>SPARE USED</th>
                    <th style="width: 70px;">REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int prevSl = 1;
                }
                @foreach (var assignment in _prevDayEntries)
                {
                    @if (assignment.JobIds != null)
                    {
                        foreach (var jobId in assignment.JobIds)
                        {
                            var job = _jobs.FirstOrDefault(j => j.Id == jobId);
                            if (job == null) continue;

                            // Additional check to only render jobs associated with the selected field
                            if (!string.IsNullOrEmpty(selectedFieldType))
                            {
                                var loc = _locations.FirstOrDefault(l => l.Id == job.LocationId);
                                if (loc == null || !string.Equals(loc.FieldType, selectedFieldType, StringComparison.OrdinalIgnoreCase))
                                    continue;
                            }

                            <tr>
                                <td>@(prevSl++)</td>
                                <td>@assignment.ShiftName</td>
                                <td>@job.NotificationNumber</td>
                                <td class="text-left">@GetLocationName(job.LocationId)</td>
                                <td>@GetEquipmentName(job.LocTagNumber)</td>
                                @* <td>@job.</td> *@
                                <td>@job.LocTagNumber</td>

                                <td class="text-left">@job.JobName</td>

                                @* <td class="text-left">@job.Description</td> *@
                                <td class="text-left">@job.JobActionRemarks</td>
                                @* <td>@job.JobSpareReplaced</td> *@
                                <td>
                                    @FormatSpareDetails(job.JobSpareReplaced)
                                </td>

                                <td></td>
                                @* <td>@(assignment.JobOvertime > 0 ? $"OT: {assignment.JobOvertime} hrs" : "")</td> *@
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        @* --- TODAY'S PLANNED SECTION --- *@
        <div class="section-banner" style="margin-top: 15px;">
            <span>Today's Planned Jobs: @(_todayDate?.ToString("dd-MM-yyyy"))</span>
        </div>
        <table class="report-table">
            <thead>
                <tr>
                    <th style="width: 30px;">SL</th>
                    <th style="width: 40px;">SHIFT</th>
                    <th style="width: 80px;">NOTIF. NO.</th>
                    <th style="width: 140px;">INSTALLATION</th>
                    <th style="width: 100px;">EQUIPMENT</th>
                    <th style="width: 80px;">DEVICE</th>
                    <th class="text-left">FIELD REPORT</th>
                    <th style="width: 80px;">VEHICLE</th>
                    <th style="width: 150px;">PERSON</th>
                    <th style="width: 70px;">REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int todaySl = 1;
                }
                @foreach (var assignment in _todayEntries)
                {
                    @if (assignment.JobIds != null)
                    {
                        foreach (var jobId in assignment.JobIds)
                        {
                            var job = _jobs.FirstOrDefault(j => j.Id == jobId);
                            if (job == null) continue;

                            if (!string.IsNullOrEmpty(selectedFieldType))
                            {
                                var loc = _locations.FirstOrDefault(l => l.Id == job.LocationId);
                                if (loc == null || !string.Equals(loc.FieldType, selectedFieldType, StringComparison.OrdinalIgnoreCase))
                                    continue;
                            }

                            <tr>
                                <td>@(todaySl++)</td>
                                <td>@assignment.ShiftName</td>
                                <td>@job.NotificationNumber</td>
                                <td class="text-left">@GetLocationName(job.LocationId)</td>
                                <td>@GetEquipmentName(job.LocTagNumber)</td>
                                <td>@job.JobName</td>
                                <td class="text-left">@job.Description</td>
                                <td class="text-left">@GetDriverVehicleNumber(assignment.DriverId)</td>
                                <td class="text-left">@(assignment.PersonnelIds != null ? string.Join(", ", assignment.PersonnelIds.Select(GetEngineerName)) : "")</td>
                                <td>@(assignment.JobOvertime > 0 ? $"OT: {assignment.JobOvertime} hrs" : "")</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        @* --- FOOTER --- *@
        <div class="footer-container">
            <div class="signature-section">
                <div><b>Prepared By:</b> <span class="handwritten">_____________</span></div>
                <div><b>Signature:</b> <span class="handwritten">______________</span></div>
                <div><b>Date:</b> <span class="handwritten">@(_todayDate?.ToString("dd/MM/yy"))</span></div>
            </div>

            <div class="stats-card">
                @{
                    var totalTodayJobs = todaySl - 1;
                }
                <div style="font-size: 16px;">Today's Jobs: @totalTodayJobs</div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime? _prevDate = DateTime.Today.AddDays(-1);
    private DateTime? _todayDate = DateTime.Today;
    private bool _loading = true;

    private List<Assignment> _prevDayEntries = new(), _todayEntries = new();
    private List<Driver> _drivers = new();
    private List<Job> _jobs = new();
    private List<Engineer> _engineers = new();
    private List<Location> _locations = new();
    private List<Marker> _markers = new();

    private string selectedFieldType = "Eastern Fields";

    protected override async Task OnInitializedAsync() => await RefreshData();

    private async Task RefreshData()
    {
        _loading = true;
        try
        {
            // 1. Fetch lookup tables
            _drivers = (await SupabaseClient.From<Driver>().Get()).Models;
            _jobs = (await SupabaseClient.From<Job>().Get()).Models;
            _engineers = (await SupabaseClient.From<Engineer>().Get()).Models;
            _locations = (await SupabaseClient.From<Location>().Get()).Models;
            _markers = (await SupabaseClient.From<Marker>().Get()).Models;

            var todayStr = _todayDate?.ToString("yyyy-MM-dd");
            var prevStr = _prevDate?.ToString("yyyy-MM-dd");

            // 2. Fetch raw assignments for the date ranges
            var rawPrevDayEntries = (await SupabaseClient.From<Assignment>()
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, prevStr)
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _prevDate?.AddDays(1).ToString("yyyy-MM-dd"))
                .Get()).Models;

            var rawTodayEntries = (await SupabaseClient.From<Assignment>()
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, todayStr)
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _todayDate?.AddDays(1).ToString("yyyy-MM-dd"))
                .Get()).Models;

            // 3. Apply the relational filter
            if (!string.IsNullOrEmpty(selectedFieldType))
            {
                _prevDayEntries = FilterAssignmentsByFieldType(rawPrevDayEntries, selectedFieldType);
                _todayEntries = FilterAssignmentsByFieldType(rawTodayEntries, selectedFieldType);
            }
            else
            {
                _prevDayEntries = rawPrevDayEntries;
                _todayEntries = rawTodayEntries;
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private List<Assignment> FilterAssignmentsByFieldType(List<Assignment> assignments, string fieldType)
    {
        var validLocationIds = _locations
            .Where(l => string.Equals(l.FieldType, fieldType, StringComparison.OrdinalIgnoreCase))
            .Select(l => l.Id)
            .ToHashSet();

        var validJobIds = _jobs
            .Where(j => j.LocationId.HasValue && validLocationIds.Contains(j.LocationId.Value))
            .Select(j => j.Id)
            .ToHashSet();

        return assignments
            .Where(a => a.JobIds != null && a.JobIds.Any(id => validJobIds.Contains(id)))
            .ToList();
    }

    // --- REFACTORED HELPERS ---
    private string GetLocationName(long? locationId)
    {
        if (!locationId.HasValue) return "";
        return _locations.FirstOrDefault(l => l.Id == locationId.Value)?.InstallationName ?? "";
    }

    private string GetEquipmentName(string tagNumber)
    {
        if (string.IsNullOrWhiteSpace(tagNumber)) return "";
        return _markers.FirstOrDefault(m => m.TagNumber == tagNumber)?.InstrumentName ?? "";
    }

    public static string FormatSpareDetails(string jsonString, string lineSeparator = "<br/>")
    {
        if (string.IsNullOrWhiteSpace(jsonString))
        {
            return string.Empty;
        }

        try
        {
            using var doc = JsonDocument.Parse(jsonString);
            var formattedSpares = new List<string>();

            // Ensure we are dealing with a JSON array
            if (doc.RootElement.ValueKind != JsonValueKind.Array)
            {
                return jsonString;
            }

            foreach (var element in doc.RootElement.EnumerateArray())
            {
                // Safely extract properties
                var type = element.TryGetProperty("InstrumentType", out var it) ? it.GetString() : null;
                var loc = element.TryGetProperty("DeviceLocation", out var dl) ? dl.GetString() : null;
                var tag = element.TryGetProperty("TagNumber", out var tn) ? tn.GetString() : null;
                var make = element.TryGetProperty("NewMakeModel", out var nm) ? nm.GetString() : null;

                // Filter out null/empty/whitespace values
                var details = new[] { type, loc, tag, make }.Where(x => !string.IsNullOrWhiteSpace(x));

                if (details.Any())
                {
                    formattedSpares.Add(string.Join(", ", details));
                }
            }

            return string.Join(lineSeparator, formattedSpares);
        }
        catch (JsonException)
        {
            // Fallback to returning the raw string if the JSON is malformed
            return jsonString;
        }
    }

    private string GetDriverVehicleNumber(long? driverId)
    {
        if (!driverId.HasValue) return "";
        return _drivers.FirstOrDefault(d => d.Id == driverId.Value)?.VehicleNumber ?? "";
    }

    private string GetEngineerName(long id) => _engineers.FirstOrDefault(e => e.Id == id)?.FullName ?? "";
    private async Task HandlePrint() => await JS.InvokeVoidAsync("window.print");


    public class JobAssignmentViewModel
    {
        public string JobSpareReplaced { get; set; }

        // Read-only property for the UI
        public string FormattedSpareReplaced => FormatSpareDetails(JobSpareReplaced);
    }

    // --- MODELS ---
    [Table("job_assignments")]
    public class Assignment : BaseModel
    {
        [PrimaryKey("id")] public Guid Id { get; set; }
        [Column("created_at")] public DateTime? CreatedAt { get; set; }
        [Column("driver_id")] public long? DriverId { get; set; }
        [Column("shift_name")] public string ShiftName { get; set; }
        [Column("job_ids")] public List<Guid> JobIds { get; set; } = new();
        [Column("personnel_ids")] public List<long> PersonnelIds { get; set; } = new();
        [Column("job_overtime")] public double? JobOvertime { get; set; }

        // Retaining these to prevent Supabase deserialization errors if they still exist in your schema
        [Column("notification_no")] public string NotificationNo { get; set; }
        [Column("device_type")] public string DeviceType { get; set; }
        [Column("tag_no")] public string TagNo { get; set; }
        [Column("field_report")] public string FieldReport { get; set; }
        [Column("job_done_details")] public string JobDoneDetails { get; set; }
        [Column("planned_task")] public string PlannedTask { get; set; }
        [Column("spare_used")] public string SpareUsed { get; set; }
    }

    [Table("jobs")]
    public class Job : BaseModel
    {
        [PrimaryKey("id")] public Guid Id { get; set; }
        [Column("job_name")] public string JobName { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("loc_tag_number")] public string LocTagNumber { get; set; }
        [Column("notification_number")] public string NotificationNumber { get; set; }
        [Column("description")] public string Description { get; set; }
        [Column("job_action_remarks")] public string JobActionRemarks { get; set; }
        [Column("job_spare_replaced")] public string JobSpareReplaced { get; set; }
    }

    [Table("pid_markers")]
    public class Marker : BaseModel
    {
        [PrimaryKey("id", false)] public long? Id { get; set; }
        [Column("location_id")] public long LocationId { get; set; }
        [Column("tag_number")] public string TagNumber { get; set; }
        [Column("instrument_type")] public string InstrumentType { get; set; }
        [Column("make_model_type")] public string MakeModelType { get; set; }
        [Column("range")] public string Range { get; set; }
        [Column("coord_x")] public double? CoordX { get; set; }
        [Column("coord_y")] public double? CoordY { get; set; }
        [Column("serial_number")] public string? Serial_number { get; set; }
        [Column("replacement_cost")] public long? Replacement_cost { get; set; }
        [Column("InstrumentName")] public string? InstrumentName { get; set; }
    }

    [Table("locations")] public class Location : BaseModel { [PrimaryKey("id")] public long Id { get; set; } [Column("installation_name")] public string InstallationName { get; set; } [Column("field_type")] public string FieldType { get; set; } }
    [Table("drivers")] public class Driver : BaseModel { [PrimaryKey("id")] public long Id { get; set; } [Column("full_name")] public string FullName { get; set; } [Column("vehicle_number")] public string VehicleNumber { get; set; } }
    [Table("employees_engineers")] public class Engineer : BaseModel { [PrimaryKey("id")] public long Id { get; set; } [Column("full_name")] public string FullName { get; set; } }
}