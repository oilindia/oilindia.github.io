@page "/dailyreportprint"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@inject Supabase.Client SupabaseClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@using System.Collections.Generic;
@using System.Linq;
@using System.Text.Json;

<style>
    /* =========================================================
                   GLOBAL PAGE
                ========================================================= */
    html, body {
        margin: 0;
        padding: 0;
        background: #e9ecef;
        font-family: Arial, Helvetica, sans-serif;
        overflow-x: auto;
    }

    * {
        box-sizing: border-box;
    }

    /* =========================================================
                   EDITABLE CELLS (SCREEN & PRINT)
                ========================================================= */
    .editable-cell {
        width: 100%;
        border: 1px dashed #b0bec5;
        background-color: transparent;
        font-family: inherit;
        font-size: inherit;
        padding: 4px;
        text-align: inherit;
        field-sizing: content;
        min-height: 22px;
        resize: none;
    }

        .editable-cell:focus {
            outline: 2px solid #1976d2;
            background-color: #ffffff;
            border-color: transparent;
        }

    /* Hide spin buttons for number inputs */
    input.editable-cell::-webkit-outer-spin-button,
    input.editable-cell::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input.editable-cell {
        -moz-appearance: textfield;
    }

    /* =========================================================
                   PRINT FIXES
                ========================================================= */
    @@media print {
        html, body {
            background: white !important;
            width: 100% !important;
            height: auto !important;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            body * {
                visibility: hidden;
            }

        .a4-container,
        .a4-container * {
            visibility: visible;
        }

        .a4-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            min-height: auto !important;
            margin: 0 !important;
            padding: 5mm !important;
            border: none !important;
            box-shadow: none !important;
            background: white !important;
            overflow: visible !important;
        }

        .no-print,
        .mud-appbar,
        .mud-drawer,
        .mud-nav-menu,
        .mud-overlay,
        .mud-dialog,
        .mud-snackbar-container,
        .mud-fab,
        .mud-button-root {
            display: none !important;
        }

        .mud-main-content {
            margin: 0 !important;
            padding: 0 !important;
        }

        @@page {
            size: A4 landscape;
            margin: 5mm;
        }

        table {
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-footer-group;
        }

        .report-table th,
        .report-table td {
            color: black !important;
            background: white !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .section-banner {
            background: #f0f0f0 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .editable-cell {
            border: none !important;
            background-color: transparent !important;
            padding: 0 !important;
            overflow: visible !important;
            white-space: pre-wrap !important;
        }
    }

    /* =========================================================
                   SCREEN CONTAINER
                ========================================================= */
    .a4-container {
        width: 287mm;
        min-height: 200mm;
        padding: 10mm;
        margin: 20px auto;
        background: white;
        color: black;
        border: 1px solid #222;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        overflow-x: auto;
    }

    /* =========================================================
                   TOP TOOLBAR
                ========================================================= */
    .no-print {
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    /* =========================================================
                   HEADER TABLE
                ========================================================= */
    .header-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
        table-layout: fixed;
    }

        .header-table td {
            border: 1px solid black;
            padding: 6px;
            vertical-align: middle;
        }

    .logo-box {
        width: 15%;
        text-align: center;
    }

        .logo-box img {
            max-width: 100%;
            height: auto;
        }

    .title-box {
        width: 60%;
        text-align: center;
        line-height: 1.4;
    }

    .meta-box {
        width: 25%;
        font-size: 11px;
        line-height: 1.6;
        text-align: left;
        padding-left: 10px !important;
    }

    /* =========================================================
                   SECTION BANNERS
                ========================================================= */
    .section-banner {
        background: #f2f2f2;
        border: 1px solid black;
        border-top: none;
        padding: 6px 15px;
        font-weight: bold;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* =========================================================
                   REPORT TABLE
                ========================================================= */
    .report-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
        table-layout: fixed;
    }

        .report-table th,
        .report-table td {
            border: 1px solid black;
            padding: 4px;
            font-size: 10px;
            text-align: center;
            vertical-align: middle;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        .report-table th {
            background: #f7f7f7;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.2;
        }

        .report-table tbody tr:nth-child(even) {
            background: #fcfcfc;
        }

        .report-table tbody tr:hover {
            background: #f1f7ff;
        }

    /* =========================================================
                   TEXT ALIGNMENT
                ========================================================= */
    .text-left {
        text-align: left !important;
        padding-left: 6px !important;
    }

    /* =========================================================
                   FOOTER
                ========================================================= */
    .footer-container {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 20px;
        align-items: stretch;
    }

    .signature-section {
        border: 1px solid black;
        border-radius: 14px;
        padding: 15px;
        width: 68%;
        min-height: 120px;
        line-height: 2;
    }

    .stats-card {
        border: 1px solid black;
        border-radius: 14px;
        padding: 15px;
        width: 32%;
        font-weight: bold;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .handwritten {
        font-family: "Courier New", monospace;
        font-size: 14px;
        text-decoration: underline;
    }

    /* =========================================================
                   RESPONSIVE TABLE
                ========================================================= */
    @@media (max-width: 1200px) {
        .a4-container {
            width: 100%;
            min-width: 1200px;
            margin: 10px;
        }
    }

    @@media (max-width: 768px) {
        .header-table td {
            font-size: 9px;
            padding: 4px;
        }

        .report-table th,
        .report-table td {
            font-size: 8px;
            padding: 3px;
        }

        .section-banner {
            font-size: 10px;
            padding: 5px 8px;
        }

        .footer-container {
            flex-direction: column;
        }

        .signature-section,
        .stats-card {
            width: 100%;
        }

        .stats-card {
            margin-top: 10px;
        }
    }

    /* =========================================================
                   LOADING BAR
                ========================================================= */
    .mud-progress-linear {
        position: sticky;
        top: 0;
        z-index: 2000;
    }

</style>

@* --- NAVIGATION CONSOLE (With Date Selectors & Refresh) --- *@
<div class="no-print pa-4" style="background: #e3f2fd; border-bottom: 3px solid #1565c0;">
    <MudGrid Justify="Justify.Center" Class="align-center">

        @* --- FIELD TYPE DROPDOWN --- *@
        <MudItem xs="12" md="2">
            <MudSelect T="string" Label="Field Type" @bind-Value="selectedFieldType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@("Western Fields")" />
                <MudSelectItem Value="@("Eastern Fields")" />
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="2">
            <MudDatePicker Label="Select Previous Day" @bind-Date="_prevDate" Variant="Variant.Outlined" Color="Color.Secondary" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudDatePicker Label="Select Today's Date" @bind-Date="_todayDate" Variant="Variant.Outlined" Color="Color.Primary" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="RefreshData" StartIcon="@Icons.Material.Filled.Sync">Refresh</MudButton>

            @* --- SAVE CHANGES BUTTON --- *@
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveChanges" Disabled="@_isSaving" StartIcon="@Icons.Material.Filled.Save">
                @if (_isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">Saving...</span>
                }
                else
                {
                    <span>Save Changes</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="HandlePrint" StartIcon="@Icons.Material.Filled.LocalPrintshop">Print Report</MudButton>
        </MudItem>
    </MudGrid>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="a4-container">
        @* --- HEADER --- *@
        <table class="header-table">
            <tr>
                <td class="logo-box">
                    <img src="_content/OIL.Shared/imgs/oil.png" style="height: 45px;" /><br />
                    <b style="font-size: 9px;">OIL INDIA</b>
                </td>
                <td class="title-box">
                    <div style="font-size: 14px; font-weight: bold;">Instrumentation Department, Field Headquarters </div>
                    <div style="font-size: 11px;">यंत्रीकरण विभाग, क्षेत्र मुख्यालय, दुलियाजान </div>
                    <div style="font-size: 15px; font-weight: 800; margin-top: 5px;">दैनिक रिपोर्ट / DAILY REPORT </div>
                </td>
                <td class="meta-box">
                    Date: <b>@(_todayDate?.ToString("dd-MM-yyyy"))</b><br />
                    Ref. No.: <b>INST/FM-WF/@(_todayDate?.ToString("ddMMyy"))</b><br />
                    Field: <b>@selectedFieldType</b><br />
                    Generated: <b>@DateTime.Now.ToString("dd-MM-yyyy HH:mm")</b>
                </td>
            </tr>
        </table>

        <div class="section-banner">
            <table class="header-table">
                <tr>
                    <td><b>To : विभाग अध्यक्ष (यंत्रीकरण) / HOD (Instrumentation)</b></td>
                    <td><b>Through : अनुभाग प्रमुख / Section Head (Inst. - Field Maintenance)</b></td>
                </tr>
            </table>
        </div>

        @* --- PREVIOUS DAY SECTION --- *@
        <div class="section-banner">
            <span>Previous Day Job Carried Out: @(_prevDate?.ToString("dd-MM-yyyy"))</span>
        </div>
        <table class="report-table">
            <thead>
                <tr>
                    <th style="width: 30px;">SL</th>
                    <th style="width: 50px;">SHIFT</th>
                    <th style="width: 80px;">NOTIF. NO.</th>
                    <th style="width: 140px;">INSTALLATION</th>
                    <th style="width: 100px;">EQUIPMENT</th>
                    <th style="width: 60px;">TAG NO.</th>
                    <th class="text-left">FIELD REPORT</th>
                    <th>JOB DONE</th>
                    <th>SPARE USED</th>
                    <th style="width: 70px;">REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int prevSl = 1;
                }
                @foreach (var assignment in _prevDayEntries)
                {
                    @if (assignment.JobIds != null)
                    {
                        foreach (var jobId in assignment.JobIds)
                        {
                            var job = _jobs.FirstOrDefault(j => j.Id == jobId);
                            if (job == null) continue;

                            if (!string.IsNullOrEmpty(selectedFieldType))
                            {
                                var loc = _locations.FirstOrDefault(l => l.Id == job.LocationId);
                                if (loc == null || !string.Equals(loc.FieldType, selectedFieldType, StringComparison.OrdinalIgnoreCase))
                                    continue;
                            }

                            <tr>
                                <td>@(prevSl++)</td>
                                <td><textarea class="editable-cell" @bind="assignment.ShiftName"></textarea></td>
                                <td><textarea class="editable-cell" @bind="job.NotificationNumber"></textarea></td>

                                <td class="text-left">@GetLocationName(job.LocationId)</td>
                                <td>@GetEquipmentName(job.LocTagNumber)</td>

                                <td><textarea class="editable-cell" @bind="job.LocTagNumber"></textarea></td>
                                <td class="text-left"><textarea class="editable-cell text-left" @bind="job.JobName"></textarea></td>
                                <td class="text-left"><textarea class="editable-cell text-left" @bind="job.JobActionRemarks"></textarea></td>
                                <td><textarea class="editable-cell text-left" @bind="job.JobSpareReplaced"></textarea></td>

                                @* Previous day remarks column was explicitly empty in original layout *@
                                <td><textarea class="editable-cell text-left" placeholder="Type notes..."></textarea></td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        @* --- TODAY'S PLANNED SECTION --- *@
        <div class="section-banner" style="margin-top: 15px;">
            <span>Today's Planned Jobs: @(_todayDate?.ToString("dd-MM-yyyy"))</span>
        </div>
        <table class="report-table">
            <thead>
                <tr>
                    <th style="width: 30px;">SL</th>
                    <th style="width: 50px;">SHIFT</th>
                    <th style="width: 80px;">NOTIF. NO.</th>
                    <th style="width: 140px;">INSTALLATION</th>
                    <th style="width: 100px;">EQUIPMENT</th>
                    @* <th style="width: 80px;">DEVICE</th> *@
                    <th class="text-left">FIELD REPORT</th>
                    <th style="width: 80px;">VEHICLE</th>
                    <th style="width: 150px;">PERSON</th>
                    <th style="width: 70px;">REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int todaySl = 1;
                }
                @foreach (var assignment in _todayEntries)
                {
                    @if (assignment.JobIds != null)
                    {
                        foreach (var jobId in assignment.JobIds)
                        {
                            var job = _jobs.FirstOrDefault(j => j.Id == jobId);
                            if (job == null) continue;

                            if (!string.IsNullOrEmpty(selectedFieldType))
                            {
                                var loc = _locations.FirstOrDefault(l => l.Id == job.LocationId);
                                if (loc == null || !string.Equals(loc.FieldType, selectedFieldType, StringComparison.OrdinalIgnoreCase))
                                    continue;
                            }

                            <tr>
                                <td>@(todaySl++)</td>
                                <td><textarea class="editable-cell" @bind="assignment.ShiftName"></textarea></td>
                                <td><textarea class="editable-cell" @bind="job.NotificationNumber"></textarea></td>

                                <td class="text-left">@GetLocationName(job.LocationId)</td>
                                <td>@GetEquipmentName(job.LocTagNumber)</td>

                                @* <td><textarea class="editable-cell text-left" @bind="job.JobName"></textarea></td> *@
                                <td class="text-left"><textarea class="editable-cell text-left" @bind="job.Description"></textarea></td>

                                <td class="text-left">@GetDriverVehicleNumber(assignment.DriverId)</td>
                                <td class="text-left">@(assignment.PersonnelIds != null ? string.Join(", ", assignment.PersonnelIds.Select(GetEngineerName)) : "")</td>

                                @* Maps to real column assignment.JobOvertime numeric property *@
                                <td>
                                    <input type="number" step="0.5" class="editable-cell" @bind="assignment.JobOvertime" style="text-align: center;" placeholder="OT Hrs" />
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        @* --- FOOTER --- *@
        <div class="footer-container">
            <div class="signature-section">
                <div><b>Prepared By:</b> <span class="handwritten">_____________</span></div>
                <div><b>Signature:</b> <span class="handwritten">______________</span></div>
                <div><b>Date:</b> <span class="handwritten">@(_todayDate?.ToString("dd/MM/yy"))</span></div>
            </div>

            <div class="stats-card">
                @{
                    var totalTodayJobs = todaySl - 1;
                }
                <div style="font-size: 16px;">Today's Jobs: @totalTodayJobs</div>
            </div>
        </div>
    </div>
}




@code {
    private DateTime? _prevDate = DateTime.Today.AddDays(-1);
    private DateTime? _todayDate = DateTime.Today;
    private bool _loading = true;
    private bool _isSaving = false;

    private List<Assignment> _prevDayEntries = new(), _todayEntries = new();
    private List<Driver> _drivers = new();
    private List<Job> _jobs = new();
    private List<Engineer> _engineers = new();
    private List<Location> _locations = new();
    private List<Marker> _markers = new();

    private string selectedFieldType = "Eastern Fields";

    protected override async Task OnInitializedAsync() => await RefreshData();

    private async Task RefreshData()
    {
        _loading = true;
        try
        {
            _drivers = (await SupabaseClient.From<Driver>().Get()).Models;
            _jobs = (await SupabaseClient.From<Job>().Get()).Models;
            _engineers = (await SupabaseClient.From<Engineer>().Get()).Models;
            _locations = (await SupabaseClient.From<Location>().Get()).Models;
            _markers = (await SupabaseClient.From<Marker>().Get()).Models;


            // Construct unambiguous IST boundaries explicitly for the API request
            string prevStartStr = $"{_prevDate?.ToString("yyyy-MM-dd")}T00:00:00+05:30";
            string prevEndStr = $"{_prevDate?.AddDays(1).ToString("yyyy-MM-dd")}T00:00:00+05:30";

            string todayStartStr = $"{_todayDate?.ToString("yyyy-MM-dd")}T00:00:00+05:30";
            string todayEndStr = $"{_todayDate?.AddDays(1).ToString("yyyy-MM-dd")}T00:00:00+05:30";

            var rawPrevDayEntries = (await SupabaseClient.From<Assignment>()
            .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, prevStartStr)
            .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, prevEndStr)
            .Get()).Models;

            var rawTodayEntries = (await SupabaseClient.From<Assignment>()
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, todayStartStr)
                .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, todayEndStr)
                .Get()).Models;

            // var todayStr = _todayDate?.ToString("yyyy-MM-dd");
            // var prevStr = _prevDate?.ToString("yyyy-MM-dd");

            // var rawPrevDayEntries = (await SupabaseClient.From<Assignment>()
            //     .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, prevStr)
            //     .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _prevDate?.AddDays(1).ToString("yyyy-MM-dd"))
            //     .Get()).Models;

            // var rawTodayEntries = (await SupabaseClient.From<Assignment>()
            //     .Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, todayStr)
            //     .Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _todayDate?.AddDays(1).ToString("yyyy-MM-dd"))
            //     .Get()).Models;

            if (!string.IsNullOrEmpty(selectedFieldType))
            {
                _prevDayEntries = FilterAssignmentsByFieldType(rawPrevDayEntries, selectedFieldType);
                _todayEntries = FilterAssignmentsByFieldType(rawTodayEntries, selectedFieldType);
            }
            else
            {
                _prevDayEntries = rawPrevDayEntries;
                _todayEntries = rawTodayEntries;
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ExecuteTimeCalculations()
    {
        string tzId = OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata";
        TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);
        DateTime currentIstTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, istZone);

        foreach (var assignment in _todayEntries)
        {
            if (assignment.CreatedAtIst.HasValue)
            {
                // Calculation Example 1: Finding exact duration elapsed in standard hours
                double hoursElapsed = (currentIstTime - assignment.CreatedAtIst.Value).TotalHours;

                // Calculation Example 2: Dynamically checking shift validation rules
                if (assignment.CreatedAtIst.Value.Hour >= 22 || assignment.CreatedAtIst.Value.Hour < 6)
                {
                    // Logic for Night Shift validation adjustments...
                }
            }
        }
    }


    private async Task SaveChanges()
    {
        _isSaving = true;
        StateHasChanged();

        try
        {
            var displayedJobIds = _prevDayEntries.SelectMany(a => a.JobIds ?? new List<Guid>())
                .Concat(_todayEntries.SelectMany(a => a.JobIds ?? new List<Guid>()))
                .Distinct()
                .ToHashSet();

            var jobsToUpdate = _jobs.Where(j => displayedJobIds.Contains(j.Id)).ToList();
            var assignmentsToUpdate = _prevDayEntries.Concat(_todayEntries).DistinctBy(a => a.Id).ToList();

            // 1. Update Jobs
            foreach (var job in jobsToUpdate)
            {
                await SupabaseClient.From<Job>().Update(job);
            }

            // 2. Update Assignments
            foreach (var assignment in assignmentsToUpdate)
            {
                await SupabaseClient.From<Assignment>().Update(assignment);
            }

            Snackbar?.Add("Changes saved safely to database!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar?.Add($"Error saving changes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private List<Assignment> FilterAssignmentsByFieldType(List<Assignment> assignments, string fieldType)
    {
        var validLocationIds = _locations
            .Where(l => string.Equals(l.FieldType, fieldType, StringComparison.OrdinalIgnoreCase))
            .Select(l => l.Id)
            .ToHashSet();

        var validJobIds = _jobs
            .Where(j => j.LocationId.HasValue && validLocationIds.Contains(j.LocationId.Value))
            .Select(j => j.Id)
            .ToHashSet();

        return assignments
            .Where(a => a.JobIds != null && a.JobIds.Any(id => validJobIds.Contains(id)))
            .ToList();
    }

    private string GetLocationName(long? locationId)
    {
        if (!locationId.HasValue) return "";
        return _locations.FirstOrDefault(l => l.Id == locationId.Value)?.InstallationName ?? "";
    }

    private string GetEquipmentName(string tagNumber)
    {
        if (string.IsNullOrWhiteSpace(tagNumber)) return "";
        return _markers.FirstOrDefault(m => m.TagNumber == tagNumber)?.InstrumentName ?? "";
    }

    private string GetDriverVehicleNumber(long? driverId)
    {
        if (!driverId.HasValue) return "";
        return _drivers.FirstOrDefault(d => d.Id == driverId.Value)?.VehicleNumber ?? "";
    }

    private string GetEngineerName(long id) => _engineers.FirstOrDefault(e => e.Id == id)?.FullName ?? "";

    private async Task HandlePrint() => await JS.InvokeVoidAsync("window.print");

    // --- MODELS (CLEANED UP FROM DEPRECATED COLUMNS) ---
    [Table("job_assignments")]
    public class Assignment : BaseModel
    {
        [PrimaryKey("id")] public Guid Id { get; set; }
        [Column("created_at")] public DateTime? CreatedAt { get; set; } // Kept as UTC for DB sync

        // Cross-platform safe property for displaying and calculating in IST
        public DateTime? CreatedAtIst
        {
            get
            {
                if (!CreatedAt.HasValue) return null;

                // Handle cross-platform differences between Windows & Linux/Docker host timezone IDs
                string tzId = OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata";
                TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);

                // Explicitly mark incoming DB time as UTC, then convert
                DateTime utcTime = DateTime.SpecifyKind(CreatedAt.Value, DateTimeKind.Utc);
                return TimeZoneInfo.ConvertTimeFromUtc(utcTime, istZone);
            }
        }
