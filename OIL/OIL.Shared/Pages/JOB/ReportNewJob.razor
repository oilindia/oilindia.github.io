@page "/reportnewjob"
@using OIL.Shared.Models
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.IO
@inject Client SupabaseClient
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject IDialogService DialogService
@using System.Security.Claims
@using OIL.Shared.Services

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-10">
    <MudGrid>
        @* --- SECTION 1: JOB REPORTING FORM --- *@
        <MudItem xs="12">
            <MudPaper Elevation="4" Class="pa-6" Style="border-left: 8px solid var(--mud-palette-primary); border-radius: 12px;">
                <MudText Typo="Typo.h5" Class="mb-4"><b>Report New Instrumentation Job</b></MudText>
                
                <MudForm @ref="_form" @bind-IsValid="@_success">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Job/Problem Title" Required="true" 
                                          @bind-Value="_newJob.JobName" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Notification Number" 
                                          @bind-Value="_newJob.NotificationNumber" Variant="Variant.Outlined" Placeholder="e.g. 10002345" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudDatePicker Label="Job Date"
                                           @bind-Date="_newJob.CreatedAt"
                                           Variant="Variant.Outlined"
                                           Required="true"
                                           Editable="true"
                                           Placeholder="Select Date" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Job Type" @bind-Value="_newJob.JobType" Variant="Variant.Outlined" Required="true">
                                <MudSelectItem Value="@("breakdown")">Breakdown</MudSelectItem>
                                <MudSelectItem Value="@("preventive")">Preventive</MudSelectItem>
                                <MudSelectItem Value="@("project")">Project Work</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        @* --- FIELD FILTER CONTROLS --- *@
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Field Area" Value="_selectedFieldArea" ValueChanged="OnFieldAreaChanged" Variant="Variant.Outlined">
                                <MudSelectItem Value="@("All")">All Areas</MudSelectItem>
                                <MudSelectItem Value="@("Eastern Fields")" />
                                <MudSelectItem Value="@("Western Fields")" />
                                <MudSelectItem Value="@("Other")" />
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Installation Type" Value="_selectedInstType" ValueChanged="OnInstTypeChanged" Variant="Variant.Outlined">
                                <MudSelectItem Value="@("All")">All Types</MudSelectItem>
                                <MudSelectItem Value="@("FGS")" />
                                <MudSelectItem Value="@("FGGS")" />
                                <MudSelectItem Value="@("WHS")" />
                                <MudSelectItem Value="@("OCS")" />
                                <MudSelectItem Value="@("GCS")" />
                                <MudSelectItem Value="@("SPF")" />
                                <MudSelectItem Value="@("EPS")" />
                                <MudSelectItem Value="@("QPS")" />
                                <MudSelectItem Value="@("OTHER")" />
                            </MudSelect>
                        </MudItem>

                        @* --- MAIN INSTALLATION LOCATION --- *@
                        @* ToStringFunc="@(loc => loc?.Id == -1 ? "Other (Manual Entry)" : loc?.InstallationName)" *@
                        <MudItem xs="12" md="4">
                            <MudSelect T="LocationTable" Label="Installation Location" 
                                       Value="@_selectedLocation" 
                                       ValueChanged="OnLocationChanged"
                                      
                                       ToStringFunc="@((Func<LocationTable?, string?>)(loc => loc?.Id == -1 ? "Other (Manual Entry)" : loc?.InstallationName))"
                                       Variant="Variant.Outlined" Required="!_isManualLocation"
                                       HelperText="Select to load instrumentation markers">
                                @foreach (var loc in _filteredLocations)
                                {
                                    <MudSelectItem Value="@loc">@loc.InstallationName</MudSelectItem>
                                }
                                <MudSelectItem Value="@_manualLocationPlaceholder"><i>+ Installation Not Listed (Manual Entry)</i></MudSelectItem>
                            </MudSelect>
                            @if (_isManualLocation)
                            {
                                <MudTextField T="string" Class="mt-2" Label="Specify Installation Location" @bind-Value="_manualLocationText" Variant="Variant.Outlined" Required="true" />
                            }
                        </MudItem>

                        @* --- DYNAMIC CASCADE DROPDOWNS --- *@
                        
                        @* 1. GCS INSTRUMENT LOCATION (Only visible if Installation Type is GCS) *@
                        @if (_selectedInstType == "GCS")
                        {
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="If GCS Instrument - Location"
                                           Value="@_selectedGCSInstrument"
                                           ValueChanged="OnGCSInstrumentChanged"
                                           Variant="Variant.Outlined" Required="!_isManualGCSInstrument"
                                           Disabled="@(_selectedLocation == null || _isManualLocation)">
                                    @foreach (var val in _gcsInstrumentOptions)
                                    {
                                        <MudSelectItem Value="@val">@val</MudSelectItem>
                                    }
                                    <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Instrument Not Listed (Manual Entry)</i></MudSelectItem>
                                </MudSelect>
                                @if (_isManualGCSInstrument)
                                {
                                    <MudTextField T="string" Class="mt-2" Label="Specify GCS Instrument Location" @bind-Value="_manualGCSInstrumentText" Variant="Variant.Outlined" Required="true"/>
                                }
                            </MudItem>
                        }

                        

                        @* 2. DEVICE LOCATION *@
                        @* Required="!_isManualDeviceLocation" *@
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Device Location"
                                       Value="@_selectedDeviceLocation"
                                       ValueChanged="OnDeviceLocationChanged"
                                       Variant="Variant.Outlined" 
                                       Required="false" 
                                       Clearable="true" 
                                       
                                       Disabled="@(_selectedLocation == null || _isManualLocation)">
                                @foreach (var val in _deviceLocationOptions)
                                {
                                    <MudSelectItem Value="@val">@val</MudSelectItem>
                                }
                                <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Device Location Not Listed (Manual Entry)</i></MudSelectItem>
                            </MudSelect>
                            @if (_isManualDeviceLocation)
                            {
                                <MudTextField T="string" Class="mt-2" Label="Specify Device Location" @bind-Value="_manualDeviceLocationText" Variant="Variant.Outlined" Required="true"/>
                            }
                        </MudItem>

                        @* 3. INSTRUMENT TYPE *@
                        @* Required="!_isManualInstrumentType" *@
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Instrument Type"
                                       Value="@_selectedInstrumentType"
                                       ValueChanged="OnInstrumentTypeChanged"
                                       Variant="Variant.Outlined" 
                                       Required="false" 
                                       Clearable="true" 
                                       
                                       Disabled="@(_selectedLocation == null || _isManualLocation || (string.IsNullOrEmpty(_selectedDeviceLocation) && !_isManualDeviceLocation))">
                                @foreach (var val in _instrumentTypeOptions)
                                {
                                    <MudSelectItem Value="@val">@val</MudSelectItem>
                                }
                                <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Type Not Listed (Manual Entry)</i></MudSelectItem>
                            </MudSelect>
                            @if (_isManualInstrumentType)
                            {
                                <MudTextField T="string" Class="mt-2" Label="Specify Instrument Type" @bind-Value="_manualInstrumentTypeText" Variant="Variant.Outlined" Required="true"/>
                            }
                        </MudItem>

                        @* 4. TAG NUMBER *@
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Tag Number"
                                       Value="@_selectedTagNumber"
                                       ValueChanged="OnTagNumberChanged"
                                       Variant="Variant.Outlined"
                                       Required="false" 
                                       Clearable="true" 
                                       Disabled="@(_selectedLocation == null || _isManualLocation || (string.IsNullOrEmpty(_selectedInstrumentType) && !_isManualInstrumentType))">
                                @foreach (var val in _tagNumberOptions)
                                {
                                    <MudSelectItem Value="@val">@val</MudSelectItem>
                                }
                                <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Tag Not Listed (Manual Entry)</i></MudSelectItem>
                            </MudSelect>
                            @if (_isManualTagNumber)
                            {
                                <MudTextField T="string" Class="mt-2" Label="Specify Tag Number"
                                              @bind-Value="_manualTagNumberText" Variant="Variant.Outlined"
                                              Required="false" />
                            }
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="Priority Level" @bind-Value="_newJob.Priority" Variant="Variant.Outlined">
                                <MudSelectItem Value="@("Low")" />
                                <MudSelectItem Value="@("Normal")" />
                                <MudSelectItem Value="@("High")" />
                                <MudSelectItem Value="@("Emergency")" />
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="8">
                            <MudTextField T="string" Label="Detailed Description" Lines="2" 
                                          @bind-Value="_newJob.Description" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Photos (@(_tempFiles.Count))</MudText>
                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesSelected" Multiple Accept=".jpg,.jpeg,.png">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PhotoCamera">Add Photos</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            
                            @if (_tempFiles.Any())
                            {
                                <div class="mt-3">
                                    @foreach (var file in _tempFiles)
                                    {
                                        <MudChip T="IBrowserFile" OnClose="@(() => _tempFiles.Remove(file))" Color="Color.Primary">@file.Name</MudChip>
                                    }
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end pt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                       Disabled="@(!_success || _isProcessing)" OnClick="SubmitJob">
                                @if (_isProcessing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                Submit & Log Job
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudPaper>
        </MudItem>

        @* --- SECTION 2: SEARCH & HISTORY --- *@
        <MudItem xs="12" Class="mt-6">
            <MudPaper Class="pa-4 mb-4">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="_searchQuery" Label="Search Title" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect T="long?" Label="Location" @bind-Value="_filterLocId" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var loc in _allLocations) { <MudSelectItem T="long?" Value="@loc.Id">@loc.InstallationName</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDateRangePicker Label="Date Range" @bind-DateRange="_dateRange" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-end">
                        <MudButton FullWidth Variant="Variant.Filled" Color="Color.Info" OnClick="LoadData">Filter</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudTable Items="@_displayJobs" Hover Dense Loading="@_loadingTable" T="JobModel">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Job Title</MudTh>
                    <MudTh>Location</MudTh>
                    <MudTh>Priority</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CreatedAt?.ToLocalTime().ToString("dd/MM/yy HH:mm")</MudTd>
                    <MudTd><b>@context.JobName</b></MudTd>
                    <MudTd>@GetLocationName(context.LocationId)</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)">@context.Priority</MudChip></MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip></MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" OnClick="@(() => OpenDetails(context, false))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => OpenDetails(context, true))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => ConfirmDelete(context))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

@* --- MODAL OVERLAY --- *@
@if (_isModalOpen)
{
    <div style="position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center;">
        <MudPaper Style="width: 700px; max-width: 95%; max-height: 90vh; overflow-y: auto; padding: 24px; border-top: 6px solid var(--mud-palette-primary);" Elevation="25">
            <MudText Typo="Typo.h6" Class="mb-4">@(_isEditMode ? "Edit Job Details" : "View Job Details")</MudText>
            
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField Label="Job Title" @bind-Value="_selectedJob.JobName" ReadOnly="!_isEditMode" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="long?" Label="Location" @bind-Value="_selectedJob.LocationId" ReadOnly="!_isEditMode" Variant="Variant.Outlined">
                         @foreach (var loc in _allLocations) { <MudSelectItem T="long?" Value="@loc.Id">@loc.InstallationName</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Status" @bind-Value="_selectedJob.Status" ReadOnly="!_isEditMode" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("pending")" />
                        <MudSelectItem Value="@("in-progress")" />
                        <MudSelectItem Value="@("completed")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Priority" @bind-Value="_selectedJob.Priority" ReadOnly="!_isEditMode" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Low")" /><MudSelectItem Value="@("Normal")" /><MudSelectItem Value="@("High")" /><MudSelectItem Value="@("Emergency")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Description" @bind-Value="_selectedJob.Description" ReadOnly="!_isEditMode" Lines="3" Variant="Variant.Outlined" />
                </MudItem>
                
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Stored Photos</MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @if (_loadingPhotos) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                        else if (!_jobPhotos.Any()) { <MudText Typo="Typo.caption">No photos found.</MudText> }
                        else {
                            @foreach (var p in _jobPhotos) {
                                <img src="@p" style="width: 100px; height: 100px; object-fit: cover; border-radius: 4px; cursor: pointer; border: 1px solid #ddd;" @onclick="@(() => JS.InvokeVoidAsync("open", p, "_blank"))" />
                            }
                        }
                    </div>
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end gap-2 mt-6">
                <MudButton OnClick="() => _isModalOpen = false" Variant="Variant.Text">Close</MudButton>
                @if (_isEditMode)
                {
                    <MudButton OnClick="UpdateJob" Variant="Variant.Filled" Color="Color.Primary">Update Job</MudButton>
                }
            </div>
        </MudPaper>
    </div>
}





@code {
    private MudForm _form = null!;
    private bool _success, _isProcessing, _loadingTable, _loadingPhotos, _isModalOpen, _isEditMode;
    private string _searchQuery = "";
    private long? _filterLocId;
    private DateRange _dateRange = new DateRange(DateTime.Now.AddDays(-7), DateTime.Now);

    private string? _selectedFieldArea = "All";
    private string? _selectedInstType = "All";

    // Top-level dropdown model bindings
    private LocationTable? _selectedLocation;
    private string? _selectedGCSInstrument;
    private string? _selectedDeviceLocation;
    private string? _selectedInstrumentType;
    private string? _selectedTagNumber;

    // Manual validation flags & string fields
    private bool _isManualLocation;
    private string _manualLocationText = "";
    private bool _isManualGCSInstrument;
    private string _manualGCSInstrumentText = "";
    private bool _isManualDeviceLocation;
    private string _manualDeviceLocationText = "";
    private bool _isManualInstrumentType;
    private string _manualInstrumentTypeText = "";
    private bool _isManualTagNumber;
    private string _manualTagNumberText = "";

    // Virtual fallbacks
    private readonly LocationTable _manualLocationPlaceholder = new() { Id = -1, InstallationName = "Other (Manual Entry)" };
    private readonly string _manualTextPlaceholder = "__MANUAL_ENTRY_SELECTED__";

    private JobModel _newJob = new() { Priority = "Normal", Status = "pending", JobType = "breakdown", CreatedAt = DateTime.Now };
    private JobModel _selectedJob = new();

    private List<JobModel> _displayJobs = new();
    private List<LocationTable> _allLocations = new();
    private List<LocationTable> _filteredLocations = new();
    private List<PidMarkerTable> _currentLocationMarkers = new(); // Raw markers for active location

    // Dynamic distinct text arrays for dropdown binding options
    private List<string> _gcsInstrumentOptions = new();
    private List<string> _deviceLocationOptions = new();
    private List<string> _instrumentTypeOptions = new();
    private List<string> _tagNumberOptions = new();

    private List<IBrowserFile> _tempFiles = new();
    private List<string> _jobPhotos = new();

    [Table("jobs")] public class JobModel : BaseModel {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("created_at")] public DateTime? CreatedAt { get; set; }
        [Column("job_name")] public string JobName { get; set; } = "";
        [Column("location_id")] public long? LocationId { get; set; } 
        [Column("notification_number")] public string? NotificationNumber { get; set; }
        [Column("field_type")] public string? FieldArea { get; set; }
        [Column("installation_type")] public string? InstallationType { get; set; }
        [Column("priority")] public string Priority { get; set; } = "Normal";
        [Column("status")] public string Status { get; set; } = "pending";
        [Column("description")] public string Description { get; set; } = "";
        [Column("reported_by_email")] public string ReportedByEmail { get; set; } = "";
        [Column("reported_by_id")] public string? ReportedById { get; set; }
        [Column("job_type")] public string JobType { get; set; } = "breakdown";

        [Column("device_location")] public string? DeviceLocation { get; set; } = "";
        [Column("instrument_type")] public string? InstrumentType { get; set; } = ""; 
        [Column("loc_tag_number")] public string? Loc_Tag_Number { get; set; } = "";


    }

    [Table("job_photos")] public class JobPhotoModel : BaseModel {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("storage_path")] public string StoragePath { get; set; } = "";
    }

    [Table("locations")] public class LocationTable : BaseModel {
        [PrimaryKey("id")] public long Id { get; set; }
        [Column("installation_name")] public string? InstallationName { get; set; }
        [Column("field_type")] public string? FieldArea { get; set; }
        [Column("installation_type")] public string? InstallationType { get; set; }
    }

    [Table("pid_markers")] public class PidMarkerTable : BaseModel {
        [PrimaryKey("id")] public long Id { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("tag_number")] public string? TagNumber { get; set; }
        [Column("instrument_type")] public string? InstrumentType { get; set; }
        [Column("device_location")] public string? DeviceLocation { get; set; }
        [Column("Instrument")] public string? Instrument { get; set; }
        [Column("location_type")] public string? LocationType { get; set; }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }
    private string _email = "";
    private string _fullName = "";
    private string _designation = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                _email = user.GetEmail();
                _fullName = user.GetFullName();
                _designation = user.GetDesignation();

            }
        }
        await LoadData();
    } 

    private string GetLocationName(long? id) => _allLocations.FirstOrDefault(l => l.Id == id)?.InstallationName ?? "Manual Entry / Unknown";

    private async Task LoadData() {
        _loadingTable = true;
        try {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.Identity?.Name;
            bool isAdmin = authState.User.IsInRole("Admin") || authState.User.IsInRole("Manager");

            // _allLocations = (await SupabaseClient.From<LocationTable>().Get()).Models;

            _allLocations = (await SupabaseClient.From<LocationTable>()
    .Order(x => x.InstallationName, Supabase.Postgrest.Constants.Ordering.Ascending)
    .Get()).Models;

    //         _allLocations = (await SupabaseClient.From<LocationTable>()
    // .Order("installation_name", Supabase.Postgrest.Constants.Ordering.Ascending)
    // .Get()).Models;

            _filteredLocations = _allLocations;

            var request = SupabaseClient.From<JobModel>();

            if (!isAdmin && !string.IsNullOrEmpty(userEmail)) 
                request.Filter("reported_by_email", Supabase.Postgrest.Constants.Operator.Equals, userEmail);

            if (!string.IsNullOrWhiteSpace(_searchQuery)) 
                request.Filter("job_name", Supabase.Postgrest.Constants.Operator.ILike, $"%{_searchQuery}%");

            if (_filterLocId.HasValue) 
                request.Filter("location_id", Supabase.Postgrest.Constants.Operator.Equals, _filterLocId.Value.ToString());

            if (_dateRange.Start.HasValue) 
                request.Filter("created_at", Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, _dateRange.Start.Value.ToString("yyyy-MM-dd"));
            
            if (_dateRange.End.HasValue) 
                request.Filter("created_at", Supabase.Postgrest.Constants.Operator.LessThan, _dateRange.End.Value.AddDays(1).ToString("yyyy-MM-dd"));

            var result = await request.Order("created_at", Supabase.Postgrest.Constants.Ordering.Descending).Get();
            _displayJobs = result.Models;
        } catch (Exception ex) { Snackbar.Add("Error loading layout: " + ex.Message, Severity.Error); }
        finally { _loadingTable = false; StateHasChanged(); }
    }

    private async Task OnFieldAreaChanged(string area) {
        _selectedFieldArea = area;
        _newJob.FieldArea = (area == "All") ? null : area;
        await FilterLocations();
    }

    private async Task OnInstTypeChanged(string type) {
        _selectedInstType = type;
        _newJob.InstallationType = (type == "All") ? null : type;
        await FilterLocations();
    }

    private async Task FilterLocations() {
        var query = SupabaseClient.From<LocationTable>();
        var filters = new Dictionary<string, string>();

        if (!string.IsNullOrEmpty(_selectedFieldArea) && _selectedFieldArea != "All") 
            filters.Add("field_type", _selectedFieldArea);
            
        if (!string.IsNullOrEmpty(_selectedInstType) && _selectedInstType != "All")
            filters.Add("installation_type", _selectedInstType);

        if (filters.Any()) {
            var result = await query.Match(filters).Get();
            _filteredLocations = result.Models;
        } else {
            _filteredLocations = _allLocations;
        }

        ResetAllCascadingFormDropdowns();
        StateHasChanged();
    }

    private void ResetAllCascadingFormDropdowns() {
        _selectedLocation = null;
        _currentLocationMarkers.Clear();
        _isManualLocation = false;
        _manualLocationText = "";
        _newJob.LocationId = null;

        ClearGCSInstrumentState();
        ClearDeviceLocationState();
        ClearInstrumentTypeState();
        ClearTagNumberState();
    }

    // --- CASCADING ACTION STATE MACHINE HANDLERS ---

    private async Task OnLocationChanged(LocationTable loc) {
        _selectedLocation = loc;
        _isManualLocation = (loc?.Id == -1);
        _newJob.LocationId = _isManualLocation ? null : loc?.Id;

        // Clear children
        _currentLocationMarkers.Clear();
        ClearGCSInstrumentState();
        ClearDeviceLocationState();
        ClearInstrumentTypeState();
        ClearTagNumberState();

        if (loc != null && !_isManualLocation) {
            try {
                // Fetch context tags matching the active Location configuration key
                var response = await SupabaseClient.From<PidMarkerTable>()
                    .Filter("location_id", Supabase.Postgrest.Constants.Operator.Equals, loc.Id.ToString())
                    .Get();
                _currentLocationMarkers = response.Models;

                // Load initial state options
                BuildGCSInstrumentOptions();
                BuildDeviceLocationOptions();
            }
            catch (Exception ex) { Snackbar.Add("Error downloading markers: " + ex.Message, Severity.Error); }
        }
        StateHasChanged();
    }

    private void OnGCSInstrumentChanged(string value) {
        _selectedGCSInstrument = value;
        _isManualGCSInstrument = (value == _manualTextPlaceholder);
        if (_isManualGCSInstrument) _manualGCSInstrumentText = "";

        // Cascading reset down the pipeline
        ClearDeviceLocationState();
        ClearInstrumentTypeState();
        ClearTagNumberState();

        BuildDeviceLocationOptions();
        StateHasChanged();
    }

    private void OnDeviceLocationChanged(string value) {
        _selectedDeviceLocation = value;
        _isManualDeviceLocation = (value == _manualTextPlaceholder);
        if (_isManualDeviceLocation) _manualDeviceLocationText = "";

        // Cascading reset down the pipeline
        ClearInstrumentTypeState();
        ClearTagNumberState();

        BuildInstrumentTypeOptions();
        StateHasChanged();
    }

    private void OnInstrumentTypeChanged(string value) {
        _selectedInstrumentType = value;
        _isManualInstrumentType = (value == _manualTextPlaceholder);
        if (_isManualInstrumentType) _manualInstrumentTypeText = "";

        // Cascading reset down the pipeline
        ClearTagNumberState();

        BuildTagNumberOptions();
        StateHasChanged();
    }

    private void OnTagNumberChanged(string value) {
        _selectedTagNumber = value;
        _isManualTagNumber = (value == _manualTextPlaceholder);
        if (_isManualTagNumber) _manualTagNumberText = "";
        StateHasChanged();
    }

    // --- PIPELINE COMPILATION CONTROLLERS ---

    private void BuildGCSInstrumentOptions() {
        _gcsInstrumentOptions = _currentLocationMarkers
            .Where(m => !string.IsNullOrEmpty(m.Instrument))
            .Select(m => m.Instrument!)
            .Distinct()
            .ToList();
    }

    private void BuildDeviceLocationOptions() {
        var query = _currentLocationMarkers.AsEnumerable();

        // 1. Filter sequentially on GCS parent choices if applicable
        if (_selectedInstType == "GCS" && !_isManualGCSInstrument && !string.IsNullOrEmpty(_selectedGCSInstrument)) {
            query = query.Where(m => m.Instrument == _selectedGCSInstrument);
        }

        _deviceLocationOptions = query
            .Where(m => !string.IsNullOrEmpty(m.DeviceLocation))
            .Select(m => m.DeviceLocation!)
            .Distinct()
            .ToList();
    }

    private void BuildInstrumentTypeOptions() {
        var query = _currentLocationMarkers.AsEnumerable();

        if (_selectedInstType == "GCS" && !_isManualGCSInstrument && !string.IsNullOrEmpty(_selectedGCSInstrument)) {
            query = query.Where(m => m.Instrument == _selectedGCSInstrument);
        }
        if (!_isManualDeviceLocation && !string.IsNullOrEmpty(_selectedDeviceLocation)) {
            query = query.Where(m => m.DeviceLocation == _selectedDeviceLocation);
        }

        _instrumentTypeOptions = query
            .Where(m => !string.IsNullOrEmpty(m.InstrumentType))
            .Select(m => m.InstrumentType!)
            .Distinct()
            .ToList();
    }

    private void BuildTagNumberOptions() {
        var query = _currentLocationMarkers.AsEnumerable();

        if (_selectedInstType == "GCS" && !_isManualGCSInstrument && !string.IsNullOrEmpty(_selectedGCSInstrument)) {
            query = query.Where(m => m.Instrument == _selectedGCSInstrument);
        }
        if (!_isManualDeviceLocation && !string.IsNullOrEmpty(_selectedDeviceLocation)) {
            query = query.Where(m => m.DeviceLocation == _selectedDeviceLocation);
        }
        if (!_isManualInstrumentType && !string.IsNullOrEmpty(_selectedInstrumentType)) {
            query = query.Where(m => m.InstrumentType == _selectedInstrumentType);
        }

        _tagNumberOptions = query
            .Where(m => !string.IsNullOrEmpty(m.TagNumber))
            .Select(m => m.TagNumber!)
            .Distinct()
            .ToList();
    }

    // --- STATE RECOVERY CLEANSERS ---

    private void ClearGCSInstrumentState() {
        _selectedGCSInstrument = null; _isManualGCSInstrument = false; _manualGCSInstrumentText = ""; _gcsInstrumentOptions.Clear();
    }
    private void ClearDeviceLocationState() {
        _selectedDeviceLocation = null; _isManualDeviceLocation = false; _manualDeviceLocationText = ""; _deviceLocationOptions.Clear();
    }
    private void ClearInstrumentTypeState() {
        _selectedInstrumentType = null; _isManualInstrumentType = false; _manualInstrumentTypeText = ""; _instrumentTypeOptions.Clear();
    }
    private void ClearTagNumberState() {
        _selectedTagNumber = null; _isManualTagNumber = false; _manualTagNumberText = ""; _tagNumberOptions.Clear();
    }

    // --- POST TRANSACTION ENTRY ---

    private async Task SubmitJob()
    {
        if (_isProcessing) return;
        _isProcessing = true;
        try
        {
            var manualCompilation = new List<string>();

            // Compile Locations metadata safely
            if (_isManualLocation && !string.IsNullOrWhiteSpace(_manualLocationText))
                manualCompilation.Add($"[Inst Loc: {_manualLocationText}]");

            // Compile dynamic sub-dropdown metrics
            if (_selectedInstType == "GCS")
            {
                var gcsVal = _isManualGCSInstrument ? _manualGCSInstrumentText : _selectedGCSInstrument;
                if (!string.IsNullOrWhiteSpace(gcsVal) && gcsVal != _manualTextPlaceholder)
                    manualCompilation.Add($"[GCS Inst: {gcsVal}]");
            }

            var devVal = _isManualDeviceLocation ? _manualDeviceLocationText : _selectedDeviceLocation;
            if (!string.IsNullOrWhiteSpace(devVal) && devVal != _manualTextPlaceholder)
                manualCompilation.Add($"[Device Loc: {devVal}]");

            var typeVal = _isManualInstrumentType ? _manualInstrumentTypeText : _selectedInstrumentType;
            if (!string.IsNullOrWhiteSpace(typeVal) && typeVal != _manualTextPlaceholder)
                manualCompilation.Add($"[Inst Type: {typeVal}]");

            // Unified & Optional Tag Number Evaluation Block
            var tagVal = _isManualTagNumber ? _manualTagNumberText : _selectedTagNumber;
            if (!string.IsNullOrWhiteSpace(tagVal) && tagVal != _manualTextPlaceholder)
            {
                manualCompilation.Add($"[Tag No: {tagVal}]");
                _newJob.Loc_Tag_Number = tagVal; // Directly populates the structural table field
            }
            else
            {
                _newJob.Loc_Tag_Number = null; // Cleanly falls back to null if skipped or cleared
            }

            // Append metadata tags directly down onto details payload summary string column
            if (manualCompilation.Any())
            {
                _newJob.Description = $"{string.Join(" ", manualCompilation)} - {_newJob.Description}".TrimEnd(' ', '-');
            }

            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            _newJob.Id = Guid.NewGuid();
            _newJob.CreatedAt = _newJob.CreatedAt;
            _newJob.ReportedByEmail = user.Identity?.Name ?? "unknown";

            _newJob.ReportedById = _email?.ToString() ?? "unknown";

            var jobRes = await SupabaseClient.From<JobModel>().Insert(_newJob);
            var confirmed = jobRes.Models.FirstOrDefault();

            if (confirmed != null && _tempFiles.Any())
            {
                foreach (var file in _tempFiles)
                {
                    var path = $"{confirmed.Id}/{Guid.NewGuid()}_{file.Name}";
                    using var stream = file.OpenReadStream(10 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    await SupabaseClient.Storage.From("job-photos").Upload(ms.ToArray(), path);
                    await SupabaseClient.From<JobPhotoModel>().Insert(new JobPhotoModel { Id = Guid.NewGuid(), JobId = confirmed.Id, StoragePath = path });
                }
            }
            Snackbar.Add("Job Logged successfully!", Severity.Success);

            _tempFiles.Clear();
            _newJob = new JobModel { Priority = "Normal", Status = "pending", JobType = "breakdown" };
            _selectedFieldArea = "All";
            _selectedInstType = "All";
            ResetAllCascadingFormDropdowns();
            _filteredLocations = _allLocations;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Submission Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }



    private async Task OpenDetails(JobModel job, bool edit) {
        _selectedJob = new JobModel {
            Id = job.Id, JobName = job.JobName, LocationId = job.LocationId,
            Status = job.Status, Priority = job.Priority, Description = job.Description,
            CreatedAt = job.CreatedAt, ReportedByEmail = job.ReportedByEmail
        };
        
        _isEditMode = edit;
        _isModalOpen = true;
        _loadingPhotos = true;
        _jobPhotos.Clear();
        StateHasChanged();

        try {
            var res = await SupabaseClient.From<JobPhotoModel>().Where(x => x.JobId == job.Id).Get();
            foreach (var p in res.Models) {
                _jobPhotos.Add(SupabaseClient.Storage.From("job-photos").GetPublicUrl(p.StoragePath));
            }
        } catch {} finally { _loadingPhotos = false; StateHasChanged(); }
    }

    private async Task UpdateJob() {
        try {
            await SupabaseClient.From<JobModel>().Update(_selectedJob);
            _isModalOpen = false;
            await LoadData();
            Snackbar.Add("Job Updated", Severity.Success);
        } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ConfirmDelete(JobModel job) {
        var result = await DialogService.ShowMessageBoxAsync("Delete Job", 
            "Are you sure? This will delete the job and all associated records.", 
            "Delete Everything", "Cancel");

        if (result == true) {
            try {
                var photos = await SupabaseClient.From<JobPhotoModel>().Where(x => x.JobId == job.Id).Get();
                var paths = photos.Models.Select(p => p.StoragePath).ToList();
                await SupabaseClient.From<JobPhotoModel>().Where(x => x.JobId == job.Id).Delete();
                if (paths.Any()) await SupabaseClient.Storage.From("job-photos").Remove(paths);

                await SupabaseClient.From<JobModel>().Where(x => x.Id == job.Id).Set(x => x.Status, "Deleted").Update();
                Snackbar.Add("Job marked as deleted", Severity.Info);
                await LoadData();
            } catch (Exception ex) { Snackbar.Add("Delete Error: " + ex.Message, Severity.Error); }
        }
    }

    private void OnFilesSelected(IReadOnlyList<IBrowserFile> files) { if (files != null) _tempFiles.AddRange(files); }
    private Color GetPriorityColor(string p) => p switch { "Emergency" => Color.Error, "High" => Color.Warning, "Normal" => Color.Info, _ => Color.Default };
    private Color GetStatusColor(string s) => s?.ToLower() switch { "pending" => Color.Warning, "in-progress" => Color.Info, "completed" => Color.Success, _ => Color.Default };
}