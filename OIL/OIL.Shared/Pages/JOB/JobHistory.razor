@page "/jobhistory"

@using System.Data
@using ClosedXML.Excel
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using MudBlazor
@using Microsoft.JSInterop

@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Models
@using Supabase.Postgrest.Attributes
@using Newtonsoft.Json
@using System.Globalization
@using System.Runtime.Serialization

@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IJSRuntime JSRuntime
@inject OIL.Shared.Services.AttendanceService AttendanceData
@using MemberType = OIL.Shared.Pages.JOB.JobAssign.Member

@using Supabase.Postgrest.Attributes;
@using Supabase.Postgrest.Models;
@using System.Runtime.Serialization;


@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <MudPaper Class="pa-4 mb-4">

        <MudGrid>

            <MudItem xs="12" sm="3">
                <MudDatePicker Label="From Date"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudDatePicker Label="To Date"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="3" Class="d-flex align-center">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadJobHistory">

                    Search Jobs

                </MudButton>

            </MudItem>

            <MudItem xs="12" sm="3" Class="d-flex align-center">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportToExcel">

                    Export Excel

                </MudButton>

            </MudItem>

        </MudGrid>

    </MudPaper>

    <MudTable Items="_jobHistory"
              Hover="true"
              Dense="true"
              Bordered="true"
              Striped="true"
              Loading="_loading"
              Elevation="4">

        <HeaderContent>

            <MudTh>Job Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Location ID</MudTh>
            <MudTh>Area</MudTh>
            <MudTh>Installation</MudTh>
            <MudTh>Installation Type</MudTh>
            <MudTh>Engineers</MudTh>
            <MudTh>Driver</MudTh>
            <MudTh>Vehicle</MudTh>
            <MudTh>Action</MudTh>
            <MudTh>Action By</MudTh>
            <MudTh>Action Time</MudTh>
            <MudTh>Overtime</MudTh>
            <MudTh>Priority</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Remarks</MudTh>
            <MudTh>PM Status</MudTh>
            <MudTh>PM Remarks</MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>@context.JobName</MudTd>

            <MudTd>

                <MudChip T="string"
                         Color="@(context.JobStatus == "completed" ? Color.Success : Color.Warning)">

                    @context.JobStatus

                </MudChip>

            </MudTd>

            <MudTd>@context.JobType</MudTd>

            <MudTd>@context.LocationId</MudTd>

            <MudTd>@context.AreaName</MudTd>

            <MudTd>@context.InstallationName</MudTd>

            <MudTd>@context.InstallationType</MudTd>

            <MudTd>

                @foreach (var eng in context.Engineers)
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Class="mr-1 mb-1">

                        @eng

                    </MudChip>
                }

            </MudTd>

            <MudTd>@context.DriverName</MudTd>

            <MudTd>@context.VehicleNumber</MudTd>

            <MudTd>@context.JobAction</MudTd>

            <MudTd>@context.JobActionBy</MudTd>

            <MudTd>

                @(context.JobActionTime?.ToString("dd-MMM-yyyy HH:mm"))

            </MudTd>

            <MudTd>@context.JobOverTime</MudTd>

            <MudTd>@context.Priority</MudTd>

            <MudTd Style="max-width:300px; white-space:pre-wrap;">
                @context.Description
            </MudTd>

            <MudTd Style="max-width:300px; white-space:pre-wrap;">
                @context.JobActionRemarks
            </MudTd>

            <MudTd>@context.PmWorkStatus</MudTd>

            <MudTd Style="max-width:300px; white-space:pre-wrap;">
                @context.PmRemarks
            </MudTd>

        </RowTemplate>

    </MudTable>

</MudContainer>

@code
{
    #region TABLE MODELS

    [Table("jobs")]
    public class Job : BaseModel
    {
        [PrimaryKey("id", false)]
        public Guid Id { get; set; }

        [Column("job_name")]
        public string JobName { get; set; }

        [Column("location_id")]
        public long? LocationId { get; set; }

        [Column("status")]
        public string Status { get; set; }

        [Column("job_type")]
        public string JobType { get; set; }

        [Column("priority")]
        public string Priority { get; set; }

        [Column("description")]
        public string Description { get; set; }

        [Column("created_at")]
        public DateTime? CreatedAt { get; set; }

        [Column("job_action_remarks")]
        public string JobActionRemarks { get; set; }
    }

    [Table("job_assignments")]
    public class JobAssignment : BaseModel
    {
        [PrimaryKey("id", false)]
        public Guid Id { get; set; }

        [Column("job_ids")]
        public List<Guid> JobIds { get; set; }

        [Column("personnel_ids")]
        public List<long> PersonnelIds { get; set; }

        [Column("driver_id")]
        public long? DriverId { get; set; }

        [Column("job_action")]
        public string JobAction { get; set; }

        [Column("job_action_time")]
        public DateTime? JobActionTime { get; set; }

        [Column("job_action_by")]
        public string JobActionBy { get; set; }

        [Column("job_action_remarks")]
        public string JobActionRemarks { get; set; }

        [Column("status")]
        public string Status { get; set; }

        [Column("job_overtime")]
        public float? JobOverTime { get; set; }

        [Column("created_at")]
        public DateTime? CreatedAt { get; set; }
    }

    [Table("locations")]
    public class Location : BaseModel
    {
        [PrimaryKey("id", false)]
        public long Id { get; set; }

        [Column("area_name")]
        public string AreaName { get; set; }

        [Column("installation_name")]
        public string InstallationName { get; set; }

        [Column("installation_type")]
        public string InstallationType { get; set; }
    }

    [Table("employees_engineers")]
    public class Engineer : BaseModel
    {
        [PrimaryKey("id", false)]
        public long Id { get; set; }

        [Column("full_name")]
        public string FullName { get; set; }

        [Column("designation")]
        public string Designation { get; set; }
    }

    [Table("drivers")]
    public class Driver : BaseModel
    {
        [PrimaryKey("id", false)]
        public long Id { get; set; }

        [Column("full_name")]
        public string FullName { get; set; }

        [Column("vehicle_number")]
        public string VehicleNumber { get; set; }
    }

    [Table("pm_reports")]
    public class PmReport : BaseModel
    {
        [PrimaryKey("id", false)]
        public int Id { get; set; }

        [Column("job_id")]
        public Guid JobId { get; set; }

        [Column("work_status")]
        public string WorkStatus { get; set; }

        [Column("remarks")]
        public string Remarks { get; set; }
    }

    #endregion

    #region VIEWMODEL

    public class JobHistoryViewModel
    {
        public Guid JobId { get; set; }

        public string JobName { get; set; }

        public string JobStatus { get; set; }

        public string JobType { get; set; }

        public long? LocationId { get; set; }

        public string AreaName { get; set; }

        public string InstallationName { get; set; }

        public string InstallationType { get; set; }

        public List<string> Engineers { get; set; } = new();

        public string DriverName { get; set; }

        public string VehicleNumber { get; set; }

        public string JobAction { get; set; }

        public string JobActionBy { get; set; }

        public DateTime? JobActionTime { get; set; }

        public float? JobOverTime { get; set; }

        public string JobActionRemarks { get; set; }

        public string Priority { get; set; }

        public string Description { get; set; }

        public string PmWorkStatus { get; set; }

        public string PmRemarks { get; set; }
    }

    #endregion

    private bool _loading = false;

    private DateTime? _fromDate = DateTime.Today.AddDays(-30);

    private DateTime? _toDate = DateTime.Today;

    private List<JobHistoryViewModel> _jobHistory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadJobHistory();
    }

    private async Task LoadJobHistory()
    {
        try
        {
            _loading = true;

            _jobHistory.Clear();

            // JOB ASSIGNMENTS
            var assignmentRes = await SupabaseClient
                .From<JobAssignment>()
                .Get();

            var assignments = assignmentRes.Models;

            // JOBS
            var jobRes = await SupabaseClient
                .From<Job>()
                .Get();

            var jobs = jobRes.Models;

            // LOCATIONS
            var locationRes = await SupabaseClient
                .From<Location>()
                .Get();

            var locations = locationRes.Models;

            // ENGINEERS
            var engineerRes = await SupabaseClient
                .From<Engineer>()
                .Get();

            var engineers = engineerRes.Models;

            // DRIVERS
            var driverRes = await SupabaseClient
                .From<Driver>()
                .Get();

            var drivers = driverRes.Models;

            // PM REPORTS
            var pmRes = await SupabaseClient
                .From<PmReport>()
                .Get();

            var pmReports = pmRes.Models;

            foreach (var assignment in assignments)
            {
                if (_fromDate.HasValue &&
                    assignment.CreatedAt.HasValue &&
                    assignment.CreatedAt.Value.Date < _fromDate.Value.Date)
                    continue;

                if (_toDate.HasValue &&
                    assignment.CreatedAt.HasValue &&
                    assignment.CreatedAt.Value.Date > _toDate.Value.Date)
                    continue;

                if (assignment.JobIds == null)
                    continue;

                foreach (var jobId in assignment.JobIds)
                {
                    Job foundJob = null;

                    foreach (var job in jobs)
                    {
                        if (job.Id == jobId)
                        {
                            foundJob = job;
                            break;
                        }
                    }

                    if (foundJob == null)
                        continue;

                    Location foundLocation = null;

                    foreach (var loc in locations)
                    {
                        if (loc.Id == foundJob.LocationId)
                        {
                            foundLocation = loc;
                            break;
                        }
                    }

                    Driver foundDriver = null;

                    foreach (var drv in drivers)
                    {
                        if (drv.Id == assignment.DriverId)
                        {
                            foundDriver = drv;
                            break;
                        }
                    }

                    List<string> engineerNames = new();

                    if (assignment.PersonnelIds != null)
                    {
                        foreach (var engId in assignment.PersonnelIds)
                        {
                            foreach (var eng in engineers)
                            {
                                if (eng.Id == engId)
                                {
                                    engineerNames.Add(eng.FullName);
                                    break;
                                }
                            }
                        }
                    }

                    PmReport foundPm = null;

                    foreach (var pm in pmReports)
                    {
                        if (pm.JobId == foundJob.Id)
                        {
                            foundPm = pm;
                            break;
                        }
                    }

                    _jobHistory.Add(new JobHistoryViewModel
                    {
                        JobId = foundJob.Id,
                        JobName = foundJob.JobName,
                        JobStatus = foundJob.Status,
                        JobType = foundJob.JobType,
                        LocationId = foundJob.LocationId,
                        Priority = foundJob.Priority,
                        Description = foundJob.Description,

                        AreaName = foundLocation?.AreaName,
                        InstallationName = foundLocation?.InstallationName,
                        InstallationType = foundLocation?.InstallationType,

                        Engineers = engineerNames,

                        DriverName = foundDriver?.FullName,
                        VehicleNumber = foundDriver?.VehicleNumber,

                        JobAction = assignment.JobAction,
                        JobActionBy = assignment.JobActionBy,
                        JobActionTime = assignment.JobActionTime,
                        JobOverTime = assignment.JobOverTime,
                        JobActionRemarks = assignment.JobActionRemarks,

                        PmWorkStatus = foundPm?.WorkStatus,
                        PmRemarks = foundPm?.Remarks
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            using var workbook = new XLWorkbook();

            var worksheet = workbook.Worksheets.Add("Job History");

            worksheet.Cell(1, 1).Value = "Job Name";
            worksheet.Cell(1, 2).Value = "Status";
            worksheet.Cell(1, 3).Value = "Type";
            worksheet.Cell(1, 4).Value = "Location ID";
            worksheet.Cell(1, 5).Value = "Area";
            worksheet.Cell(1, 6).Value = "Installation";
            worksheet.Cell(1, 7).Value = "Installation Type";
            worksheet.Cell(1, 8).Value = "Engineers";
            worksheet.Cell(1, 9).Value = "Driver";
            worksheet.Cell(1, 10).Value = "Vehicle";
            worksheet.Cell(1, 11).Value = "Action";
            worksheet.Cell(1, 12).Value = "Action By";
            worksheet.Cell(1, 13).Value = "Action Time";
            worksheet.Cell(1, 14).Value = "Overtime";
            worksheet.Cell(1, 15).Value = "Priority";
            worksheet.Cell(1, 16).Value = "Description";
            worksheet.Cell(1, 17).Value = "Remarks";
            worksheet.Cell(1, 18).Value = "PM Status";
            worksheet.Cell(1, 19).Value = "PM Remarks";

            int row = 2;

            foreach (var item in _jobHistory)
            {
                worksheet.Cell(row, 1).Value = item.JobName;
                worksheet.Cell(row, 2).Value = item.JobStatus;
                worksheet.Cell(row, 3).Value = item.JobType;
                worksheet.Cell(row, 4).Value = item.LocationId;
                worksheet.Cell(row, 5).Value = item.AreaName;
                worksheet.Cell(row, 6).Value = item.InstallationName;
                worksheet.Cell(row, 7).Value = item.InstallationType;
                worksheet.Cell(row, 8).Value = string.Join(", ", item.Engineers);
                worksheet.Cell(row, 9).Value = item.DriverName;
                worksheet.Cell(row, 10).Value = item.VehicleNumber;
                worksheet.Cell(row, 11).Value = item.JobAction;
                worksheet.Cell(row, 12).Value = item.JobActionBy;
                worksheet.Cell(row, 13).Value = item.JobActionTime?.ToString("dd-MMM-yyyy HH:mm");
                worksheet.Cell(row, 14).Value = item.JobOverTime;
                worksheet.Cell(row, 15).Value = item.Priority;
                worksheet.Cell(row, 16).Value = item.Description;
                worksheet.Cell(row, 17).Value = item.JobActionRemarks;
                worksheet.Cell(row, 18).Value = item.PmWorkStatus;
                worksheet.Cell(row, 19).Value = item.PmRemarks;

                row++;
            }

            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            var content = stream.ToArray();

            var fileName = $"JobHistory_{DateTime.Now:ddMMyyyyHHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFile",
                fileName,
                Convert.ToBase64String(content)
            );
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}