@page "/ot-others"
@using Supabase
@inject Client SupabaseClient
@inject IJSRuntime JS

<style>
    .ot-dashboard {
        font-family: Arial, sans-serif;
        padding: 20px;
        position: relative;
    }

    .header-controls {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        align-items: center;
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
    }

    .main-content {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .grid-container {
        flex: 3;
        overflow-x: auto;
        background: white;
        border: 1px solid #ddd;
    }

    .ot-grid {
        border-collapse: collapse;
        width: 100%;
        min-width: 700px;
    }

        .ot-grid th, .ot-grid td {
            border: 2px solid black;
            padding: 0;
            text-align: center;
            min-width: 75px;
        }

        .ot-grid th {
            background-color: #f1f1f1;
            font-weight: bold;
            padding: 10px 5px;
        }

        .ot-grid td.cell-active {
            cursor: pointer;
            position: relative;
        }

            .ot-grid td.cell-active:hover {
                background-color: #e2e6ea;
            }

        .ot-grid td.selected {
            background-color: #0d6efd !important;
        }

    .ot-input {
        width: 100%;
        height: 100%;
        min-height: 38px;
        min-width: 70px;
        box-sizing: border-box;
        text-align: center;
        border: none;
        background: transparent;
        font-size: 15px;
    }

        .ot-input:focus {
            outline: 2px solid #28a745;
            background: #fff;
            z-index: 10;
            position: relative;
        }

    .selected .ot-input {
        color: white;
        font-weight: bold;
    }

    .side-panel {
        flex: 1;
        border: 2px solid black;
        padding: 20px;
        min-width: 300px;
        background: #fff;
        box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
    }

        .side-panel h3 {
            margin-top: 0;
            border-bottom: 1px solid #ccc;
            padding-bottom: 10px;
        }

    .form-group {
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-group input {
            padding: 8px;
            border: 1px solid #ccc;
        }

    .btn-save {
        background-color: #0d6efd;
        color: white;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        font-size: 16px;
        border-radius: 4px;
    }

        .btn-save:hover {
            background-color: #0b5ed7;
        }

    .btn-bulk-save {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 25px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        border-radius: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-bulk-save:hover:not(:disabled) {
            background-color: #218838;
        }

        .btn-bulk-save:disabled {
            background-color: #6c757d;
            cursor: not-allowed;
            opacity: 0.8;
        }

    .btn-close {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
        width: 100%;
        margin-top: 10px;
    }

    .bottom-section {
        margin-top: 40px;
    }

    .top-20-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

        .top-20-table th, .top-20-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        .top-20-table th {
            background-color: #343a40;
            color: white;
        }

    .charts-container {
        display: flex;
        gap: 30px;
        margin-top: 20px;
    }

    .chart-box {
        flex: 1;
        border: 1px solid #ddd;
        padding: 15px;
        background: white;
        height: 350px;
        position: relative;
        display: flex;
        justify-content: center;
    }

    /* Fullscreen Spinner Overlay */
    .spinner-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        color: white;
    }

    .spinner {
        border: 6px solid #f3f3f3;
        border-top: 6px solid #0d6efd;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

@if (IsSaving)
{
    <div class="spinner-overlay">
        <div class="spinner"></div>
        <p style="margin-top: 18px; font-weight: bold; font-size: 18px;">Saving entries to database...</p>
    </div>
}

<div class="ot-dashboard">
    <h2>Instrumentation Department - Overtime Entry</h2>

    <div class="header-controls">
        <div>
            <label>Section:</label>
            <select value="@SelectedSection" @onchange="OnSectionChanged">
                <option value="All">All</option>
                <option value="Projects">Projects</option>
                <option value="P&A">P&A</option>
                <option value="Others">Others</option>
                <option value="Office">Office</option>
            </select>
        </div>
        <div>
            <label>From Date:</label>
            <input type="date" @bind="StartDate" />
        </div>
        <div>
            <label>To Date:</label>
            <input type="date" @bind="EndDate" />
        </div>
        <button @onclick="LoadGridData" class="btn-save" disabled="@IsSaving">Load Grid</button>

        <button @onclick="SaveAllChanges" class="btn-bulk-save" disabled="@IsSaving" style="margin-left: auto;">
            @if (IsSaving)
            {
                <span>⏳ Saving...</span>
            }
            else
            {
                <span>💾 Save All Changes</span>
            }
        </button>
    </div>

    <div class="main-content">
        <div class="grid-container">
            @if (GridDates != null && Employees != null && Employees.Any())
            {
                <table class="ot-grid">
                    <thead>
                        <tr>
                            <th style="min-width: 180px;">Employee Name</th>
                            @foreach (var date in GridDates)
                            {
                                <th>@date.Day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Employees)
                        {
                            <tr>
                                <td style="white-space: nowrap; padding: 10px; text-align: left;"><strong>@emp.Name</strong></td>
                                @foreach (var date in GridDates)
                                {
                                    var key = $"{emp.Id}_{date:yyyyMMdd}";
                                    var isSelected = SelectedEmpId == emp.Id && SelectedDate == date;
                                    var entry = GetGridEntry(key);

                                    <td class="cell-active @(isSelected ? "selected" : "")"
                                        @onclick="() => OpenPanel(emp, date, key)">
                                        <input type="number"
                                               class="ot-input"
                                               value="@(entry.Hours == 0 ? "" : entry.Hours.ToString("0.#"))"
                                               @onchange="(e) => OnGridHoursInputChanged(e, key)"
                                               @onclick="() => OpenPanel(emp, date, key)"
                                               @onfocus="() => OpenPanel(emp, date, key)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="padding: 20px; font-weight: bold; color: red;">No employees found. Try selecting 'All' or change the dates.</p>
            }
        </div>

        @if (IsPanelOpen)
        {
            <div class="side-panel">
                <h3>Details (Optional)</h3>
                <p><strong>Name:</strong> @SelectedEmpName</p>
                <p><strong>Date:</strong> @SelectedDate.ToShortDateString()</p>

                <div class="form-group">
                    <label>OT Hours (F1)</label>
                    <input type="text"
                           value="@(CurrentEntry.Hours == 0 ? "" : CurrentEntry.Hours.ToString("0.#"))"
                           @onchange="OnPanelHoursInputChanged"
                           placeholder="0.0" />
                </div>
                <div class="form-group">
                    <label>From Time (F2)</label>
                    <input type="time" @bind="CurrentEntry.BindFromTime" />
                </div>
                <div class="form-group">
                    <label>To Time (F3)</label>
                    <input type="time" @bind="CurrentEntry.BindToTime" />
                </div>
                <div class="form-group">
                    <label>Reason (F4)</label>
                    <input type="text" list="reasonList" @bind="CurrentEntry.Reason" placeholder="Select or type reason..." />
                    <datalist id="reasonList">
                        @foreach (var reason in PredefinedReasons)
                        {
                            <option value="@reason" />
                        }
                    </datalist>
                </div>

                <p style="font-size: 12px; color: gray;">Changes here automatically apply to the grid cell. Click "Save All Changes" at the top to commit to the database.</p>
                <button class="btn-close" @onclick="() => IsPanelOpen = false">Done (Close Panel)</button>
            </div>
        }
    </div>

    <div class="bottom-section">
        <h3>Top 20 OT Hours (Selected Period)</h3>
        <table class="top-20-table">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Employee Name</th>
                    <th>Total OT Hours</th>
                    <th>Total Days with OT</th>
                </tr>
            </thead>
            <tbody>
                @if (Top20Employees != null && Top20Employees.Any())
                {
                    int rank = 1;
                    foreach (var stat in Top20Employees)
                    {
                        <tr>
                            <td>@rank</td>
                            <td>@stat.Name</td>
                            <td>@stat.TotalHours.ToString("0.#")</td>
                            <td>@stat.TotalDays</td>
                        </tr>
                        rank++;
                    }
                }
                else
                {
                    <tr><td colspan="4" style="text-align: center;">No overtime logged for this period.</td></tr>
                }
            </tbody>
        </table>

        <div class="charts-container">
            <div class="chart-box">
                <canvas id="reasonChart"></canvas>
            </div>
            <div class="chart-box">
                <canvas id="topEmployeeChart"></canvas>
            </div>
        </div>
    </div>
</div>

@code {
    private string SelectedSection { get; set; } = "All";
    private DateTime StartDate { get; set; } = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime EndDate { get; set; } = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month));

    private List<DateTime> GridDates = new();
    private List<Employee> Employees = new();
    private List<OTEntry> AllEntries = new();

    private Dictionary<string, OTEntry> GridState = new();

    private List<string> PredefinedReasons = new();
    private List<EmployeeStat> Top20Employees = new();

    private bool IsPanelOpen = false;
    private bool IsSaving = false;
    private long SelectedEmpId;
    private string SelectedEmpName;
    private DateTime SelectedDate;
    private OTEntry CurrentEntry = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGridData();
    }

    private async Task OnSectionChanged(ChangeEventArgs e)
    {
        SelectedSection = e.Value?.ToString() ?? "All";
        await LoadGridData();
    }

    private OTEntry GetGridEntry(string key)
    {
        if (GridState.TryGetValue(key, out var entry))
        {
            return entry;
        }

        return new OTEntry();
    }

    private string FormatDateKey(DateTime dt)
    {
        return dt.ToString("yyyy-MM-dd");
    }

    private async Task LoadGridData()
    {
        IsPanelOpen = false;
        GridDates.Clear();
        GridState.Clear();

        for (var dt = StartDate.Date; dt <= EndDate.Date; dt = dt.AddDays(1))
        {
            GridDates.Add(dt);
        }

        var empQuery = SupabaseClient.From<Employee>().Select("*");
        if (SelectedSection != "All")
        {
            empQuery = empQuery.Filter("section", Supabase.Postgrest.Constants.Operator.Equals, SelectedSection);
        }
        var empResponse = await empQuery.Get();
        Employees = empResponse.Models;

        var entryResponse = await SupabaseClient.From<OTEntry>()
            .Where(x => x.Date >= StartDate.Date && x.Date <= EndDate.Date)
            .Get();
        AllEntries = entryResponse.Models;

        foreach (var emp in Employees)
        {
            foreach (var date in GridDates)
            {
                var key = $"{emp.Id}_{date:yyyyMMdd}";
                var formattedTargetDate = FormatDateKey(date);

                var existing = AllEntries.FirstOrDefault(e =>
                    e.EmployeeId == emp.Id &&
                    FormatDateKey(e.Date) == formattedTargetDate);

                if (existing != null)
                {
                    GridState[key] = new OTEntry
                    {
                        Id = existing.Id,
                        EmployeeId = existing.EmployeeId,
                        Date = date,
                        Hours = Math.Round(existing.Hours, 1),
                        FromTime = existing.FromTime,
                        ToTime = existing.ToTime,
                        Reason = existing.Reason
                    };
                }
                else
                {
                    GridState[key] = new OTEntry
                    {
                        Id = 0,
                        EmployeeId = emp.Id,
                        Date = date,
                        Hours = 0
                    };
                }
            }
        }

        UpdatePredefinedReasons();
        CalculateTop20();
        await RenderCharts();
    }

    private void OpenPanel(Employee emp, DateTime date, string key)
    {
        SelectedEmpId = emp.Id;
        SelectedEmpName = emp.Name;
        SelectedDate = date;

        CurrentEntry = GetGridEntry(key);
        IsPanelOpen = true;
    }

    private void OnGridHoursInputChanged(ChangeEventArgs e, string key)
    {
        var entry = GetGridEntry(key);
        if (decimal.TryParse(e.Value?.ToString(), out decimal parsed))
        {
            entry.Hours = Math.Round(parsed, 1);
        }
        else
        {
            entry.Hours = 0;
        }
    }

    private void OnPanelHoursInputChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal parsed))
        {
            CurrentEntry.Hours = Math.Round(parsed, 1);
        }
        else
        {
            CurrentEntry.Hours = 0;
        }
    }

    private async Task SaveAllChanges()
    {
        if (IsSaving) return;

        try
        {
            IsSaving = true;
            StateHasChanged();
            await Task.Delay(50); // Yield control to ensure UI renders loader spinner immediately

            var dbResponse = await SupabaseClient.From<OTEntry>()
                .Where(x => x.Date >= StartDate.Date && x.Date <= EndDate.Date)
                .Get();
            var dbEntries = dbResponse.Models;

            var entriesToUpdate = new List<OTEntry>();
            var entriesToInsert = new List<OTEntry>();

            foreach (var kvp in GridState)
            {
                var entry = kvp.Value;
                entry.Hours = Math.Round(entry.Hours, 1);
                var targetDateString = FormatDateKey(entry.Date);

                var existingInDb = dbEntries.FirstOrDefault(e =>
                    e.EmployeeId == entry.EmployeeId &&
                    FormatDateKey(e.Date) == targetDateString);

                if (existingInDb != null)
                {
                    entry.Id = existingInDb.Id;
                }

                if (entry.Hours > 0 || entry.Id > 0)
                {
                    var cleanItem = new OTEntry
                    {
                        EmployeeId = entry.EmployeeId,
                        Date = DateTime.SpecifyKind(entry.Date.Date, DateTimeKind.Utc),
                        Hours = entry.Hours,
                        FromTime = entry.FromTime,
                        ToTime = entry.ToTime,
                        Reason = entry.Reason
                    };

                    if (entry.Id > 0)
                    {
                        cleanItem.Id = entry.Id;
                        entriesToUpdate.Add(cleanItem);
                    }
                    else
                    {
                        // New entry: leave Id as default/0 so Insert omits it and Postgres auto-generates primary key via sequence
                        entriesToInsert.Add(cleanItem);
                    }
                }
            }

            if (!entriesToUpdate.Any() && !entriesToInsert.Any())
            {
                await JS.InvokeVoidAsync("alert", "No changes detected to save.");
                return;
            }

            // Update existing records
            foreach (var item in entriesToUpdate)
            {
                await SupabaseClient.From<OTEntry>().Update(item);
            }

            // Bulk insert new records
            if (entriesToInsert.Any())
            {
                await SupabaseClient.From<OTEntry>().Insert(entriesToInsert);
            }

            await JS.InvokeVoidAsync("alert", "All changes saved successfully!");
            await LoadGridData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error saving entries: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private void UpdatePredefinedReasons()
    {
        PredefinedReasons = AllEntries
            .Where(e => !string.IsNullOrWhiteSpace(e.Reason))
            .Select(e => e.Reason.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void CalculateTop20()
    {
        Top20Employees = AllEntries
            .GroupBy(e => e.EmployeeId)
            .Select(g => new EmployeeStat
            {
                Name = Employees.FirstOrDefault(emp => emp.Id == g.Key)?.Name ?? "Unknown",
                TotalHours = Math.Round(g.Sum(e => e.Hours), 1),
                TotalDays = g.Count(e => e.Hours > 0)
            })
            .OrderByDescending(x => x.TotalHours)
            .Take(20)
            .ToList();
    }

    private async Task RenderCharts()
    {
        var reasonCounts = AllEntries
            .Where(e => !string.IsNullOrEmpty(e.Reason) && e.Hours > 0)
            .GroupBy(e => e.Reason)
            .Select(g => new { Reason = g.Key, Count = g.Count() })
            .ToList();

        var topEmpLabels = Top20Employees.Select(e => e.Name).ToArray();
        var topEmpData = Top20Employees.Select(e => e.TotalHours).ToArray();
        var reasonLabels = reasonCounts.Select(r => r.Reason).ToArray();
        var reasonData = reasonCounts.Select(r => r.Count).ToArray();

        var jsCode = $@"
            if(window.reasonChartInstance) window.reasonChartInstance.destroy();
            if(window.topEmpChartInstance) window.topEmpChartInstance.destroy();

            var ctx1 = document.getElementById('reasonChart').getContext('2d');
            window.reasonChartInstance = new Chart(ctx1, {{
                type: 'pie',
                data: {{
                    labels: {System.Text.Json.JsonSerializer.Serialize(reasonLabels)},
                    datasets: [{{ data: {System.Text.Json.JsonSerializer.Serialize(reasonData)}, backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'] }}]
                }},
                options: {{ 
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {{ title: {{ display: true, text: 'OT Reasons Breakdown' }} }} 
                }}
            }});

            var ctx2 = document.getElementById('topEmployeeChart').getContext('2d');
            window.topEmpChartInstance = new Chart(ctx2, {{
                type: 'bar',
                data: {{
                    labels: {System.Text.Json.JsonSerializer.Serialize(topEmpLabels)},
                    datasets: [{{ label: 'Total OT Hours', data: {System.Text.Json.JsonSerializer.Serialize(topEmpData)}, backgroundColor: '#36A2EB' }}]
                }},
                options: {{ 
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {{ title: {{ display: true, text: 'Top 20 Employees by OT Hours' }} }} 
                }}
            }});
        ";

        await JS.InvokeVoidAsync("eval", jsCode);
    }

    [Supabase.Postgrest.Attributes.Table("employees_engineers")]
    public class Employee : Supabase.Postgrest.Models.BaseModel
    {
        [Supabase.Postgrest.Attributes.PrimaryKey("id")]
        public long Id { get; set; }

        [Supabase.Postgrest.Attributes.Column("full_name")]
        public string Name { get; set; }

        [Supabase.Postgrest.Attributes.Column("section")]
        public string Section { get; set; }
    }

    [Supabase.Postgrest.Attributes.Table("ot_other_section")]
    public class OTEntry : Supabase.Postgrest.Models.BaseModel
    {
        [Supabase.Postgrest.Attributes.PrimaryKey("id", false)]
        public long Id { get; set; }

        [Supabase.Postgrest.Attributes.Column("employee_id")]
        public long EmployeeId { get; set; }

        [Supabase.Postgrest.Attributes.Column("ot_date")]
        public DateTime Date { get; set; }

        [Supabase.Postgrest.Attributes.Column("ot_hours")]
        public decimal Hours { get; set; }

        [Supabase.Postgrest.Attributes.Column("from_time")]
        public TimeSpan? FromTime { get; set; }

        [Supabase.Postgrest.Attributes.Column("to_time")]
        public TimeSpan? ToTime { get; set; }

        [Supabase.Postgrest.Attributes.Column("reason")]
        public string Reason { get; set; }

        [Newtonsoft.Json.JsonIgnore]
        public TimeOnly? BindFromTime
        {
            get => FromTime.HasValue ? TimeOnly.FromTimeSpan(FromTime.Value) : null;
            set => FromTime = value.HasValue ? value.Value.ToTimeSpan() : null;
        }

        [Newtonsoft.Json.JsonIgnore]
        public TimeOnly? BindToTime
        {
            get => ToTime.HasValue ? TimeOnly.FromTimeSpan(ToTime.Value) : null;
            set => ToTime = value.HasValue ? value.Value.ToTimeSpan() : null;
        }
    }

    public class EmployeeStat
    {
        public string Name { get; set; }
        public decimal TotalHours { get; set; }
        public int TotalDays { get; set; }
    }
}