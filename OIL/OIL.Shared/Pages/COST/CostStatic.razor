@page "/coststatic"
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models

@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

@using MudBlazor
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using static Supabase.Postgrest.Constants
@using System.Text.Json.Serialization
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@inject Client SupabaseClient

<style>
    .border-left-primary {
        border-left: 5px solid #594ae2;
    }

    .border-left-success {
        border-left: 5px solid #00c853;
    }

    .border-left-warning {
        border-left: 5px solid #ffb300;
    }

    .border-left-info {
        border-left: 5px solid #33a9ff;
    }

    .font-weight-bold {
        font-weight: 700;
    }
</style>


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Cost Analysis Dashboard</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Alignment="GridAlignment.Center">
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="Start Date" @bind-Date="_startDate" DateFormat="dd-MM-yyyy" Editable="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="End Date" @bind-Date="_endDate" DateFormat="dd-MM-yyyy" Editable="true" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshDashboardAsync" Disabled="_loading" StartIcon="@Icons.Material.Filled.Refresh" Class="mr-2">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Loading...</MudText>
                    }
                    else
                    {
                        <MudText>Refresh</MudText>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div class="d-flex flex-wrap align-center justify-center gap-4 mb-4 width-100">

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-primary" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Total Operations Cost</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalCalculatedCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">=</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-success" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Manpower Cost (Base)</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalEmployeeCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">+</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-warning" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Total Overtime Cost</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalOvertimeCost.ToString("N2")</MudText>
                <MudText Typo="Typo.caption" Class="text-muted mt-1 d-block">Hours: @TotalOvertimeHours.ToString("N1") hrs</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">+</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-info" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Travel & Logistics</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalTravelCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">+</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-secondary" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Spares Total</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalSparesCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

    </div>

    <style>
            .style-operator-shape {
                width: 44px;
                height: 44px;
                min-width: 44px;
                background-color: var(--mud-palette-background-grey, #f4f4f4);
                border: 2px solid var(--mud-palette-lines-inputs, #e0e0e0);
                border-radius: 50%;
                user-select: none;
                box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);
            }
    </style>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Style="height: 420px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Cost Breakdown Over Time (Daily Cumulative)</MudText>
                <canvas id="chartCumulative" style="width: 100%; height: 340px;"></canvas>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Style="height: 420px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Cost Share Composition</MudText>
                <canvas id="chartDonut" style="width: 100%; height: 340px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Style="height: 420px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Daily Cost Categories (Stacked)</MudText>
                <canvas id="chartDailyStacked" style="width: 100%; height: 340px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Quarterly Cost Projections</MudText>
                <canvas id="chartQuarterly" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Daily Overtime Analysis (Hours vs Headcount)</MudText>
                <canvas id="chartResourceTrend" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Cost Vector Profile</MudText>
                <canvas id="chartRadar" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Avg Cost per Personnel (Trend)</MudText>
                <canvas id="chartCostPerHead" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Processed Job Assignment Manifest</MudText>
        <MudTable Items="@GridRows" Hover="true" Striped="true" FixedHeader="true" Height="400px" Loading="@_loading" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Assignment ID</MudTh>
                <MudTh>Execution Date</MudTh>
                <MudTh Style="text-align: right;">OT Hours</MudTh>
                <MudTh Style="text-align: right;">OT Cost</MudTh>
                <MudTh Style="text-align: right;">Crew Size</MudTh>
                <MudTh Style="text-align: right;">Engineers Cost</MudTh>
                <MudTh Style="text-align: right;">Travel Cost</MudTh>
                <MudTh Style="text-align: right;">Spares/Parts Cost</MudTh>
                <MudTh Style="text-align: right; font-weight: bold;">Aggregate Cost</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Assignment ID"><MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text">@context.AssignmentId</MudChip></MudTd>
                <MudTd DataLabel="Execution Date">@context.CreatedAt.ToString("dd-MM-yyyy HH:mm")</MudTd>
                <MudTd DataLabel="OT Hours" Style="text-align: right;">@context.OvertimeHours.ToString("N1")</MudTd>
                <MudTd DataLabel="OT Cost" Style="text-align: right; color: var(--mud-palette-error);">₹ @context.OvertimeCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Crew Size" Style="text-align: right;">@context.PersonnelCount</MudTd>
                <MudTd DataLabel="Engineers Cost" Style="text-align: right;">₹ @context.EmployeeCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Travel Cost" Style="text-align: right;">₹ @context.TravelCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Spares/Parts Cost" Style="text-align: right;">₹ @context.SparesCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Aggregate Cost" Style="text-align: right; font-weight: bold; color: var(--mud-palette-primary);">₹ @context.RowTotalCost.ToString("N2")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.subtitle1" Class="text-center pa-4">No structural executions mapped within this time boundary filter context.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private bool _loading = false;
    private DateTime? _startDate = DateTime.Today.AddMonths(-1);
    private DateTime? _endDate = DateTime.Today;
    private const double HourlyOvertimeRate = 750.00;
    private const double VehicleMileageKmPerLiter = 8.0; // Set your fleet's standard mileage here

    public double TotalCalculatedCost { get; set; }
    public double TotalOvertimeHours { get; set; }
    public int TotalPmReportsMatched { get; set; }
    public int TotalAssignmentsProcessed { get; set; }
    public double TotalOvertimeCost { get; set; }
    public double TotalSparesCost { get; set; }
    public double TotalEmployeeCost { get; set; }
    public double TotalTravelCost { get; set; }

    public List<AssignmentGridRow> GridRows { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshDashboardAsync();
    }

    private async Task RefreshDashboardAsync()
    {
        


        _loading = true;
        StateHasChanged();

        TotalCalculatedCost = 0; TotalOvertimeHours = 0; TotalPmReportsMatched = 0; TotalAssignmentsProcessed = 0;
        TotalOvertimeCost = 0; TotalSparesCost = 0; TotalEmployeeCost = 0; TotalTravelCost = 0;
        GridRows.Clear();

        List<JobAssignmentModel> assignments = new();
        List<PmReportModel> pmReports = new();
        List<JobModel> jobs = new();
        List<EmployeeEngineerModel> employees = new();
        List<Location> locations = new();
        List<DieselPriceModel> dieselPrices = new();

        var start = (_startDate ?? DateTime.Today.AddMonths(-1)).Date;
        var end = (_endDate ?? DateTime.Today).Date.AddDays(1);

        try
        {
            var assignmentResponse = await SupabaseClient.From<JobAssignmentModel>()
                .Select("*").Filter("created_at", Operator.GreaterThanOrEqual, start.ToString("yyyy-MM-dd"))
                .Filter("created_at", Operator.LessThanOrEqual, end.ToString("yyyy-MM-dd")).Get();
            assignments = assignmentResponse.Models ?? new List<JobAssignmentModel>();

            var pmReportResponse = await SupabaseClient.From<PmReportModel>().Select("*").Get();
            pmReports = pmReportResponse.Models ?? new List<PmReportModel>();

            var jobsResponse = await SupabaseClient.From<JobModel>().Select("*").Get();
            jobs = jobsResponse.Models ?? new List<JobModel>();

            var employeeResponse = await SupabaseClient.From<EmployeeEngineerModel>().Select("*").Get();
            employees = employeeResponse.Models ?? new List<EmployeeEngineerModel>();

            var locationResponse = await SupabaseClient.From<Location>().Select("*").Get();
            locations = locationResponse.Models ?? new List<Location>();

            var dieselResponse = await SupabaseClient.From<DieselPriceModel>().Select("*").Get();
            dieselPrices = dieselResponse.Models ?? new List<DieselPriceModel>();

            if (_startDate.HasValue) assignments = assignments.Where(a => a.CreatedAt >= _startDate.Value).ToList();
            if (_endDate.HasValue) assignments = assignments.Where(a => a.CreatedAt <= _endDate.Value).ToList();

            TotalAssignmentsProcessed = assignments.Count;

            var uniqueDates = assignments.Select(a => a.CreatedAt.Date).Distinct().OrderBy(d => d).ToList();
            string[] labelsDaily = uniqueDates.Select(d => d.ToString("dd MMM")).ToArray();

            double[] dailyOvertime = new double[uniqueDates.Count];
            double[] dailySpares = new double[uniqueDates.Count];
            double[] dailyEmployee = new double[uniqueDates.Count];
            double[] dailyTravel = new double[uniqueDates.Count];

            double[] dailyPersonnelCount = new double[uniqueDates.Count];
            double[] dailyOtHours = new double[uniqueDates.Count];

            var dateToIndexMap = uniqueDates.Select((date, index) => new { date, index }).ToDictionary(x => x.date, x => x.index);

            double[] quarterlyOvertime = new double[4];
            double[] quarterlySpares = new double[4];
            double[] quarterlyEmployee = new double[4];
            double[] quarterlyTravel = new double[4];

            foreach (var assignment in assignments)
            {
                if (assignment.CreatedAt == DateTime.MinValue) continue;
                int quarter = (assignment.CreatedAt.Month - 1) / 3;
                if (quarter < 0 || quarter > 3) quarter = 0;

                var gridRowItem = new AssignmentGridRow { AssignmentId = assignment.Id, CreatedAt = assignment.CreatedAt };

                double otHours = assignment.JobOvertime ?? 0;
                TotalOvertimeHours += otHours;
                double calculatedOtCost = otHours * HourlyOvertimeRate;
                quarterlyOvertime[quarter] += calculatedOtCost;
                TotalOvertimeCost += calculatedOtCost;
                gridRowItem.OvertimeHours = otHours;
                gridRowItem.OvertimeCost = calculatedOtCost;

                double calculatedEmployeeCost = 0;
                int personnelCount = assignment.PersonnelIds?.Count ?? 0;
                if (assignment.PersonnelIds != null)
                {
                    foreach (var pIdStr in assignment.PersonnelIds)
                    {
                        if (long.TryParse(pIdStr, out long empId))
                        {
                            var emp = employees.FirstOrDefault(e => e.Id == empId);
                            if (emp != null && emp.AnnualCost.HasValue) calculatedEmployeeCost += (emp.AnnualCost.Value / 365.0);
                        }
                    }
                }
                quarterlyEmployee[quarter] += calculatedEmployeeCost;
                TotalEmployeeCost += calculatedEmployeeCost;
                gridRowItem.PersonnelCount = personnelCount;
                gridRowItem.EmployeeCost = calculatedEmployeeCost;

                // --- TRAVEL LOGISTICS LOOKUP START ---
                double calculatedTravelCost = 0;

                if (assignment.JobIds != null && assignment.JobIds.Any())
                {
                    // 1. Get unique location IDs for all jobs in this assignment to handle multi-stop routes
                    var locationIds = jobs
                        .Where(j => assignment.JobIds.Any(id => string.Equals(j.Id, id.Trim(), StringComparison.OrdinalIgnoreCase)) && j.LocationId.HasValue)
                        .Select(j => j.LocationId!.Value)
                        .Distinct();

                    //Console.WriteLine($"locationIds: {locationIds}");


                    // 2. Fetch the corresponding locations
                    var assignmentLocations = locations.Where(l => locationIds.Contains(l.Id));

                    //Console.WriteLine($"assignmentLocations: {assignmentLocations}");

                    // 3. Sum the round-trip distance (DistanceFhqKm * 2)
                    double totalRoundTripDistance = assignmentLocations.Sum(l => (l.DistanceFhqKm ?? 0f) * 2);

                    if (totalRoundTripDistance > 0)
                    {
                        var assignmentDate = assignment.CreatedAt.Date;

                        // 4. Fetch the nearest available Diesel Price
                        var nearestDieselRecord = dieselPrices
                            .Where(p => p.PriceDate.HasValue && p.DieselPrice.HasValue && p.DieselPrice > 0)
                            .OrderBy(p => Math.Abs((p.PriceDate.Value - assignmentDate).TotalDays))
                            .FirstOrDefault();

                        // Added 90.00 fallback in case diesel table is completely empty
                        double dieselPrice = nearestDieselRecord?.DieselPrice ?? 90.00;

                        // 5. Calculate: (Total Round Trip Distance / Mileage) * Diesel Price
                        calculatedTravelCost = (totalRoundTripDistance / VehicleMileageKmPerLiter) * dieselPrice;

                        //Console.WriteLine($"calculatedTravelCost: {calculatedTravelCost}");
                    }
                }
                else
                {
                    //Console.WriteLine($"calculatedTravelCost  ELSE BLOCK: {calculatedTravelCost}");
                }



                quarterlyTravel[quarter] += calculatedTravelCost;
                TotalTravelCost += calculatedTravelCost;
                gridRowItem.TravelCost = calculatedTravelCost;
                // --- TRAVEL LOGISTICS LOOKUP END ---

                // double itemSparesCost = 0;
                // if (assignment.JobIds != null && assignment.JobIds.Any())
                // {
                //     foreach (var jobId in assignment.JobIds)
                //     {
                //         if (string.IsNullOrWhiteSpace(jobId)) continue;
                //         var matchedPm = pmReports.FirstOrDefault(p => string.Equals(p.JobId, jobId, StringComparison.OrdinalIgnoreCase));
                //         if (matchedPm != null) { itemSparesCost += matchedPm.ApproxTotalCost ?? 0; TotalPmReportsMatched++; }
                //         var matchedJob = jobs.FirstOrDefault(j => string.Equals(j.Id, jobId, StringComparison.OrdinalIgnoreCase));
                //         if (matchedJob != null) { itemSparesCost += matchedJob.PartsCost ?? 0; }
                //     }
                // }
                // quarterlySpares[quarter] += itemSparesCost;
                // TotalSparesCost += itemSparesCost;
                // gridRowItem.SparesCost = itemSparesCost;

                // gridRowItem.RowTotalCost = calculatedOtCost + calculatedEmployeeCost + calculatedTravelCost + itemSparesCost;
                // GridRows.Add(gridRowItem);

                // --- SPARES COST CALCULATION START ---
                double itemSparesCost = 0;

                if (assignment.JobIds != null && assignment.JobIds.Any())
                {
                    // 1. Clean the incoming IDs to prevent whitespace mismatches
                    var cleanAssignmentJobIds = assignment.JobIds
                        .Where(id => !string.IsNullOrWhiteSpace(id))
                        .Select(id => id.Trim())
                        .ToList();

                    //Console.WriteLine($"cleanAssignmentJobIds: {cleanAssignmentJobIds}");

                    if (cleanAssignmentJobIds.Any())
                    {
                        // 2. Sum parts_cost from ALL matching jobs
                        var assignmentJobs = jobs
                            .Where(j => !string.IsNullOrWhiteSpace(j.Id)
                                        && cleanAssignmentJobIds.Any(cleanId => string.Equals(j.Id.Trim(), cleanId, StringComparison.OrdinalIgnoreCase)))
                            .ToList();

                        Console.WriteLine($"assignmentJobs: {assignmentJobs}");

                        double totalPartsCost = assignmentJobs.Sum(j => j.PartsCost ?? 0);

                        // 3. Sum approx_total_cost from ALL matching PM reports
                        var assignmentPmReports = pmReports
                            .Where(p => !string.IsNullOrWhiteSpace(p.JobId)
                                        && cleanAssignmentJobIds.Any(cleanId => string.Equals(p.JobId.Trim(), cleanId, StringComparison.OrdinalIgnoreCase)))
                            .ToList();

                        Console.WriteLine($"assignmentPmReports: {assignmentPmReports}");

                        double totalPmCost = assignmentPmReports.Sum(p => p.ApproxTotalCost ?? 0);

                        // Update the dashboard counter
                        TotalPmReportsMatched += assignmentPmReports.Count;

                        // 4. Combine both sums
                        itemSparesCost = totalPartsCost + totalPmCost;
                    }
                }

                quarterlySpares[quarter] += itemSparesCost;
                TotalSparesCost += itemSparesCost;
                gridRowItem.SparesCost = itemSparesCost;
                // --- SPARES COST CALCULATION END ---

                // ⚠️ CRITICAL: Ensure these two lines were not accidentally deleted!
                gridRowItem.RowTotalCost = calculatedOtCost + calculatedEmployeeCost + calculatedTravelCost + itemSparesCost;
                GridRows.Add(gridRowItem);


                if (dateToIndexMap.TryGetValue(assignment.CreatedAt.Date, out int dayIndex))
                {
                    dailyOvertime[dayIndex] += calculatedOtCost;
                    dailyEmployee[dayIndex] += calculatedEmployeeCost;
                    dailyTravel[dayIndex] += calculatedTravelCost;
                    dailySpares[dayIndex] += itemSparesCost;
                    dailyPersonnelCount[dayIndex] += personnelCount;
                    dailyOtHours[dayIndex] += otHours;
                }
            }

            TotalCalculatedCost = TotalOvertimeCost + TotalSparesCost + TotalEmployeeCost + TotalTravelCost;

            double[] cumulativeTotal = new double[uniqueDates.Count];
            double running = 0;
            for (int i = 0; i < uniqueDates.Count; i++)
            {
                running += dailyOvertime[i] + dailySpares[i] + dailyEmployee[i] + dailyTravel[i];
                cumulativeTotal[i] = running;
            }

            var chartPayload = new
            {
                labelsDaily = labelsDaily,
                labelsQuarterly = new[] { "Q1", "Q2", "Q3", "Q4" },
                costNames = new[] { "Overtime", "Spares", "Employee", "Travel" },
                totals = new[] { TotalOvertimeCost, TotalSparesCost, TotalEmployeeCost, TotalTravelCost },
                dailyOvertime,
                dailySpares,
                dailyEmployee,
                dailyTravel,
                quarterlyOvertime,
                quarterlySpares,
                quarterlyEmployee,
                quarterlyTravel,
                cumulativeTotal,
                dailyPersonnelCount,
                dailyOtHours
            };

            _loading = false;
            StateHasChanged();

            await Task.Delay(50);
            if (GridRows.Any())
            {
                await JSRuntime.InvokeVoidAsync("costDashboard.renderAll", chartPayload);
            }
        }
        catch (Exception ex)
        {
            _loading = false;
            StateHasChanged();

            Console.WriteLine($"Dashboard Data Fault: {ex.Message}");
            Snackbar.Add($"Dashboard Data Fault: {ex.Message}", Severity.Error);
        }
    }

    public class AssignmentGridRow
    {
        public string AssignmentId { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public double OvertimeHours { get; set; }
        public double OvertimeCost { get; set; }
        public int PersonnelCount { get; set; }
        public double EmployeeCost { get; set; }
        public double TravelCost { get; set; }
        public double SparesCost { get; set; }
        public double RowTotalCost { get; set; }
    }

    [Table("job_assignments")]
    public class JobAssignmentModel : BaseModel
    {
        [PrimaryKey("id", false)] public string Id { get; set; } = string.Empty;
        [Column("created_at")] public DateTime CreatedAt { get; set; }
        [Column("job_ids")] public List<string>? JobIds { get; set; }
        [Column("personnel_ids")] public List<string>? PersonnelIds { get; set; }
        [Column("job_overtime")] public double? JobOvertime { get; set; }




    }

    [Table("locations")]
    public class Location : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("sub_area")] public string? SubArea { get; set; }
        [Column("area_name")] public string? AreaName { get; set; }
        [Column("installation_name")] public string? InstallationName { get; set; }
        [Column("field_type")] public string? FieldType { get; set; }
        [Column("image_url")] public string? ImageUrl { get; set; }
        [Column("installation_type")] public string? InstallationType { get; set; }
        [Column("is_active")] public bool? IsActive { get; set; }
        [Column("distance_fhq_km")] public float? DistanceFhqKm { get; set; }
    }

    [Table("pm_reports")]
    public class PmReportModel : BaseModel
    {
        [PrimaryKey("id", false)] public int Id { get; set; }
        [Column("job_id")] public string JobId { get; set; } = string.Empty;
        [Column("approx_total_cost")] public double? ApproxTotalCost { get; set; }
    }

    [Table("jobs")]
    public class JobModel : BaseModel
    {
        [PrimaryKey("id", false)] public string Id { get; set; } = string.Empty;
        [Column("job_spare_cost")] public double? PartsCost { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
    }

