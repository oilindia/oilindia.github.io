@page "/coststatic"
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models

@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

@using MudBlazor
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using static Supabase.Postgrest.Constants
@using System.Text.Json.Serialization
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@inject Client SupabaseClient

<style>
    .border-left-primary {
        border-left: 5px solid #594ae2;
    }

    .border-left-success {
        border-left: 5px solid #00c853;
    }

    .border-left-warning {
        border-left: 5px solid #ffb300;
    }

    .border-left-info {
        border-left: 5px solid #33a9ff;
    }

    .font-weight-bold {
        font-weight: 700;
    }
</style>


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Cost Analysis Dashboard</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Alignment="GridAlignment.Center">
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="Start Date" @bind-Date="_startDate" DateFormat="dd-MM-yyyy" Editable="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="End Date" @bind-Date="_endDate" DateFormat="dd-MM-yyyy" Editable="true" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshDashboardAsync" Disabled="_loading" StartIcon="@Icons.Material.Filled.Refresh" Class="mr-2">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Loading...</MudText>
                    }
                    else
                    {
                        <MudText>Refresh</MudText>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div class="d-flex flex-wrap align-center justify-center gap-4 mb-4 width-100">

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-primary" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Total Operations Cost</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalCalculatedCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">=</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-success" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Manpower Cost (Base)</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalEmployeeCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">+</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-warning" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Total Overtime Cost</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalOvertimeCost.ToString("N2")</MudText>
                <MudText Typo="Typo.caption" Class="text-muted mt-1 d-block">Hours: @TotalOvertimeHours.ToString("N1") hrs</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">+</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-info" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Travel & Logistics</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalTravelCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

        <div class="d-flex align-center justify-center style-operator-shape">
            <MudText Typo="Typo.h4" Class="text-secondary font-weight-bold" Style="line-height: 1; margin-top: -4px;">+</MudText>
        </div>

        <div style="flex: 1 1 240px; max-width: 320px;">
            <MudPaper Class="pa-4 text-center border-left-secondary" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="text-secondary text-uppercase font-weight-bold">Spares Total</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">₹ @TotalSparesCost.ToString("N2")</MudText>
            </MudPaper>
        </div>

    </div>

    <style>
            .style-operator-shape {
                width: 44px;
                height: 44px;
                min-width: 44px;
                background-color: var(--mud-palette-background-grey, #f4f4f4);
                border: 2px solid var(--mud-palette-lines-inputs, #e0e0e0);
                border-radius: 50%;
                user-select: none;
                box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);
            }
    </style>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Style="height: 420px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Cost Breakdown Over Time (Daily Cumulative)</MudText>
                <canvas id="chartCumulative" style="width: 100%; height: 340px;"></canvas>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Style="height: 420px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Cost Share Composition</MudText>
                <canvas id="chartDonut" style="width: 100%; height: 340px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Style="height: 420px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Daily Cost Categories (Stacked)</MudText>
                <canvas id="chartDailyStacked" style="width: 100%; height: 340px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Quarterly Cost Projections</MudText>
                <canvas id="chartQuarterly" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Daily Overtime Analysis (Hours vs Headcount)</MudText>
                <canvas id="chartResourceTrend" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Cost Vector Profile</MudText>
                <canvas id="chartRadar" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height: 380px;" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Avg Cost per Personnel (Trend)</MudText>
                <canvas id="chartCostPerHead" style="width: 100%; height: 300px;"></canvas>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Processed Job Assignment Manifest</MudText>
        <MudTable Items="@GridRows" Hover="true" Striped="true" FixedHeader="true" Height="400px" Loading="@_loading" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Job Name</MudTh>
                <MudTh>Execution Date</MudTh>
                <MudTh Style="text-align: right;">OT Hours</MudTh>
                <MudTh Style="text-align: right;">OT Cost</MudTh>
                <MudTh Style="text-align: right;">Crew Size</MudTh>
                <MudTh Style="text-align: right;">Engineers Cost</MudTh>
                <MudTh Style="text-align: right;">Travel Cost</MudTh>
                <MudTh Style="text-align: right;">Spares/Parts Cost</MudTh>
                <MudTh Style="text-align: right; font-weight: bold;">Aggregate Cost</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Job Name"><MudText>@context.JobNames</MudText></MudTd>
                <MudTd DataLabel="Execution Date">@context.CreatedAt.ToString("dd-MM-yyyy HH:mm")</MudTd>
                <MudTd DataLabel="OT Hours" Style="text-align: right;">@context.OvertimeHours.ToString("N1")</MudTd>
                <MudTd DataLabel="OT Cost" Style="text-align: right; color: var(--mud-palette-error);">₹ @context.OvertimeCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Crew Size" Style="text-align: right;">@context.PersonnelCount</MudTd>
                <MudTd DataLabel="Engineers Cost" Style="text-align: right;">₹ @context.EmployeeCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Travel Cost" Style="text-align: right;">₹ @context.TravelCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Spares/Parts Cost" Style="text-align: right;">₹ @context.SparesCost.ToString("N2")</MudTd>
                <MudTd DataLabel="Aggregate Cost" Style="text-align: right; font-weight: bold; color: var(--mud-palette-primary);">₹ @context.RowTotalCost.ToString("N2")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.subtitle1" Class="text-center pa-4">No structural executions mapped within this time boundary filter context.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>


    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Engineer Overtime (Last 4 Months)</MudText>
        <MudTable Items="@EmployeeOtRows" Hover="true" Striped="true" FixedHeader="true" Height="300px">
            <HeaderContent>
                <MudTh>Engineer Name</MudTh>
                <MudTh>Employee Code</MudTh>
                <MudTh Style="text-align: right;">Total OT Hours</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.FullName</MudTd>
                <MudTd DataLabel="Code">@context.EmpCode</MudTd>
                <MudTd DataLabel="OT Hours" Style="text-align: right;">@context.TotalOtHours.ToString("N1")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

</MudContainer>

@code {
    private bool _loading = false;
    private DateTime? _startDate = DateTime.Today.AddMonths(-1);
    private DateTime? _endDate = DateTime.Today;
    private const double HourlyOvertimeRate = 750.00;
    private const double VehicleMileageKmPerLiter = 8.0;

    public double TotalCalculatedCost { get; set; }
    public double TotalOvertimeHours { get; set; }
    public int TotalPmReportsMatched { get; set; }
    public int TotalAssignmentsProcessed { get; set; }
    public double TotalOvertimeCost { get; set; }
    public double TotalSparesCost { get; set; }
    public double TotalEmployeeCost { get; set; }
    public double TotalTravelCost { get; set; }

    public List<AssignmentGridRow> GridRows { get; set; } = new();
    public List<EngineerOtRow> EmployeeOtRows { get; set; } = new();

    public class EngineerOtRow
    {
        public string FullName { get; set; } = string.Empty;
        public string EmpCode { get; set; } = string.Empty;
        public double TotalOtHours { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task RefreshDashboardAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var dashStart = (_startDate ?? DateTime.Today.AddMonths(-1)).Date;
            var dashEnd = (_endDate ?? DateTime.Today).Date.AddDays(1);
            var otFourMonthsAgo = DateTime.Today.AddMonths(-4).Date;

            // Fetch from the earliest start date to cover both Dashboard and OT Grid in a single DB pass
            var minStart = dashStart < otFourMonthsAgo ? dashStart : otFourMonthsAgo;

            // 1. Parallel DB Fetching (1 Network Round-Trip including Store tables)
            var assignmentTask = SupabaseClient.From<JobAssignmentModel>()
                .Select("*")
                .Filter("created_at", Operator.GreaterThanOrEqual, minStart.ToString("yyyy-MM-dd"))
                .Filter("created_at", Operator.LessThanOrEqual, dashEnd.ToString("yyyy-MM-dd"))
                .Get();

            var pmReportTask = SupabaseClient.From<PmReportModel>().Select("*").Get();
            var jobsTask = SupabaseClient.From<JobModel>().Select("*").Get();
            var employeeTask = SupabaseClient.From<EmployeeEngineerModel>().Select("*").Get();
            var locationTask = SupabaseClient.From<Location>().Select("*").Get();
            var dieselTask = SupabaseClient.From<DieselPriceModel>().Select("*").Get();

            // Store Material Tasks for Spare Cost Calculation
            var issuancesTask = SupabaseClient.From<StoreIssuanceModel>().Select("id, job_id").Get();
            var issuanceItemsTask = SupabaseClient.From<StoreIssuanceItemModel>().Select("issuance_id, total_cost").Get();
            var returnsTask = SupabaseClient.From<StoreReturnModel>().Select("id, job_id").Get();
            var returnItemsTask = SupabaseClient.From<StoreReturnItemModel>().Select("return_id, total_refund").Get();

            await Task.WhenAll(
                assignmentTask, pmReportTask, jobsTask, employeeTask, locationTask, dieselTask,
                issuancesTask, issuanceItemsTask, returnsTask, returnItemsTask
            );

            var allAssignments = assignmentTask.Result.Models ?? new List<JobAssignmentModel>();
            var pmReports = pmReportTask.Result.Models ?? new List<PmReportModel>();
            var jobs = jobsTask.Result.Models ?? new List<JobModel>();
            var employees = employeeTask.Result.Models ?? new List<EmployeeEngineerModel>();
            var locations = locationTask.Result.Models ?? new List<Location>();
            var dieselPrices = dieselTask.Result.Models ?? new List<DieselPriceModel>();

            var issuances = issuancesTask.Result.Models ?? new List<StoreIssuanceModel>();
            var issuanceItems = issuanceItemsTask.Result.Models ?? new List<StoreIssuanceItemModel>();
            var returns = returnsTask.Result.Models ?? new List<StoreReturnModel>();
            var returnItems = returnItemsTask.Result.Models ?? new List<StoreReturnItemModel>();

            // 2. Build In-Memory Lookups for O(1) Search Speed
            var jobDict = jobs
                .Where(j => !string.IsNullOrWhiteSpace(j.Id))
                .GroupBy(j => j.Id.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

            var pmReportLookup = pmReports
                .Where(p => !string.IsNullOrWhiteSpace(p.JobId))
                .ToLookup(p => p.JobId.Trim(), StringComparer.OrdinalIgnoreCase);

            var employeeDict = employees.ToDictionary(e => e.Id);
            var locationDict = locations.ToDictionary(l => l.Id);

            var validDieselPrices = dieselPrices
                .Where(p => p.PriceDate.HasValue && p.DieselPrice.HasValue && p.DieselPrice > 0)
                .ToList();

            // --- Dynamic Net Spare Cost Calculation per Job (Issuances - Returns) ---
            var netSparesCostByJob = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);

            var issuanceJobMap = issuances
                .Where(i => !string.IsNullOrWhiteSpace(i.JobId))
                .ToDictionary(i => i.Id, i => i.JobId!.Trim(), StringComparer.OrdinalIgnoreCase);

            foreach (var item in issuanceItems)
            {
                if (!string.IsNullOrWhiteSpace(item.IssuanceId) &&
                    issuanceJobMap.TryGetValue(item.IssuanceId, out var jobId))
                {
                    netSparesCostByJob.TryAdd(jobId, 0);
                    netSparesCostByJob[jobId] += item.TotalCost ?? 0;
                }
            }

            var returnJobMap = returns
                .Where(r => !string.IsNullOrWhiteSpace(r.JobId))
                .ToDictionary(r => r.Id, r => r.JobId!.Trim(), StringComparer.OrdinalIgnoreCase);

            foreach (var item in returnItems)
            {
                if (!string.IsNullOrWhiteSpace(item.ReturnId) &&
                    returnJobMap.TryGetValue(item.ReturnId, out var jobId))
                {
                    netSparesCostByJob.TryAdd(jobId, 0);
                    netSparesCostByJob[jobId] -= item.TotalRefund ?? 0;
                }
            }
            // -------------------------------------------------------------------------

            // Reset Aggregates
            TotalCalculatedCost = 0; TotalOvertimeHours = 0; TotalPmReportsMatched = 0; TotalAssignmentsProcessed = 0;
            TotalOvertimeCost = 0; TotalSparesCost = 0; TotalEmployeeCost = 0; TotalTravelCost = 0;
            GridRows.Clear();

            // Filter for Dashboard Date Range
            var dashAssignments = allAssignments
                .Where(a => a.CreatedAt >= dashStart && a.CreatedAt < dashEnd)
                .ToList();

            TotalAssignmentsProcessed = dashAssignments.Count;

            var uniqueDates = dashAssignments.Select(a => a.CreatedAt.Date).Distinct().OrderBy(d => d).ToList();
            string[] labelsDaily = uniqueDates.Select(d => d.ToString("dd MMM")).ToArray();

            double[] dailyOvertime = new double[uniqueDates.Count];
            double[] dailySpares = new double[uniqueDates.Count];
            double[] dailyEmployee = new double[uniqueDates.Count];
            double[] dailyTravel = new double[uniqueDates.Count];
            double[] dailyPersonnelCount = new double[uniqueDates.Count];
            double[] dailyOtHours = new double[uniqueDates.Count];

            var dateToIndexMap = uniqueDates.Select((date, index) => new { date, index })
                .ToDictionary(x => x.date, x => x.index);

            double[] quarterlyOvertime = new double[4];
            double[] quarterlySpares = new double[4];
            double[] quarterlyEmployee = new double[4];
            double[] quarterlyTravel = new double[4];

            // 3. Process Dashboard Data
            foreach (var assignment in dashAssignments)
            {
                if (assignment.CreatedAt == DateTime.MinValue) continue;

                int quarter = (assignment.CreatedAt.Month - 1) / 3;
                if (quarter < 0 || quarter > 3) quarter = 0;

                var gridRowItem = new AssignmentGridRow { CreatedAt = assignment.CreatedAt };
                var cleanAssignmentJobIds = GetCleanJobIds(assignment.JobIds);

                double otHours = 0;
                double totalPartsCost = 0;
                double totalPmCost = 0;
                var locationIds = new HashSet<long>();
                var jobNameList = new List<string>();

                foreach (var cleanId in cleanAssignmentJobIds)
                {
                    if (jobDict.TryGetValue(cleanId, out var job))
                    {
                        otHours += job.OvertimeApproved ?? 0;
                        if (job.LocationId.HasValue) locationIds.Add(job.LocationId.Value);

                        var nameToDisplay = !string.IsNullOrWhiteSpace(job.JobName) ? job.JobName : (!string.IsNullOrWhiteSpace(job.Name) ? job.Name : cleanId);
                        if (!jobNameList.Contains(nameToDisplay))
                        {
                            jobNameList.Add(nameToDisplay);
                        }
                    }

                    if (netSparesCostByJob.TryGetValue(cleanId, out var dynamicSpareCost))
                    {
                        totalPartsCost += Math.Max(0, dynamicSpareCost);
                    }

                    if (pmReportLookup.Contains(cleanId))
                    {
                        foreach (var pm in pmReportLookup[cleanId])
                        {
                            totalPmCost += pm.ApproxTotalCost ?? 0;
                            TotalPmReportsMatched++;
                        }
                    }
                }

                gridRowItem.JobNames = jobNameList.Count > 0 ? string.Join(", ", jobNameList) : "N/A";

                TotalOvertimeHours += otHours;
                double calculatedOtCost = otHours * HourlyOvertimeRate;
                quarterlyOvertime[quarter] += calculatedOtCost;
                TotalOvertimeCost += calculatedOtCost;
                gridRowItem.OvertimeHours = otHours;
                gridRowItem.OvertimeCost = calculatedOtCost;

                // Employee Cost Calculation
                double calculatedEmployeeCost = 0;
                int personnelCount = assignment.PersonnelIds?.Count ?? 0;
                if (assignment.PersonnelIds != null)
                {
                    foreach (var pIdStr in assignment.PersonnelIds)
                    {
                        if (long.TryParse(pIdStr, out long empId) && employeeDict.TryGetValue(empId, out var emp))
                        {
                            if (emp.AnnualCost.HasValue) calculatedEmployeeCost += (emp.AnnualCost.Value / 365.0);
                        }
                    }
                }
                quarterlyEmployee[quarter] += calculatedEmployeeCost;
                TotalEmployeeCost += calculatedEmployeeCost;
                gridRowItem.PersonnelCount = personnelCount;
                gridRowItem.EmployeeCost = calculatedEmployeeCost;

                // Travel Logistics Calculation
                double calculatedTravelCost = 0;
                if (locationIds.Count > 0)
                {
                    double totalRoundTripDistance = 0;
                    foreach (var locId in locationIds)
                    {
                        if (locationDict.TryGetValue(locId, out var loc))
                        {
                            totalRoundTripDistance += (loc.DistanceFhqKm ?? 0f) * 2;
                        }
                    }

                    if (totalRoundTripDistance > 0)
                    {
                        double dieselPrice = GetNearestDieselPrice(validDieselPrices, assignment.CreatedAt.Date);
                        calculatedTravelCost = (totalRoundTripDistance / VehicleMileageKmPerLiter) * dieselPrice;
                    }
                }

                quarterlyTravel[quarter] += calculatedTravelCost;
                TotalTravelCost += calculatedTravelCost;
                gridRowItem.TravelCost = calculatedTravelCost;

                // Spares Cost Calculation
                double itemSparesCost = totalPartsCost + totalPmCost;
                quarterlySpares[quarter] += itemSparesCost;
                TotalSparesCost += itemSparesCost;
                gridRowItem.SparesCost = itemSparesCost;

                gridRowItem.RowTotalCost = calculatedOtCost + calculatedEmployeeCost + calculatedTravelCost + itemSparesCost;
                GridRows.Add(gridRowItem);

                if (dateToIndexMap.TryGetValue(assignment.CreatedAt.Date, out int dayIndex))
                {
                    dailyOvertime[dayIndex] += calculatedOtCost;
                    dailyEmployee[dayIndex] += calculatedEmployeeCost;
                    dailyTravel[dayIndex] += calculatedTravelCost;
                    dailySpares[dayIndex] += itemSparesCost;
                    dailyPersonnelCount[dayIndex] += personnelCount;
                    dailyOtHours[dayIndex] += otHours;
                }
            }

            TotalCalculatedCost = TotalOvertimeCost + TotalSparesCost + TotalEmployeeCost + TotalTravelCost;

            // Sort grid rows by CreatedAt descending (newest first)
            GridRows = GridRows.OrderByDescending(x => x.CreatedAt).ToList();

            double[] cumulativeTotal = new double[uniqueDates.Count];
            double running = 0;
            for (int i = 0; i < uniqueDates.Count; i++)
            {
                running += dailyOvertime[i] + dailySpares[i] + dailyEmployee[i] + dailyTravel[i];
                cumulativeTotal[i] = running;
            }

            // 4. Process OT Grid using pre-fetched dataset
            ProcessOtGridData(allAssignments, otFourMonthsAgo, jobDict, employees);

            var chartPayload = new
            {
                labelsDaily,
                labelsQuarterly = new[] { "Q1", "Q2", "Q3", "Q4" },
                costNames = new[] { "Overtime", "Spares", "Employee", "Travel" },
                totals = new[] { TotalOvertimeCost, TotalSparesCost, TotalEmployeeCost, TotalTravelCost },
                dailyOvertime,
                dailySpares,
                dailyEmployee,
                dailyTravel,
                quarterlyOvertime,
                quarterlySpares,
                quarterlyEmployee,
                quarterlyTravel,
                cumulativeTotal,
                dailyPersonnelCount,
                dailyOtHours
            };

            _loading = false;
            StateHasChanged();

            await Task.Delay(50);
            if (GridRows.Any())
            {
                await JSRuntime.InvokeVoidAsync("costDashboard.renderAll", chartPayload);
            }
        }
        catch (Exception ex)
        {
            _loading = false;
            StateHasChanged();

            Console.WriteLine("===== FULL ERROR =====");
            Console.WriteLine(ex.ToString());
            if (ex.InnerException != null)
            {
                Console.WriteLine("===== INNER ERROR =====");
                Console.WriteLine(ex.InnerException.ToString());
            }

            Snackbar.Add($"Dashboard Data Fault: {ex.Message}", Severity.Error);
        }
    }

    private void ProcessOtGridData(
        List<JobAssignmentModel> allAssignments,
        DateTime fourMonthsAgo,
        Dictionary<string, JobModel> jobDict,
        List<EmployeeEngineerModel> employees)
    {
        var filteredAssignments = allAssignments.Where(a => a.CreatedAt >= fourMonthsAgo).ToList();
        var otLookup = new Dictionary<long, double>();

        foreach (var assignment in filteredAssignments)
        {
            var cleanJobIds = GetCleanJobIds(assignment.JobIds);
            double ot = 0;

            foreach (var cleanId in cleanJobIds)
            {
                if (jobDict.TryGetValue(cleanId, out var job))
                {
                    ot += job.OvertimeApproved ?? 0;
                }
            }

            if (ot > 0 && assignment.PersonnelIds != null)
            {
                foreach (var pIdStr in assignment.PersonnelIds)
                {
                    if (long.TryParse(pIdStr, out long empId))
                    {
                        if (!otLookup.ContainsKey(empId)) otLookup[empId] = 0;
                        otLookup[empId] += ot;
                    }
                }
            }
        }

        EmployeeOtRows = employees
            .Where(e => otLookup.ContainsKey(e.Id))
            .Select(e => new EngineerOtRow
            {
                FullName = e.FullName ?? "N/A",
                EmpCode = e.EmpCode,
                TotalOtHours = otLookup[e.Id]
            })
            .OrderByDescending(x => x.TotalOtHours)
            .ToList();
    }

    private static double GetNearestDieselPrice(List<DieselPriceModel> validPrices, DateTime date)
    {
        if (validPrices.Count == 0) return 90.00;

        double minDiff = double.MaxValue;
        double bestPrice = 90.00;

        foreach (var p in validPrices)
        {
            double diff = Math.Abs((p.PriceDate!.Value - date).TotalDays);
            if (diff < minDiff)
            {
                minDiff = diff;
                bestPrice = p.DieselPrice!.Value;
            }
        }
        return bestPrice;
    }

    private static List<string> GetCleanJobIds(List<string>? rawJobIds)
    {
        var cleanIds = new List<string>();
        if (rawJobIds == null) return cleanIds;

        foreach (var rawId in rawJobIds)
        {
            if (string.IsNullOrWhiteSpace(rawId)) continue;
            var split = rawId.Split(new[] { '[', ']', '"', '\'', ',', ' ' }, StringSplitOptions.RemoveEmptyEntries);
            cleanIds.AddRange(split);
        }
        return cleanIds;
    }

