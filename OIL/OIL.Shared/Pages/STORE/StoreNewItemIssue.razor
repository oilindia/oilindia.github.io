    // Updated View Model to carry the compiled list of assigned personnel
    public class JobDisplayViewModel
    {
        public Job Job { get; set; } = new();
        public JobAssignment? Assignment { get; set; }
        public List<EmployeeEngineer> AssignedPersonnel { get; set; } = new();
        //public List<AllocatedSpareDetail> Spares { get; set; } = new();
    }

    public class UnifiedSpareWorkspaceRow
    {
        // Static Record Identifiers
        public long MaterialId { get; set; }
        public string MaterialCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal UnitCost { get; set; }
        public decimal SapStock { get; set; } // Fresh live warehouse stock level

        // Historical Database Totals (Read-Only Context)
        public decimal TotalIssued { get; set; }
        public decimal TotalReturned { get; set; }
        public decimal NetAllocated => TotalIssued - TotalReturned;

        // Interactive Transaction Actions (Pending Write-State)
        public decimal PendingIssueQty { get; set; }   // Bi-directional UI input binding
        public decimal PendingReturnQty { get; set; }  // Bi-directional UI input binding

        // Flags for conditional UI elements
        public bool IsNewlyAddedLine => TotalIssued == 0 && TotalReturned == 0;
    }

    
    //private List<StagedSpareItem> stagedSparesBucket = new();

    private string activeTab = "JobIssuance";
    private bool isSearching = false;
    private bool isLoading = true;
    private string spareSearchQuery = string.Empty;
    private string errorMessage = string.Empty;
    private Job? selectedJob;

    private List<Job> jobsList = new();
    private List<JobAssignment> assignmentsList = new();
    private List<EmployeeEngineer> engineersDirectory = new();
    private List<StoreMaterial> filteredSpares = new();
    private List<Location> _locations = new();
    // The Single Source of Truth Workspace List for the UI Grid
    private List<UnifiedSpareWorkspaceRow> unifiedWorkspaceList = new();


    private string GetLocationName(long? locationId)
    {
        if (!locationId.HasValue) return "";
        return _locations.FirstOrDefault(l => l.Id == locationId.Value)?.InstallationName ?? "";
    }
    private IEnumerable<JobDisplayViewModel> GetJoinedJobsData()
    {
        // Order by created_at descending right at the source
        return jobsList
            .OrderByDescending(job => job.CreatedAt) // Note: Change to job.created_at if your C# property matches database snake_case exactly
            .Select(job =>
            {
                // Find the specific assignment that references this job UUID
                var assignment = assignmentsList.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains(job.Id));

                // Resolve the bigint[] array column to matching personnel objects
                var assignedPeople = new List<EmployeeEngineer>();
                if (assignment?.PersonnelIds != null && engineersDirectory.Any())
                {
                    assignedPeople = engineersDirectory
                        .Where(engineer => assignment.PersonnelIds.Contains(engineer.Id))
                        .ToList();
                }

                return new JobDisplayViewModel
                {
                    Job = job,
                    Assignment = assignment,
                    AssignedPersonnel = assignedPeople
                    //Spares = activeSessionCommittedSpares
                };
            });
    }
    private void SetTab(string tab)
    {
        activeTab = tab;
        errorMessage = string.Empty;
        spareSearchQuery = string.Empty;
        filteredSpares.Clear();
    }
    private void DeselectJob()
    {
        selectedJob = null;
        //stagedSparesBucket.Clear();
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceDataAsync();
    }

    private async Task LoadWorkspaceDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            string cutoffDate = DateTime.UtcNow.AddDays(-30).ToString("o");

            var jobsResponse = await Supabase.From<Job>()
                .Filter("created_at", global::Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, cutoffDate)
                .Order("created_at", global::Supabase.Postgrest.Constants.Ordering.Descending)
                .Get();
            jobsList = jobsResponse.Models;

            var assignmentsResponse = await Supabase.From<JobAssignment>()
                .Filter("created_at", global::Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, cutoffDate)
                .Order("created_at", global::Supabase.Postgrest.Constants.Ordering.Descending)
                .Get();
            assignmentsList = assignmentsResponse.Models;

            var engineersResponse = await Supabase.From<EmployeeEngineer>().Get();
            engineersDirectory = engineersResponse.Models;

            _locations = (await SupabaseClient.From<Location>().Get()).Models;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error populating cache tables: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectJob(Job job)
    {
        selectedJob = job;
        spareSearchQuery = string.Empty;
        filteredSpares.Clear();
        errorMessage = string.Empty;

        // Clear and reload the single workspace grid for the newly selected job context
        await LoadUnifiedJobWorkspaceAsync(job.Id);
    }

    private async Task LoadUnifiedJobWorkspaceAsync(Guid jobId)
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            unifiedWorkspaceList.Clear();

            // 1. Fetch historical issuances
            var issuanceHeaders = await Supabase.From<MaterialIssuance>().Where(x => x.JobId == jobId).Get();
            var issuanceIds = issuanceHeaders.Models.Select(x => x.Id).ToList();
            List<MaterialIssuanceItem> issuedItems = new();

            if (issuanceIds.Any())
            {
                var itemsResponse = await Supabase.From<MaterialIssuanceItem>()
                    .Filter("issuance_id", global::Supabase.Postgrest.Constants.Operator.In, issuanceIds)
                    .Get();
                issuedItems = itemsResponse.Models;
            }

            // 2. Fetch historical returns
            var returnHeaders = await Supabase.From<MaterialReturn>().Where(x => x.JobId == jobId).Get();
            var returnIds = returnHeaders.Models.Select(x => x.Id).ToList();
            List<MaterialReturnItem> returnedItems = new();

            if (returnIds.Any())
            {
                var returnsResponse = await Supabase.From<MaterialReturnItem>()
                    .Filter("return_id", global::Supabase.Postgrest.Constants.Operator.In, returnIds)
                    .Get();
                returnedItems = returnsResponse.Models;
            }

            // 3. Extract unique material IDs across both history lines
            var uniqueMatIds = issuedItems.Select(x => x.MaterialId)
                .Union(returnedItems.Select(x => x.MaterialId))
                .Distinct()
                .ToList();

            if (!uniqueMatIds.Any()) return;

            // 4. Fetch Master Details (to populate live warehouse stock boundaries)
            var matsResponse = await Supabase.From<StoreMaterial>()
                .Filter("id", global::Supabase.Postgrest.Constants.Operator.In, uniqueMatIds.Cast<object>().ToList())
                .Get();
            var masterLookup = matsResponse.Models;

            // 5. Construct the Unified rows matrix
            foreach (var matId in uniqueMatIds)
            {
                var matMaster = masterLookup.FirstOrDefault(x => x.Id == matId);
                var totalIssued = issuedItems.Where(x => x.MaterialId == matId).Sum(x => x.QuantityIssued);
                var totalReturned = returnedItems.Where(x => x.MaterialId == matId).Sum(x => x.QuantityReturned);
                var unitCost = issuedItems.Where(x => x.MaterialId == matId).Select(x => x.UnitCostAtIssue).FirstOrDefault();

                if (unitCost == 0 && matMaster != null) unitCost = matMaster.UnitCost;

                unifiedWorkspaceList.Add(new UnifiedSpareWorkspaceRow
                {
                    MaterialId = matId,
                    MaterialCode = matMaster?.Material ?? $"ID: {matId}",
                    Description = matMaster?.MaterialDescription ?? "Unknown Profile",
                    SapStock = matMaster?.StockQuantity ?? 0,
                    UnitCost = unitCost,
                    TotalIssued = totalIssued,
                    TotalReturned = totalReturned
                });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error assembling unified matrix lookup: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

