    private async Task CommitUnifiedWorkspaceBatchAsync()
    {
        if (selectedJob == null || !unifiedWorkspaceList.Any()) return;

        // 1. DATA INTEGRITY BOUNDARY CHECKS
        foreach (var row in unifiedWorkspaceList)
        {
            if (row.PendingIssueQty < 0 || row.PendingReturnQty < 0)
            {
                errorMessage = $"Negative quantities are forbidden. Check part entry: {row.MaterialCode}";
                return;
            }
            if (row.PendingIssueQty > row.SapStock)
            {
                errorMessage = $"Allocation breach! Requested Issue ({row.PendingIssueQty}) exceeds Warehouse Available Stock ({row.SapStock}) for: {row.MaterialCode}";
                return;
            }
            if (row.PendingReturnQty > row.NetAllocated)
            {
                errorMessage = $"Return ledger breach! Attempted to return ({row.PendingReturnQty}), but Net Allocated to Job is only ({row.NetAllocated}) for: {row.MaterialCode}";
                return;
            }
        }

        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var pendingIssuances = unifiedWorkspaceList.Where(x => x.PendingIssueQty > 0).ToList();
            var pendingReturns = unifiedWorkspaceList.Where(x => x.PendingReturnQty > 0).ToList();

            if (!pendingIssuances.Any() && !pendingReturns.Any())
            {
                errorMessage = "No transactions found to save. Modify operational quantities first.";
                return;
            }

            var matchedAssignment = assignmentsList.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains(selectedJob.Id));

            // 2. TRANSACTION EXECUTION ENGINE ONE: PROCESS ISSUANCES
            if (pendingIssuances.Any())
            {
                var issuanceHeader = new MaterialIssuance
                {
                    JobId = selectedJob.Id,
                    AssignmentId = matchedAssignment?.Id,
                    IssuedByEmail = "surendra.choudhary@company.com", // Dynamic authentication replacement point
                    Remarks = $"Batch Issuance Workspace: {selectedJob.JobName}"
                };

                var headerResponse = await Supabase.From<MaterialIssuance>().Insert(issuanceHeader);
                var committedHeader = headerResponse.Model;

                if (committedHeader != null && committedHeader.Id != Guid.Empty)
                {
                    var itemsToInsert = pendingIssuances.Select(x => new MaterialIssuanceItem
                    {
                        IssuanceId = committedHeader.Id,
                        MaterialId = x.MaterialId,
                        QuantityIssued = x.PendingIssueQty,
                        UnitCostAtIssue = x.UnitCost
                    }).ToList();

                    await Supabase.From<MaterialIssuanceItem>().Insert(itemsToInsert);
                }
            }

            // 3. TRANSACTION EXECUTION ENGINE TWO: PROCESS RETURNS
            if (pendingReturns.Any())
            {
                var returnHeader = new MaterialReturn
                {
                    JobId = selectedJob.Id,
                    ReturnedByEmail = "surendra.choudhary@company.com",
                    Remarks = $"Batch Return Workspace: {selectedJob.JobName}"
                };

                var returnHeaderResponse = await Supabase.From<MaterialReturn>().Insert(returnHeader);
                var committedReturnHeader = returnHeaderResponse.Model;

                if (committedReturnHeader != null && committedReturnHeader.Id != Guid.Empty)
                {
                    var itemsToReturn = pendingReturns.Select(x => new MaterialReturnItem
                    {
                        ReturnId = committedReturnHeader.Id,
                        MaterialId = x.MaterialId,
                        QuantityReturned = x.PendingReturnQty,
                        UnitCostAtReturn = x.UnitCost
                    }).ToList();

                    await Supabase.From<MaterialReturnItem>().Insert(itemsToReturn);
                }
            }

            // 4. WORKSPACE POST-FULFILLMENT CLEAN REBOOT
            await LoadWorkspaceDataAsync();
            await LoadUnifiedJobWorkspaceAsync(selectedJob.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Transactional processing engine error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

