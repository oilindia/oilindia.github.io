            unifiedWorkspaceList.Add(new UnifiedSpareWorkspaceRow
            {
                MaterialId = spare.Id,
                MaterialCode = spare.Material,
                Description = spare.MaterialDescription,
                SapStock = spare.StockQuantity,
                UnitCost = spare.UnitCost,
                TotalIssued = 0,
                TotalReturned = 0,
                PendingIssueQty = 1 // Bootstrap with initial allocation target
            });
        }



        // Wipe context search constraints instantly
        spareSearchQuery = string.Empty;
        filteredSpares.Clear();

        // Explicitly tell Blazor to repaint the UI
        StateHasChanged();

    }

