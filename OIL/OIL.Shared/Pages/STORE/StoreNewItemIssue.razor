        }

        //var existingRow = unifiedWorkspaceList.FirstOrDefault(x => x.MaterialId == spare.Id);


        // Guard Check: If item already sits inside the table matrix, do not duplicate rows
        var existingRow = unifiedWorkspaceList.FirstOrDefault(x => x.MaterialId == spare.Id);
        if (existingRow != null)
        {
            existingRow.PendingIssueQty += 1; // Increment intended action count as an intuitive fallback
        }
        else
