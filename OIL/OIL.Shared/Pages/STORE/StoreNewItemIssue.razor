    // Assuming you have a model class for this, re-using your issue model as an example.
    private List<DepartmentIssueModel> historicalIssuesList = new();

    // --- New Method for Fetching History ---
    private async Task LoadIssueHistoryAsync()
    {
        try
        {
            isHistoryLoading = true;
            StateHasChanged();

            // 1. Ensure dates cover the entire day timeframe safely
            var startDate = historyFromDate.Date;
            var endDate = historyToDate.Date.AddDays(1).AddTicks(-1);

            // 2. Fetch the Parent Issuance Records (filtering by issuance_category if needed)
            var issuancesResponse = await SupabaseClient.From<MaterialIssuance>()
                .Filter("created_at", global::Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, startDate)
                .Filter("created_at", global::Supabase.Postgrest.Constants.Operator.LessThanOrEqual, endDate)
                .Filter("issuance_category", global::Supabase.Postgrest.Constants.Operator.Equals, "JOB") // Assuming Dept is categorized differently or just fetching all
                .Get();

            var issuances = issuancesResponse.Models;

            if (!issuances.Any())
            {
                historicalIssuesList = new List<DepartmentIssueModel>();
                return;
            }

            var issuanceIds = issuances.Select(i => i.Id).ToList();

            // 3. Fetch the associated Items in a single batch
            var itemsResponse = await SupabaseClient.From<MaterialIssuanceItem>()
                .Filter("issuance_id", global::Supabase.Postgrest.Constants.Operator.In, issuanceIds)
                .Get();

            var items = itemsResponse.Models;

            if (!items.Any())
            {
                historicalIssuesList = new List<DepartmentIssueModel>();
                return;
            }

            var materialIds = items.Select(x => x.MaterialId).Distinct().ToList();

            // 4. Fetch Master Data for Descriptions, UOM, and SLOC
            var materialsResponse = await SupabaseClient.From<StoreMaterial>()
                .Filter("id", global::Supabase.Postgrest.Constants.Operator.In, materialIds)
                .Get();

            var materials = materialsResponse.Models.ToDictionary(m => m.Id, m => m);

            // 5. Project the real DB data into your unified UI Model
            historicalIssuesList = items.Select(item =>
            {
                var parent = issuances.First(i => i.Id == item.IssuanceId);
                materials.TryGetValue(item.MaterialId, out var mat);

                return new DepartmentIssueModel
                {
                    IssueDate = parent.CreatedAt,
                    MatCode = mat?.Material ?? "UNKNOWN",
                    Description = mat?.MaterialDescription ?? "Unknown Material",
                    IssuedQuantity = (double)item.QuantityIssued,

                    // Map the newly exposed UI fields directly from the DB
                    Uom = mat?.BaseUnitOfMeasure,
                    Sloc = mat?.StorageLocation,
                    IssuedTo = !string.IsNullOrWhiteSpace(parent.IssuedToName) ? parent.IssuedToName : parent.IssuedByEmail,
                    Notification = parent.NotificationNo,
                    Location = parent.LocationTarget,
                    JobDescription = parent.ManualJobDescription,
                    Asset = parent.AssetId,
                    MigoToBeDoneBy = parent.MigoToBeDoneBy,
                    MigoNo = parent.MigoNo,
                    Remarks = parent.Remarks
                };
            })
            .OrderByDescending(x => x.IssueDate)
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
        }
        finally
        {
            isHistoryLoading = false;
            StateHasChanged();
        }
    }



