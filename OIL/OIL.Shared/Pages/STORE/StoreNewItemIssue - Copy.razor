    // Updated View Model to carry the compiled list of assigned personnel
    public class JobDisplayViewModel
    {
        public Job Job { get; set; } = new();
        public JobAssignment? Assignment { get; set; }
        public List<EmployeeEngineer> AssignedPersonnel { get; set; } = new();
        public List<AllocatedSpareDetail> Spares { get; set; } = new();
    }

    public class StagedSpareItem
    {
        public long Id { get; set; }
        public string Material { get; set; } = string.Empty;
        public string MaterialDescription { get; set; } = string.Empty;
        public decimal StockQuantity { get; set; }
        public int QuantityToIssue { get; set; } = 1;
        public decimal UnitCost { get; set; }
    }

    public class AllocatedSpareDetail
    {
        public string MaterialCode { get; set; } = string.Empty;
        public string SpareName { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public decimal UnitCost { get; set; }
        public decimal TotalCost { get; set; }
    }

    // Local runtime states
    private List<Job> jobsList = new();
    private List<JobAssignment> assignmentsList = new();
    private List<StoreMaterial> filteredSpares = new();
    private List<StagedSpareItem> stagedSparesBucket = new();

    // Tracks saved transactions locally for UI representation after saving
    private List<AllocatedSpareDetail> activeSessionCommittedSpares = new();

    private List<EmployeeEngineer> engineersDirectory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceDataAsync();
    }

    private async Task LoadWorkspaceDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            // 1. Calculate the 30-day cutoff timestamp (ISO-8601 string)
            string cutoffDate = DateTime.UtcNow.AddDays(-30).ToString("o");

            // 2. Fetch jobs sorted with latest records at the top (last 30 days only)
            var jobsResponse = await Supabase.From<Job>()
                .Filter("created_at", global::Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, cutoffDate)
                .Order("created_at", global::Supabase.Postgrest.Constants.Ordering.Descending)
                .Get();
            jobsList = jobsResponse.Models;

            // 3. Fetch job assignments sorted with latest records at the top (last 30 days only)
            var assignmentsResponse = await Supabase.From<JobAssignment>()
                .Filter("created_at", global::Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, cutoffDate)
                .Order("created_at", global::Supabase.Postgrest.Constants.Ordering.Descending)
                .Get();
            assignmentsList = assignmentsResponse.Models;

            // 4. Fetch your engineers directory for array resolution mapping (Keep unfiltered as it's a structural lookup)
            var engineersResponse = await Supabase.From<EmployeeEngineer>().Get();
            engineersDirectory = engineersResponse.Models;


        }
        catch (Exception ex)
        {
            errorMessage = $"Error populating workbench cache tables: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchTyping(ChangeEventArgs e)
    {
        spareSearchQuery = e.Value?.ToString() ?? string.Empty;

        if (spareSearchQuery.Length >= 2)
        {
            isSearching = true;
            try
            {
                // Fix: Pass an explicit List of IPostgrestQueryFilter objects
                // Fix: Added global:: modifier to bypass variable name collision
                var response = await Supabase.From<StoreMaterial>()
                    .Or(new List<Supabase.Postgrest.Interfaces.IPostgrestQueryFilter>
                    {
                    new Supabase.Postgrest.QueryFilter("material", global::Supabase.Postgrest.Constants.Operator.ILike, $"%{spareSearchQuery}%"),
                    new Supabase.Postgrest.QueryFilter("material_description", global::Supabase.Postgrest.Constants.Operator.ILike, $"%{spareSearchQuery}%")
                    })
                    .Limit(10)
                    .Get();

                filteredSpares = response.Models;
            }
            catch
            {
                filteredSpares = new List<StoreMaterial>();
            }
            finally
            {
                isSearching = false;
            }
        }
        else
        {
            filteredSpares.Clear();
        }
    }

    private void StageSpareItem(StoreMaterial spare)
    {
        if (stagedSparesBucket.Any(x => x.Id == spare.Id))
        {
            errorMessage = "This material row is already active in your staging console.";
            spareSearchQuery = string.Empty;
            filteredSpares.Clear();
            return;
        }

        stagedSparesBucket.Add(new StagedSpareItem
        {
            Id = spare.Id,
            Material = spare.Material,
            MaterialDescription = spare.MaterialDescription,
            StockQuantity = spare.StockQuantity,
            QuantityToIssue = 1,
            UnitCost = spare.UnitCost
        });

        spareSearchQuery = string.Empty;
        filteredSpares.Clear();
        errorMessage = string.Empty;
    }

    private void RemoveStagedItem(long id) => stagedSparesBucket.RemoveAll(x => x.Id == id);
    private void ClearStagingBucket() => stagedSparesBucket.Clear();

    private async Task ConfirmAndCommitBatch()
    {
        if (selectedJob == null || !stagedSparesBucket.Any()) return;

        // 1. Guard check: Validate input states before hitting production tables
        foreach (var item in stagedSparesBucket)
        {
            if (item.QuantityToIssue <= 0 || item.QuantityToIssue > item.StockQuantity)
            {
                errorMessage = $"Stock boundaries violated for code: {item.Material}. Check entry limits.";
                return;
            }
        }

        try
        {
            isLoading = true; // Lock down components during async context calls
            errorMessage = string.Empty;

            // Find matching assignment ID from your existing UI memory dataset if available
            var matchedAssignment = assignmentsList.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains(selectedJob.Id));

            // 2. STEP ONE: Insert Parent Record (The Transaction Header)
            var issuanceHeader = new MaterialIssuance
            {
                JobId = selectedJob.Id,
                AssignmentId = matchedAssignment?.Id,
                IssuedByEmail = "surendra.choudhary@company.com", // Replace with your authentication state/variable
                Remarks = $"Automated dispatch via Workbench UI for ticket: {selectedJob.JobName}"
            };

            // Fire transaction to create header and retrieve generated database UUID
            var headerResponse = await Supabase.From<MaterialIssuance>().Insert(issuanceHeader);
            var committedHeader = headerResponse.Model;

            if (committedHeader == null || committedHeader.Id == Guid.Empty)
            {
                throw new Exception("The database refused to initialize an integration entry token header.");
            }

            // 3. STEP TWO: Map UI Staging Box to Database Line Items Array
            var itemsToInsert = new List<MaterialIssuanceItem>();
            foreach (var staged in stagedSparesBucket)
            {
                itemsToInsert.Add(new MaterialIssuanceItem
                {
                    IssuanceId = committedHeader.Id, // Foreign Key linking directly back to our new header UUID
                    MaterialId = staged.Id,
                    QuantityIssued = staged.QuantityToIssue,
                    UnitCostAtIssue = staged.UnitCost
                });
            }

            // 4. STEP THREE: Write child records in a single batch insert payload
            await Supabase.From<MaterialIssuanceItem>().Insert(itemsToInsert);

            // 5. STEP FOUR: Mirror database actions on runtime UI tracking tables
            foreach (var item in stagedSparesBucket)
            {
                activeSessionCommittedSpares.Add(new AllocatedSpareDetail
                {
                    MaterialCode = item.Material,
                    SpareName = item.MaterialDescription,
                    Quantity = item.QuantityToIssue,
                    UnitCost = item.UnitCost,
                    TotalCost = item.QuantityToIssue * item.UnitCost
                });
            }

            // Clean slate upon transactional fulfillment
            stagedSparesBucket.Clear();

            // 6. STEP FIVE: Refresh parent records to display automated trigger values
            var jobsResponse = await Supabase.From<Job>().Get();
            jobsList = jobsResponse.Models;

            // Re-locate current active context selection to refresh costs visibility metrics
            selectedJob = jobsList.FirstOrDefault(j => j.Id == selectedJob.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Transactional storage breakdown: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<JobDisplayViewModel> GetJoinedJobsData()
    {
        // Order by created_at descending right at the source
        return jobsList
            .OrderByDescending(job => job.CreatedAt) // Note: Change to job.created_at if your C# property matches database snake_case exactly
            .Select(job =>
            {
                // Find the specific assignment that references this job UUID
                var assignment = assignmentsList.FirstOrDefault(a => a.JobIds != null && a.JobIds.Contains(job.Id));

                // Resolve the bigint[] array column to matching personnel objects
                var assignedPeople = new List<EmployeeEngineer>();
                if (assignment?.PersonnelIds != null && engineersDirectory.Any())
                {
                    assignedPeople = engineersDirectory
                        .Where(engineer => assignment.PersonnelIds.Contains(engineer.Id))
                        .ToList();
                }

                return new JobDisplayViewModel
                {
                    Job = job,
                    Assignment = assignment,
                    AssignedPersonnel = assignedPeople,
                    Spares = activeSessionCommittedSpares
                };
            });
    }

    

    private void DeselectJob()
    {
