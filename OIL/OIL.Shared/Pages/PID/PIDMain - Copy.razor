@page "/pidmain3"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@inject IJSRuntime JS
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar

<div id="full-page-container" class="@(_isFull ? "fullscreen-bg" : "")" style="background: inherit;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 mt-md-4">
        <MudGrid Spacing="2">

            @* --- RESPONSIVE HEADER CONTROLS --- *@
            <MudItem xs="12">
                <MudPaper Elevation="3" Class="pa-2 pa-md-4 d-flex flex-wrap align-center gap-2 rounded-lg">
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" Label="Field Type" Value="_selectedFieldType" ValueChanged="OnFieldTypeChanged" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" FullWidth="true">
                            <MudSelectItem Value="@("Eastern Fields")" />
                            <MudSelectItem Value="@("Western Fields")" />
                            <MudSelectItem Value="@("Other")" />
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="Location" Label="Installation" @bind-Value="_tempLocation" ToStringFunc="@(l => l?.InstallationName ?? string.Empty)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" FullWidth="true">
                            @foreach (var loc in _filteredLocations)
                            {
                                <MudSelectItem Value="@loc">@loc.InstallationName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <div class="d-flex align-center gap-2 flex-grow-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="LoadDrawing" Disabled="@(_tempLocation == null)">Go</MudButton>
                        <MudSpacer />
                        <MudToggleGroup T="bool" @bind-Value="_isMappingMode" Color="Color.Error" Outline="true" Size="Size.Small" CheckMark="false">
                            <MudToggleItem Value="false" Text="View" />
                            <MudToggleItem Value="true" Text="Edit/Pin" />
                        </MudToggleGroup>
                    </div>
                </MudPaper>
            </MudItem>

            @if (_currentLocation != null)
            {
                @* --- INTERACTIVE P&ID VIEWPORT --- *@
                <MudItem xs="12">
                    <div @ref="_mapScrollContainer" class="pid-viewport" style="position: relative; overflow: auto; border: 2px solid #333; background: #121212; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);">

                        @* Floating Action Buttons for Zoom/Navigation *@
                        <div style="position: sticky; top: 10px; left: 10px; z-index: 100; display: flex; flex-direction: column; gap: 8px;">
                            <MudFab Color="Color.Surface" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => _zoomLevel += 0.2" />
                            <MudFab Color="Color.Surface" StartIcon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => _zoomLevel = Math.Max(0.2, _zoomLevel - 0.2)" />
                            <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Fullscreen" Size="Size.Small" OnClick="ToggleFullScreen" Class="d-sm-none" />
                        </div>

                        <div id="pid-map-container" @onclick="HandleImageClick" style="@GetZoomStyle()" class="@(_isMappingMode ? "mapping-cursor" : "")">
                            <img @ref="myImage" src="@_currentLocation.ImageUrl" style="width: 100%; height: auto; display: block; pointer-events: none;" />

                            @foreach (var m in _markers.Where(x => x.CoordX.HasValue && x.CoordY.HasValue))
                            {
                                <div style="position: absolute; top: @($"{m.CoordY}%"); left: @($"{m.CoordX}%"); transform: translate(-50%, -50%); z-index: 10;">
                                    <MudTooltip Text="@($"{m.TagNumber}")">
                                        <MudIconButton Icon="@Icons.Material.Filled.LocationOn"
                                                       Style="@GetMarkerStyle(m.Id)"
                                                       Size="Size.Medium"
                                                       OnClick="() => OpenEdit(m)" />
                                    </MudTooltip>
                                </div>
                            }
                        </div>
                    </div>
                </MudItem>

                @* --- ASSET INVENTORY: Mobile Responsive Table --- *@
                <MudItem xs="12">
                    <MudTable Items="@_markers" Dense="true" Hover="true" Elevation="4" Height="300px" FixedHeader="true" Class="rounded-lg">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle1"><b>Asset Inventory</b></MudText>
                            <MudSpacer />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Tag</MudTh>
                            <MudTh Class="d-none d-sm-table-cell">Type</MudTh>
                            <MudTh Class="d-none d-md-table-cell">Range</MudTh>
                            <MudTh>Last PM</MudTh>
                            <MudTh Style="text-align:right">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="m">
                            <MudTd><b>@m.TagNumber</b></MudTd>
                            <MudTd Class="d-none d-sm-table-cell">@m.InstrumentType</MudTd>
                            <MudTd Class="d-none d-md-table-cell">@m.Range</MudTd>
                            <MudTd>@(_locationPmConfig?.LastGeneratedDate?.ToString("dd-MMM-yy") ?? "N/A")</MudTd>
                            <MudTd Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Color="Color.Info" Size="Size.Small" OnClick="() => LocateMarker(m)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEdit(m)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>

    @* --- FULL ASSET INTELLIGENCE DRAWER (Mobile Responsive) --- *@
    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Width="@(_isMobile ? "100%" : "450px")" Variant="DrawerVariant.Temporary" Elevation="5">
        <MudDrawerHeader Class="pa-4 bg-primary mud-theme-primary">
            <MudText Typo="Typo.h6" Color="Color.Inherit">Asset Configuration</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="() => _drawerOpen = false" />
        </MudDrawerHeader>
        <div class="pa-6">
            @if (_selectedMarker != null)
            {
                <MudStack Spacing="4">
                    <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight: 800">Technical Specifications</MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_selectedMarker.TagNumber" Label="Tag Number" Variant="Variant.Outlined" Required="true" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_selectedMarker.InstrumentType" Label="Instrument Type" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_selectedMarker.MakeModelType" Label="Make & Model" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_selectedMarker.Range" Label="Range" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_selectedMarker.Serial_number" Label="Serial No" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-2" />

                    <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight: 800">Maintenance & Logistics</MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="_selectedMarker.Replacement_cost" Label="Part Price (₹)" Variant="Variant.Outlined" Dense="true" HideSpinButtons="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField Label="PM Frequency" Value="@($"{_locationPmConfig?.FrequencyDays ?? 0} Days")" ReadOnly="true" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>

                    <MudPaper Variant="Variant.Outlined" Class="pa-4 d-flex align-center gap-4 mt-2" Style="background: #f8f9fa; border-style: dashed;">
                        <img src="@GetQrCodeUrl(_selectedMarker.TagNumber)" style="width: 100px; height: 100px;" />
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Field Tag QR</MudText>
                            <MudText Typo="Typo.body2"><b>Last PM:</b><br />@(_locationPmConfig?.LastGeneratedDate?.ToString("d MMM yyyy") ?? "Not Scheduled")</MudText>
                        </div>
                    </MudPaper>

                    <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveMarker" FullWidth="true" Size="Size.Large" StartIcon="@Icons.Material.Filled.Save" Class="mt-4">Update Database</MudButton>
                    
                    <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="CloseEdit" FullWidth="true" Size="Size.Large" StartIcon="@Icons.Material.Filled.Cancel" Class="mt-4"> Cancel & Close Drawer</MudButton>
                    
                    <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="() => DeleteMarker(_selectedMarker)" FullWidth="true" Size="Size.Small">Delete Marker</MudButton>
                </MudStack>
            }
        </div>
    </MudDrawer>
</div>

<style>
    .pid-viewport {
        height: 55vh;
    }
    @@media (min-width: 960px) {
        .pid-viewport {
            height: 75vh;
        }
    }

    .mapping-cursor {
        cursor: crosshair !important;
    }

    .fullscreen-bg {
        background-color: #1a1a1a !important;
        min-height: 100vh;
    }
</style>

@code {
    private ElementReference myImage;
    private ElementReference _mapScrollContainer;
    private Location _tempLocation;
    private Location _currentLocation;
    private double _zoomLevel = 1.0;
    private bool _isMappingMode = false;
    private bool _drawerOpen = false;
    private string _selectedFieldType;
    private List<Location> _allLocations = new();
    private List<Location> _filteredLocations = new();
    private List<Marker> _markers = new();
    private Marker _selectedMarker;
    private long? _activeMarkerId;
    private bool _isFull = false;
    private bool _isMobile = false;
    private PmConfiguration _locationPmConfig;

    [Table("locations")]
    public class Location : BaseModel
    {
        [Column("id")] public long Id { get; set; }
        [Column("installation_name")] public string InstallationName { get; set; }
        [Column("field_type")] public string FieldType { get; set; }
        [Column("image_url")] public string ImageUrl { get; set; }
    }

    [Table("pid_markers")]
    public class Marker : BaseModel
    {
        [PrimaryKey("id", false)] public long? Id { get; set; }
        [Column("location_id")] public long LocationId { get; set; }
        [Column("tag_number")] public string TagNumber { get; set; }
        [Column("instrument_type")] public string InstrumentType { get; set; }
        [Column("make_model_type")] public string MakeModelType { get; set; }
        [Column("range")] public string Range { get; set; }
        [Column("coord_x")] public double? CoordX { get; set; }
        [Column("coord_y")] public double? CoordY { get; set; }
        [Column("serial_number")] public string? Serial_number { get; set; }
        [Column("replacement_cost")] public long? Replacement_cost { get; set; }
    }

    [Table("pm_configurations")]
    public class PmConfiguration : BaseModel
    {
        [Column("location_id")] public long LocationId { get; set; }
        [Column("last_generated_date")] public DateTime? LastGeneratedDate { get; set; }
        [Column("frequency_days")] public int FrequencyDays { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var res = await SupabaseClient.From<Location>().Get();
        _allLocations = res.Models;
    }

    private void OnFieldTypeChanged(string t)
    {
        _selectedFieldType = t;
        _filteredLocations = _allLocations.Where(x => x.FieldType?.Equals(t, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
    }

    private async Task LoadDrawing()
    {
        _currentLocation = _tempLocation;
        await RefreshMarkers();
    }

    private async Task RefreshMarkers()
    {
        if (_currentLocation == null) return;
        var res = await SupabaseClient.From<Marker>().Where(x => x.LocationId == _currentLocation.Id).Get();
        _markers = res.Models;

        var pmRes = await SupabaseClient.From<PmConfiguration>().Where(x => x.LocationId == _currentLocation.Id).Get();
        _locationPmConfig = pmRes.Models.FirstOrDefault();
        StateHasChanged();
    }

    private void OpenEdit(Marker m)
    {
        _selectedMarker = m;
        _drawerOpen = true;
    }

    private void CloseEdit()
    {
        //_selectedMarker = m;
        _drawerOpen = false;
    }

    private async Task HandleImageClick(MouseEventArgs e)
    {
        if (!_isMappingMode) return;
        var dims = await JS.InvokeAsync<Dimensions>("eval", "(() => { const el = document.querySelector('img'); return { Width: el.clientWidth, Height: el.clientHeight }; })()");

        _selectedMarker = new Marker
        {
            LocationId = _currentLocation.Id,
            CoordX = (e.OffsetX / dims.Width) * 100,
            CoordY = (e.OffsetY / dims.Height) * 100,
            TagNumber = "NEW-TAG"
        };
        _drawerOpen = true;
    }

    private async Task SaveMarker()
    {
        await SupabaseClient.From<Marker>().Upsert(_selectedMarker);
        _drawerOpen = false;
        await RefreshMarkers();
        Snackbar.Add("Asset Updated", Severity.Success);
    }

    private async Task LocateMarker(Marker m)
    {
        _activeMarkerId = m.Id;
        _zoomLevel = 1.5;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("eval", $"document.getElementById('pid-map-container').parentElement.scrollTo({m.CoordX * 10}, {m.CoordY * 10})");
    }

    private async Task DeleteMarker(Marker m)
    {
        if (m.Id == null) return;
        await SupabaseClient.From<Marker>().Where(x => x.Id == m.Id).Delete();
        _drawerOpen = false;
        await RefreshMarkers();
        Snackbar.Add("Marker Removed", Severity.Warning);
    }

    private string GetMarkerStyle(long? id) => (_activeMarkerId == id)
        ? "color: #ff1744; scale: 2.2; filter: drop-shadow(0 0 8px #ff1744); transition: all 0.3s;"
        : "color: #00e676; filter: drop-shadow(0 0 3px black); transition: all 0.3s;";

    private string GetZoomStyle() => $"position: relative; width: {(_zoomLevel * 100)}%; transition: width 0.3s;";
    private string GetQrCodeUrl(string tag) => !string.IsNullOrEmpty(tag) ? $"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={tag}" : "";

    private async Task ToggleFullScreen()
    {
        _isFull = !_isFull;
        await JS.InvokeVoidAsync("eval", _isFull ? "document.documentElement.requestFullscreen()" : "document.exitFullscreen()");
    }

    public class Dimensions { public double Width { get; set; } public double Height { get; set; } }
}