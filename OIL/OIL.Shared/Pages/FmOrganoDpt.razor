@page "/fmorganodpt"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-10 mb-10">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="mud-text-primary font-weight-bold">Field Maintenance Organogram</MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-8">Departmental Hierarchy & Asset Allocation</MudText>

    <div class="org-scroll-container">
        <div class="org-tree">

            @* --- LEVEL 1: HOD --- *@
            <div class="node-group">
                <MudPaper Elevation="8" Class="pa-4 node-card root-node">
                    <MudText Typo="Typo.h6"><b>Chinmay Kumar Sarma</b></MudText>
                    <MudText Typo="Typo.caption">HOD</MudText>
                </MudPaper>

                <div class="connector-v"></div>

                @* --- LEVEL 2: GM --- *@
                <div class="node-group">
                    <MudPaper Elevation="6" Class="pa-4 node-card gm-node">
                        <MudText Typo="Typo.subtitle1"><b>Partha Pratim Adhyapak</b></MudText>
                        <MudText Typo="Typo.caption">GM</MudText>
                    </MudPaper>

                    <div class="connector-v"></div>

                    @* --- LEVEL 3: MANAGERS (Static Distribution) --- *@
                    <div class="node-children">
                        @foreach (var manager in StaticManagers)
                        {
                            <div class="node-group">
                                <div class="connector-h-branch"></div>
                                <MudPaper Elevation="4" Class="pa-4 node-card manager-node">
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Error" Size="Size.Small" />
                                        <div class="text-start">
                                            <MudText Typo="Typo.body1"><b>@manager.Name</b></MudText>
                                            <MudText Typo="Typo.caption" Class="d-block">@manager.Designation</MudText>
                                        </div>
                                    </div>

                                    <div class="asset-list-box">
                                        @foreach (var loc in manager.Locations)
                                        {
                                            <div class="asset-row">
                                                <span class="asset-dot"></span>
                                                <span class="asset-name">@loc</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-auto pt-3">
                                        <MudDivider Class="mb-2" />
                                        <div class="d-flex justify-space-between align-center">
                                            <MudText Typo="Typo.caption" Style="font-weight: 700;">Total Assets:</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Error" Style="font-weight: 900;">@manager.Locations.Count</MudText>
                                        </div>
                                    </div>
                                </MudPaper>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    
    
    
        <div>
            <br />
            <MudText Typo="Typo.caption" Style="font-weight: 700; font-size: 1.25rem;">
                Total Manpower: 23 Employees
            </MudText>
            <br />
            <MudText Typo="Typo.caption" Style="font-weight: 700; font-size: 1.25rem;">
                Round the clock maintenance support is provided in 2 shifts.
            </MudText>
        </div>

       

    </div>
</MudContainer>

<style>
    .org-scroll-container {
        overflow-x: auto;
        padding: 60px 20px;
        background: #f8fafc;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .org-tree {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 1600px;
    }

    .node-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .node-children {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        position: relative;
        padding-top: 30px;
        gap: 20px;
    }

    .connector-v {
        width: 2px;
        height: 35px;
        background: #94a3b8;
    }

    .node-children::before {
        content: "";
        position: absolute;
        top: 0;
        left: 15px;
        right: 15px;
        height: 2px;
        background: #94a3b8;
    }

    .node-card {
        width: 250px;
        text-align: center;
        z-index: 2;
        border-bottom: 5px solid transparent;
        border-radius: 12px;
    }

    .root-node {
        border-bottom-color: #1e293b;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }

    .gm-node {
        border-bottom-color: #ea580c;
    }

    .manager-node {
        border-bottom-color: #dc2626;
        width: 290px;
        min-height: 720px; /* High min-height to ensure all 20+ locations fit */
        display: flex;
        flex-direction: column;
        background: white;
        transition: all 0.3s ease;
    }

        .manager-node:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
        }

    .asset-list-box {
        text-align: left;
        background: #fdfdfd;
        border: 1px solid #f1f5f9;
        border-radius: 8px;
        padding: 12px;
        flex-grow: 1;
    }

    .asset-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        border-bottom: 1px solid #f8fafc;
        padding-bottom: 2px;
    }

    .asset-dot {
        width: 6px;
        height: 6px;
        background: #dc2626;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .asset-name {
        font-size: 11px;
        color: #334155;
        font-weight: 500;
        line-height: 1.2;
    }
</style>

@code {
    public class ManagerData
    {
        public string Name { get; set; }
        public string Designation { get; set; }
        public List<string> Locations { get; set; } = new();
    }

    private List<ManagerData> StaticManagers = new();

    protected override void OnInitialized()
    {
        var allLocations = GetManualLocations();

        // Define exactly 5 managers as per your requirement
        StaticManagers = new List<ManagerData> {
            new ManagerData { Name = "Satya Ranjan Chetia", Designation = "SUPERINTENDING ENGINEER" },
            new ManagerData { Name = "Rahul Pal", Designation = "SUPERINTENDING ENGINEER" },
            new ManagerData { Name = "Subhanan Goswami", Designation = "SENIOR OFFICER" },
            new ManagerData { Name = "Surendra Choudhary", Designation = "SUPERINTENDING ENGINEER" },
            new ManagerData { Name = "Tolan Boruah", Designation = "DEPUTY CHIEF ENGINEER" }
        };

        // Distribute 102 locations across 5 managers (~20 each)
        int perManager = allLocations.Count / StaticManagers.Count;
        int remainder = allLocations.Count % StaticManagers.Count;
        int currentIdx = 0;

        for (int i = 0; i < StaticManagers.Count; i++)
        {
            int countToTake = perManager + (i < remainder ? 1 : 0);
            StaticManagers[i].Locations = allLocations.Skip(currentIdx).Take(countToTake).ToList();
            currentIdx += countToTake;
        }
    }

