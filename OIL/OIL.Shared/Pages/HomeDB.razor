@page "/homeDB"

@using MudBlazor
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_brandTheme" DefaultScrollbar="true" />

<div id="full-page-container" style="background: inherit;">
    <div class="dashboard-root">
        <div class="dashboard-shell">

            <div class="d-flex justify-space-between align-center flex-wrap gap-4 mb-8">
                <div class="d-flex align-center gap-4">
                    <div class="logo-container">
                        <MudImage Src="_content/OIL.Shared/imgs/oil.png" Width="68" Height="68" Alt="OIL Logo" />
                    </div>
                    <div>
                        <span class="brand-kicker">Instrumentation Department • Field Maintenance Section</span>
                        <MudText Typo="Typo.h3" Class="brand-title">Field Maintenance <span class="accent-red">Dashboard</span></MudText>
                        <MudText Typo="Typo.body1" Class="brand-subtext">Instrumentation support for production installations, control systems and safety-critical assets.</MudText>
                    </div>
                </div>

                <div class="d-flex gap-3 align-center">
                    <div class="brand-pill">
                        <span class="@(_autoCycle ? "dot-live" : "dot-paused")"></span>
                        Status: <b>@(_autoCycle ? "Live Cycle" : "Paused")</b>
                    </div>
                    <div class="brand-pill">Time: <b>@DateTime.Now.ToString("HH:mm:ss")</b></div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="rounded-pill px-4" OnClick="ToggleFullScreen">Full Screen</MudButton>
                    @if (!_autoCycle)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4" OnClick="() => _autoCycle = true">Resume</MudButton>
                    }
                </div>
            </div>



            <div class="hero-section mt-12">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                    @* --- KPI SECTION (Slide 3 Data) --- *@
                    <MudGrid Class="mb-8">
                        @foreach (var kpi in KPIs)
                        {
                            <MudItem xs="12" sm="4" md="2">
                                <MudPaper Class="pa-4 command-card d-flex flex-column align-start">
                                    <MudText Typo="Typo.caption" Style="color: #888; font-weight: bold; text-transform: uppercase;">@kpi.Label</MudText>
                                    <MudText Typo="Typo.h4" Style="font-weight: 900; color: var(--oil-black);">@kpi.Value</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #aaa;">@kpi.SubText</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>

                    @* --- MISSION & IDENTITY (Slide 1 Data) --- *@
                    <MudGrid Class="mb-12 slide-up">
                        <MudItem xs="12" md="7">
                            <MudText Typo="Typo.h3" Style="font-weight: 900;" Class="mb-2">Who We Are</MudText>
                            <MudText Typo="Typo.subtitle1" Class="mb-6" Style="color: #666;">Field Maintenance Team, Instrumentation</MudText>
                            <MudText Typo="Typo.body1" Style="font-size: 1.1rem; line-height: 1.8;">
                                The Field Maintenance Instrumentation Team provides comprehensive maintenance services across a wide
                                geographical and operational footprint. Our scope of work covers a diverse range of critical
                                installations including <b>OCS, GCS, EPS, QPS, and WHS clusters</b>, along with specialized support
                                for industrial units such as <b>CBUS, MSG, CMT, and R&D facilities</b>. From established
                                production hubs to upcoming sites, we ensure the reliability and
                                precision of instrumentation and control systems organization-wide.
                            </MudText>
                            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.FormatQuote" Class="mt-4" Style="color: var(--oil-red); font-style: italic;">
                                "Printing our footprints in every domain of maintenance, automation and digitalization."
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudPaper Elevation="0" Class="pa-6" Style="background: var(--oil-pink); border-radius: 15px;">
                                <MudList T="string">
                                    <MudListItem Icon="@Icons.Material.Filled.Hub" IconColor="Color.Error">
                                        <MudText Typo="Typo.body1"><b>Operational Backbone:</b> Base to enterprise-wide support</MudText>
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Filled.Security" IconColor="Color.Error">
                                        <MudText Typo="Typo.body1"><b>Automation Custodian:</b> Control & protection systems</MudText>
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Filled.Analytics" IconColor="Color.Error">
                                        <MudText Typo="Typo.body1"><b>Digital Enabler:</b> Data foundation for decisions</MudText>
                                    </MudListItem>
                                </MudList>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    @* --- CORE OPERATIONS (Slide 2 Data) --- *@
                    <MudText Typo="Typo.h4" Class="mb-6" Style="font-weight: 900;">Core Operations & Contributions</MudText>
                    <MudGrid Class="mb-12">
                        @foreach (var op in Operations)
                        {
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-6 border-top-4" Style="@($"border-top: 4px solid {op.Color}; background: white; height: 100%; box-shadow: var(--card-shadow);")">
                                    <div class="d-flex align-center mb-4">
                                        <MudIcon Icon="@op.Icon" Color="@op.MudColor" Class="mr-2" />
                                        <MudText Typo="Typo.h6" Style="font-weight: bold;">@op.Title</MudText>
                                    </div>
                                    <MudList T="string" Dense="true">
                                        @foreach (var detail in op.Items)
                                        {
                                            <MudListItem Icon="@Icons.Material.Filled.KeyboardArrowRight" IconColor="@op.MudColor">@detail</MudListItem>
                                        }
                                    </MudList>
                                    <MudDivider Class="my-4" />
                                    <MudText Typo="Typo.button" Style="@($"color: {op.Color}; font-weight: 800;")">@op.Goal</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>

                    @* --- ASSET PORTFOLIO (Slide 3 Expanded Data) --- *@
                    <MudText Typo="Typo.h4" Class="mb-6" Style="font-weight: 900;">Complete Asset Portfolio</MudText>
                    <MudGrid Class="mb-12">
                        @foreach (var asset in Portfolio)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <div class="d-flex align-center pa-4 mb-2 command-card">
                                    <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Class="mr-4">
                                        <MudIcon Icon="@asset.Icon" />
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.h5" Style="font-weight: 900;">@asset.Count</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #666; font-weight: bold;">@asset.Name.ToUpper()</MudText>
                                    </div>
                                </div>
                            </MudItem>
                        }
                    </MudGrid>

                    @* --- GLOBAL PRESENCE (Slide 4 Data) --- *@
                    <MudText Typo="Typo.h4" Class="mb-6" Style="font-weight: 900;">Our Presence Across OIL</MudText>
                    <MudGrid>
                        @foreach (var p in Locations)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Elevation="0" Class="pa-4 presence-chip">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@p.Icon" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.button" Style="font-weight: 900;">@p.Area</MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="color: #555;">@p.Details</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudContainer>
            </div>
        </div>




            @* <MudGrid Class="mb-8">
                @foreach (var kpi in _kpis)
                {
                    <MudItem xs="12" sm="4" md="2">
                        <div class="kpi-card-brand">
                            <div class="k">@kpi.Title</div>
                            <div class="v">@kpi.Value</div>
                            <div class="s">@kpi.Subtext</div>
                        </div>
                    </MudItem>
                }
            </MudGrid> *@

        <MudText Typo="Typo.h4" Class="mb-6" Style="font-weight: 900;">Our Snapshot</MudText>

            <div class="carousel-container">
                <MudCarousel @bind-SelectedIndex="_currentSlideIndex"
                             Class="mud-width-full"
                             Style="height: 620px;"
                             ShowArrows="true"
                             ShowBullets="true"
                             AutoCycle="_autoCycle"
                             TData="object">

                    <MudCarouselItem Transition="Transition.Slide">
                        <div class="slide-layout">
                            <div class="content-panel">
                                <div class="section-tag">Operational Mandate</div>
                                <MudText Typo="Typo.h4" Class="mt-4 fw-bold">High availability of field instrumentation services.</MudText>
                                <MudText Typo="Typo.body2" Class="mt-2 mb-6 opacity-70">Field Maintenance sustains operating continuity through preventive maintenance and disciplined response.</MudText>

                                <MudGrid Spacing="2">
                                    <MudItem xs="6"><div class="callout-box"><span>Primary Objective</span><strong>Service continuity</strong><p>Keeps control elements available.</p></div></MudItem>
                                    <MudItem xs="6"><div class="callout-box"><span>Maintenance Model</span><strong>Preventive Support</strong><p>Structured maintenance coverage.</p></div></MudItem>
                                    <MudItem xs="6"><div class="callout-box"><span>Operating Value</span><strong>Plant Performance</strong><p>Strengthens process stability.</p></div></MudItem>
                                    <MudItem xs="6"><div class="callout-box"><span>Section Reach</span><strong>Production Allied</strong><p>Associated support functions.</p></div></MudItem>
                                </MudGrid>
                            </div>

                        <div class="visual-panel">
                            <!-- Container for the Image -->
                            <div class="media-card" style="height: 300px; width: 100%; overflow: hidden; position: relative; border-radius: 8px;">
                                <MudImage Src="_content/OIL.Shared/imgs/homeDB/s1.png"
                                          Alt="Operational Mandate"
                                          ObjectFit="ObjectFit.Cover"
                                          Class="w-100 h-100" />
                                <div class="media-label" style="position: absolute; bottom: 0; width: 100%;">
                                    <b>Operational Mandate</b>
                                </div>
                            </div>



                                <div class="mini-scada-brand mt-4">
                                    <div class="d-flex justify-space-between mb-2">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Coverage Snapshot</MudText>
                                        <span class="pulse-text">Active</span>
                                    </div>
                                    @foreach (var meter in _meters)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex justify-space-between mb-1">
                                                <MudText Typo="Typo.caption" Class="fw-bold">@meter.Label</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Primary">@meter.Val</MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Primary" Value="@meter.Percent" Size="Size.Small" Class="rounded-pill bg-pink-light" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </MudCarouselItem>

                    <MudCarouselItem Transition="Transition.Slide">
                        <div class="slide-layout">
                            <div class="content-panel">
                                <div class="section-tag">Service Portfolio</div>
                                <MudText Typo="Typo.h4" Class="mt-4 fw-bold">Integrated support across instruments and safety systems.</MudText>
                                <p class="mt-2 opacity-70">Managing field devices, control platforms, and safety-related instrumentation assets.</p>

                                <MudGrid Class="mt-4" Spacing="2">
                                    <MudItem xs="6"><div class="service-card-brand"><strong>Field Instrument Health</strong><p>Calibration and troubleshooting.</p></div></MudItem>
                                    <MudItem xs="6"><div class="service-card-brand"><strong>Control System Readiness</strong><p>DCS and Panel hardware support.</p></div></MudItem>
                                    <MudItem xs="6"><div class="service-card-brand"><strong>Safety System Dependability</strong><p>BMS and Flare Ignition support.</p></div></MudItem>
                                    <MudItem xs="6"><div class="service-card-brand"><strong>Cross-functional Support</strong><p>Allied department services.</p></div></MudItem>
                                </MudGrid>
                            </div>
                            <div class="visual-panel">
                            <div class="media-card" style="height: 300px; width: 100%; overflow: hidden; position: relative; border-radius: 8px;">
                                <MudImage Src="_content/OIL.Shared/imgs/homeDB/s2.png"
                                          Alt="Portfolio Coverage"
                                          ObjectFit="ObjectFit.Cover"
                                          Class="w-100 h-100" />
                                <div class="media-label" style="position: absolute; bottom: 0; width: 100%;">
                                    <b>Portfolio Coverage</b>
                                </div>
                            </div>
                                <MudGrid Spacing="2" Class="mt-2">
                                    @foreach (var tile in _portfolioTiles)
                                    {
                                        <MudItem xs="6">
                                            <div class="portfolio-tile">
                                                <div class="d-flex justify-space-between align-center">
                                                    <span class="tile-label">@tile.Label</span>
                                                    <span class="tile-idx">@tile.Id</span>
                                                </div>
                                                <div class="tile-val">@tile.Value</div>
                                                <div class="tile-note">@tile.Note</div>
                                            </div>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </div>
                        </div>
                    </MudCarouselItem>

                    <MudCarouselItem Transition="Transition.Slide">
                        <div class="slide-layout">
                            <div class="content-panel">
                                <div class="section-tag">Connected Workflow</div>
                                <MudText Typo="Typo.h4" Class="mt-4 fw-bold">Immediate visibility and direct operating access.</MudText>

                                <MudGrid Spacing="2" Class="mt-4">
                                    @foreach (var live in _liveStats)
                                    {
                                        <MudItem xs="6">
                                            <div class="live-stat-card">
                                                <div class="k">@live.Label</div>
                                                <div class="v">@live.Value</div>
                                                <div class="s">@live.Sub</div>
                                            </div>
                                        </MudItem>
                                    }
                                </MudGrid>
                                <div class="mt-4 pa-4 rounded-lg bg-pink-light border-red-soft">
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-bold">Digitizing processes using systems ...</MudText>
                                </div>
                            </div>
                            <div class="visual-panel">
                                <MudStack Spacing="2">
                                    <div class="nav-link-brand">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold" onclick="">Open P&IDs</MudText>
                                            <MudText Typo="Typo.caption" onlick="">Installation-wise drawings & hotspots.</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" />
                                    </div>
                                    <div class="nav-link-brand">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold" onclick="">Open Daily Report</MudText>
                                            <MudText Typo="Typo.caption" onclick="">Daily entry and reporting workflow.</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" />
                                    </div>
                                    

                                <div class="media-card" style="height: 300px; width: 100%; overflow: hidden; position: relative; border-radius: 8px;">
                                    <MudImage Src="_content/OIL.Shared/imgs/homeDB/s3.png"
                                              Alt="System Access"
                                              ObjectFit="ObjectFit.Cover"
                                              Class="w-100 h-100" />
                                    <div class="media-label" style="position: absolute; bottom: 0; width: 100%;">
                                        <b>System Access</b>
                                    </div>
                                </div>


                                </MudStack>
                            </div>
                        </div>
                    </MudCarouselItem>
                </MudCarousel>
            </div>
        </div>
    </div>



<style>
    :root {
        --oil-red: #E21E26;
        --oil-pink: #FFF5F7;
        --oil-soft-pink: #FEF2F4;
        --oil-black: #1A1A1A;
        --oil-white: #FFFFFF;
        --card-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .main-container {
        background-color: var(--oil-white);
        min-height: 100vh;
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    /* Reference Image 9 Styling: Minimalist Cards with Red Accents */
    .command-card {
        background: var(--oil-white) !important;
        border-radius: 12px !important;
        box-shadow: var(--card-shadow) !important;
        border-bottom: 4px solid var(--oil-red) !important;
        transition: transform 0.3s ease;
    }

        .command-card:hover {
            transform: translateY(-5px);
        }

    .hero-section {
        background: linear-gradient(180deg, var(--oil-pink) 0%, var(--oil-white) 100%);
        padding: 40px 0;
    }

    /* Animations */
    .fade-in {
        animation: fadeIn 0.8s ease-in forwards;
    }

    .slide-up {
        animation: slideUp 0.6s ease-out forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .timeline-line {
        position: relative;
        border-bottom: 3px solid #eee;
    }

    .timeline-dot {
        height: 15px;
        width: 15px;
        background-color: var(--oil-red);
        border-radius: 50%;
        display: inline-block;
        position: absolute;
        top: -9px;
    }

    /* Presence Grid Styling */
    .presence-chip {
        border-left: 4px solid var(--oil-red);
        background: var(--oil-soft-pink);
    }
</style>


<style>
    :root {
        --oil-red: #E21E26;
        --oil-pink: #fff1f2;
        --oil-white: #ffffff;
    }

    .dashboard-root {
        background: radial-gradient(circle at top left, rgba(215, 25, 32, 0.05), transparent 40%), var(--oil-white);
        min-height: 100vh;
        color: #1e293b;
    }

    .dashboard-shell {
        padding: 40px;
    }

    .logo-container {
        padding: 10px;
        background: white;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(215, 25, 32, 0.1);
        border: 1px solid var(--oil-pink);
    }

    .brand-kicker {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--oil-red);
        font-weight: 800;
        background: var(--oil-pink);
        padding: 4px 14px;
        border-radius: 20px;
    }

    .brand-title {
        font-weight: 900;
        color: #0f172a;
        margin-top: 8px;
    }

    .accent-red {
        color: var(--oil-red);
    }

    .brand-subtext {
        color: #64748b;
        font-size: 1.1rem;
    }

    .brand-pill {
        background: white;
        border: 1px solid #e2e8f0;
        padding: 8px 20px;
        border-radius: 99px;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
    }

    .dot-live {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        box-shadow: 0 0 8px #22c55e;
    }

    .dot-paused {
        width: 8px;
        height: 8px;
        background: #f59e0b;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        box-shadow: 0 0 8px #f59e0b;
    }

    /* KPI CARDS */
    .kpi-card-brand {
        padding: 24px;
        background: white;
        border-radius: 24px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 8px 20px rgba(0,0,0,0.02);
        border-bottom: 4px solid var(--oil-red);
    }

        .kpi-card-brand .k {
            font-size: 11px;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
        }

        .kpi-card-brand .v {
            font-size: 32px;
            font-weight: 900;
            color: #1e293b;
            margin: 4px 0;
        }

        .kpi-card-brand .s {
            font-size: 11px;
            color: #64748b;
        }

    /* CAROUSEL */
    .carousel-container {
        background: white;
        border: 1px solid #f1f5f9;
        border-radius: 32px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.04);
    }

    .slide-layout {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 40px;
        padding: 40px;
    }

    .section-tag {
        display: inline-block;
        padding: 6px 14px;
        background: var(--oil-pink);
        color: var(--oil-red);
        border-radius: 99px;
        font-size: 11px;
        font-weight: 800;
    }

    .callout-box, .service-card-brand, .live-stat-card {
        background: var(--oil-pink);
        padding: 16px;
        border-radius: 16px;
        border: 1px solid rgba(215, 25, 32, 0.05);
    }

        .callout-box span, .live-stat-card .k {
            font-size: 10px;
            color: var(--oil-red);
            font-weight: 800;
            text-transform: uppercase;
        }

        .callout-box strong, .service-card-brand strong {
            display: block;
            font-size: 14px;
            margin-top: 2px;
        }

        .callout-box p, .service-card-brand p {
            font-size: 11px;
            color: #64748b;
            margin-top: 4px;
            line-height: 1.2;
        }

        .live-stat-card .v {
            font-size: 26px;
            font-weight: 900;
            color: #0f172a;
        }

    .media-card {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        border: 4px solid white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .media-label {
        position: absolute;
        bottom: 0;
        width: 100%;
        padding: 15px;
        background: linear-gradient(transparent, rgba(0,0,0,0.85));
        color: white;
    }

    .mini-scada-brand {
        background: #fff8f8;
        padding: 20px;
        border-radius: 20px;
        border: 1px solid var(--oil-pink);
    }

    .pulse-text {
        color: var(--oil-red);
        font-weight: 900;
        font-size: 11px;
        text-transform: uppercase;
        animation: blink 2s infinite;
    }

    .portfolio-tile {
        padding: 16px;
        background: white;
        border: 1px solid #f1f5f9;
        border-radius: 16px;
    }

    .tile-label {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
    }

    .tile-idx {
        font-size: 11px;
        color: var(--oil-red);
        font-weight: 900;
        opacity: 0.3;
    }

    .tile-val {
        font-size: 22px;
        font-weight: 900;
    }

    .nav-link-brand {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 20px;
        border-radius: 20px;
        border: 1px solid #f1f5f9;
        cursor: pointer;
        transition: 0.2s;
    }

        .nav-link-brand:hover {
            border-color: var(--oil-red);
            background: var(--oil-pink);
        }

    .bg-pink-light {
        background-color: var(--oil-pink) !important;
    }

    .border-red-soft {
        border: 1px solid rgba(215, 25, 32, 0.1);
    }

    .fw-bold {
        font-weight: 700;
    }

    @@keyframes blink {
        50% {
            opacity: 0.4;
        }
    }
