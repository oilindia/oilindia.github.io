    private async Task ToggleFullScreen()
    {
        try
        {
            if (!_isFull)
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('full-page-container').requestFullscreen()");
                _isFull = true;
            }
            else
            {
                await JS.InvokeVoidAsync("eval", "if(document.fullscreenElement) document.exitFullscreen()");
                _isFull = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Fullscreen not supported or blocked", Severity.Error);
        }
    }

