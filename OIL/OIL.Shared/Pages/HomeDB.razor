    private int _currentSlideIndex = 0;
    private int _lastInteractedIndex = -1;
    private bool _autoCycle = true;
    private bool _isFull = false;

    // Detects when the user clicks a dot or arrow
    protected override void OnAfterRender(bool firstRender)
    {
        if (_currentSlideIndex != _lastInteractedIndex)
        {
            _lastInteractedIndex = _currentSlideIndex;
            // If user explicitly changed the slide, pause the cycle
            _autoCycle = true;
            StateHasChanged();
        }
    }

