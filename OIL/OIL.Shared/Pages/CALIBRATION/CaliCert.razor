<style>
    /* 1. SCREEN STYLING (The UI looks) */
    .report-paper {
        background-color: white;
        color: black;
        font-family: "Arial", sans-serif;
        line-height: 1.2;
        margin: 0 auto;
        border: 1px solid black;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        color: black;
        page-break-inside: auto;
    }

        .report-table tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        .report-table th, .report-table td {
            border: 1px solid black !important;
            padding: 4px 6px;
            text-align: left;
            font-size: 13px;
            font-weight: bold;
        }

    .text-center {
        text-align: center !important;
    }

    .font-bold {
        font-weight: bold;
    }

    .header-logo-section {
        border: 1px solid black;
        text-align: center;
        padding: 10px;
    }

    .custom-modal-overlay {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.8);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        overflow-y: auto;
        padding: 40px 0;
        backdrop-filter: blur(4px);
    }

    .modal-content-container {
        width: 900px;
        background-color: #f0f0f0;
        padding: 25px;
        margin-bottom: 40px;
        border-radius: 4px;
    }

    /* 2. PRINT LOGIC (The "Magic" Fix) */
    @@media print {
        @@page {
            size: A4;
            margin: 10mm;
        }
        /* Hide all UI background elements */
        body * {
            visibility: hidden !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        /* Make the report and its specific parents visible */
        #printable-report,
        #printable-report *,
        .custom-modal-overlay,
        .modal-content-container {
            visibility: visible !important;
        }
        /* CRITICAL: Remove scrollbars and fixed heights for multi-page flow */
        .custom-modal-overlay {
            position: absolute !important;
            display: block !important; /* Prevents flexbox clipping */
            overflow: visible !important;
            height: auto !important;
            background: white !important;
            padding: 0 !important;
        }

        .modal-content-container {
            width: 100% !important;
            max-width: none !important;
            background: white !important;
            height: auto !important;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #printable-report {
            position: static !important; /* Let it flow across pages naturally */
            width: 100% !important;
            border: none !important;
            padding: 0 !important;
            /* Scale slightly to ensure it fits within A4 margins */
            transform: scale(0.98);
            transform-origin: top left;
        }

        .no-print {
            display: none !important;
        }
    }
</style>


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 no-print">

    <MudPaper Elevation="3" Class="pa-4 mb-6">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="From Date"
                               Editable="true"
                               @bind-Date="_fromDate"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="To Date"
                               Editable="true"
                               @bind-Date="_toDate"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center pt-5">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FilterAlt"
                           OnClick="LoadCalibrationData"
                           Loading="_loading"
                           FullWidth="true">
                    Fetch Reports
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="3" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Info" />
            <MudText Typo="Typo.h5" Class="font-bold">Instrumentation Calibration Index</MudText>
        </MudStack>

        <MudDataGrid T="CalibrationUiView" Items="_gridItems" Dense="true" Hover="true" Bordered="true" Loading="_loading">
            <Columns>
                <TemplateColumn Title="View" HeaderStyle="width: 60px;" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => ViewCertificate(context.Item)" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.DateFormatted" Title="Date" />
                <PropertyColumn Property="x => x.DisplayCertNo" Title="Certificate No" />
                <PropertyColumn Property="x => x.DisplayInstallation" Title="Location Name" />
                <PropertyColumn Property="x => x.DisplayUnitId" Title="Unit / Loop Location" />
                <PropertyColumn Property="x => x.DisplayInstrumentType" Title="Instrument Category" />
                <PropertyColumn Property="x => x.DisplayModel" Title="Model Variant" />
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4" Align="Align.Center">No records matching designated date parameters found.</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

