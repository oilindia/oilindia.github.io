<style>
    /* 1. SCREEN STYLING (The UI looks) */
    .report-paper {
        background-color: white;
        color: black;
        font-family: "Arial", sans-serif;
        line-height: 1.2;
        margin: 0 auto;
        border: 1px solid black;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        color: black;
        page-break-inside: auto;
    }

        .report-table tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        .report-table th, .report-table td {
            border: 1px solid black !important;
            padding: 4px 6px;
            text-align: left;
            font-size: 13px;
            font-weight: bold;
        }

    .text-center {
        text-align: center !important;
    }

    .font-bold {
        font-weight: bold;
    }

    .header-logo-section {
        border: 1px solid black;
        text-align: center;
        padding: 10px;
    }

    .custom-modal-overlay {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.8);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        overflow-y: auto;
        padding: 40px 0;
        backdrop-filter: blur(4px);
    }

    .modal-content-container {
        width: 900px;
        background-color: #f0f0f0;
        padding: 25px;
        margin-bottom: 40px;
        border-radius: 4px;
    }

    /* 2. PRINT LOGIC (The "Magic" Fix) */
    @@media print {
        @@page {
            size: A4;
            margin: 10mm;
        }
        /* Hide all UI background elements */
        body * {
            visibility: hidden !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        /* Make the report and its specific parents visible */
        #printable-report,
        #printable-report *,
        .custom-modal-overlay,
        .modal-content-container {
            visibility: visible !important;
        }
        /* CRITICAL: Remove scrollbars and fixed heights for multi-page flow */
        .custom-modal-overlay {
            position: absolute !important;
            display: block !important; /* Prevents flexbox clipping */
            overflow: visible !important;
            height: auto !important;
            background: white !important;
            padding: 0 !important;
        }

        .modal-content-container {
            width: 100% !important;
            max-width: none !important;
            background: white !important;
            height: auto !important;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #printable-report {
            position: static !important; /* Let it flow across pages naturally */
            width: 100% !important;
            border: none !important;
            padding: 0 !important;
            /* Scale slightly to ensure it fits within A4 margins */
            transform: scale(0.98);
            transform-origin: top left;
        }

        .no-print {
            display: none !important;
        }
    }
</style>



<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 no-print">

    <!-- Filter Panel Header -->
    <MudPaper Elevation="3" Class="pa-4 mb-6">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="From Date"
                               Editable="true"
                               @bind-Date="_fromDate"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="To Date"
                               Editable="true"
                               @bind-Date="_toDate"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center pt-5">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FilterAlt"
                           OnClick="LoadCalibrationData"
                           Loading="_loading"
                           FullWidth="true">
                    Fetch Reports
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Data Grid View -->
    <MudPaper Elevation="3" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Info" />
            <MudText Typo="Typo.h5" Class="font-bold">Instrumentation Calibration Index</MudText>
        </MudStack>

        <MudDataGrid T="CalibrationUiView" Items="_gridItems" Dense="true" Hover="true" Bordered="true" Loading="_loading">
            <Columns>
                <TemplateColumn Title="View" HeaderStyle="width: 60px;" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => ViewCertificate(context.Item)" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.DateFormatted" Title="Date" />
                <PropertyColumn Property="x => x.Detail.CertNo" Title="Certificate No" />
                <PropertyColumn Property="x => x.LocationId" Title="Location ID" />
                <PropertyColumn Property="x => x.Detail.UnitId" Title="Unit / Loop Location" />
                <PropertyColumn Property="x => x.Detail.InstrumentType" Title="Instrument Category" />
                <PropertyColumn Property="x => x.Detail.Model" Title="Model Variant" />
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4" Align="Align.Center">No records matching designated date parameters found.</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

<!-- Dynamic Report Modal Interface -->
@if (_isModalOpen && _selectedReport != null)
{
    <div class="custom-modal-overlay">
        <div class="modal-content-container">
            <!-- Action Navigation Bar -->
            <div class="d-flex justify-space-between align-center mb-4 no-print" style="position: sticky; top: -25px; background: #f0f0f0; z-index: 10; padding: 10px; border-radius: 4px;">
                <MudButton OnClick="PrintReport" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Print">
                    Print Document
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _isModalOpen = false" Color="Color.Error" Variant="Variant.Filled" />
            </div>

            <div id="printable-report" class="report-paper mx-auto" style="width: 210mm; padding: 15mm; background-color: white; color: black; font-family: sans-serif;">

                <div class="header-logo-section" style="text-align: center; margin-bottom: 15px;">
                    <img src="_content/OIL.Shared/imgs/oil.png" alt="OIL INDIA" style="height: 60px;" /><br />
                    <MudText Typo="Typo.h5" Class="font-bold" Style="color: black; font-weight: bold; margin-top: 5px;">OIL INDIA LIMITED</MudText>
                </div>

                <div style="border: 1px solid black; text-align: center; background-color: #f8f9fa; padding: 4px;">
                    <MudText Typo="Typo.body1" Class="font-bold" Style="color: black; font-weight: bold;">
                        Calibration Report for @_selectedReport.Detail.InstrumentType
                    </MudText>
                </div>

                <!-- Structured Meta Table -->
                <table style="width: 100%; border-collapse: collapse; border: 1px solid black; border-top: none; font-size: 13px;">
                    <tr>
                        <td style="width: 50%; padding: 6px; border: 1px solid black;">Installation: @_selectedReport.Detail.Installation</td>
                        <td style="width: 50%; padding: 6px; border: 1px solid black;">Certificate No: @_selectedReport.Detail.CertNo</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px; border: 1px solid black;">Date: @_selectedReport.DateFormatted</td>
                        <td style="padding: 6px; border: 1px solid black;">Location Reference ID: @_selectedReport.LocationId</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px; border: 1px solid black;">Unit / Tag Location: @_selectedReport.Detail.UnitId</td>
                        <td style="padding: 6px; border: 1px solid black;">Model variant: @_selectedReport.Detail.Model</td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding: 6px; border: 1px solid black;">Range capability: @_selectedReport.Detail.InstrumentRange</td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding: 6px; border: 1px solid black;">
                            Master Calibrator Applied: @(string.IsNullOrWhiteSpace(_selectedReport.CalibrationPayload.MasterCalibrator) ? _selectedReport.Detail.MasterCalibrator : _selectedReport.CalibrationPayload.MasterCalibrator)
                        </td>
                    </tr>
                </table>

                <!-- Main Matrix Table -->
                <table style="width: 100%; border-collapse: collapse; border: 1px solid black; border-top: none; font-size: 13px; margin-top: 15px;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 6px; border: 1px solid black; text-align: center;">Input Applied Value</th>
                            <th style="padding: 6px; border: 1px solid black; text-align: center;">Span %</th>
                            <th style="padding: 6px; border: 1px solid black; text-align: center;">Expected Output</th>
                            <th style="padding: 6px; border: 1px solid black; text-align: center;">Actual Measured</th>
                            <th style="padding: 6px; border: 1px solid black; text-align: center;">Calculated Error</th>
                            <th style="padding: 6px; border: 1px solid black; text-align: center;">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_selectedReport.CalibrationPayload.CalibrationTable.Any())
                        {
                            @foreach (var row in _selectedReport.CalibrationPayload.CalibrationTable)
                            {
                                <tr>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@row.InputValue</td>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@row.InputPercentage</td>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@row.ExpectedOutput</td>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@row.ActualOutput</td>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@row.Error</td>
                                    <td style="padding: 6px; border: 1px solid black;">@row.CalRemarks</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <!-- Conditional Sub-block for Controller Loop Configurations -->
                @if (_selectedReport.Detail.InstrumentType?.Contains("CONTROLLER", StringComparison.OrdinalIgnoreCase) == true)
                {
                    <div style="border: 1px solid black; border-top: none; padding: 8px; font-size: 13px;">
                        <p style="font-weight: bold; text-decoration: underline; margin-bottom: 4px;">Dynamic Loop Configuration Parameters:</p>
                        <ul style="list-style-type: square; padding-left: 20px; margin: 0;">
                            <li>Operational Target Setpoint: @_selectedReport.CalibrationPayload.SetPoint</li>
                            <li>Actuator / Valve Direction Matrix: @_selectedReport.CalibrationPayload.ActuatorAction</li>
                        </ul>
                    </div>

                    <!-- Simulation Signal Analysis Section -->
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black; border-top: none; font-size: 13px;">
                        <thead>
                            <tr style="background-color: #f1f1f1;">
                                <th style="padding: 6px; border: 1px solid black; text-align: center;">Simulation Target Input</th>
                                <th style="padding: 6px; border: 1px solid black; text-align: center;">Loops Response Output</th>
                                <th style="padding: 6px; border: 1px solid black; text-align: center;">Functional Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sim in _selectedReport.CalibrationPayload.SimulationTable)
                            {
                                <tr>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@sim.ProcessInput</td>
                                    <td style="padding: 6px; border: 1px solid black; text-align: center;">@sim.OutputPressure</td>
                                    <td style="padding: 6px; border: 1px solid black;">@sim.PSRemarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <!-- Signatures Grid Footer -->
                <table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-top: 15px; font-size: 13px;">
                    <tr><td colspan="2" style="padding: 6px; border: 1px solid black;">Observations: OK.</td></tr>
                    <tr style="background-color: #f1f1f1; font-weight: bold;">
                        <td style="width: 50%; padding: 6px; border: 1px solid black;">Calibration By:</td>
                        <td style="width: 50%; padding: 6px; border: 1px solid black;">Witnessed By / Engineer:</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px; border: 1px solid black;">Name: @_selectedReport.Detail.PerformedByName</td>
                        <td style="padding: 6px; border: 1px solid black;">Name: @_selectedReport.Detail.WitnessedByName</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px; border: 1px solid black;">Designation: @_selectedReport.Detail.PerformedByDesig</td>
                        <td style="padding: 6px; border: 1px solid black;">Designation: @_selectedReport.Detail.WitnessedByDesig</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
}



@code {
    private DateTime? _fromDate = DateTime.Today.AddMonths(-1);
    private DateTime? _toDate = DateTime.Today;
    private bool _loading = false;
    private bool _isModalOpen = false;

    private List<CalibrationUiView> _gridItems = new();
    private CalibrationUiView? _selectedReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadCalibrationData();
    }

    private async Task LoadCalibrationData()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            // TEST 1: Fetch completely UNFILTERED details to test RLS and Mapping
            var detailsResponse = await SupabaseClient
                .From<SupabasePmCalibrationDetail>()
                .Get();

            var fetchedDetails = detailsResponse.Models;

            // Check the internal console or debug window output
            System.Diagnostics.Debug.WriteLine($"[DIAGNOSTIC] Fetched {fetchedDetails.Count} calibration rows total without filters.");

            if (fetchedDetails.Count == 0)
            {
                Snackbar.Add("Diagnostic: Database returned 0 total records. This is likely an RLS or Table Name issue.", Severity.Warning);
            }

            var reportsResponse = await SupabaseClient
                .From<SupabasePmReport>()
                .Get();

            var fetchedReports = reportsResponse.Models;
            System.Diagnostics.Debug.WriteLine($"[DIAGNOSTIC] Fetched {fetchedReports.Count} parent report rows total.");

            var jsonOptions = new JsonSerializerOptions { AllowTrailingCommas = true, PropertyNameCaseInsensitive = true };

            _gridItems = fetchedDetails.Select(detail =>
            {
                var view = new CalibrationUiView
                {
                    Detail = detail,
                    LocationId = fetchedReports.FirstOrDefault(r => r.Id == detail.PmReportId)?.LocationId
                };

                if (!string.IsNullOrWhiteSpace(detail.CalibrationData))
                {
                    try
                    {
                        string cleanJson = detail.CalibrationData.Trim();
                        if (cleanJson.StartsWith("\"") && cleanJson.EndsWith("\""))
                        {
                            cleanJson = JsonSerializer.Deserialize<string>(cleanJson, jsonOptions) ?? "{}";
                        }
                        view.CalibrationPayload = JsonSerializer.Deserialize<ParsedPayload>(cleanJson, jsonOptions) ?? new ParsedPayload();
                    }
                    catch
                    {
                        view.CalibrationPayload = new ParsedPayload();
                    }
                }
                return view;
            })
            .OrderByDescending(v => v.Detail.ReportDate)
            .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fetch Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ViewCertificate(CalibrationUiView item)
    {
        _selectedReport = item;
        _isModalOpen = true;
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("window.print");











    [Table("pm_reports")]
    public class SupabasePmReport : BaseModel
    {
        [PrimaryKey("id", false)] public int Id { get; set; }
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("technician_email")] public string? TechnicianEmail { get; set; }
        [Column("completion_date")] public DateTimeOffset? CompletionDate { get; set; }
        [Column("assigned_to")] public string? AssignedTo { get; set; }
    }

    [Table("pm_calibration_details")]
    public class SupabasePmCalibrationDetail : BaseModel
    {
        [PrimaryKey("id", false)] public int Id { get; set; }
        [Column("pm_report_id")] public int? PmReportId { get; set; }
        [Column("job_id")] public Guid? JobId { get; set; }
        [Column("cert_no")] public string CertNo { get; set; } = string.Empty;
        [Column("installation")] public string? Installation { get; set; }
        [Column("instrument_type")] public string? InstrumentType { get; set; }
        [Column("unit_id")] public string? UnitId { get; set; }
        [Column("model")] public string? Model { get; set; }
        [Column("instrument_range")] public string? InstrumentRange { get; set; }
        [Column("master_calibrator")] public string? MasterCalibrator { get; set; }

        // Handled as raw string text from Supabase to process nested quotes safely
        [Column("calibration_data")] public string? CalibrationData { get; set; }

        [Column("observations")] public string? Observations { get; set; }
        [Column("performed_by_name")] public string? PerformedByName { get; set; }
        [Column("performed_by_desig")] public string? PerformedByDesig { get; set; }
        [Column("witnessed_by_name")] public string? WitnessedByName { get; set; }
        [Column("witnessed_by_desig")] public string? WitnessedByDesig { get; set; }
        [Column("report_date")] public DateTime? ReportDate { get; set; }
    }

    // View Model for UI Grid binding
    public class CalibrationUiView
    {
        public SupabasePmCalibrationDetail Detail { get; set; } = new();
        public long? LocationId { get; set; }
        public string DateFormatted => Detail.ReportDate?.ToString("dd/MM/yyyy") ?? "";
        public ParsedPayload CalibrationPayload { get; set; } = new();
    }

    // Nested JSON Data Objects
    public class ParsedPayload
    {
        [JsonPropertyName("MasterCalibrator")] public string MasterCalibrator { get; set; } = "";
        [JsonPropertyName("SetPoint")] public string? SetPoint { get; set; }
        [JsonPropertyName("ActuatorAction")] public string? ActuatorAction { get; set; }
        [JsonPropertyName("CalibrationTable")] public List<CalRow> CalibrationTable { get; set; } = new();
        [JsonPropertyName("SimulationTable")] public List<SimRow> SimulationTable { get; set; } = new();
    }

    public class CalRow
    {
        [JsonPropertyName("InputValue")] public string InputValue { get; set; } = "";
        [JsonPropertyName("InputPercentage")] public string InputPercentage { get; set; } = "";
        [JsonPropertyName("ExpectedOutput")] public string ExpectedOutput { get; set; } = "";
        [JsonPropertyName("ActualOutput")] public string ActualOutput { get; set; } = "";
        [JsonPropertyName("Error")] public string Error { get; set; } = "";
        [JsonPropertyName("CalRemarks")] public string CalRemarks { get; set; } = "";
    }

    public class SimRow
    {
        [JsonPropertyName("ProcessInput")] public string ProcessInput { get; set; } = "";
        [JsonPropertyName("OutputPressure")] public string OutputPressure { get; set; } = "";
        [JsonPropertyName("PSRemarks")] public string PSRemarks { get; set; } = "";
    }





}