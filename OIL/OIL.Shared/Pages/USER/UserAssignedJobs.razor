    private async Task HandleSubmit()
    {
        if (_selectedJob == null) return;

        _isBusy = true;
        try
        {
            // Robust check: Auto-detect if parts were actually added to the grid
            bool itemsWereReplaced = _partReplaced || (_replacements != null && _replacements.Any(x => !string.IsNullOrEmpty(x.DeviceLocation)));

            // 1. Prepare common data using the detected flag
            string replacementJson = itemsWereReplaced
                ? System.Text.Json.JsonSerializer.Serialize<List<ReplacementEntry>>(_replacements)
                : "None";

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.Identity?.Name ?? "Unknown";

            if (_selectedJob.JobType == "preventive")
            {
                // PM specific logic if needed
            }

            if (CurrentJobAssignmentId == Guid.Empty)
            {
                Snackbar.Add("Error: Cannot submit. Job Assignment ID is missing.", Severity.Error);
                return;
            }

            float? finalOvertime = null;
            if (_overtime && (_overtimeHours.HasValue || _overtimeMinutes.HasValue))
            {
                var currentAssignment = await SupabaseClient.From<JobAssignment>()
                    .Where(x => x.Id == CurrentJobAssignmentId)
                    .Single();

                float existingHours = currentAssignment?.JobOverTime ?? 0f;
                float enteredHours = _overtimeHours ?? 0;
                float enteredMinutesAsHours = (_overtimeMinutes ?? 0) / 60f;
                float newOvertimeTotal = enteredHours + enteredMinutesAsHours;

                finalOvertime = existingHours + newOvertimeTotal;
            }

            // 3. Update Job Assignment
            var updateRequest = SupabaseClient.From<JobAssignment>()
                .Where(x => x.Id == CurrentJobAssignmentId)
                .Set(x => x.JobAction, "Completed")
                .Set(x => x.status, "Completed")
                .Set(x => x.JobActionBy, userEmail)
                .Set(x => x.JobActionTime, DateTime.Now)
                .Set(x => x.JobActionRemarks, _workDone)
                .Set(x => x.SpareReplace, replacementJson);

            if (_overtime)
            {
                updateRequest = updateRequest.Set(x => x.JobOverTime, finalOvertime);
            }

            await updateRequest.Update();

            // 4. Sync PID Markers
            if (itemsWereReplaced)
            {
                foreach (var item in _replacements)
                {
                    var markerData = new PIDMarker
                    {
                        LocationId = CurrentLocationId,
                        Device_location = item.DeviceLocation,
                        TagNumber = item.TagNumber,
                        InstrumentType = item.InstrumentType,
                        MakeModelType = item.NewMakeModel,
                        Range = item.NewRange,
                        Serial_number = item.NewSerialNumber,
                        Replacement_cost = item.ApproxCost
                    };

                    if (item.IsManualDeviceLocation || item.IsManualInstrumentType || item.LocationId == null)
                    {
                        await SupabaseClient.From<PIDMarker>().Insert(markerData);
                    }
                    else
                    {
                        markerData.Id = item.LocationId.Value;
                        await SupabaseClient.From<PIDMarker>().Update(markerData);
                    }
                }
            }

            // Calculate total cost using the validated flag
            long? totalSpareCost = itemsWereReplaced ? _replacements.Sum(x => x.ApproxCost ?? 0) : null;

            // 5. Finalize Job Status
            await SupabaseClient.From<Job>()
                .Where(x => x.Id == _selectedJob.Id)
                .Set(x => x.JobSpareCost, totalSpareCost)
                .Set(x => x.JobSpareReplaced, replacementJson) // FIX: Changed from _spareDetails to replacementJson
                .Set(x => x.JobActionRemarks, _workDone)
                .Set(x => x.Status, "completed")
                .Update();

            if (_uploadedFiles.Any() && _selectedJob != null)
            {
                foreach (var file in _uploadedFiles)
                {
                    var path = $"{_selectedJob.Id}/{Guid.NewGuid()}_{file.Name}";
                    using var stream = file.OpenReadStream(10 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);

                    await SupabaseClient.Storage.From("job-photos").Upload(ms.ToArray(), path);

                    await SupabaseClient.From<JobPhotoModel>().Insert(new JobPhotoModel
                    {
                        Id = Guid.NewGuid(),
                        JobId = _selectedJob.Id,
                        StoragePath = path
                    });
                }
            }

            _uploadedFiles.Clear();
            _workDone = "";
            _partReplaced = false;
            _overtime = false;

            Snackbar.Add("Job Submitted Successfully", Severity.Success);
            _isExecuting = false;
            await LoadInitialData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

