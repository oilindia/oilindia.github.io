        }
        return "Unknown Location";
    }

    private async Task<string> GetFieldName(long? locationId)
    {
       
        if (locationId == null)
        {
            return "";
        }

        // 1. Await the Supabase task to get the response
        var response = await SupabaseClient.From<Location>().Get();

        // 2. Extract the list of Location models from the response
        var locations = response.Models;

        // 3. Find the matching location by ID
        var location = locations.FirstOrDefault(x => x.Id == locationId);

        // 4. Return the FieldType if found and not null; otherwise default
        return location?.FieldType ?? "";
    }


