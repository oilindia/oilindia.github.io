    private readonly string _manualTextPlaceholder = "MANUAL_ENTRY";

    // 1. When Device Location Changes
    private void OnEntryDeviceLocationChanged(ReplacementEntry entry, string value)
    {
        entry.DeviceLocation = value;
        entry.IsManualDeviceLocation = (value == _manualTextPlaceholder);
        if (entry.IsManualDeviceLocation) entry.ManualDeviceLocationText = "";

        // Cascade Reset downwards
        entry.InstrumentType = null;
        entry.IsManualInstrumentType = false;
        entry.ManualInstrumentTypeText = "";

        entry.TagNumber = null;
        entry.IsManualTagNumber = false;
        entry.ManualTagNumberText = "";

        ResetOldData(entry);
    }

    // 2. When Instrument Type Changes
    private void OnEntryInstrumentTypeChanged(ReplacementEntry entry, string value)
    {
        entry.InstrumentType = value;
        entry.IsManualInstrumentType = (value == _manualTextPlaceholder);
        if (entry.IsManualInstrumentType) entry.ManualInstrumentTypeText = "";

        // Cascade Reset downwards
        entry.TagNumber = null;
        entry.IsManualTagNumber = false;
        entry.ManualTagNumberText = "";

        ResetOldData(entry);
    }

    // 3. When Tag Number Changes (Triggers DB Fetch)
    private async Task OnEntryTagNumberChanged(ReplacementEntry entry, string value)
    {
        entry.TagNumber = value;
        entry.IsManualTagNumber = (value == _manualTextPlaceholder);
        if (entry.IsManualTagNumber) entry.ManualTagNumberText = "";

        // Only fetch if a valid, non-manual sequence is fully selected
        if (!entry.IsManualDeviceLocation && !entry.IsManualInstrumentType && !entry.IsManualTagNumber &&
            !string.IsNullOrEmpty(entry.DeviceLocation) && !string.IsNullOrEmpty(entry.InstrumentType) && !string.IsNullOrEmpty(entry.TagNumber))
        {
            await FetchOldDeviceData(entry);
        }
        else
        {
            ResetOldData(entry);
        }
    }

    // --- Data Fetching & Helpers ---

    private async Task FetchOldDeviceData(ReplacementEntry entry)
    {
        try
        {
            var match = await SupabaseClient.From<PIDMarker>()
                .Where(x => x.LocationId == CurrentLocationId)
                .Where(x => x.Device_location == entry.DeviceLocation)
                .Where(x => x.InstrumentType == entry.InstrumentType)
                .Where(x => x.TagNumber == entry.TagNumber) // Filtered by Tag instead of just type now
                .Single();

            if (match != null)
            {
                entry.LocationId = match.Id;
                entry.OldMakeModel = match.MakeModelType;
                entry.OldRange = match.Range;
            }
            else
            {
                ResetOldData(entry);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
            ResetOldData(entry);
        }

        StateHasChanged();
    }

    private void ResetOldData(ReplacementEntry entry)
    {
        entry.LocationId = null;
        entry.OldMakeModel = null;
        entry.OldRange = null;
    }

    // --- Dynamic Dropdown Population Methods ---
    // Assuming _currentLocationMarkers contains the downloaded markers for the current job location

    private List<PIDMarker> _currentLocationMarkers = new List<PIDMarker>();

    //private readonly string _manualTextPlaceholder = "MANUAL_ENTRY";

    private IEnumerable<string> GetAvailableLocations()
    {
        if (_currentLocationMarkers == null) return Array.Empty<string>();
        return _currentLocationMarkers
            .Select(m => m.Device_location)
            .Where(l => !string.IsNullOrEmpty(l))
            .Distinct();
    }

    private IEnumerable<string> GetAvailableTypes(ReplacementEntry entry)
    {
        if (_currentLocationMarkers == null || string.IsNullOrEmpty(entry.DeviceLocation) || entry.IsManualDeviceLocation)
            return Array.Empty<string>();

        return _currentLocationMarkers
            .Where(m => m.Device_location == entry.DeviceLocation)
            .Select(m => m.InstrumentType)
            .Where(t => !string.IsNullOrEmpty(t))
            .Distinct();
    }

    private IEnumerable<string> GetAvailableTags(ReplacementEntry entry)
    {
        if (_currentLocationMarkers == null || string.IsNullOrEmpty(entry.InstrumentType) || entry.IsManualInstrumentType)
            return Array.Empty<string>();

        return _currentLocationMarkers
            .Where(m => m.Device_location == entry.DeviceLocation && m.InstrumentType == entry.InstrumentType)
            .Select(m => m.TagNumber) // Ensure your PIDMarker model maps the tag correctly
            .Where(t => !string.IsNullOrEmpty(t))
            .Distinct();
    }


