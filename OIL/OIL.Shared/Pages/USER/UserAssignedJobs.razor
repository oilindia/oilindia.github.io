    private async Task HandleSubmit()
    {
        if (_selectedJob == null) return;

        _isBusy = true;
        try
        {
            // 1. Prepare common data
            //var replacementJson = _partReplaced ? JsonSerializer.Serialize(_replacements) : "None";

            // Use the explicit String-returning overload
            string replacementJson = _partReplaced
                ? System.Text.Json.JsonSerializer.Serialize<List<ReplacementEntry>>(_replacements)
                : "None";

            // Do the same for the checklist
            //string checklistJson = System.Text.Json.JsonSerializer.Serialize(_filteredChecklist);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.Identity?.Name ?? "Unknown";

            // 2. Handle Preventive Maintenance (PM) specific data
            if (_selectedJob.JobType == "preventive")
            {
                // var checklistJson = JsonSerializer.Serialize(_filteredChecklist);
                // await SupabaseClient.From<PmReport>().Insert(new PmReport
                // {
                //     JobId = _selectedJob.Id,
                //     ChecklistJson = checklistJson
                // });
            }

            // 1. FETCH EXISTING OVERTIME (To add current to existing)
            // 1. FETCH EXISTING OVERTIME & CALCULATE NEW OVERTIME
            float? finalOvertime = null;

            if (_overtime && (_overtimeHours.HasValue || _overtimeMinutes.HasValue))
            {
                var currentAssignment = await SupabaseClient.From<JobAssignment>()
                    .Where(x => x.Id == CurrentJobAssignmentId)
                    .Single();

                // Safely grab existing hours (now correctly typed as float)
                float existingHours = currentAssignment?.JobOverTime ?? 0f;

                // Convert UI hours and minutes into a single float value
                float enteredHours = _overtimeHours ?? 0;
                float enteredMinutesAsHours = (_overtimeMinutes ?? 0) / 60f;
                float newOvertimeTotal = enteredHours + enteredMinutesAsHours;

                finalOvertime = existingHours + newOvertimeTotal;
            }




            // 3. Update Job Assignment (Audit & Spare details)
            // We use the Assignment ID directly (as in your 2nd method) for precision
            var updateRequest =  SupabaseClient.From<JobAssignment>()
                .Where(x => x.Id == CurrentJobAssignmentId)
                .Set(x => x.status, "Completed")
                .Set(x => x.JobActionBy, userEmail)
                .Set(x => x.JobActionTime, DateTime.Now)
                .Set(x => x.JobActionRemarks, _workDone)
                .Set(x => x.SpareReplace, replacementJson);
            //.Update();

            // Only include Overtime in the update if the switch is ON
            if (_overtime)
            {
                // This will now pass a clean float? matching your column schema perfectly
                updateRequest = updateRequest.Set(x => x.JobOverTime, finalOvertime);
            }

            await updateRequest.Update();

            // 4. Sync PID Markers (Updating the Asset Database)
            if (_partReplaced)
            {
                foreach (var item in _replacements)
                {
                    var markerData = new PIDMarker
                    {
                        LocationId = CurrentLocationId,
                        Device_location = item.DeviceLocation,
                        TagNumber = item.TagNumber, // Added Tag Number from cascading logic
                        InstrumentType = item.InstrumentType,
                        MakeModelType = item.NewMakeModel,
                        Range = item.NewRange,
                        Serial_number = item.NewSerialNumber,
                        Replacement_cost = item.ApproxCost
                    };

                    // Logic: Insert new if manual/not found, otherwise update existing record
                    if (item.IsManualLocation  || item.IsManualType || item.LocationId == null)
                    {
                        await SupabaseClient.From<PIDMarker>().Insert(markerData);
                    }
                    else
                    {
                        markerData.Id = item.LocationId.Value;
                        await SupabaseClient.From<PIDMarker>().Update(markerData);
                    }
                }
            }

            // 5. Finalize Job Status
            await SupabaseClient.From<Job>()
                .Where(x => x.Id == _selectedJob.Id)
                .Set(x => x.Status, "completed")
                .Update();

            Snackbar.Add("Job Completed and Asset Database Synced!", Severity.Success);
            await LoadInitialData(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submission failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }





