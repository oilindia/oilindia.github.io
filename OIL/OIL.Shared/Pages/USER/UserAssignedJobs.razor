    private async Task LoadExistingPhotos(Guid jobId)
    {
        _existingPhotos.Clear();
        try
        {
            // Query the job_photos table for this specific job
            var photoRecords = await SupabaseClient.From<JobPhotoModel>()
                .Where(x => x.JobId == jobId)
                .Get();

            foreach (var record in photoRecords.Models)
            {
                if (!string.IsNullOrWhiteSpace(record.StoragePath))
                {
                    // Generate the public URL from the bucket
                    // Note: If your bucket is private, you will need to use CreateSignedUrl instead
                    var url = SupabaseClient.Storage.From("job-photos").GetPublicUrl(record.StoragePath);
                    _existingPhotos.Add(url);
                }
            }

            // Force Blazor to re-render the DOM with the populated list
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading existing photos: {ex.Message}", Severity.Error);
        }
    }

    private async Task StartJobExecution(Job job)
    {
        if (job.JobType?.ToLower() == "preventive")
        {
            // Navigate to the specific PM execution page, passing the Job ID
            Navigation.NavigateTo($"/pmexecution");
            return;
        }

        // Default logic for other job types (e.g., Breakdown)
        _selectedJob = job;
        CurrentLocationId = _selectedJob.LocationId ?? 0;

        // --- ADD THIS LINE TO LOAD PHOTOS ---
        await LoadExistingPhotos(job.Id);


        // --- FIX START: Fetch the matching Job Assignment ID ---
        try
        {
            var assignmentResponse = await SupabaseClient.From<JobAssignment>()
                .Filter("job_ids", Supabase.Postgrest.Constants.Operator.Contains, new[] { job.Id })
                .Get();

            var matchingAssignment = assignmentResponse.Models.FirstOrDefault();

            if (matchingAssignment != null)
            {
                CurrentJobAssignmentId = matchingAssignment.Id;
            }
            else
            {
                // Handle edge case where a job exists but isn't assigned properly
                Snackbar.Add("Warning: No active assignment found for this job.", Severity.Warning);
                CurrentJobAssignmentId = Guid.Empty;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error looking up assignment: {ex.Message}", Severity.Error);
        }
        // --- FIX END ---

        await LoadInitialDataPID();
        AddNewRow(); // Start with one empty row

        // Set the current location for PID data loading
        _isExecuting = true;
    }


