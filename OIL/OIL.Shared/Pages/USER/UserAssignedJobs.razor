@page "/userassignedjobs"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Runtime.Serialization
@using Microsoft.AspNetCore.Components.Forms
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Newtonsoft.Json
@using OIL.Shared.Services
@inject CustomAuthStateProvider AuthStateProvider
@using System.Security.Claims



<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    @if (!_isExecuting)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5" Class="fw-bold">My Pending Assignments</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" OnClick="LoadInitialData">Refresh</MudButton>
        </MudStack>

        <MudTable Items="@_pendingJobs" Hover="true" Elevation="4" Class="rounded-lg" Loading="@_loading">
            <HeaderContent>
                <MudTh>Job Name</MudTh>

                <MudTh>Type</MudTh>

                <MudTh>Description</MudTh>

                <MudTh>Location</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.JobName</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(context.JobType == "preventive" ? Color.Info : Color.Warning)" Size="Size.Small">
                        @context.JobType.ToUpper()
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Description" Style="white-space: pre-wrap; word-break: break-word; min-width: 350px;">
                    <div class="mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-bold">USER REPORTED DESCRIPTION:</MudText>
                        <MudText Typo="Typo.body2">@context.Description</MudText>
                    </div>

                    @if (!string.IsNullOrEmpty(context.JobActionRemarks))
                    {
                        <MudDivider Class="mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold">ENGINEER OBSERVATIONS:</MudText>
                        <div style="font-size: 0.85rem; color: #555;">
                            @((MarkupString)context.JobActionRemarks.Replace("\n", "<br />"))
                        </div>
                    }
                </MudTd>
                <MudTd>@context.LocationId</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => StartJobExecution(context))">Execute</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="4">
            <div class="d-flex align-center mb-4">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="CancelExecution" />
                <MudText Typo="Typo.h6" Class="ml-2">Executing: @_selectedJob?.JobName</MudText>
            </div>

            @if (_selectedJob?.JobType == "preventive")
            {
                @* --- PREVENTIVE UI --- *@
                <MudAlert Severity="Severity.Info" Class="mb-4">Checklist: <b>@_detectedType</b></MudAlert>
                @foreach (var item in _filteredChecklist)
                {
                    <MudPaper Outlined="true" Class="pa-3 my-2">
                        <MudGrid AlignItems="Center">
                            <MudItem xs="1"><MudCheckBox T="bool" @bind-Value="item.IsCompleted" Color="Color.Primary" /></MudItem>
                            <MudItem xs="5"><MudText>@item.TaskDescription</MudText></MudItem>
                            <MudItem xs="6"><MudTextField T="string" @bind-Value="item.ItemObservation" Label="Remarks" Variant="Variant.Text" /></MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            }
            else
            {
                @* --- BREAKDOWN UI --- *@
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Details of Work Done" Variant="Variant.Outlined" Lines="3" @bind-Value="_workDone" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileUpload" Accept="image/*" capture="camera" id="photo-up">
                            <ButtonTemplate>
                                <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.PhotoCamera" for="photo-up">Capture Photo</MudButton>
                            </ButtonTemplate>
                        </MudFileUpload>
                        @foreach (var file in _uploadedFiles) { <MudChip T="string" Color="Color.Success" OnClose="@(() => _uploadedFiles.Remove(file))">@file.Name</MudChip> }
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSwitch T="bool" Value="@_partReplaced" ValueChanged="@((v) => { _partReplaced = v; StateHasChanged(); })" Color="Color.Secondary" Label="Was any part replaced?" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSwitch T="bool" Value="@_overtime" ValueChanged="@((v) => { _overtime = v; StateHasChanged(); })" Color="Color.Secondary" Label="Was any overtime worked?" />
                    </MudItem>
                    
                    @if (_overtime)
{
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudNumericField @bind-Value="_overtimeHours" 
                             Label="Overtime Hours"
                             Variant="Variant.Outlined" 
                             Min="0" 
                             Step="1"
                             HideSpinButtons="false"
                             Adornment="Adornment.End"
                             AdornmentIcon="@Icons.Material.Filled.AccessTime" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField @bind-Value="_overtimeMinutes" 
                             Label="Overtime Minutes"
                             Variant="Variant.Outlined" 
                             Min="0" 
                             Max="59" 
                             Step="1"
                             HideSpinButtons="false"
                             Adornment="Adornment.End"
                             AdornmentIcon="@Icons.Material.Filled.Build" />
        </MudItem>
    </MudGrid>
}



                    @if (_partReplaced)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Class="mt-4">Replacement Details</MudText>
                            @foreach (var entry in _replacements)
                            {
                                <MudPaper Class="pa-4 mb-4" Outlined="true">
                                    <MudGrid Spacing="2">
                                        @* Location Selection *@
                                        <MudItem xs="12" sm="3">
                                            @if (!entry.IsManualLocation)
                                            {
                                                <MudSelect T="string" Label="Device Location"
                                                           Value="@entry.DeviceLocation"
                                                           ValueChanged="@((v) => OnLocationOrTypeChanged(entry, v, "location"))">

                                                    @foreach (var loc in _availableLocations)
                                                    {
                                                        <MudSelectItem Value="@loc">@loc</MudSelectItem>
                                                    }
                                                </MudSelect>

                                                <MudButton OnClick="@(() => entry.IsManualLocation = true)"
                                                           Size="Size.Small"
                                                           Color="Color.Primary">
                                                    + Add New Location
                                                </MudButton>
                                            }
                                            else
                                            {
                                                <MudTextField Label="New Location Name" @bind-Value="entry.DeviceLocation"
                                                              AdornmentIcon="@Icons.Material.Filled.Edit"
                                                              OnAdornmentClick="@(() => entry.IsManualLocation = false)" />
                                            }
                                        </MudItem>

                                        @* Tag Selection *@
                                        <MudItem xs="12" sm="3">
                                            @if (!entry.IsManualLocation)
                                            {
                                                <MudSelect T="string" Label="Tag Selection"
                                                           Value="entry.TagNumber"
                                                           ValueChanged="@((v) => OnLocationOrTypeChanged(entry, v, "tag"))"
                                                           AnchorOrigin="Origin.BottomCenter"
                                                           AdornmentIcon="@Icons.Material.Filled.Search">
                                                    @foreach (var tag in _availableTags)
                                                    {
                                                        <MudSelectItem Value="@tag">@tag</MudSelectItem>
                                                    }
                                                    <MudButton OnClick="@(() => entry.IsManualLocation = true)" FullWidth="true" Color="Color.Primary">+ Add New Location</MudButton>
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <MudTextField Label="New Location Name" @bind-Value="entry.TagNumber"
                                                              AdornmentIcon="@Icons.Material.Filled.Edit"
                                                              OnAdornmentClick="@(() => entry.IsManualLocation = false)" />
                                            }
                                        </MudItem>


                                        @* Instrument Type Selection *@
                                        <MudItem xs="12" sm="3">
                                            @if (!entry.IsManualType)
                                            {
                                                <MudSelect T="string" Label="Instrument Type"
                                                           Value="entry.InstrumentType"
                                                           ValueChanged="@((v) => OnLocationOrTypeChanged(entry, v, "type"))">
                                                    @foreach (var type in _availableTypes)
                                                    {
                                                        <MudSelectItem Value="@type">@type</MudSelectItem>
                                                    }
                                                    <MudButton OnClick="@(() => entry.IsManualType = true)" FullWidth="true" Color="Color.Primary">+ Add New Type</MudButton>
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <MudTextField Label="New Instrument Type" @bind-Value="entry.InstrumentType" />
                                            }
                                        </MudItem>

                                        @* Old Data Display *@
                                        <MudItem xs="12" sm="3">
                                            <MudField Label="Old Data (Fetched)" Variant="Variant.Text" InnerPadding="false">
                                                @(string.IsNullOrEmpty(entry.OldMakeModel) ? "No existing record" : $"{entry.OldMakeModel}  {entry.OldRange}")
                                            </MudField>
                                        </MudItem>

                                        @* New Data Inputs *@
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Make/Model" @bind-Value="entry.NewMakeModel" Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Tag No" @bind-Value="entry.TagNumber" Variant="Variant.Outlined" />
                                        </MudItem>


                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Range" @bind-Value="entry.NewRange" Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Serial #" @bind-Value="entry.NewSerialNumber" Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudNumericField Label="Approx Cost" @bind-Value="entry.ApproxCost" Variant="Variant.Outlined" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddNewRow" Variant="Variant.Filled">Add Another Part</MudButton>
                        </MudItem>
                    }
                

                   

</MudGrid>
            }

            <MudDivider Class="my-6" />
            <div class="d-flex gap-4">

                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ProcessJobSubmission" StartIcon="@Icons.Material.Filled.MarkChatRead">Further Review</MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleSubmit" StartIcon="@Icons.Material.Filled.CheckCircle">Finalize & Submit</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelExecution">Cancel</MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>

    @code {
    [Table("jobs")]
    public class Job : BaseModel {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("job_name")] public string JobName { get; set; } = "";
        [Column("job_type")] public string JobType { get; set; } = "";
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("status")] public string Status { get; set; } = "pending";

        // Matches your 'description' column in SQL
        [Column("description")] public string Description { get; set; } = "";

        // We will use this to store/display the cumulative trail of remarks
        // Note: If you don't have this column in public.jobs, you should add it
        // or rely solely on job_assignments.job_action_remarks.
        [Column("job_action_remarks")] public string? JobActionRemarks { get; set; }
    }

    [Table("job_assignments")]
    public class JobAssignment : BaseModel {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("job_ids")] public List<Guid>? JobIds { get; set; }
        [Column("job_action")] public string? JobAction { get; set; }
        [Column("job_action_time")] public DateTime? JobActionTime { get; set; }
        [Column("job_action_by")] public string? JobActionBy { get; set; }
        [Column("job_action_remarks")] public string? JobActionRemarks { get; set; }
        [Column("spare_replace")] public string? SpareReplace { get; set; }
        [Column("status")] public string? status { get; set; }
        [Column("job_overtime")] public float? JobOverTime { get; set; }

    }

    [Table("pm_reports")]
    public class PmReport : BaseModel {
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("checklist_data")] public string ChecklistJson { get; set; } = "";
        [Column("observations")] public string Observations { get; set; } = "";
    }

    [Table("pm_master_checklist")]
    public class ChecklistItem : BaseModel {
        [Column("task_description")] public string TaskDescription { get; set; } = "";
        [Column("installation_type")] public string InstallationType { get; set; } = "";
        [IgnoreDataMember] public bool IsCompleted { get; set; }
        [IgnoreDataMember] public string ItemObservation { get; set; } = "";
    }

    [Table("locations")]
    public class Location : BaseModel {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("installation_type")] public string? InstallationType { get; set; }
    }

    private List<Job> _pendingJobs = new();
    private List<ChecklistItem> _allMasterTasks = new();
    private List<ChecklistItem> _filteredChecklist = new();
    private Job? _selectedJob;
    private bool _loading = true;
    private bool _isExecuting = false;
    private string _detectedType = "";
    private string _workDone = "";
    private bool _partReplaced = false;
    private bool _overtime = false;


    private int? _overtimeHours;
    private int? _overtimeMinutes;


    //private bool _isOvertime;
    private float? _currentOvertime;

    private string _spareDetails = "";
    private List<IBrowserFile> _uploadedFiles = new();

    protected override async Task OnInitializedAsync() => await LoadInitialData();

    private async Task LoadInitialData() {
        try {
            _loading = true;
            var res = await SupabaseClient.From<Job>().Where(x => x.Status == "pending").Get();
            _pendingJobs = res.Models;
            var master = await SupabaseClient.From<ChecklistItem>().Get();
            _allMasterTasks = master.Models;





        } finally { _loading = false; }





    }

    private async Task StartJobExecution(Job job) {
        // _selectedJob = job;
        // _isExecuting = true;
        // if (job.JobType == "preventive" && job.LocationId.HasValue) {
        //     var loc = await SupabaseClient.From<Location>().Where(x => x.Id == job.LocationId.Value).Get();
        //     _detectedType = loc.Models.FirstOrDefault()?.InstallationType?.ToUpper() == "GCS" ? "GCS" : "OCS";
        //     _filteredChecklist = _allMasterTasks.Where(x => x.InstallationType.ToUpper() == _detectedType)
        //         .Select(x => new ChecklistItem { TaskDescription = x.TaskDescription }).ToList();
        // }

        if (job.JobType?.ToLower() == "preventive")
        {
            // Navigate to the specific PM execution page, passing the Job ID
            Navigation.NavigateTo($"/pmexecution");
            return;
        }



        // Default logic for other job types (e.g., Breakdown)
        _selectedJob = job;
        CurrentLocationId = _selectedJob.LocationId ?? 0; 

        await LoadInitialDataPID();
        AddNewRow(); // Start with one empty row

        // Set the current location for PID data loading
        _isExecuting = true;



    }

    private void HandleFileUpload(IBrowserFile file) { if (file != null) _uploadedFiles.Add(file); }
    private void CancelExecution() => _isExecuting = false;

    private string? userEmail;
    private string? userRole;

    private async Task ProcessJobSubmission()
    {
        try
        {

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // 2. Check if the user is logged in
            if (user.Identity is { IsAuthenticated: true })
            {
                // 3. Extract the claims you set in CustomAuthStateProvider
                // ClaimTypes.Name was used for Email in your service
                userEmail = user.Identity.Name;

                // Extract the Role
                userRole = user.FindFirst(ClaimTypes.Role)?.Value;
            }
            else
            {
                // Handle anonymous state
                userEmail = "Anonymous";
                userRole = "None";
            }


            // You can get the engineer name from your auth context or a service
            string engineerName = userEmail;


            string timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm");

            // Construct the remark string as requested:
            // engineer name - information - then information added at : datetime
            string newObservation = $"{engineerName} - {_workDone} - added at : {timestamp}";

            // Append to existing remarks with a line break for the grid display
            string updatedRemarks = string.IsNullOrEmpty(_selectedJob?.JobActionRemarks)
                ? newObservation
                : $"{_selectedJob.JobActionRemarks}\n{newObservation}";

            // 1. Update the Job Assignment table (finding the record containing this job ID)
            await SupabaseClient.From<JobAssignment>()
                .Filter("job_ids", Supabase.Postgrest.Constants.Operator.Contains, new[] { _selectedJob.Id })
                .Set(x => x.JobAction, "pending")
                .Set(x => x.JobActionBy, engineerName)
                .Set(x => x.JobActionTime, DateTime.Now)
                .Set(x => x.JobActionRemarks, updatedRemarks)
                .Update();

            // 2. Update the main Jobs table
            // We update the status (remains 'pending' if yellow button is clicked)
            // and save the remarks so they show up in the grid immediately.
            await SupabaseClient.From<Job>()
                .Where(x => x.Id == _selectedJob.Id)
                .Set(x => x.Status, "pending")
                .Set(x => x.JobActionRemarks, updatedRemarks)
                .Update();

            Snackbar.Add("Job updated for further review", Severity.Success);
            _isExecuting = false;
            await LoadInitialData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }



    private async Task SubmitJob() {
        try {
            if (_selectedJob!.JobType == "preventive") {
                // --- SUBMIT PM REPORT ---
                var json = System.Text.Json.JsonSerializer.Serialize(_filteredChecklist);
                await SupabaseClient.From<PmReport>().Insert(new PmReport { 
                    JobId = _selectedJob.Id, ChecklistJson = json 
                });
            } else {
                // --- UPDATE JOB ASSIGNMENTS TABLE ---
                // Find the assignment record that contains this specific Job ID in its array
                await SupabaseClient.From<JobAssignment>()
                    .Filter("job_ids", Supabase.Postgrest.Constants.Operator.Contains, new[] { _selectedJob.Id })
                    .Set(x => x.JobAction, "Completed")
                    .Set(x => x.JobActionBy, userEmail) // Use the authenticated user's email
                    .Set(x => x.JobActionTime, DateTime.Now)
                    .Set(x => x.JobActionRemarks, _workDone)
                    .Set(x => x.SpareReplace, _partReplaced ? _spareDetails : "None")
                    .Update();
            }

            // Mark job as completed
            await SupabaseClient.From<Job>().Where(x => x.Id == _selectedJob.Id).Set(x => x.Status, "completed").Update();

            Snackbar.Add("Job Submitted Successfully", Severity.Success);
            _isExecuting = false;
            await LoadInitialData();
        } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }














    [Table("pid_markers")]
    public class PIDMarker : BaseModel
    {
        [PrimaryKey("id", false)]
        public long? Id { get; set; }
        [Column("location_id")] public long LocationId { get; set; }
        [Column("tag_number")] public string TagNumber { get; set; }
        [Column("instrument_type")] public string InstrumentType { get; set; }
        [Column("make_model_type")] public string MakeModelType { get; set; }
        [Column("range")] public string Range { get; set; }
        [Column("coord_x")] public double? CoordX { get; set; }
        [Column("coord_y")] public double? CoordY { get; set; }
        [Column("device_location")] public string? Device_location { get; set; }
        [Column("serial_number")] public string? Serial_number { get; set; }
        [Column("replacement_cost")] public long? Replacement_cost { get; set; }
    }

    public class ReplacementEntry
    {
        // Selection IDs
        public long? LocationId { get; set; }
        public string DeviceLocation { get; set; }
        public string InstrumentType { get; set; }
        public string TagNumber { get; set; }


        // Old Data (Fetched)
        public string OldMakeModel { get; set; }
        public string OldRange { get; set; }

        // Lists for cascading dropdowns
        public List<string> FilteredTags { get; set; } = new();
        public List<string> FilteredTypes { get; set; } = new();


        // New Data (User Input)
        public string NewMakeModel { get; set; }
        public string NewRange { get; set; }
        public string NewSerialNumber { get; set; }
        public long? ApproxCost { get; set; }

        // UI State: Toggle between dropdown and text input
        // Renamed to match the logic exactly
        public bool IsManualLocation { get; set; }
        public bool IsManualType { get; set; }
    }

    [Parameter] public long CurrentLocationId { get; set; } // Installation ID
    [Parameter] public Guid CurrentJobAssignmentId { get; set; }

    private List<ReplacementEntry> _replacements = new();
    private List<string> _availableLocations = new();
    private List<string> _availableTypes = new();
    private List<string> _availableTags = new();


    private bool _isBusy = false;

    // protected override async Task OnInitializedAsync()
    // {
    //     await LoadInitialDataPID();
    //     AddNewRow(); // Start with one empty row
    // }

    private async Task LoadInitialDataPID()
    {
        // Fetch existing locations for this specific Installation from pid_markers
        var markers = await SupabaseClient.From<PIDMarker>()
            .Where(x => x.LocationId == CurrentLocationId)
            .Get();

        _availableLocations = markers.Models
            .Select(x => x.Device_location)
            .Distinct()
            .ToList();

        _availableTypes = markers.Models
                    .Select(x => x.InstrumentType)
                    .Distinct()
                    .ToList();
        _availableTags = markers.Models
                           .Select(x => x.Device_location)
                           .Distinct()
                           .ToList();


    }

    private void AddNewRow()
    {
        _replacements.Add(new ReplacementEntry { LocationId = CurrentLocationId });
    }

    private async Task OnFieldChanged(ReplacementEntry entry, string newVal, string field)
    {
        if (field == "location")
        {
            entry.DeviceLocation = newVal;
            entry.TagNumber = null; // Reset children
            entry.InstrumentType = null;

            // Filter Tags based on Location
            var results = await SupabaseClient.From<PIDMarker>()
                .Where(x => x.LocationId == CurrentLocationId)
                .Where(x => x.Device_location == newVal)
                .Get();

            entry.FilteredTags = results.Models.Select(x => x.TagNumber).Distinct().ToList();
        }

        if (field == "tag")
        {
            entry.TagNumber = newVal;
            entry.InstrumentType = null; // Reset child

            // Filter Types based on Tag
            var results = await SupabaseClient.From<PIDMarker>()
                .Where(x => x.LocationId == CurrentLocationId)
                .Where(x => x.Device_location == entry.DeviceLocation)
                .Where(x => x.TagNumber == newVal)
                .Get();

            entry.FilteredTypes = results.Models.Select(x => x.InstrumentType).Distinct().ToList();
        }

        if (field == "type")
        {
            entry.InstrumentType = newVal;

            // Final Fetch: Get specific part details
            var match = await SupabaseClient.From<PIDMarker>()
                .Where(x => x.LocationId == CurrentLocationId)
                .Where(x => x.Device_location == entry.DeviceLocation)
                .Where(x => x.TagNumber == entry.TagNumber)
                .Where(x => x.InstrumentType == newVal)
                .Single();

            if (match != null)
            {
                entry.LocationId = match.Id;
                entry.OldMakeModel = match.MakeModelType;
                entry.OldRange = match.Range;
            }
        }

        StateHasChanged();
    }


    private async Task OnLocationOrTypeChanged(ReplacementEntry entry, string newVal, string field)
    {
        if (field == "location") entry.DeviceLocation = newVal;
        if (field == "type") entry.InstrumentType = newVal;

        // Fetch old data if both are selected
        if (!entry.IsManualLocation && !entry.IsManualType &&
            !string.IsNullOrEmpty(entry.DeviceLocation) && !string.IsNullOrEmpty(entry.InstrumentType))
        {
            try
            {
                // Use MaybeSingle to avoid exceptions if no match is found
                var match = await SupabaseClient.From<PIDMarker>()
                    .Where(x => x.LocationId == CurrentLocationId)
                    .Where(x => x.Device_location == entry.DeviceLocation)
                    .Where(x => x.InstrumentType == entry.InstrumentType)
                    .Single();

                if (match != null)
                {
                    entry.LocationId = match.Id;
                    entry.OldMakeModel = match.MakeModelType;
                    entry.OldRange = match.Range;


                    Console.WriteLine($"Error fetching data: {entry.OldMakeModel}");
                }
                else
                {
                    // Reset if no match found
                    entry.OldMakeModel = null;
                    entry.OldRange = null;


                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching data: {ex.Message}");

                Console.WriteLine($"Error fetching data: {entry.OldMakeModel}");
                Console.WriteLine($"Error fetching data: {ex.Message}");
            }

            // CRITICAL: Manually trigger a UI refresh after async work
            StateHasChanged();
        }
    }



