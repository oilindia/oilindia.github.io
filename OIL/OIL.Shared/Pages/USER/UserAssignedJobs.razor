    private async Task ProcessJobSubmission()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity is { IsAuthenticated: true })
            {
                userEmail = user.Identity.Name;
                userRole = user.FindFirst(ClaimTypes.Role)?.Value;
            }
            else
            {
                userEmail = "Anonymous";
                userRole = "None";
            }

            float? finalOvertime = null;
            if (_overtime && (_overtimeHours.HasValue || _overtimeMinutes.HasValue))
            {
                var currentAssignment = await SupabaseClient.From<JobAssignment>()
                    .Where(x => x.Id == CurrentJobAssignmentId)
                    .Single();

                float existingHours = currentAssignment?.JobOverTime ?? 0f;
                float enteredHours = _overtimeHours ?? 0;
                float enteredMinutesAsHours = (_overtimeMinutes ?? 0) / 60f;
                float newOvertimeTotal = enteredHours + enteredMinutesAsHours;

                finalOvertime = existingHours + newOvertimeTotal;
            }

            string engineerName = _fullName;
            string timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
            string newObservation = $"{engineerName} - {_workDone} - added at : {timestamp}";

            string updatedRemarks = string.IsNullOrEmpty(_selectedJob?.JobActionRemarks)
                ? newObservation
                : $"{_selectedJob.JobActionRemarks}\n{newObservation}";

            // Robust check for replacements
            bool itemsWereReplaced = _partReplaced || (_replacements != null && _replacements.Any(x => !string.IsNullOrEmpty(x.DeviceLocation)));

            // Generate JSON data package from grid
            string replacementJson = itemsWereReplaced
                ? System.Text.Json.JsonSerializer.Serialize<List<ReplacementEntry>>(_replacements)
                : "None";

            long? totalSpareCost = itemsWereReplaced ? _replacements.Sum(x => x.ApproxCost ?? 0) : null;

            // 1. Update the Job Assignment table
            await SupabaseClient.From<JobAssignment>()
                .Filter("job_ids", Supabase.Postgrest.Constants.Operator.Contains, new[] { _selectedJob.Id })
                .Set(x => x.JobAction, "pending")
                .Set(x => x.JobActionBy, engineerName)
                .Set(x => x.JobActionTime, DateTime.Now)
                .Set(x => x.JobActionRemarks, updatedRemarks)
                .Set(x => x.SpareReplace, replacementJson) // FIX: Changed from _spareDetails to replacementJson
                .Set(x => x.JobOverTime, finalOvertime)
                .Update();

            // 2. Update the main Jobs table
            await SupabaseClient.From<Job>()
                .Where(x => x.Id == _selectedJob.Id)
                .Set(x => x.Status, "pending")
                .Set(x => x.JobSpareReplaced, replacementJson) // FIX: Changed from _spareDetails to replacementJson
                .Set(x => x.JobSpareCost, totalSpareCost)
                .Set(x => x.JobActionRemarks, updatedRemarks)
                .Update();

            if (_uploadedFiles.Any() && _selectedJob != null)
            {
                foreach (var file in _uploadedFiles)
                {
                    var path = $"{_selectedJob.Id}/{Guid.NewGuid()}_{file.Name}";
                    using var stream = file.OpenReadStream(10 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);

                    await SupabaseClient.Storage.From("job-photos").Upload(ms.ToArray(), path);

                    await SupabaseClient.From<JobPhotoModel>().Insert(new JobPhotoModel
                    {
                        Id = Guid.NewGuid(),
                        JobId = _selectedJob.Id,
                        StoragePath = path
                    });
                }
            }

            _uploadedFiles.Clear();
            _workDone = "";
            _partReplaced = false;
            _overtime = false;

            Snackbar.Add("Job updated for further review", Severity.Success);
            _isExecuting = false;
            await LoadInitialData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }













    [Table("pid_markers")]
    public class PIDMarker : BaseModel
    {
        [PrimaryKey("id", false)]
        public long? Id { get; set; }
        [Column("location_id")] public long LocationId { get; set; }
        [Column("tag_number")] public string TagNumber { get; set; }
        [Column("instrument_type")] public string InstrumentType { get; set; }
        [Column("make_model_type")] public string MakeModelType { get; set; }
        [Column("range")] public string Range { get; set; }
        [Column("coord_x")] public double? CoordX { get; set; }
        [Column("coord_y")] public double? CoordY { get; set; }
        [Column("device_location")] public string? Device_location { get; set; }
        [Column("serial_number")] public string? Serial_number { get; set; }
        [Column("replacement_cost")] public long? Replacement_cost { get; set; }
    }

    public class ReplacementEntry
    {
        // Selection IDs
        public long? LocationId { get; set; }
        public string? DeviceLocation { get; set; }
        public string? InstrumentType { get; set; }
        public string? TagNumber { get; set; }

        // Old Data (Fetched)
        public string? OldMakeModel { get; set; }
        public string? OldRange { get; set; }

        // Lists for cascading dropdowns
        public List<string> FilteredTags { get; set; } = new();
        public List<string> FilteredTypes { get; set; } = new();

        // New Data (User Input)
        public string? NewMakeModel { get; set; }
        public string? NewRange { get; set; }
        public string? NewSerialNumber { get; set; }
        public long? ApproxCost { get; set; }

        // --- CASCADING UI STATE PROPERTIES ---

        // 1. Device Location Manual State
        public bool IsManualDeviceLocation { get; set; }
        public string? ManualDeviceLocationText { get; set; }

        // 2. Instrument Type Manual State
        public bool IsManualInstrumentType { get; set; }
        public string? ManualInstrumentTypeText { get; set; }

        // 3. Tag Number Manual State
        public bool IsManualTagNumber { get; set; }
        public string? ManualTagNumberText { get; set; }
    }

