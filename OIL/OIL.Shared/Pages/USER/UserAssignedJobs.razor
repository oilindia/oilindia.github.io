@page "/userassignedjobs"
@using MudBlazor
@using Supabase
@using Supabase.Postgrest.Attributes
@using Supabase.Postgrest.Models
@using System.Runtime.Serialization
@using Microsoft.AspNetCore.Components.Forms
@inject Supabase.Client SupabaseClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Newtonsoft.Json
@using OIL.Shared.Services
@inject CustomAuthStateProvider AuthStateProvider
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@using OIL.Shared.Services


<style>
    .responsive-job-page {
        overflow-x: hidden;
    }

    /* Force responsive design for tables */
    .mud-table-container {
        overflow-x: auto;
    }

    /* Improve description readability */
    .description-text {
        word-break: break-word;
        white-space: pre-wrap;
    }

    /* Ensure action button is always visible in card mode */
    .job-action-cell .mud-button-root {
        width: 100%;
        min-height: 40px;
    }

    /* Target MudTable's mobile card layout */
    @@media (max-width: 599px) {
        .mud-table-cell {
            display: flex !important;
            justify-content: space-between;
            align-items: center;
        }
        /* Make Description occupy full width in cards */
        .job-description-cell {
            display: block !important;
            width: 100%;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 responsive-job-page">
    @if (!_isExecuting)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5" Class="fw-bold">My Pending Assignments</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" OnClick="LoadInitialData">Refresh</MudButton>
        </MudStack>

        <MudTable Items="@_pendingJobs"
                  Hover="true"
                  Elevation="4"
                  Class="rounded-lg responsive-job-table"
                  Loading="@_loading"
                  Breakpoint="Breakpoint.Sm"
                  FixedHeader="true"
                  Virtualize="false">

            <HeaderContent>
                <MudTh Class="job-col-name">Date</MudTh>
                <MudTh Class="job-col-location">Location</MudTh>
                <MudTh Class="job-col-location">FieldType</MudTh>
                <MudTh Class="job-col-name">Job Name</MudTh>
                <MudTh Class="job-col-type">Type</MudTh>
                <MudTh Class="job-col-type">Person</MudTh>
                <MudTh Class="job-col-type">Driver/Vehicle</MudTh>

                <MudTh Class="job-col-description">Description</MudTh>
                
                <MudTh Class="job-col-action">Action</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Date" Class="job-name-cell">
                    @context.CreatedAt.ToString("dd-MM-yyyy")
                </MudTd>

                <MudTd DataLabel="Location" Class="job-location-cell">
                    @GetLocationName(context.LocationId)
                </MudTd>

                <MudTd DataLabel="Location" Class="job-location-cell">
                    @GetFieldName(context.LocationId)
                </MudTd>


                <MudTd DataLabel="Job Name" Class="job-name-cell">
                    @context.JobName
                </MudTd>

                <MudTd DataLabel="Type" Class="job-type-cell">
                    <MudChip T="string"
                             Color="@(context.JobType == "preventive" ? Color.Info : Color.Warning)"
                             Size="Size.Small">
                        @context.JobType.ToUpper()
                    </MudChip>
                </MudTd>

                <!-- NEW PERSON CELL MAPPING -->
                <MudTd DataLabel="Person" Class="job-person-cell">
                    @GetPersonnelNames(context.Id)
                </MudTd>
                <!-- END NEW PERSON CELL -->
                <!-- DISPLAYS COMBINED DRIVER NAME & VEHICLE NUMBER -->
                <MudTd DataLabel="Driver/Vehicle" Class="job-driver-cell">
                    @GetDriverAndVehicleInfo(context.Id)
                </MudTd>

                <MudTd DataLabel="Description" Class="job-description-cell">

                    <div class="description-wrapper">

                        <div class="user-description-block">
                            <MudText Typo="Typo.caption"
                                     Color="Color.Primary"
                                     Class="fw-bold section-title">
                                USER REPORTED DESCRIPTION:
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Class="description-text">
                                @context.Description
                            </MudText>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(context.JobActionRemarks))
                        {
                            <MudDivider Class="my-2" />

                            <div class="remarks-block">

                                <MudText Typo="Typo.caption"
                                         Color="Color.Secondary"
                                         Class="fw-bold section-title">
                                    ENGINEER OBSERVATIONS:
                                </MudText>

                                <div class="remarks-text">
                                    @((MarkupString)context.JobActionRemarks.Replace("\n", "<br />"))
                                </div>

                            </div>
                        }

                    </div>

                </MudTd>

                

                @* <MudTd DataLabel="Location" Class="job-location-cell">
                    @context.LocationId
                </MudTd> *@

                <MudTd DataLabel="Action" Class="job-action-cell">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               FullWidth="true"
                               OnClick="@(() => StartJobExecution(context))">
                        Execute
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="4">
            <div class="d-flex align-center mb-4">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="CancelExecution" />
                <MudText Typo="Typo.h6" Class="ml-2">Executing: @_selectedJob?.JobName</MudText>
                <MudText Typo="Typo.h6" Class="ml-2">Executing: @_selectedJob?.Description</MudText>
            </div>

            @if (_selectedJob?.JobType == "preventive")
            {
                @* --- PREVENTIVE UI --- *@
                <MudAlert Severity="Severity.Info" Class="mb-4">Checklist: <b>@_detectedType</b></MudAlert>
                @foreach (var item in _filteredChecklist)
                {
                    <MudPaper Outlined="true" Class="pa-3 my-2">
                        <MudGrid AlignItems="Center">
                            <MudItem xs="1"><MudCheckBox T="bool" @bind-Value="item.IsCompleted" Color="Color.Primary" /></MudItem>
                            <MudItem xs="5"><MudText>@item.TaskDescription</MudText></MudItem>
                            <MudItem xs="6"><MudTextField T="string" @bind-Value="item.ItemObservation" Label="Remarks" Variant="Variant.Text" /></MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            }
            else
            {
                @* --- BREAKDOWN UI --- *@
                <MudGrid>
                   



                    <MudItem xs="12">
                        <MudTextField T="string" Label="Details of Work Done" Variant="Variant.Outlined" Lines="3" @bind-Value="_workDone" Required="true" />
                    </MudItem>


                    @* --- EXISTING PHOTOS SECTION --- *@
                    @if (_existingPhotos.Any())
                    {
                        <MudPaper Class="pa-4 mb-4" Elevation="2">
                            <MudText Typo="Typo.h6" Class="mb-3">Existing Job Photos</MudText>
                            <div class="d-flex flex-wrap gap-4">
                                @foreach (var photoUrl in _existingPhotos)
                                {
                                    <MudImage Src="@photoUrl"
                                              Width="120" Height="120"
                                              ObjectFit="ObjectFit.Cover"
                                              Class="cursor-pointer rounded hover-overlay"
                                              Elevation="4"
                                              @onclick="@(() => OpenImage(photoUrl))" />
                                }
                            </div>
                        </MudPaper>
                    }

                    @* --- FULLSCREEN IMAGE OVERLAY --- *@
                    <MudOverlay Visible="@_isImageOpen" DarkBackground="true" AutoClose="true" OnClick="@CloseImage" ZIndex="9999">
                        <div class="d-flex flex-column align-center justify-center" style="height: 100vh; width: 100vw; position: relative;">
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Error"
                                           Size="Size.Large"
                                           Style="position: absolute; top: 20px; right: 20px;"
                                           OnClick="@CloseImage" />
                            <MudImage Src="@_selectedImage" ObjectFit="ObjectFit.Contain" Style="max-height: 85vh; max-width: 90vw;" />
                        </div>
                    </MudOverlay>



                    <MudItem xs="12" sm="3">
                        <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileUpload" Accept="image/*" capture="camera" id="photo-up">
                            <ButtonTemplate>
                                <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.PhotoCamera" for="photo-up">Capture Photo</MudButton>
                            </ButtonTemplate>
                        </MudFileUpload>
                        @foreach (var file in _uploadedFiles)
                        {
                            <MudChip T="string" Color="Color.Success" OnClose="@(() => _uploadedFiles.Remove(file))">@file.Name</MudChip>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSwitch T="bool" Value="@_partReplaced" ValueChanged="@((v) => { _partReplaced = v; StateHasChanged(); })" Color="Color.Secondary" Label="Was any part replaced?" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSwitch T="bool" Value="@_overtime" ValueChanged="@((v) => { _overtime = v; StateHasChanged(); })" Color="Color.Secondary" Label="Was any overtime worked?" />
                    </MudItem>

                    @if (_overtime)
                    {
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_overtimeHours"
                                                 Label="Overtime Hours"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Step="1"
                                                 HideSpinButtons="false"
                                                 Adornment="Adornment.End"
                                                 AdornmentIcon="@Icons.Material.Filled.AccessTime" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_overtimeMinutes"
                                                 Label="Overtime Minutes"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Max="59"
                                                 Step="1"
                                                 HideSpinButtons="false"
                                                 Adornment="Adornment.End"
                                                 AdornmentIcon="@Icons.Material.Filled.Build" />
                            </MudItem>
                        </MudGrid>
                    }



                    @if (_partReplaced)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Class="mt-4">Replacement Details</MudText>
                            @foreach (var entry in _replacements)
                            {
                                <MudPaper Class="pa-4 mb-4" Outlined="true">
                                    <MudGrid Spacing="2">

                                        @* 1. DEVICE LOCATION *@
                                        <MudItem xs="12" sm="3">
                                            <MudSelect T="string" Label="Device Location"
                                                       Value="@entry.DeviceLocation"
                                                       ValueChanged="@(v => OnEntryDeviceLocationChanged(entry, v))"
                                                       Variant="Variant.Outlined"
                                                       Required="!entry.IsManualDeviceLocation">
                                                @foreach (var loc in GetAvailableLocations())
                                                {
                                                    <MudSelectItem Value="@loc">@loc</MudSelectItem>
                                                }
                                                <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Device Location Not Listed (Manual)</i></MudSelectItem>
                                            </MudSelect>
                                            @if (entry.IsManualDeviceLocation)
                                            {
                                                <MudTextField T="string" Class="mt-2" Label="Specify Device Location"
                                                              @bind-Value="entry.ManualDeviceLocationText"
                                                              Variant="Variant.Outlined" Required="true" />
                                            }
                                        </MudItem>

                                        @* 2. INSTRUMENT TYPE *@
                                        <MudItem xs="12" sm="3">
                                            <MudSelect T="string" Label="Instrument Type"
                                                       Value="@entry.InstrumentType"
                                                       ValueChanged="@(v => OnEntryInstrumentTypeChanged(entry, v))"
                                                       Variant="Variant.Outlined"
                                                       Required="!entry.IsManualInstrumentType"
                                                       Disabled="@(string.IsNullOrEmpty(entry.DeviceLocation) && !entry.IsManualDeviceLocation)">
                                                @foreach (var type in GetAvailableTypes(entry))
                                                {
                                                    <MudSelectItem Value="@type">@type</MudSelectItem>
                                                }
                                                <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Type Not Listed (Manual)</i></MudSelectItem>
                                            </MudSelect>
                                            @if (entry.IsManualInstrumentType)
                                            {
                                                <MudTextField T="string" Class="mt-2" Label="Specify Instrument Type"
                                                              @bind-Value="entry.ManualInstrumentTypeText"
                                                              Variant="Variant.Outlined" Required="true" />
                                            }
                                        </MudItem>

                                        @* 3. TAG NUMBER *@
                                        <MudItem xs="12" sm="3">
                                            <MudSelect T="string" Label="Tag Number"
                                                       Value="@entry.TagNumber"
                                                       ValueChanged="@(async v => await OnEntryTagNumberChanged(entry, v))"
                                                       Variant="Variant.Outlined"
                                                       Required="!entry.IsManualTagNumber"
                                                       Disabled="@(string.IsNullOrEmpty(entry.InstrumentType) && !entry.IsManualInstrumentType)">
                                                @foreach (var tag in GetAvailableTags(entry))
                                                {
                                                    <MudSelectItem Value="@tag">@tag</MudSelectItem>
                                                }
                                                <MudSelectItem Value="@_manualTextPlaceholder"><i>+ Tag Not Listed (Manual)</i></MudSelectItem>
                                            </MudSelect>
                                            @if (entry.IsManualTagNumber)
                                            {
                                                <MudTextField T="string" Class="mt-2" Label="Specify Tag Number"
                                                              @bind-Value="entry.ManualTagNumberText"
                                                              Variant="Variant.Outlined" Required="true" />
                                            }
                                        </MudItem>

                                        @* Old Data Display *@
                                        <MudItem xs="12" sm="3">
                                            <MudField Label="Old Data (Fetched)" Variant="Variant.Text" InnerPadding="false">
                                                @(string.IsNullOrEmpty(entry.OldMakeModel) ? "No existing record" : $"{entry.OldMakeModel} - {entry.OldRange}")
                                            </MudField>
                                        </MudItem>

                                        @* New Data Inputs *@
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Make/Model" @bind-Value="entry.NewMakeModel" Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Range" @bind-Value="entry.NewRange" Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="New Serial #" @bind-Value="entry.NewSerialNumber" Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudNumericField Label="Approx Cost" @bind-Value="entry.ApproxCost" Variant="Variant.Outlined" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddNewRow" Variant="Variant.Filled">Add Another Part</MudButton>
                        </MudItem>
                    }

                

                   

                </MudGrid>
            }

            <MudDivider Class="my-6" />
            <div class="d-flex gap-4">

                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ProcessJobSubmission" StartIcon="@Icons.Material.Filled.MarkChatRead">Further Review</MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleSubmit" StartIcon="@Icons.Material.Filled.CheckCircle">Finalize & Submit</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelExecution">Cancel</MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>
   




@code {

    [Table("employees_engineers")]
    public class EmployeeEngineer : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("emp_code")] public string EmpCode { get; set; } = "";
        [Column("email")] public string? Email { get; set; }
        [Column("full_name")] public string? FullName { get; set; }
    }

    [Table("employees_executives")]
    public class Executive : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("reports_to_id")] public long? ReportsToId { get; set; }
        [Column("email")] public string Email { get; set; } = "";
        [Column("designation")] public string Designation { get; set; } = "";
        [Column("full_name")] public string FullName { get; set; } = "";
        [Column("mobile")] public long? Mobile { get; set; }
        [Column("Department")] public string? Department { get; set; } // Case sensitive mapping
        [Column("annual_cost")] public long? AnnualCost { get; set; }
    }

    [Table("jobs")]
    public class Job : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("job_name")] public string JobName { get; set; } = "";
        [Column("job_type")] public string JobType { get; set; } = "";
        [Column("location_id")] public long? LocationId { get; set; }
        [Column("status")] public string Status { get; set; } = "pending";

        [Column("created_at")] public DateTime CreatedAt { get; set; } 
        // Matches your 'description' column in SQL
        [Column("description")] public string Description { get; set; } = "";

        // We will use this to store/display the cumulative trail of remarks
        // Note: If you don't have this column in public.jobs, you should add it
        // or rely solely on job_assignments.job_action_remarks.
        [Column("job_action_remarks")] public string? JobActionRemarks { get; set; }

        [Column("job_spare_replaced")] public string? JobSpareReplaced { get; set; }
        [Column("job_spare_cost")] public long? JobSpareCost { get; set; }
    }

    [Table("job_photos")]
    public class JobPhotoModel : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("storage_path")] public string StoragePath { get; set; } = "";
    }

    // CREATE THIS MODEL
    [Table("drivers")]
    public class Driver : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }
        [Column("full_name")] public string? FullName { get; set; }
        [Column("vehicle_number")] public string? VehicleNumber { get; set; }
        
    }


    [Table("job_assignments")]
    public class JobAssignment : BaseModel
    {
        [PrimaryKey("id", false)] public Guid Id { get; set; }
        [Column("job_ids")] public List<Guid>? JobIds { get; set; }

        // Add this property to map the int8[] column
        [Column("personnel_ids")] public List<long>? PersonnelIds { get; set; }

        // ADD THIS PROPERTY
        [Column("driver_id")] public long? DriverId { get; set; }

        [Column("job_action")] public string? JobAction { get; set; }
        [Column("job_action_time")] public DateTime? JobActionTime { get; set; }
        [Column("job_action_by")] public string? JobActionBy { get; set; }
        [Column("job_action_remarks")] public string? JobActionRemarks { get; set; }
        [Column("spare_replace")] public string? SpareReplace { get; set; }
        [Column("status")] public string? status { get; set; }
        [Column("job_overtime")] public float? JobOverTime { get; set; }

    }

    [Table("pm_reports")]
    public class PmReport : BaseModel
    {
        [Column("job_id")] public Guid JobId { get; set; }
        [Column("checklist_data")] public string ChecklistJson { get; set; } = "";
        [Column("observations")] public string Observations { get; set; } = "";
    }

    [Table("pm_master_checklist")]
    public class ChecklistItem : BaseModel
    {
        [Column("task_description")] public string TaskDescription { get; set; } = "";
        [Column("installation_type")] public string InstallationType { get; set; } = "";
        [IgnoreDataMember] public bool IsCompleted { get; set; }
        [IgnoreDataMember] public string ItemObservation { get; set; } = "";
    }

    [Table("locations")]
    public class Location : BaseModel
    {
        [PrimaryKey("id", false)] public long Id { get; set; }

        [Column("installation_name")] public string? InstallationName { get; set; }

        [Column("installation_type")] public string? InstallationType { get; set; }
        [Column("field_type")] public string? FieldType { get; set; }
    }


    private Dictionary<long, string> _locationLookup = new();
    private Dictionary<Guid, string> _jobPersonnelLookup = new();
    private Dictionary<Guid, string> _jobDriverLookup = new();

    private List<Job> _pendingJobs = new();
    private List<ChecklistItem> _allMasterTasks = new();
    private List<ChecklistItem> _filteredChecklist = new();
    private Job? _selectedJob;
    private bool _loading = true;
    private bool _isExecuting = false;
    private string _detectedType = "";
    private string _workDone = "";
    private bool _partReplaced = false;
    private bool _overtime = false;


    private int? _overtimeHours;
    private int? _overtimeMinutes;


    //private bool _isOvertime;
    private float? _currentOvertime;

    private string _spareDetails = "";
    //private List<IBrowserFile> _uploadedFiles = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }
    private string _email = "";
    private string _fullName = "";
    private string _designation = "";
    private long? _empCode;

    private List<string> _existingPhotos = new();
    private bool _isImageOpen = false;
    private string _selectedImage = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                _email = user.GetEmail();
                _fullName = user.GetFullName();
                _designation = user.GetDesignation();
                _empCode = await GetEngineerEmpCode(_fullName);
            }
        }
        await LoadInitialData();    
    } 

    private async Task<long?> GetEngineerEmpCode(string fullName)
    {
        try
        {
            var empRes = await SupabaseClient.From<EmployeeEngineer>()
                .Where(x => x.Email == _email)
                .Get();
            var currentEmployee = empRes.Models.FirstOrDefault();
            if (currentEmployee != null)
            {
                _empCode = long.Parse(currentEmployee.EmpCode);
                return _empCode;
            }
            else
            {
                Snackbar.Add("Could not locate your engineer profile in the system.", Severity.Warning);
                return null;
            }


        }
        catch (Exception e)
        {
            Console.WriteLine($"Error fetching employee data: {e.Message}");
            Snackbar.Add($"Error fetching employee data: {e.Message}", Severity.Error);
            return null;
        }
    }


    private async Task LoadInitialData()
    {
        try
        {
            _loading = true;

            // 1. Fetch all master data concurrently
            var locationsTask = SupabaseClient.From<Location>().Get();
            var engineersTask = SupabaseClient.From<EmployeeEngineer>().Get();
            var executivesTask = SupabaseClient.From<Executive>().Get();
            var checklistsTask = SupabaseClient.From<ChecklistItem>().Get();
            var driversTask = SupabaseClient.From<Driver>().Get();

            // Await all 5 parallel tasks together
            await Task.WhenAll(locationsTask, engineersTask, executivesTask, checklistsTask, driversTask);

            // 2. Build Base Lookups
            _locationLookup = locationsTask.Result.Models.ToDictionary(
                l => l.Id,
                l => l.InstallationName ?? "Unnamed Installation"
               
            );

            var allEngineers = engineersTask.Result.Models;
            var engineerLookup = allEngineers.ToDictionary(
                e => e.Id,
                e => e.FullName ?? "Unknown Engineer"
            );

            // Map the ID directly to the whole Driver object for multi-field access
            var driverLookup = driversTask.Result.Models.ToDictionary(d => d.Id);

            _allMasterTasks = checklistsTask.Result.Models;

            // 3. Identify User Role (In-memory search)
            var currentEmployee = allEngineers.FirstOrDefault(x => x.FullName == _fullName);
            var currentExec = executivesTask.Result.Models.FirstOrDefault(x => x.FullName == _fullName);

            List<JobAssignment> relevantAssignments = new();

            // --- ENGINEER LOGIC ---
            if (currentEmployee != null)
            {
                var assignmentsRes = await SupabaseClient.From<JobAssignment>()
                    .Filter("personnel_ids", Supabase.Postgrest.Constants.Operator.Contains, new List<long> { currentEmployee.Id })
                    .Get();

                relevantAssignments = assignmentsRes.Models.Where(a => a.status != "deleted").ToList();

                var assignedJobIds = relevantAssignments
                    .Where(a => a.JobIds != null)
                    .SelectMany(a => a.JobIds!)
                    .Distinct()
                    .ToList();

                if (assignedJobIds.Any())
                {
                    var jobsRes = await SupabaseClient.From<Job>()
                        .Where(x => x.Status == "assigned")
                        .Filter("id", Supabase.Postgrest.Constants.Operator.In, assignedJobIds)
                        .Order(x => x.CreatedAt, Supabase.Postgrest.Constants.Ordering.Descending)
                        .Get();

                    _pendingJobs = jobsRes.Models;
                }
                else
                {
                    _pendingJobs = new List<Job>();
                }
            }
            // --- EXECUTIVE LOGIC ---
            else if (currentExec != null)
            {
                var jobsRes = await SupabaseClient.From<Job>()
                    .Where(x => x.Status == "assigned")
                    .Order(x => x.CreatedAt, Supabase.Postgrest.Constants.Ordering.Descending)
                    .Get();

                _pendingJobs = jobsRes.Models;

                if (_pendingJobs.Any())
                {
                    var allAssignmentsRes = await SupabaseClient.From<JobAssignment>().Get();
                    relevantAssignments = allAssignmentsRes.Models.Where(a => a.status != "deleted").ToList();
                }
            }
            // --- NOT FOUND ---
            else
            {
                _pendingJobs = new List<Job>();
                Snackbar.Add("Could not locate your profile in the system.", Severity.Warning);
                return;
            }

            // 4. Map Personnel AND Drivers to Jobs for the UI Table
            _jobPersonnelLookup.Clear();
            _jobDriverLookup.Clear();

            foreach (var job in _pendingJobs)
            {
                var linkedAssignments = relevantAssignments
                    .Where(a => a.JobIds != null && a.JobIds.Contains(job.Id))
                    .ToList();

                var namesForThisJob = new List<string>();
                var driversForThisJob = new List<string>();

                foreach (var assignment in linkedAssignments)
                {
                    // Map Personnel
                    if (assignment.PersonnelIds != null)
                    {
                        foreach (var personId in assignment.PersonnelIds)
                        {
                            if (engineerLookup.TryGetValue(personId, out var engineerName))
                            {
                                namesForThisJob.Add(engineerName);
                            }
                        }
                    }

                    // Map Driver + Vehicle Number combined text
                    if (assignment.DriverId.HasValue)
                    {
                        if (driverLookup.TryGetValue(assignment.DriverId.Value, out var driver))
                        {
                            var driverName = driver.FullName ?? "Unknown Driver";
                            var vehicleNo = !string.IsNullOrWhiteSpace(driver.VehicleNumber) ? driver.VehicleNumber : "No Vehicle Assigned";

                            driversForThisJob.Add($"{driverName} ({vehicleNo})");
                        }
                    }
                }

                // Save Distinct Engineers
                var distinctNames = namesForThisJob.Distinct().ToList();
                _jobPersonnelLookup[job.Id] = distinctNames.Any()
                    ? string.Join(", ", distinctNames)
                    : "Unassigned";

                // Save Distinct Drivers
                var distinctDrivers = driversForThisJob.Distinct().ToList();
                _jobDriverLookup[job.Id] = distinctDrivers.Any()
                    ? string.Join(", ", distinctDrivers)
                    : "No Driver";
            }

            Console.WriteLine($"_pendingJobs: {_pendingJobs?.Count ?? 0}");
        }
        catch (Exception e)
        {
            Console.WriteLine($"Method Error: {e.Message}");
            Snackbar.Add($"Error : {e.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Simple lookup helper to consume inside the table layout safely
    private string GetDriverAndVehicleInfo(Guid jobId) =>
        _jobDriverLookup.TryGetValue(jobId, out var driverText) ? driverText : "No Driver";



